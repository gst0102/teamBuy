# 当前运行环境。development=本地开发；production=线上。
APP_ENV=development

# FastAPI 本地监听地址和端口。
APP_HOST=127.0.0.1
APP_PORT=8000

# 企业微信能访问到的公网后端地址，例如 https://api.your-domain.com。
PUBLIC_BASE_URL=https://your-domain.example.com
WECOM_ADMIN_TOKEN=replace-with-long-random-admin-token
# 客户信息链开关的首次默认值。生产建议 false，运营人员在 /ops 中确认后再打开。
CUSTOMER_INFO_CHAIN_DEFAULT_ENABLED=false

# 数据库类型。项目正式使用 PostgreSQL；local_json 仅用于无数据库时的本地兜底。
DATABASE_BACKEND=postgres

# PostgreSQL 连接串。
# 示例：postgresql+psycopg://teambuy:your_password@127.0.0.1:5432/teambuy
DATABASE_URL=postgresql+psycopg://teambuy:your_password@127.0.0.1:5432/teambuy

# JSON 本地兜底数据文件。DATABASE_BACKEND=local_json 时才会使用。
DATA_FILE=backend/mock/runtime-state.json

# 本地开发 true；真实企业微信 sync_msg 联调改 false。
WECOM_USE_MOCK=true

# 企业微信 API 域名。通常不用改。
WECOM_API_BASE_URL=https://qyapi.weixin.qq.com

# 企业微信企业 ID，通常 ww 开头。
WECOM_CORP_ID=wwxxxxxxxxxxxxxxxx

# 微信客服 / 外部联系人回调 Token，需和企业微信后台回调配置一致。
WECOM_KF_CALLBACK_TOKEN=teamBuy-dev-token

# 微信客服 Secret，用于获取 access_token。
WECOM_KF_SECRET=replace-with-wecom-kf-secret

# 微信客服回调 EncodingAESKey，43 位字符串。
WECOM_KF_ENCODING_AES_KEY=replace-with-43-char-encoding-aes-key

# 微信客服账号 ID，通常 wk 开头。
WECOM_OPEN_KFID=wkxxxxxxxxxxxxxxxx

# sync_msg 游标。首次为空；后续保存接口返回的新 cursor。
WECOM_SYNC_CURSOR=

# sync_msg 每次拉取条数。
WECOM_SYNC_LIMIT=100
WECOM_SYNC_LOCK_TIMEOUT_SECONDS=600

# 企业微信会话内容存档。开通后把后台 Secret 填入 WECOM_ARCHIVE_SECRET。
# 私钥只保存在服务器或本机，不提交 Git；公钥填到企业微信后台。
WECOM_ARCHIVE_ENABLED=false
WECOM_ARCHIVE_SECRET=replace-with-wecom-archive-secret
# 会话存档必须使用独立的回调凭证，不复用微信客服 / 外部联系人凭证。
WECOM_ARCHIVE_CALLBACK_TOKEN=replace-with-archive-callback-token
WECOM_ARCHIVE_ENCODING_AES_KEY=replace-with-43-char-archive-encoding-aes-key
WECOM_ARCHIVE_PRIVATE_KEY_PATH=backend/secrets/wecom_archive_private.pem
WECOM_ARCHIVE_PUBLIC_KEY_PATH=backend/secrets/wecom_archive_public.pem
# 后续接官方会话存档 SDK 时配置动态库路径，当前骨架阶段可留空。
WECOM_ARCHIVE_SDK_LIB_PATH=
WECOM_ARCHIVE_PULL_LIMIT=100
WECOM_ARCHIVE_SDK_TIMEOUT_SECONDS=30
WECOM_ARCHIVE_PROXY=
WECOM_ARCHIVE_PROXY_PASSWORD=
WECOM_ARCHIVE_WORKER_ENABLED=false
WECOM_ARCHIVE_WORKER_INTERVAL_SECONDS=60
# Set to shared after the standalone wecom-archive-core is deployed. In shared
# mode this project must not call Finance SDK; it only consumes routed events.
WECOM_ARCHIVE_SOURCE=direct
WECOM_ARCHIVE_CORE_PROJECT_ID=teamBuy
WECOM_ARCHIVE_CORE_PROJECT_TOKEN=
WECOM_ARCHIVE_CORE_MEDIA_BASE_URL=

# 小程序用户点击“添加企业微信助手”后，等待第一条企微消息自动绑定的有效期。
WECOM_BIND_INTENT_TTL_SECONDS=3600
# 小程序“联系我”插件在企业微信后台“使用指引”复制的配置ID。
WECOM_CONTACT_PLUGID=df29f3fd3ddc95bfec70e60cef93730c
# 可选：给该联系我方式配置的 state；填写后只处理 state 完全匹配的添加事件。
WECOM_CONTACT_STATE=
# 兼容旧配置；正式方案请在 PC 后台上传封面，由服务端自动上传和刷新 media_id。
WECOM_BIND_CARD_PIC_MEDIA_ID=
WECOM_BIND_CARD_TTL_SECONDS=600
WECOM_BIND_CARD_TITLE=点击完成绑定
WECOM_BIND_WELCOME_TEXT=你好，我是资料整理助手 👋\n\n以后你发来的图片、文件和链接，我会帮你整理到资料库。\n首次使用只需确认一次，之后直接发资料即可。\n\n点击下方“开启我的资料库”，开始使用。
WECOM_BIND_CARD_MEDIA_TTL_SECONDS=259200
WECOM_BIND_CARD_MEDIA_REFRESH_MARGIN_SECONDS=86400
WECOM_BIND_CARD_MAX_BYTES=2097152
# 仅自营测试可配置；为空时未绑定消息进入待认领，不能默认归到某个人。
WECOM_UNCLAIMED_DEFAULT_OWNER_USER_ID=

# 企业微信智能机器人网关令牌。WorkBuddy / 机器人入口调用后端时使用，不写入前端。
ROBOT_GATEWAY_TOKEN=replace-with-long-random-robot-token
AUTOMATION_OPERATOR_TOKEN=replace-with-long-random-automation-operator-token
AUTOMATION_DEVICE_TOKEN=replace-with-long-random-automation-device-token

# 企业微信群机器人 webhook 白名单。只写后端环境，不写前端。
# 示例：{"property":"https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx","resource":"https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=yyy"}
WECOM_GROUP_BOT_WEBHOOKS={}

# 媒体存储方式。mock=本地占位；cos=腾讯云 COS。
STORAGE_MODE=mock
MEDIA_STORAGE_DIR=backend/mock/media
MEDIA_PUBLIC_URL_PREFIX=/media
OBJECT_STORAGE_ENDPOINT=https://cos.ap-shanghai.myqcloud.com
OBJECT_STORAGE_REGION=ap-shanghai
OBJECT_STORAGE_BUCKET=replace-with-bucket-name
OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-access-key-id
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-secret-access-key
OBJECT_STORAGE_PUBLIC_BASE_URL=https://cdn.your-domain.example.com
OBJECT_STORAGE_KEY_PREFIX=wecom-media

# OCR 图片文字识别。auto 会优先尝试 PaddleOCR，再尝试 Tesseract；生产建议明确配置 provider。
OCR_PROVIDER=auto
OCR_LANGUAGE=chi_sim+eng
OCR_TESSERACT_BIN=tesseract
# 仅本地测试 mock provider 使用，生产不要配置真实业务文本。
OCR_MOCK_TEXT=

# 微信小程序正式登录。Secret 只放后端服务器，不写入小程序前端。
WECHAT_MINIAPP_APPID=wxf43f7bc098d9858b
WECHAT_MINIAPP_SECRET=replace-with-miniapp-secret
# 小程序订阅消息模板 ID：未读消息提醒（模板编号 654）。
WECHAT_MINIAPP_SUBSCRIBE_TEMPLATE_ID=replace-with-subscribe-template-id
# 模板字段键必须以微信后台“模板详情”里的 thing/time 键为准；当前模板“未读消息提醒”的实际字段如下。
WECHAT_MINIAPP_SUBSCRIBE_FIELD_KEYS={"messageName":"thing13","customerName":"thing16","projectName":"thing14","messageContent":"thing3","reminderTime":"time11"}
WECHAT_MINIAPP_SUBSCRIBE_PAGE=/pages/visits/index
WECHAT_JSCODE2SESSION_URL=https://api.weixin.qq.com/sns/jscode2session

# 微信支付 API v3。默认关闭，只有证书、私钥、API v3 Key 和回调地址配置齐全后才开启。
# 商户号不是密钥；API v3 Key、商户私钥和平台证书只能放在服务器环境/ secrets，不要提交 Git 或写入小程序。
WECHAT_PAY_ENABLED=false
WECHAT_PAY_MCH_ID=1111636477
WECHAT_PAY_API_V3_KEY=replace-with-32-byte-api-v3-key
WECHAT_PAY_CERT_SERIAL_NO=replace-with-merchant-api-cert-serial-number
WECHAT_PAY_PRIVATE_KEY_PATH=backend/secrets/wechat_pay_apiclient_key.pem
WECHAT_PAY_PLATFORM_CERT_SERIAL_NO=replace-with-wechat-platform-cert-serial-number
WECHAT_PAY_PLATFORM_CERT_PATH=backend/secrets/wechat_pay_platform_cert.pem
WECHAT_PAY_NOTIFY_URL=https://teambuy.lifelove.top/api/scrm/wechat-pay/notify
WECHAT_PAY_API_BASE_URL=https://api.mch.weixin.qq.com
WECHAT_PAY_TIMEOUT_SECONDS=15
# 商家转账/佣金提现。默认关闭；开通商家转账并完成真实联调后再开启。
WECHAT_TRANSFER_ENABLED=false
WECHAT_TRANSFER_SCENE_ID=1005
WECHAT_TRANSFER_NOTIFY_URL=https://teambuy.lifelove.top/api/scrm/wechat-transfer/notify
WECHAT_TRANSFER_TEST_MIN_AMOUNT_FEN=10
WECHAT_TRANSFER_MIN_AMOUNT_FEN=1000
WECHAT_TRANSFER_DAILY_WITHDRAWAL_LIMIT=1

# 腾讯地图地理编码。用于把房源默认地址转成经纬度，Key 只放后端。
TENCENT_MAP_KEY=
TENCENT_MAP_GEOCODER_URL=https://apis.map.qq.com/ws/geocoder/v1/

# 天眼查企业资源搜索。真实 Key 只允许写入 backend/.env 或生产环境变量，禁止写入前端。
TYC_API_KEY=
TYC_MCP_URL=https://mcp.tianyancha.com/v1
TYC_SEARCH_URL=https://open.api.tianyancha.com/services/v4/open/searchV2

# Python 依赖安装源。
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
