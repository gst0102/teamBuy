# 当前运行环境。development=本地开发；production=线上。
APP_ENV=development

# FastAPI 本地监听地址和端口。
APP_HOST=127.0.0.1
APP_PORT=8000

# 企业微信能访问到的公网后端地址，例如 https://api.your-domain.com。
PUBLIC_BASE_URL=https://your-domain.example.com
WECOM_ADMIN_TOKEN=replace-with-long-random-admin-token

# 数据库类型。项目正式使用 PostgreSQL；local_json 仅用于无数据库时的本地兜底。
DATABASE_BACKEND=postgres

# PostgreSQL 连接串。
# 示例：postgresql+psycopg://teambuy:your_password@127.0.0.1:5432/teambuy
DATABASE_URL=postgresql+psycopg://teambuy:your_password@127.0.0.1:5432/teambuy

# JSON 本地兜底数据文件。DATABASE_BACKEND=local_json 时才会使用。
DATA_FILE=backend/mock/runtime-state.json

# 本地开发 true；真实企业微信 sync_msg 联调改 false。
WECOM_USE_MOCK=true

# 企业微信 API 域名。通常不用改。
WECOM_API_BASE_URL=https://qyapi.weixin.qq.com

# 企业微信企业 ID，通常 ww 开头。
WECOM_CORP_ID=wwxxxxxxxxxxxxxxxx

# 微信客服回调 Token，需和企业微信后台回调配置一致。
WECOM_CALLBACK_TOKEN=teamBuy-dev-token

# 微信客服 Secret，用于获取 access_token。
WECOM_SECRET=replace-with-wecom-kf-secret

# 微信客服回调 EncodingAESKey，43 位字符串。
WECOM_ENCODING_AES_KEY=replace-with-43-char-encoding-aes-key

# 微信客服账号 ID，通常 wk 开头。
WECOM_OPEN_KFID=wkxxxxxxxxxxxxxxxx

# sync_msg 游标。首次为空；后续保存接口返回的新 cursor。
WECOM_SYNC_CURSOR=

# sync_msg 每次拉取条数。
WECOM_SYNC_LIMIT=100
WECOM_SYNC_LOCK_TIMEOUT_SECONDS=600

# 企业微信会话内容存档。开通后把后台 Secret 填入 WECOM_ARCHIVE_SECRET。
# 私钥只保存在服务器或本机，不提交 Git；公钥填到企业微信后台。
WECOM_ARCHIVE_ENABLED=false
WECOM_ARCHIVE_SECRET=replace-with-wecom-archive-secret
# 会话存档事件服务器可先复用 WECOM_CALLBACK_TOKEN / WECOM_ENCODING_AES_KEY。
# 如需单独配置，再填写下面两个值。
WECOM_ARCHIVE_CALLBACK_TOKEN=
WECOM_ARCHIVE_ENCODING_AES_KEY=
WECOM_ARCHIVE_PRIVATE_KEY_PATH=backend/secrets/wecom_archive_private.pem
WECOM_ARCHIVE_PUBLIC_KEY_PATH=backend/secrets/wecom_archive_public.pem
# 后续接官方会话存档 SDK 时配置动态库路径，当前骨架阶段可留空。
WECOM_ARCHIVE_SDK_LIB_PATH=
WECOM_ARCHIVE_PULL_LIMIT=100
WECOM_ARCHIVE_SDK_TIMEOUT_SECONDS=30
WECOM_ARCHIVE_PROXY=
WECOM_ARCHIVE_PROXY_PASSWORD=
WECOM_ARCHIVE_WORKER_ENABLED=false
WECOM_ARCHIVE_WORKER_INTERVAL_SECONDS=60

# 企业微信智能机器人网关令牌。WorkBuddy / 机器人入口调用后端时使用，不写入前端。
ROBOT_GATEWAY_TOKEN=replace-with-long-random-robot-token

# 媒体存储方式。mock=本地占位；cos=腾讯云 COS。
STORAGE_MODE=mock
MEDIA_STORAGE_DIR=backend/mock/media
MEDIA_PUBLIC_URL_PREFIX=/media
OBJECT_STORAGE_ENDPOINT=https://cos.ap-shanghai.myqcloud.com
OBJECT_STORAGE_REGION=ap-shanghai
OBJECT_STORAGE_BUCKET=replace-with-bucket-name
OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-access-key-id
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-secret-access-key
OBJECT_STORAGE_PUBLIC_BASE_URL=https://cdn.your-domain.example.com
OBJECT_STORAGE_KEY_PREFIX=wecom-media

# OCR 图片文字识别。auto 会优先尝试 PaddleOCR，再尝试 Tesseract；生产建议明确配置 provider。
OCR_PROVIDER=auto
OCR_LANGUAGE=chi_sim+eng
OCR_TESSERACT_BIN=tesseract
# 仅本地测试 mock provider 使用，生产不要配置真实业务文本。
OCR_MOCK_TEXT=

# 微信小程序正式登录。Secret 只放后端服务器，不写入小程序前端。
WECHAT_MINIAPP_APPID=wxf43f7bc098d9858b
WECHAT_MINIAPP_SECRET=replace-with-miniapp-secret
WECHAT_JSCODE2SESSION_URL=https://api.weixin.qq.com/sns/jscode2session

# 腾讯地图地理编码。用于把房源默认地址转成经纬度，Key 只放后端。
TENCENT_MAP_KEY=
TENCENT_MAP_GEOCODER_URL=https://apis.map.qq.com/ws/geocoder/v1/

# 天眼查企业资源搜索。真实 Key 只允许写入 backend/.env 或生产环境变量，禁止写入前端。
TYC_API_KEY=
TYC_MCP_URL=https://mcp.tianyancha.com/v1
TYC_SEARCH_URL=https://open.api.tianyancha.com/services/v4/open/searchV2

# Python 依赖安装源。
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
