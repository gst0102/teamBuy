page {
  background: #eef6ff;
  color: #172033;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page-shell {
  min-height: 100vh;
  padding: 28rpx 28rpx 44rpx;
  background:
    radial-gradient(circle at 88% 4%, rgba(22, 119, 255, 0.16), transparent 260rpx),
    linear-gradient(180deg, #eef6ff 0%, #f8fbff 44%, #ffffff 100%);
  box-sizing: border-box;
}

.panel {
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 32rpx;
  padding: 28rpx;
  box-shadow: 0 18rpx 46rpx rgba(31, 88, 168, 0.09);
  margin-bottom: 24rpx;
}

.title {
  font-size: 38rpx;
  font-weight: 800;
  margin-bottom: 16rpx;
  color: #121826;
}

.muted {
  color: #738093;
  font-size: 26rpx;
  line-height: 1.55;
}

.primary-btn {
  background: linear-gradient(135deg, #2d8cff 0%, #0066ff 100%);
  color: #fff;
  border-radius: 999rpx;
  box-shadow: 0 14rpx 30rpx rgba(22, 119, 255, 0.28);
}

.ghost-btn {
  background: #edf5ff;
  color: #1677ff;
  border-radius: 999rpx;
  border: 1rpx solid rgba(22, 119, 255, 0.14);
}

.tag {
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #edf5ff;
  color: #1677ff;
  font-size: 22rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

.field-label {
  color: #5b6678;
  font-size: 24rpx;
  margin-bottom: 10rpx;
}

.field-input {
  background: #fff;
  border: 2rpx solid #e5efff;
  border-radius: 24rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 18rpx;
}

.brand-bar {
  padding: 10rpx 6rpx 22rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 800;
  color: #111827;
}

.hero-title {
  font-size: 58rpx;
  font-weight: 900;
  line-height: 1.1;
  letter-spacing: -2rpx;
  color: #0f172a;
}

.hero-highlight {
  color: #1677ff;
}

.hero-subtitle {
  color: #5e6b7e;
  font-size: 28rpx;
  line-height: 1.6;
  margin-top: 18rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #121826;
}

.section-link {
  font-size: 24rpx;
  color: #8a96a8;
}

.stat-grid {
  display: flex;
  gap: 16rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-icon {
  width: 66rpx;
  height: 66rpx;
  border-radius: 24rpx;
  margin: 0 auto 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
}

.stat-value {
  display: block;
  font-size: 34rpx;
  font-weight: 900;
  color: #101828;
}

.stat-label {
  display: block;
  font-size: 22rpx;
  color: #6b7788;
  margin-top: 4rpx;
}

.chip-row {
  display: flex;
  gap: 16rpx;
  overflow-x: auto;
  white-space: nowrap;
  padding-bottom: 8rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 28rpx;
  background: rgba(255, 255, 255, 0.88);
  color: #5f6d80;
  border-radius: 24rpx;
  font-size: 26rpx;
  box-shadow: 0 10rpx 24rpx rgba(31, 88, 168, 0.06);
}

.chip.active {
  background: linear-gradient(135deg, #2d8cff 0%, #0066ff 100%);
  color: #fff;
  box-shadow: 0 14rpx 28rpx rgba(22, 119, 255, 0.22);
}

.card-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.resource-card {
  width: calc(50% - 10rpx);
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 28rpx;
  padding: 20rpx;
  box-shadow: 0 14rpx 36rpx rgba(31, 88, 168, 0.08);
}

.resource-cover {
  width: 100%;
  height: 150rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #eaf3ff, #f6f9ff);
  margin-bottom: 16rpx;
}

.resource-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #172033;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.resource-meta {
  margin-top: 12rpx;
  color: #7d8898;
  font-size: 22rpx;
}

.empty-state {
  padding: 48rpx 24rpx;
  text-align: center;
  color: #8a96a8;
  font-size: 26rpx;
}
