.relay-card {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #edf2f8;
}

.relay-card:last-child {
  border-bottom: none;
}

.relay-head {
  display: flex;
  align-items: center;
}

.relay-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #edf5ff;
}

.relay-main {
  flex: 1;
  margin-left: 18rpx;
}

.relay-name {
  font-size: 28rpx;
  font-weight: 900;
  color: #172033;
}

.relay-status {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #fff1df;
  color: #f97316;
  font-size: 22rpx;
  font-weight: 800;
}

.relay-status.followed {
  background: #dcfae6;
  color: #079455;
}

.relay-fields {
  margin: 18rpx 0 0 90rpx;
}

.relay-field {
  color: #526070;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.relay-actions {
  display: flex;
  gap: 16rpx;
  margin: 18rpx 0 0 90rpx;
}
