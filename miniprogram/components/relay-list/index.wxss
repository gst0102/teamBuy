.relay-card {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #edf2f8;
}

.relay-card.pending {
  margin: 16rpx 0;
  padding: 22rpx;
  border: 1rpx solid #ffd29a;
  border-radius: 24rpx;
  background: #fffaf2;
}

.relay-card:last-child {
  border-bottom: none;
}

.relay-head {
  display: flex;
  align-items: center;
}

.relay-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #edf5ff;
}

.relay-avatar.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #ffffff;
  background: linear-gradient(135deg, #1677ff, #20c997);
  font-size: 28rpx;
  font-weight: 900;
}

.relay-main {
  flex: 1;
  margin-left: 18rpx;
}

.relay-name {
  font-size: 28rpx;
  font-weight: 900;
  color: #172033;
}

.relay-status {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #fff1df;
  color: #f97316;
  font-size: 22rpx;
  font-weight: 800;
  white-space: nowrap;
}

.relay-status.pending {
  background: #fff1df;
  color: #f97316;
}

.relay-status.followed {
  background: #dcfae6;
  color: #079455;
}

.relay-fields {
  margin: 18rpx 0 0 90rpx;
}

.relay-field {
  color: #526070;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.relay-quick-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 18rpx 0 0 90rpx;
}

.quick-btn {
  margin: 0;
  padding: 0 18rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 999rpx;
  background: #edf5ff;
  color: #1677ff;
  font-size: 22rpx;
  font-weight: 800;
}

.quick-btn.primary {
  background: #1677ff;
  color: #fff;
}

.quick-btn::after {
  border: none;
}

.relay-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 18rpx 0 0 90rpx;
}

.relay-action-btn {
  margin: 0;
  padding: 0 22rpx;
  min-width: 150rpx;
  height: 58rpx;
  line-height: 58rpx;
  border-radius: 14rpx;
  background: #f6f8fb;
  color: #172033;
  font-size: 24rpx;
  font-weight: 800;
}

.relay-action-btn.danger {
  background: #fff1f3;
  color: #d92d20;
}

.relay-action-btn::after {
  border: none;
}
