.studio-page {
  padding-bottom: 150rpx;
  background:
    radial-gradient(circle at 94% 3%, rgba(41, 184, 98, 0.18), transparent 260rpx),
    linear-gradient(180deg, #f2f8f3 0%, #f7fbff 46%, #ffffff 100%);
}

.studio-hero {
  padding: 30rpx 6rpx 24rpx;
}

.hero-kicker {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 42rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(16, 157, 71, 0.12);
  color: #0b8d37;
  font-size: 22rpx;
  font-weight: 800;
}

.studio-title {
  margin-top: 18rpx;
  color: #0f172a;
  font-size: 48rpx;
  line-height: 1.14;
  font-weight: 900;
}

.studio-subtitle {
  margin-top: 14rpx;
  color: #667085;
  font-size: 26rpx;
  line-height: 1.55;
}

.step-bar {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-bottom: 22rpx;
}

.step-item {
  min-height: 72rpx;
  padding: 10rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.84);
  border: 2rpx solid rgba(15, 23, 42, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  color: #667085;
  font-size: 22rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.step-item.active {
  color: #ffffff;
  border-color: #13a538;
  background: linear-gradient(135deg, #25bb4b, #078d31);
  box-shadow: 0 14rpx 30rpx rgba(7, 141, 49, 0.2);
}

.step-no {
  width: 32rpx;
  height: 32rpx;
  border-radius: 10rpx;
  background: rgba(15, 23, 42, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}

.step-item.active .step-no {
  color: #078d31;
  background: #ffffff;
}

.existing-card-panel {
  margin-bottom: 22rpx;
  padding: 22rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 2rpx solid rgba(22, 163, 74, 0.16);
  box-shadow: 0 14rpx 34rpx rgba(20, 78, 52, 0.08);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.existing-card-kicker {
  color: #0b8d37;
  font-size: 22rpx;
  font-weight: 900;
}

.existing-card-title {
  margin-top: 8rpx;
  color: #101828;
  font-size: 30rpx;
  line-height: 1.25;
  font-weight: 900;
}

.existing-card-sub {
  margin-top: 8rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.35;
}

.existing-card-actions {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.existing-card-actions view {
  min-width: 128rpx;
  height: 48rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #eefbf3;
  color: #0b8d37;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.stage-panel {
  padding: 24rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 18rpx 48rpx rgba(20, 78, 52, 0.08);
  border: 2rpx solid rgba(255, 255, 255, 0.86);
}

.stage-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 22rpx;
}

.view-switch {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  padding: 6rpx;
  border-radius: 999rpx;
  background: #f2f4f7;
}

.view-switch-item {
  min-width: 74rpx;
  height: 44rpx;
  border-radius: 999rpx;
  color: #667085;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 800;
}

.view-switch-item.active {
  color: #ffffff;
  background: #16a34a;
  box-shadow: 0 8rpx 18rpx rgba(22, 163, 74, 0.18);
}

.stage-title {
  color: #101828;
  font-size: 34rpx;
  font-weight: 900;
}

.stage-desc {
  margin-top: 8rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.45;
}

.style-pill {
  flex: 0 0 auto;
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(16, 157, 71, 0.1);
  color: #0b8d37;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 800;
}

.template-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 18rpx;
}

.template-grid.mode-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.template-option {
  padding: 12rpx;
  border-radius: 28rpx;
  background: #ffffff;
  border: 2rpx solid #edf2f7;
  box-shadow: 0 14rpx 34rpx rgba(15, 23, 42, 0.06);
  box-sizing: border-box;
}

.template-option.active {
  border-color: #16a34a;
  box-shadow: 0 18rpx 40rpx rgba(22, 163, 74, 0.16);
}

.template-preview,
.share-card {
  position: relative;
  overflow: hidden;
  min-height: 278rpx;
  border-radius: 24rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.template-grid.mode-list .template-preview {
  min-height: 318rpx;
  padding: 28rpx;
  border-radius: 30rpx;
}

.template-grid.mode-list .tpl-main-row {
  gap: 24rpx;
}

.template-grid.mode-list .tpl-avatar {
  width: 124rpx;
  height: 124rpx;
}

.template-grid.mode-list .tpl-name {
  font-size: 40rpx;
}

.template-grid.mode-list .tpl-role,
.template-grid.mode-list .tpl-org,
.template-grid.mode-list .tpl-contact {
  font-size: 24rpx;
}

.template-grid.mode-list .tpl-badge {
  min-height: 42rpx;
  padding: 0 18rpx;
  font-size: 22rpx;
}

.template-grid.mode-list .tpl-chip {
  min-height: 40rpx;
  padding: 0 16rpx;
  font-size: 22rpx;
}

.template-grid.mode-list .tpl-qr {
  width: 78rpx;
  height: 78rpx;
  right: 24rpx;
  bottom: 24rpx;
}

.tpl-main-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.tpl-avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  font-size: 34rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.tpl-avatar-photo {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 10;
}

.tpl-avatar-photo + .portrait-hair,
.tpl-avatar-photo ~ .portrait-face,
.tpl-avatar-photo ~ .portrait-neck,
.tpl-avatar-photo ~ .portrait-clothes {
  display: none;
}

.portrait-hair,
.portrait-face,
.portrait-neck,
.portrait-clothes,
.portrait-eye,
.portrait-smile {
  position: absolute;
  box-sizing: border-box;
}

.portrait-face {
  left: 26%;
  top: 21%;
  width: 48%;
  height: 46%;
  border-radius: 46% 46% 42% 42%;
  background: #f3c6a6;
  z-index: 3;
}

.portrait-hair {
  left: 18%;
  top: 10%;
  width: 64%;
  height: 46%;
  border-radius: 48% 48% 32% 32%;
  background: #1c2430;
  z-index: 4;
}

.portrait-eye {
  top: 40%;
  width: 8%;
  height: 8%;
  border-radius: 50%;
  background: #18202b;
  z-index: 5;
}

.portrait-eye.left {
  left: 32%;
}

.portrait-eye.right {
  right: 32%;
}

.portrait-smile {
  left: 38%;
  top: 62%;
  width: 24%;
  height: 12%;
  border-bottom: 3rpx solid rgba(24, 32, 43, 0.6);
  border-radius: 0 0 999rpx 999rpx;
  z-index: 5;
}

.portrait-neck {
  left: 40%;
  top: 62%;
  width: 20%;
  height: 18%;
  border-radius: 8rpx;
  background: #e8b995;
  z-index: 2;
}

.portrait-clothes {
  left: 17%;
  bottom: -9%;
  width: 66%;
  height: 34%;
  border-radius: 32rpx 32rpx 10rpx 10rpx;
  background: #173d72;
  z-index: 1;
}

.avatar-female .portrait-hair {
  left: 14%;
  top: 8%;
  width: 72%;
  height: 70%;
  border-radius: 48% 48% 42% 42%;
  background: #2a2020;
}

.avatar-female .portrait-face {
  top: 24%;
  z-index: 5;
}

.avatar-female .portrait-clothes {
  background: #222833;
}

.avatar-suit-blue .portrait-clothes {
  background: #0d2d5a;
}

.avatar-apron-green .portrait-clothes {
  background: #477446;
}

.avatar-suit-dark .portrait-clothes {
  background: #11151b;
}

.avatar-casual-light .portrait-hair {
  background: #2b2f39;
}

.avatar-casual-light .portrait-clothes {
  background: #e7efe8;
  border-top: 8rpx solid #4ea65e;
}

.tpl-copy {
  flex: 1;
  min-width: 0;
}

.tpl-name {
  font-size: 30rpx;
  line-height: 1.15;
  font-weight: 900;
}

.tpl-role,
.tpl-org,
.tpl-contact {
  margin-top: 8rpx;
  font-size: 18rpx;
  line-height: 1.3;
}

.tpl-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 34rpx;
  padding: 0 14rpx;
  margin-top: 10rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 800;
}

.tpl-contact,
.tpl-chip-row,
.tpl-qr {
  position: relative;
  z-index: 1;
}

.tpl-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
  padding-right: 68rpx;
}

.tpl-chip {
  min-height: 32rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.tpl-qr {
  position: absolute;
  right: 18rpx;
  bottom: 18rpx;
  width: 58rpx;
  height: 58rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 900;
}

.tpl-store-cover {
  position: absolute;
  top: 0;
  right: 0;
  width: 54%;
  height: 116rpx;
  background:
    linear-gradient(90deg, rgba(245, 247, 239, 0.5), rgba(86, 114, 80, 0.22)),
    repeating-linear-gradient(90deg, #d8c5a8 0 18rpx, #f6ede0 18rpx 38rpx);
  border-bottom-left-radius: 36rpx;
}

.preview-bg-shape,
.share-bg-shape {
  position: absolute;
  right: -34rpx;
  top: -40rpx;
  width: 170rpx;
  height: 170rpx;
  border-radius: 50%;
  opacity: 0.18;
}

.template-name-row {
  min-height: 86rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  padding-top: 12rpx;
}

.template-name {
  color: #101828;
  font-size: 26rpx;
  font-weight: 900;
}

.template-subtitle {
  margin-top: 6rpx;
  color: #667085;
  font-size: 20rpx;
  line-height: 1.35;
}

.selected-dot {
  flex: 0 0 auto;
  min-width: 64rpx;
  height: 40rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #1677ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.template-option.active .selected-dot {
  background: #16a34a;
  color: #ffffff;
}

.tpl-consultant_classic {
  color: #ffffff;
  background: linear-gradient(135deg, #0c2349 0%, #173d72 100%);
}

.tpl-consultant_classic .tpl-avatar {
  color: #0b2855;
  background: linear-gradient(180deg, #ffffff, #e7f0ff);
  border: 4rpx solid rgba(236, 196, 118, 0.9);
}

.tpl-consultant_classic .tpl-badge,
.tpl-consultant_classic .tpl-qr {
  color: #132640;
  background: linear-gradient(135deg, #f8d89c, #e7b85f);
}

.tpl-consultant_classic .tpl-role,
.tpl-consultant_classic .tpl-org,
.tpl-consultant_classic .tpl-contact {
  color: rgba(255, 255, 255, 0.82);
}

.tpl-consultant_classic .tpl-chip {
  color: #f3d290;
  border: 1rpx solid rgba(243, 210, 144, 0.42);
}

.tpl-consultant_classic .preview-bg-shape,
.tpl-consultant_classic .share-bg-shape {
  background: #ffffff;
}

.tpl-store_sales_card {
  color: #243426;
  background: linear-gradient(135deg, #edf5e8 0%, #ffffff 55%, #dfead8 100%);
  border: 2rpx solid rgba(67, 109, 66, 0.22);
}

.tpl-store_sales_card .tpl-avatar {
  color: #ffffff;
  background: #477446;
  border: 4rpx solid #ffffff;
}

.tpl-store_sales_card .tpl-badge,
.tpl-store_sales_card .tpl-qr {
  color: #ffffff;
  background: #477446;
}

.tpl-store_sales_card .tpl-role,
.tpl-store_sales_card .tpl-org,
.tpl-store_sales_card .tpl-contact {
  color: #516052;
}

.tpl-store_sales_card .tpl-chip {
  color: #2f7035;
  background: rgba(70, 128, 74, 0.12);
}

.tpl-store_sales_card .preview-bg-shape,
.tpl-store_sales_card .share-bg-shape {
  background: #477446;
}

.tpl-expert_personal_brand {
  color: #ffffff;
  background: linear-gradient(145deg, #11151b 0%, #0a0d12 58%, #272128 100%);
}

.tpl-expert_personal_brand .tpl-avatar {
  color: #11151b;
  background: linear-gradient(180deg, #fff6e2, #d6a451);
  border: 3rpx solid #d6a451;
}

.tpl-expert_personal_brand .tpl-badge,
.tpl-expert_personal_brand .tpl-qr {
  color: #17120a;
  background: linear-gradient(135deg, #f0c878, #b5792e);
}

.tpl-expert_personal_brand .tpl-role,
.tpl-expert_personal_brand .tpl-org,
.tpl-expert_personal_brand .tpl-contact {
  color: rgba(255, 255, 255, 0.72);
}

.tpl-expert_personal_brand .tpl-chip {
  color: #f0c878;
  border: 1rpx solid rgba(240, 200, 120, 0.42);
}

.tpl-expert_personal_brand .preview-bg-shape,
.tpl-expert_personal_brand .share-bg-shape {
  background: #f0c878;
}

.tpl-wechat_simple_card {
  color: #15191f;
  background: linear-gradient(135deg, #ffffff 0%, #f7fbf8 100%);
  border: 2rpx solid #edf2ef;
}

.tpl-wechat_simple_card .tpl-main-row {
  flex-direction: column;
  justify-content: center;
  text-align: center;
}

.tpl-wechat_simple_card .tpl-avatar {
  color: #2c6f3b;
  background: #eef7f0;
  border: 4rpx solid #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(49, 116, 62, 0.12);
}

.tpl-wechat_simple_card .tpl-badge {
  color: #4ea65e;
  background: rgba(78, 166, 94, 0.12);
}

.tpl-wechat_simple_card .tpl-role,
.tpl-wechat_simple_card .tpl-org,
.tpl-wechat_simple_card .tpl-contact {
  color: #667085;
  text-align: center;
}

.tpl-wechat_simple_card .tpl-chip {
  color: #697386;
  background: #f2f4f7;
}

.tpl-wechat_simple_card .tpl-qr {
  color: #2c6f3b;
  background: #eef7f0;
}

.tpl-wechat_simple_card .preview-bg-shape,
.tpl-wechat_simple_card .share-bg-shape {
  background: #4ea65e;
}

.image-fields {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-bottom: 22rpx;
}

.image-picker {
  min-height: 210rpx;
  border-radius: 28rpx;
  background: #f8fafc;
  border: 2rpx dashed #d9e5f2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-sizing: border-box;
}

.image-preview,
.image-placeholder {
  width: 112rpx;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eef4ff;
  color: #1677ff;
  font-size: 24rpx;
  font-weight: 900;
}

.image-preview.avatar,
.image-placeholder.avatar {
  border-radius: 50%;
}

.image-preview.qr,
.image-placeholder.qr {
  border-radius: 18rpx;
}

.image-label {
  color: #475467;
  font-size: 24rpx;
  font-weight: 800;
}

.form-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 0 18rpx;
}

.form-field {
  width: 100%;
}

.form-field.half {
  width: calc((100% - 18rpx) / 2);
}

.form-field.third {
  width: calc((100% - 36rpx) / 3);
}

.studio-input {
  min-height: 78rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.studio-textarea {
  width: 100%;
  min-height: 120rpx;
  font-size: 26rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

.studio-textarea.long {
  min-height: 170rpx;
}

.confirm-section-title {
  margin: 18rpx 0 12rpx;
  color: #101828;
  font-size: 28rpx;
  font-weight: 900;
}

.preview-tabs {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
  border-radius: 18rpx;
  background: #f2f4f7;
}

.preview-tab {
  height: 70rpx;
  border-radius: 14rpx;
  color: #475467;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 900;
}

.preview-tab.active {
  color: #ffffff;
  background: linear-gradient(135deg, #24b448, #078d31);
  box-shadow: 0 10rpx 22rpx rgba(7, 141, 49, 0.2);
}

.share-card {
  min-height: 248rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.share-avatar-wrap {
  position: relative;
  z-index: 1;
  flex: 0 0 auto;
}

.share-avatar {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  border: 5rpx solid rgba(255, 255, 255, 0.9);
  box-sizing: border-box;
}

.share-avatar.fallback {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.88);
  color: #0b2855;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 900;
}

.share-info {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
}

.share-name {
  font-size: 46rpx;
  line-height: 1.1;
  font-weight: 900;
}

.share-role {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 42rpx;
  padding: 0 16rpx;
  margin-top: 12rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.share-company,
.share-headline,
.share-contact {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.35;
}

.share-qr {
  position: relative;
  z-index: 1;
  flex: 0 0 auto;
  width: 92rpx;
  height: 92rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #ffffff;
  color: #111827;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 900;
}

.share-qr image {
  width: 100%;
  height: 100%;
}

.share-card.tpl-consultant_classic .share-role,
.share-card.tpl-consultant_classic .share-qr {
  color: #162640;
  background: linear-gradient(135deg, #f8d89c, #e7b85f);
}

.share-card.tpl-store_sales_card .share-role,
.share-card.tpl-store_sales_card .share-qr {
  color: #ffffff;
  background: #477446;
}

.share-card.tpl-store_sales_card .inline-editable.light,
.phone-frame.tpl-store_sales_card .inline-editable.light {
  border-color: rgba(47, 112, 53, 0.24);
  background: rgba(70, 128, 74, 0.08);
}

.share-card.tpl-store_sales_card .inline-editable.light .inline-edit-tip,
.phone-frame.tpl-store_sales_card .inline-editable.light .inline-edit-tip {
  color: #2f7035;
  background: rgba(70, 128, 74, 0.14);
}

.share-card.tpl-expert_personal_brand .share-role,
.share-card.tpl-expert_personal_brand .share-qr {
  color: #17120a;
  background: linear-gradient(135deg, #f0c878, #b5792e);
}

.share-card.tpl-wechat_simple_card {
  justify-content: center;
  text-align: center;
}

.share-card.tpl-wechat_simple_card .share-role,
.share-card.tpl-wechat_simple_card .share-qr {
  color: #2c6f3b;
  background: #eef7f0;
}

.phone-frame {
  overflow: hidden;
  border-radius: 34rpx;
  background: #ffffff;
  border: 2rpx solid rgba(15, 23, 42, 0.06);
  box-shadow: 0 18rpx 44rpx rgba(15, 23, 42, 0.08);
}

.phone-status {
  height: 58rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  color: #101828;
  font-size: 22rpx;
  font-weight: 900;
}

.detail-hero {
  padding: 28rpx;
  text-align: center;
}

.detail-avatar-wrap {
  display: flex;
  justify-content: center;
}

.detail-avatar {
  width: 124rpx;
  height: 124rpx;
  border-radius: 50%;
  border: 5rpx solid #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(15, 23, 42, 0.12);
  box-sizing: border-box;
}

.detail-avatar.fallback {
  width: 124rpx;
  height: 124rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eef4ff;
  color: #1677ff;
  font-size: 42rpx;
  font-weight: 900;
}

.detail-name {
  margin-top: 16rpx;
  color: #101828;
  font-size: 42rpx;
  font-weight: 900;
}

.detail-role,
.detail-company,
.detail-headline {
  margin-top: 8rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.45;
}

.detail-actions {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2rpx;
  margin: 0 20rpx 20rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #edf2f7;
}

.detail-actions.count-2 {
  grid-template-columns: repeat(2, 1fr);
}

.detail-actions.count-3 {
  grid-template-columns: repeat(3, 1fr);
}

.detail-action {
  min-height: 118rpx;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #344054;
  font-size: 22rpx;
  font-weight: 800;
}

.detail-action-icon {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background: #1677ff;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 900;
}

.detail-block {
  margin: 0 20rpx 20rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(15, 23, 42, 0.06);
}

.detail-block-title {
  color: #101828;
  font-size: 28rpx;
  font-weight: 900;
}

.detail-block-text,
.contact-line {
  margin-top: 12rpx;
  color: #475467;
  font-size: 25rpx;
  line-height: 1.55;
}

.scope-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.scope-chip {
  min-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #f2f4f7;
  color: #475467;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  white-space: nowrap;
}

.contact-block {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.detail-qr {
  flex: 0 0 auto;
  width: 132rpx;
  height: 132rpx;
  border-radius: 16rpx;
  background: #f2f4f7;
}

.phone-frame.tpl-consultant_classic .detail-hero {
  background: linear-gradient(135deg, #0c2349, #173d72);
}

.phone-frame.tpl-consultant_classic .detail-name,
.phone-frame.tpl-consultant_classic .detail-role,
.phone-frame.tpl-consultant_classic .detail-company,
.phone-frame.tpl-consultant_classic .detail-headline {
  color: #ffffff;
}

.phone-frame.tpl-consultant_classic .detail-action-icon {
  background: #0c2349;
}

.phone-frame.tpl-store_sales_card .detail-hero {
  background: linear-gradient(135deg, #edf5e8, #dfead8);
}

.phone-frame.tpl-store_sales_card .detail-action-icon {
  background: #477446;
}

.phone-frame.tpl-expert_personal_brand {
  background: #0d1117;
}

.phone-frame.tpl-expert_personal_brand .phone-status,
.phone-frame.tpl-expert_personal_brand .detail-name,
.phone-frame.tpl-expert_personal_brand .detail-role,
.phone-frame.tpl-expert_personal_brand .detail-company,
.phone-frame.tpl-expert_personal_brand .detail-headline,
.phone-frame.tpl-expert_personal_brand .detail-block-title {
  color: #ffffff;
}

.phone-frame.tpl-expert_personal_brand .detail-hero {
  background: linear-gradient(145deg, #11151b, #0a0d12);
}

.phone-frame.tpl-expert_personal_brand .detail-block,
.phone-frame.tpl-expert_personal_brand .detail-action {
  background: #151a22;
}

.phone-frame.tpl-expert_personal_brand .detail-block-text,
.phone-frame.tpl-expert_personal_brand .contact-line,
.phone-frame.tpl-expert_personal_brand .detail-action {
  color: rgba(255, 255, 255, 0.72);
}

.phone-frame.tpl-expert_personal_brand .detail-action-icon {
  color: #17120a;
  background: linear-gradient(135deg, #f0c878, #b5792e);
}

.phone-frame.tpl-wechat_simple_card .detail-hero {
  background: linear-gradient(180deg, #ffffff, #f8fbf9);
}

.phone-frame.tpl-wechat_simple_card .detail-action-icon {
  background: #4ea65e;
}

.confirm-template-row {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  padding-bottom: 4rpx;
}

.confirm-template-item {
  min-width: 0;
  text-align: center;
}

.confirm-template-thumb {
  position: relative;
  width: 100%;
  height: 96rpx;
  border-radius: 14rpx;
  overflow: hidden;
  border: 3rpx solid #edf2f7;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.confirm-template-item.active .confirm-template-thumb {
  border-color: #16a34a;
  box-shadow: 0 8rpx 22rpx rgba(22, 163, 74, 0.2);
}

.confirm-template-thumb image {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 255, 255, 0.9);
  box-sizing: border-box;
}

.confirm-template-thumb view {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.86);
  color: #1677ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 900;
}

.confirm-template-item text {
  display: block;
  margin-top: 8rpx;
  color: #475467;
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 800;
}

.confirm-template-item.active text {
  color: #0b8d37;
}

.publish-check-card {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: #ffffff;
  border: 2rpx solid #e5e7eb;
}

.publish-check-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.publish-check-kicker {
  color: #667085;
  font-size: 22rpx;
  font-weight: 800;
}

.publish-check-title {
  margin-top: 6rpx;
  color: #111827;
  font-size: 30rpx;
  font-weight: 900;
}

.publish-check-state {
  flex: 0 0 auto;
  min-width: 112rpx;
  height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #eef8ff;
  color: #1677ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 900;
  white-space: nowrap;
  box-sizing: border-box;
}

.publish-check-list {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.publish-check-item {
  min-height: 72rpx;
  padding: 14rpx 16rpx;
  border-radius: 18rpx;
  background: #f8fafc;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-sizing: border-box;
}

.publish-check-item > text {
  flex: 0 0 92rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background: #edf4ff;
  color: #1677ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 900;
  white-space: nowrap;
}

.publish-check-item.done > text {
  background: #dcfce7;
  color: #15803d;
}

.publish-check-item.warn > text {
  background: #fff7ed;
  color: #c2410c;
}

.publish-check-item > view {
  min-width: 0;
}

.publish-check-item > view > view:first-child {
  color: #1f2937;
  font-size: 25rpx;
  font-weight: 900;
}

.publish-check-item > view > view:last-child {
  margin-top: 4rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.35;
}

.studio-bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 -12rpx 36rpx rgba(15, 23, 42, 0.08);
  display: flex;
  gap: 16rpx;
  box-sizing: border-box;
  z-index: 20;
}

.bottom-btn {
  flex: 1;
  height: 88rpx;
  font-size: 28rpx;
  font-weight: 900;
}

.share-mini {
  flex: 0 0 120rpx;
  height: 88rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  background: #101828;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1;
}

.share-mini::after {
  border: 0;
}

.inline-editable {
  position: relative;
  min-width: 0;
}

.inline-editable:not(.flat) {
  padding: 8rpx;
  margin: -8rpx;
  border-radius: 18rpx;
  border: 2rpx dashed rgba(22, 163, 74, 0.18);
}

.inline-editable.light {
  display: grid;
  gap: 4rpx;
  padding-right: 72rpx;
  border-color: rgba(255, 255, 255, 0.28);
  background: rgba(255, 255, 255, 0.05);
}

.inline-editable.flat {
  border-radius: 14rpx;
}

.inline-edit-tip {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  height: 34rpx;
  min-width: 56rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: rgba(22, 163, 74, 0.1);
  color: #0b8d37;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 19rpx;
  font-weight: 900;
  white-space: nowrap;
}

.inline-editable.light .inline-edit-tip {
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
}

.detail-block.inline-editable {
  padding-right: 82rpx;
}

.inline-editor-mask {
  position: fixed;
  inset: 0;
  z-index: 80;
  background: rgba(15, 23, 42, 0.34);
  display: flex;
  align-items: flex-end;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.inline-editor-panel {
  width: 100%;
  padding: 24rpx;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 -18rpx 60rpx rgba(15, 23, 42, 0.18);
  display: grid;
  gap: 18rpx;
  box-sizing: border-box;
}

.inline-editor-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.inline-editor-head view {
  color: #101828;
  font-size: 30rpx;
  line-height: 1.25;
  font-weight: 900;
}

.inline-editor-head text {
  flex: 0 0 auto;
  color: #667085;
  font-size: 24rpx;
  font-weight: 800;
}

.inline-editor-input,
.inline-editor-textarea {
  width: 100%;
  min-height: 84rpx;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: #f8fafc;
  border: 2rpx solid #e5e7eb;
  color: #101828;
  font-size: 27rpx;
  line-height: 1.45;
  box-sizing: border-box;
}

.inline-editor-textarea {
  min-height: 180rpx;
}

.inline-editor-save {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 82rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #25bb4b, #078d31);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1;
}

.inline-editor-save::after {
  display: none;
}

.image-editable {
  outline: 3rpx solid rgba(22, 163, 74, 0.2);
  outline-offset: -3rpx;
}

.contact-add-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.contact-add-row view {
  min-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #eefbf3;
  color: #0b8d37;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 21rpx;
  font-weight: 900;
  white-space: nowrap;
}

.detail-qr.placeholder {
  color: #0b8d37;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 900;
}

.studio-share-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 750rpx;
  height: 420rpx;
  pointer-events: none;
}
