<view class="page-shell opportunity-detail-page">
  <custom-nav title="客户页预览" showBack="{{true}}" fallbackUrl="/pages/business-opportunity/index" />

  <view wx:if="{{loading}}" class="detail-loading"><view class="loading-dot"></view><text>正在打开合作名片…</text></view>
  <view wx:elif="{{error}}" class="detail-error"><view>这张合作名片暂时不可见</view><text>可能已撤回或尚未发布</text><button bindtap="loadDetail">重新读取</button></view>
  <block wx:elif="{{card}}">
    <view class="detail-hero">
      <view class="hero-decoration decoration-one"></view><view class="hero-decoration decoration-two"></view>
      <view class="detail-identity">
        <image wx:if="{{card.avatarUrl}}" class="detail-avatar" src="{{card.avatarUrl}}" mode="aspectFill" />
        <view wx:else class="detail-avatar placeholder">{{card.avatarInitial}}</view>
        <view class="detail-name">{{card.displayName}}</view>
        <view wx:if="{{card.jobTitle}}" class="detail-role">{{card.jobTitle}}</view>
        <view wx:if="{{card.company}}" class="detail-company">{{card.company}}</view>
        <view class="detail-location">{{card.city || '线上合作'}} · {{card.subIndustry || card.industry || '综合服务'}}</view>
      </view>
      <view wx:if="{{card.isMine}}" class="mine-badge">我的名片</view>
    </view>

    <view class="detail-section capability-section">
      <view class="section-heading"><view class="section-title">我能提供</view><text class="section-kicker">合作资源</text></view>
      <view class="tag-row"><text wx:for="{{card.keywords}}" wx:key="*this">{{item}}</text><text wx:for="{{card.industryTags}}" wx:key="*this" class="industry-tag">{{item}}</text></view>
      <view wx:if="{{!card.keywords.length && !card.industryTags.length}}" class="section-empty">这位伙伴还没有补充能力标签</view>
    </view>

    <view wx:if="{{card.cooperationIntent && card.cooperationIntent.text && card.cooperationIntent.active}}" class="detail-section intent-section">
      <view class="section-heading"><view class="section-title">{{card.cooperationIntent.directionText || '当前合作意向'}}</view><text class="intent-live">正在发生</text></view>
      <view class="intent-text">{{card.cooperationIntent.text}}</view>
      <view wx:if="{{card.cooperationIntent.expiresAt}}" class="intent-expiry">有效期内的合作意向</view>
    </view>

    <view wx:if="{{card.bio}}" class="detail-section">
      <view class="section-heading"><view class="section-title">关于我</view><text class="section-kicker">认识伙伴</text></view>
      <view class="bio-text">{{card.bio}}</view>
    </view>

    <view class="detail-section contact-section">
      <view class="section-heading"><view class="section-title">更多联系方式</view><text class="section-kicker">先了解，再连接</text></view>
      <view wx:if="{{card.contactWarning}}" class="contact-warning">{{card.contactWarning}}</view>
      <view wx:if="{{card.contactLocked}}" class="contact-lock" bindtap="handleUnlock">
        <view class="lock-icon">锁</view>
        <view class="lock-copy"><view>联系方式已保护</view><text>确认后可拨打电话、复制微信或查看邮箱</text></view>
        <button loading="{{unlocking}}" disabled="{{unlocking}}" catchtap="handleUnlock">查看 {{card.viewCostPoints || 1}} 积分</button>
      </view>
      <view wx:elif="{{card.contacts.length}}" class="contact-list">
        <view wx:for="{{card.contacts}}" wx:key="contactType" class="contact-row">
          <view class="contact-label">{{item.label}}</view><view class="contact-value">{{item.contactType === 'wechatQr' ? '查看微信二维码' : item.contactValue}}</view>
          <view wx:if="{{item.contactType === 'phone'}}" class="contact-actions"><button class="contact-action" data-index="{{index}}" catchtap="handleCall">拨打</button><button class="contact-action" data-index="{{index}}" catchtap="handleCopyContact">复制</button></view>
          <view wx:elif="{{item.contactType === 'wechatQr'}}" class="contact-actions"><button class="contact-action" data-index="{{index}}" catchtap="handlePreviewQr">查看</button></view>
          <view wx:else class="contact-actions"><button class="contact-action" data-index="{{index}}" catchtap="handleCopyContact">复制</button></view>
        </view>
      </view>
      <view wx:else class="section-empty">这位伙伴暂未公开联系方式</view>
      <button wx:if="{{!card.isMine && !card.contactLocked && card.contacts.length}}" class="contact-report-btn" loading="{{reportingContact}}" disabled="{{reportingContact}}" catchtap="handleReportContactInvalid">联系方式失效？举报</button>
    </view>

    <view wx:if="{{card.featuredResources.length}}" class="detail-section featured-section">
      <view class="section-heading"><view class="section-title">精选资料</view><text class="section-kicker">进一步了解</text></view>
      <view wx:for="{{card.featuredResources}}" wx:key="id" class="featured-row" data-id="{{item.id}}" bindtap="handleOpenFeatured">
        <image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill" lazy-load="{{true}}" /><view wx:else class="featured-placeholder">资</view><view class="featured-copy"><view>{{item.title}}</view><text>{{item.summary || '点击查看资料'}}</text></view><text class="featured-arrow">›</text>
      </view>
    </view>

    <view wx:if="{{card.isMine}}" class="mine-edit-wrap"><button bindtap="handleEdit">编辑我的名片</button></view>
    <view wx:else class="detail-foot-tip">联系方式解锁后，24小时内再次查看同一张名片不重复扣分。</view>
  </block>
  <view class="detail-bottom-space"></view>
</view>
