<view class="page-shell business-opportunity-publish-page">
  <custom-nav title="{{editing ? '编辑合作机会' : '发布合作机会'}}" showBack="{{true}}" fallbackUrl="/pages/business-opportunity/index" />

  <view wx:if="{{loading}}" class="opportunity-publish-loading"><view class="loading-dot"></view><text>正在准备发布内容…</text></view>
  <block wx:else>
    <view class="opportunity-publish-hero">
      <view class="publish-hero-kicker">合作信息</view>
      <view class="publish-hero-title">让别人知道你能帮什么</view>
      <view class="publish-hero-sub">写清楚合作内容，联系方式和身份信息可以直接使用你的名片。</view>
    </view>

    <view class="opportunity-publish-panel">
      <view class="opportunity-field-heading"><view class="opportunity-field-label">合作方向</view><text>可随时编辑</text></view>
      <view class="opportunity-direction-row">
        <view class="opportunity-direction {{form.cardType === 'supply' ? 'active' : ''}}" data-value="supply" bindtap="handleDirectionTap">我能提供</view>
        <view class="opportunity-direction {{form.cardType === 'demand' ? 'active' : ''}}" data-value="demand" bindtap="handleDirectionTap">我正在找</view>
      </view>

      <view class="opportunity-form-field">
        <view class="opportunity-field-heading"><view class="opportunity-field-label">标题<text class="required-mark"> *</text></view><text>一句话说清楚</text></view>
        <input class="opportunity-title-input {{form.title ? 'has-value' : ''}}" value="{{form.title}}" maxlength="60" data-key="title" placeholder="例如：招渠道合作｜云服务与 AI 技术支持" bindinput="handleInput" />
      </view>

      <view class="opportunity-form-field">
        <view class="opportunity-field-heading"><view class="opportunity-field-label">具体说明<text class="required-mark"> *</text></view><text>建议 1–3 句话</text></view>
        <textarea class="opportunity-summary-input" value="{{form.summary}}" maxlength="300" data-key="summary" placeholder="例如：提供云服务器、大模型和 AI 技术支持，欢迎渠道合作。" bindinput="handleInput" />
      </view>

      <view class="opportunity-contact-section">
        <view class="opportunity-field-heading"><view class="opportunity-field-label">联系方式</view><text>默认隐藏，解锁后可见</text></view>
        <view wx:if="{{businessCardReady}}" class="opportunity-contact-mode-row">
          <view class="opportunity-contact-mode {{form.contactSource === 'business_card' ? 'active' : ''}}" data-value="business_card" bindtap="handleContactSource">使用我的名片</view>
          <view class="opportunity-contact-mode {{form.contactSource === 'manual' ? 'active' : ''}}" data-value="manual" bindtap="handleContactSource">手动填写</view>
        </view>
        <view wx:if="{{form.contactSource === 'business_card' && businessCardReady}}" class="opportunity-contact-card"><view class="contact-card-title">使用合作名片中的联系方式</view><text>{{businessCardContactLine}}</text></view>
        <block wx:else>
          <view wx:if="{{!businessCardReady}}" class="opportunity-contact-hint">还没有可用的合作名片，请填写一个电话或微信。</view>
          <view class="opportunity-contact-type-row">
            <view class="opportunity-contact-type {{form.contactType === 'phone' ? 'active' : ''}}" data-value="phone" bindtap="handleContactType">手机号</view>
            <view class="opportunity-contact-type {{form.contactType === 'wechat' ? 'active' : ''}}" data-value="wechat" bindtap="handleContactType">微信号</view>
          </view>
          <input class="opportunity-contact-input" type="{{form.contactType === 'phone' ? 'number' : 'text'}}" value="{{form.contactValue}}" data-key="contactValue" placeholder="{{form.contactType === 'phone' ? '请输入手机号' : '请输入微信号'}}" bindinput="handleInput" />
        </block>
      </view>

      <view class="opportunity-expiry-row"><view><view class="opportunity-field-label">展示有效期</view><text>到期后自动停止展示，可再次续期</text></view><picker mode="selector" range="{{validityOptions}}" value="{{validityIndex}}" bindchange="handleValidityChange"><view class="opportunity-expiry-picker">{{validityOptions[validityIndex]}}⌄</view></picker></view>
    </view>

    <view class="opportunity-publish-note">发布后进入审核，审核通过后会出现在商机合作列表。</view>
    <view class="opportunity-publish-bottom"><button class="opportunity-cancel-button" bindtap="handleCancel">暂不发布</button><button class="opportunity-submit-button" loading="{{saving}}" disabled="{{saving}}" bindtap="handlePublish">{{editing ? '保存并提交审核' : '发布合作机会'}}</button></view>
  </block>
</view>
