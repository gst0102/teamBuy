<view class="page-shell" wx:if="{{card}}">
  <custom-nav title="&#x8D44;&#x6E90;&#x7F16;&#x8F91;" showBack="{{true}}" />

  <view class="edit-share-hero">
    <image wx:if="{{card.coverUrl}}" class="edit-share-cover" src="{{card.coverDisplayUrl || card.coverUrl}}" mode="aspectFill"></image>
    <view wx:else class="edit-share-cover placeholder">资源封面</view>
    <view class="edit-share-overlay">
      <view class="status-pill">{{statusLabel}}</view>
      <input class="hero-title-input" data-field="title" value="{{card.title}}" placeholder="填写资源标题" bindinput="handleFieldChange" />
      <input class="hero-meta-input" data-field="projectName" value="{{card.projectName}}" placeholder="填写项目名或分类说明" bindinput="handleFieldChange" />
      <input class="hero-meta-input" data-field="locationText" value="{{card.locationText}}" placeholder="填写位置或地址（选填）" bindinput="handleFieldChange" />
    </view>
  </view>

  <view class="panel">
    <view class="section-title">资源详情</view>
    <textarea class="field-input textarea-large" data-field="detailText" value="{{card.detailText}}" placeholder="写清楚卖点、亮点、领取方式或活动说明" bindinput="handleFieldChange"></textarea>
  </view>

  <view class="panel" wx:if="{{card.media.length}}">
    <view class="section-head">
      <view class="section-title">详情素材</view>
      <view class="media-head-actions">
        <view class="section-link">{{card.media.length}} 项</view>
        <button class="mini-upload-btn" loading="{{uploading}}" bindtap="handleChooseUpload">添加图片/视频</button>
      </view>
    </view>
    <view class="media-edit-stack">
      <block wx:for="{{card.media}}" wx:key="url">
        <view class="media-edit-card">
          <image
            wx:if="{{item.type === 'image'}}"
            class="media-edit-image"
            src="{{item.displayUrl || item.url}}"
            mode="widthFix"
            data-url="{{item.url}}"
            data-type="{{item.type}}"
            bindtap="handleMediaTap"
          ></image>
          <view wx:else class="media-edit-video-wrap">
            <video class="media-edit-video" src="{{item.displayUrl || item.url}}" controls object-fit="cover"></video>
          </view>
          <view class="media-edit-footer">
            <view>
              <view class="media-edit-title">{{item.roleText}}</view>
              <view class="media-edit-sub">{{item.type === 'image' ? '点击图片可设为封面' : '详情视频'}}</view>
            </view>
            <view class="media-edit-actions">
              <text wx:if="{{item.isCover}}" class="cover-label">当前封面</text>
              <button wx:if="{{index > 0}}" class="media-action-btn" size="mini" data-index="{{index}}" data-direction="up" bindtap="handleMoveMedia">上移</button>
              <button wx:if="{{index < card.media.length - 1}}" class="media-action-btn" size="mini" data-index="{{index}}" data-direction="down" bindtap="handleMoveMedia">下移</button>
              <button class="media-action-btn danger" size="mini" data-index="{{index}}" bindtap="handleRemoveMedia">删除</button>
            </view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <view class="panel" wx:else>
    <view class="section-head">
      <view class="section-title">详情素材</view>
    </view>
    <button class="upload-empty-card" loading="{{uploading}}" bindtap="handleChooseUpload">
      <text class="upload-plus">+</text>
      <text>添加图片/视频</text>
      <text class="upload-help">第一张图片会作为资源封面，后续图片/视频会展示在详情内容里</text>
    </button>
  </view>

  <view class="panel">
    <view class="section-head">
      <view class="section-title">分类标签</view>
      <view class="section-link" bindtap="handleGoTagManage">管理标签 ></view>
    </view>
    <view class="tag-pick-row" wx:if="{{categories.length}}">
      <block wx:for="{{categories}}" wx:key="id">
        <view class="tag {{item.selected ? 'active' : ''}}" data-id="{{item.id}}" bindtap="handleCategoryToggle">{{item.name}}</view>
      </block>
    </view>
    <view class="empty-state compact" wx:else>暂无标签，可先去标签管理添加。</view>
  </view>

  <view class="panel">
    <view class="section-title">联系与来源</view>
    <view class="field-label">联系电话</view>
    <input class="field-input" data-field="phone" value="{{card.phone}}" type="number" placeholder="用于资源页一键拨号" bindinput="handleFieldChange" />

    <view class="field-label">来源链接</view>
    <input class="field-input" data-field="sourceUrl" value="{{card.sourceUrl}}" placeholder="可填写公众号、小程序或网页链接" bindinput="handleFieldChange" />
  </view>

  <view class="panel">
    <view class="section-title">接龙设置</view>
    <view class="field-label">接龙说明</view>
    <textarea class="field-input" data-field="relayNotice" value="{{card.relayNotice}}" placeholder="例如：感兴趣请接龙，团长会尽快联系你" bindinput="handleFieldChange"></textarea>

    <view class="switch-row">
      <view>
        <view class="switch-title">手机号必填</view>
        <view class="muted">适合需要电话跟进的资源</view>
      </view>
      <switch checked="{{card.relayConfig.requirePhone}}" bindchange="handleToggleRelayPhone" />
    </view>

    <view class="switch-row">
      <view>
        <view class="switch-title">地址必填</view>
        <view class="muted">适合团购配送或资料寄送</view>
      </view>
      <switch checked="{{card.relayConfig.requireAddress}}" bindchange="handleToggleRelayAddress" />
    </view>
  </view>

  <view class="submit-bar">
    <button class="ghost-btn action-btn" loading="{{saving}}" bindtap="handleSave">保存修改</button>
    <button class="primary-btn action-btn" loading="{{publishing}}" bindtap="handlePublish">发布并查看</button>
  </view>
</view>
