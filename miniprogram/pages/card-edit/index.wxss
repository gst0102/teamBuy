.edit-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 0 24rpx;
}

.edit-visual {
  width: 176rpx;
  height: 176rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #dcebff, #ffffff);
  color: #1677ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 900;
  box-shadow: 0 18rpx 46rpx rgba(31, 88, 168, 0.12);
}

.preview-card {
  display: flex;
  gap: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 18rpx 46rpx rgba(31, 88, 168, 0.09);
}

.preview-cover {
  width: 176rpx;
  height: 128rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #eaf3ff, #f6f9ff);
}

.preview-cover.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1677ff;
  font-weight: 900;
}

.preview-main {
  flex: 1;
  min-width: 0;
}

.preview-title {
  font-size: 32rpx;
  font-weight: 900;
  color: #172033;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.preview-tags {
  margin-top: 14rpx;
}

.tag-pick-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.media-editor-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.media-editor-item {
  display: flex;
  gap: 18rpx;
  padding: 18rpx;
  border-radius: 24rpx;
  background: #f7fbff;
  border: 1rpx solid #e7eef8;
}

.media-editor-thumb {
  width: 132rpx;
  height: 132rpx;
  border-radius: 20rpx;
  background: #edf5ff;
  flex-shrink: 0;
}

.video-thumb {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1677ff;
  font-size: 24rpx;
  font-weight: 800;
}

.media-editor-main {
  flex: 1;
  min-width: 0;
}

.media-editor-title {
  color: #172033;
  font-size: 28rpx;
  font-weight: 900;
}

.media-editor-sub {
  margin-top: 8rpx;
  color: #7b8798;
  font-size: 22rpx;
}

.media-editor-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
  color: #1677ff;
  font-size: 22rpx;
  font-weight: 700;
}

.cover-label {
  color: #12b76a;
}

.danger-action {
  color: #ff5d5d;
}

.tag.active {
  background: #1677ff;
  color: #fff;
}

.textarea-large {
  min-height: 240rpx;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #edf2f8;
}

.switch-row:last-child {
  border-bottom: none;
}

.switch-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #172033;
}

.submit-bar {
  position: sticky;
  bottom: 0;
  display: flex;
  gap: 16rpx;
  padding: 18rpx 0 10rpx;
  background: rgba(248, 251, 255, 0.94);
}

.action-btn {
  flex: 1;
}
