.edit-share-hero {
  position: relative;
  min-height: 500rpx;
  border-radius: 36rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 24rpx 54rpx rgba(31, 88, 168, 0.14);
  background: linear-gradient(135deg, #dcebff, #ffffff);
}

.edit-share-cover {
  width: 100%;
  height: 500rpx;
  display: block;
}

.edit-share-cover.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1677ff;
  font-size: 38rpx;
  font-weight: 900;
}

.edit-share-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 92rpx 30rpx 30rpx;
  background: linear-gradient(180deg, rgba(15, 23, 42, 0), rgba(15, 23, 42, 0.84));
}

.status-pill {
  display: inline-flex;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  font-size: 22rpx;
  margin-bottom: 16rpx;
}

.hero-title-input,
.hero-meta-input {
  width: 100%;
  box-sizing: border-box;
  padding: 0;
  color: #fff;
  background: transparent;
}

.hero-title-input {
  min-height: 62rpx;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.25;
}

.hero-meta-input {
  min-height: 40rpx;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.86);
}

.tag-pick-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag.active {
  background: #1677ff;
  color: #fff;
}

.textarea-large {
  min-height: 260rpx;
}

.media-edit-stack {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.media-head-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.mini-upload-btn {
  margin: 0;
  padding: 0 18rpx;
  height: 54rpx;
  line-height: 54rpx;
  border-radius: 999rpx;
  background: #1677ff;
  color: #fff;
  font-size: 22rpx;
  font-weight: 800;
}

.mini-upload-btn::after {
  border: none;
}

.upload-empty-card {
  margin-top: 18rpx;
  width: 100%;
  min-height: 220rpx;
  border-radius: 28rpx;
  border: 2rpx dashed #a8c8ff;
  background: #f7fbff;
  color: #1677ff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 28rpx;
  font-weight: 900;
}

.upload-empty-card::after {
  border: none;
}

.upload-plus {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: #e7f0ff;
  color: #1677ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  line-height: 58rpx;
}

.upload-help {
  width: 82%;
  color: #7b8798;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.5;
}

.media-edit-card {
  overflow: hidden;
  border-radius: 28rpx;
  background: #f8fbff;
  border: 1rpx solid #e6eef9;
}

.media-edit-image {
  width: 100%;
  display: block;
  background: #edf5ff;
}

.media-edit-video-wrap {
  width: 100%;
  background: #0f172a;
}

.media-edit-video {
  width: 100%;
  height: 420rpx;
  display: block;
}

.media-edit-footer {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 20rpx 20rpx;
}

.media-edit-title {
  color: #172033;
  font-size: 28rpx;
  font-weight: 900;
}

.media-edit-sub {
  margin-top: 8rpx;
  color: #7b8798;
  font-size: 22rpx;
}

.media-edit-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 12rpx;
  color: #1677ff;
  font-size: 22rpx;
  font-weight: 700;
  min-width: 210rpx;
}

.cover-label {
  color: #12b76a;
}

.danger-action {
  color: #ff5d5d;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #edf2f8;
}

.switch-row:last-child {
  border-bottom: none;
}

.switch-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #172033;
}

.submit-bar {
  position: sticky;
  bottom: 0;
  display: flex;
  gap: 16rpx;
  padding: 18rpx 0 10rpx;
  background: rgba(248, 251, 255, 0.94);
}

.action-btn {
  flex: 1;
}
