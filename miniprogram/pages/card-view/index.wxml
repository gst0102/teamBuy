<view class="page-shell" wx:if="{{card}}">
  <view class="share-hero">
    <image wx:if="{{card.coverUrl}}" class="share-cover" src="{{card.coverUrl}}" mode="aspectFill"></image>
    <view wx:else class="share-cover placeholder">悦享互动宝</view>
    <view class="share-overlay">
      <view class="share-brand">微信内容资源助手</view>
      <view class="share-title">{{card.title}}</view>
      <view class="share-meta">
        <text>{{card.projectName || '精选资源'}}</text>
        <text wx:if="{{card.locationText}}"> · {{card.locationText}}</text>
      </view>
    </view>
  </view>

  <view class="panel">
    <view class="detail-actions">
      <button class="primary-btn" bindtap="handleCall" wx:if="{{card.phone}}">电话直拨</button>
      <button class="ghost-btn" bindtap="handleCopyInfo">复制信息</button>
      <button class="ghost-btn" bindtap="handleSharePlaceholder">分享资源</button>
      <button class="ghost-btn" bindtap="handleGoManager">访问详情</button>
    </view>
    <view class="stat-grid detail-stats">
      <view class="stat-item">
        <view class="stat-icon blue">PV</view>
        <text class="stat-value">{{stats.pv || 0}}</text>
        <text class="stat-label">访问</text>
      </view>
      <view class="stat-item">
        <view class="stat-icon green">UV</view>
        <text class="stat-value">{{stats.uv || 0}}</text>
        <text class="stat-label">访客</text>
      </view>
      <view class="stat-item">
        <view class="stat-icon orange">接</view>
        <text class="stat-value">{{stats.relayCount || 0}}</text>
        <text class="stat-label">接龙</text>
      </view>
    </view>
  </view>

  <view class="panel">
    <view class="section-title">资源详情</view>
    <view class="detail-text">{{card.detailText}}</view>
    <view class="field-grid">
      <field-copy-row label="项目名" value="{{card.projectName}}" />
      <field-copy-row label="位置" value="{{card.locationText}}" />
      <field-copy-row label="来源链接" value="{{card.sourceUrl}}" />
    </view>
    <button class="ghost-btn source-btn" wx:if="{{card.sourceUrl}}" bindtap="handleCopySource">复制来源链接</button>
  </view>

  <view class="panel">
    <view class="section-head">
      <view class="section-title">实名接龙</view>
      <view class="section-link">登录后提交</view>
    </view>
    <view class="muted">{{card.relayNotice || '感兴趣可以提交接龙，发布者会尽快跟进。'}}</view>
    <input class="field-input" placeholder="手机号（按配置选填）" bindinput="handlePhoneChange" />
    <input class="field-input" placeholder="地址（按配置选填）" bindinput="handleAddressChange" />
    <button class="primary-btn" bindtap="handleRelaySubmit">提交接龙</button>
  </view>

  <view class="panel">
    <view class="section-head">
      <view class="section-title">已接龙名单</view>
      <view class="section-link">{{stats.relayEntries.length || 0}} 人</view>
    </view>
    <relay-list relays="{{stats.relayEntries || []}}" isOwner="{{false}}" />
    <view class="empty-state compact" wx:if="{{!stats.relayEntries.length}}">还没有人接龙。</view>
  </view>
</view>
