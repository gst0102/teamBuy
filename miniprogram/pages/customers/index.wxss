.customer-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 30rpx 0 24rpx;
}

.customer-visual {
  width: 176rpx;
  height: 176rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #dcebff, #ffffff);
  color: #1677ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 900;
  box-shadow: 0 18rpx 46rpx rgba(31, 88, 168, 0.12);
}

.intent-filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 4rpx 0 18rpx;
}

.intent-filter,
.intent-pill,
.customer-actions text {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 58rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #edf5ff;
  border: 1rpx solid rgba(22, 119, 255, 0.14);
  color: #1677ff;
  font-size: 24rpx;
  font-weight: 900;
}

.intent-filter.active {
  background: #1677ff;
  color: #ffffff;
  box-shadow: 0 12rpx 26rpx rgba(22, 119, 255, 0.18);
}

.customer-meta,
.customer-fields {
  color: #667085;
  font-size: 24rpx;
  line-height: 1.55;
}

.customer-fields {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.customer-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}
