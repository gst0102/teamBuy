.customer-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 30rpx 0 24rpx;
}

.customer-visual {
  width: 176rpx;
  height: 176rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #dcebff, #ffffff);
  color: #1677ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 900;
  box-shadow: 0 18rpx 46rpx rgba(31, 88, 168, 0.12);
}

.intent-filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 4rpx 0 18rpx;
}

.intent-filter-row.compact {
  margin-top: -6rpx;
}

.filter-title {
  margin: 4rpx 0 12rpx;
  color: #667085;
  font-size: 23rpx;
  font-weight: 900;
}

.sort-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: -4rpx 0 18rpx;
}

.export-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
  padding: 20rpx 22rpx;
  border-radius: 26rpx;
  background: #ffffff;
  border: 1rpx solid #e6eef9;
  box-shadow: 0 12rpx 28rpx rgba(31, 88, 168, 0.07);
}

.export-title {
  color: #172033;
  font-size: 28rpx;
  font-weight: 900;
}

.export-sub {
  margin-top: 6rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.4;
}

.export-btn {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #edf5ff;
  border: 1rpx solid rgba(22, 119, 255, 0.14);
  color: #1677ff;
  font-size: 23rpx;
  font-weight: 900;
}

.export-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 12rpx;
}

.search-panel {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 18rpx;
  padding: 12rpx;
  border-radius: 28rpx;
  background: #ffffff;
  border: 1rpx solid #e6eef9;
  box-shadow: 0 12rpx 28rpx rgba(31, 88, 168, 0.07);
}

.customer-search {
  flex: 1;
  min-height: 66rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #f6f9ff;
  color: #172033;
  font-size: 25rpx;
}

.view-toolbar,
.saved-view-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.view-action,
.saved-view-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #edf5ff;
  border: 1rpx solid rgba(22, 119, 255, 0.14);
  color: #1677ff;
  font-size: 23rpx;
  font-weight: 900;
}

.view-action.primary {
  background: #1677ff;
  color: #ffffff;
  box-shadow: 0 12rpx 26rpx rgba(22, 119, 255, 0.18);
}

.saved-view-pill {
  gap: 12rpx;
}

.saved-view-remove {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: rgba(22, 119, 255, 0.12);
  color: #1677ff;
  font-size: 24rpx;
  font-weight: 900;
}

.clear-search,
.copy-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 52rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #edf5ff;
  border: 1rpx solid rgba(22, 119, 255, 0.14);
  color: #1677ff;
  font-size: 23rpx;
  font-weight: 900;
}

.intent-filter,
.intent-pill,
.sort-pill,
.customer-actions text {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 58rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #edf5ff;
  border: 1rpx solid rgba(22, 119, 255, 0.14);
  color: #1677ff;
  font-size: 24rpx;
  font-weight: 900;
}

.intent-filter.active {
  background: #1677ff;
  color: #ffffff;
  box-shadow: 0 12rpx 26rpx rgba(22, 119, 255, 0.18);
}

.sort-pill.active {
  background: #172033;
  color: #ffffff;
  box-shadow: 0 12rpx 26rpx rgba(23, 32, 51, 0.16);
}

.customer-meta,
.customer-fields {
  color: #667085;
  font-size: 24rpx;
  line-height: 1.55;
}

.customer-fields {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.customer-tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.customer-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 46rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #edf5ff;
  border: 1rpx solid rgba(22, 119, 255, 0.14);
  color: #1677ff;
  font-size: 22rpx;
  font-weight: 900;
}

.field-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.field-line > text:first-child {
  flex: 1;
  min-width: 0;
}

.copy-pill {
  flex: 0 0 auto;
  min-height: 48rpx;
  padding: 0 18rpx;
  font-size: 22rpx;
}

.customer-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

.quick-follow-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf2f9;
}

.quick-follow-row text {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #edf5ff;
  border: 1rpx solid rgba(22, 119, 255, 0.16);
  color: #1677ff;
  font-size: 23rpx;
  font-weight: 900;
}
