.customer-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 30rpx 0 24rpx;
}

.customer-visual {
  width: 176rpx;
  height: 176rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #dcebff, #ffffff);
  color: #1677ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 900;
  box-shadow: 0 18rpx 46rpx rgba(31, 88, 168, 0.12);
}

.intent-filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 4rpx 0 18rpx;
}

.intent-filter-row.compact {
  margin-top: -6rpx;
}

.filter-title {
  margin: 4rpx 0 12rpx;
  color: #667085;
  font-size: 23rpx;
  font-weight: 900;
}

.sort-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: -4rpx 0 18rpx;
}

.export-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
  padding: 20rpx 22rpx;
  border-radius: 26rpx;
  background: #ffffff;
  border: 1rpx solid #e6eef9;
  box-shadow: 0 12rpx 28rpx rgba(31, 88, 168, 0.07);
}

.drill-panel {
  margin-bottom: 18rpx;
  padding: 22rpx;
  border-radius: 26rpx;
  background: #ffffff;
  border: 1rpx solid #e6eef9;
  box-shadow: 0 12rpx 28rpx rgba(31, 88, 168, 0.07);
}

.drill-head,
.source-group-line,
.order-customer-line,
.customer-head-left {
  display: flex;
  align-items: center;
}

.drill-head,
.source-group-line {
  justify-content: space-between;
  gap: 18rpx;
}

.drill-title {
  color: #172033;
  font-size: 28rpx;
  font-weight: 900;
}

.drill-sub,
.source-group-sub {
  margin-top: 6rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.4;
}

.drill-more {
  flex: 0 0 auto;
  color: #1677ff;
  font-size: 23rpx;
  font-weight: 900;
}

.stage-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.stage-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 108rpx;
  border-radius: 20rpx;
  background: #f6f9ff;
  border: 1rpx solid #e6eef9;
}

.stage-card.active {
  background: #1677ff;
  border-color: #1677ff;
}

.stage-value {
  color: #172033;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.15;
}

.stage-label {
  margin-top: 6rpx;
  color: #667085;
  font-size: 21rpx;
  font-weight: 900;
}

.stage-card.active .stage-value,
.stage-card.active .stage-label {
  color: #ffffff;
}

.source-group-line {
  min-height: 80rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf2f9;
}

.order-customer-line {
  min-height: 88rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf2f9;
}

.source-group-line:first-of-type {
  margin-top: 14rpx;
}

.order-customer-line:first-of-type {
  margin-top: 14rpx;
}

.source-group-main {
  flex: 1;
  min-width: 0;
}

.order-customer-main {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.source-group-title {
  color: #172033;
  font-size: 25rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.source-group-count {
  flex: 0 0 auto;
  color: #1677ff;
  font-size: 24rpx;
  font-weight: 900;
}

.export-title {
  color: #172033;
  font-size: 28rpx;
  font-weight: 900;
}

.export-sub {
  margin-top: 6rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.4;
}

.export-btn {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #edf5ff;
  border: 1rpx solid rgba(22, 119, 255, 0.14);
  color: #1677ff;
  font-size: 23rpx;
  font-weight: 900;
}

.export-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 12rpx;
}

.search-panel {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 18rpx;
  padding: 12rpx;
  border-radius: 28rpx;
  background: #ffffff;
  border: 1rpx solid #e6eef9;
  box-shadow: 0 12rpx 28rpx rgba(31, 88, 168, 0.07);
}

.customer-search {
  flex: 1;
  min-height: 66rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #f6f9ff;
  color: #172033;
  font-size: 25rpx;
}

.view-toolbar,
.saved-view-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.active-view-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
  padding: 20rpx 22rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 1rpx solid #dbeafe;
  box-shadow: 0 12rpx 28rpx rgba(31, 88, 168, 0.07);
}

.active-view-card > view:first-child {
  flex: 1;
  min-width: 0;
}

.active-view-title {
  color: #172033;
  font-size: 26rpx;
  font-weight: 900;
}

.active-view-sub {
  margin-top: 6rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.4;
}

.active-view-reset {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  min-width: 128rpx;
  height: 58rpx;
  margin: 0;
  padding: 0 20rpx;
  line-height: normal;
  border-radius: 999rpx;
  background: #edf5ff;
  color: #1677ff;
  font-size: 23rpx;
  font-weight: 900;
}

.active-view-reset::after {
  border: 0;
}

.active-view-reset.green {
  background: #eaf7ef;
  color: #11924d;
}

.active-view-actions {
  display: flex;
  flex-shrink: 0;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 10rpx;
}

.view-action,
.saved-view-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #edf5ff;
  border: 1rpx solid rgba(22, 119, 255, 0.14);
  color: #1677ff;
  font-size: 23rpx;
  font-weight: 900;
}

.view-action.primary {
  background: #1677ff;
  color: #ffffff;
  box-shadow: 0 12rpx 26rpx rgba(22, 119, 255, 0.18);
}

.saved-view-pill {
  gap: 12rpx;
}

.saved-view-remove {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: rgba(22, 119, 255, 0.12);
  color: #1677ff;
  font-size: 24rpx;
  font-weight: 900;
}

.clear-search,
.copy-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 52rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #edf5ff;
  border: 1rpx solid rgba(22, 119, 255, 0.14);
  color: #1677ff;
  font-size: 23rpx;
  font-weight: 900;
}

.intent-filter,
.intent-pill,
.sort-pill,
.customer-actions text {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 58rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #edf5ff;
  border: 1rpx solid rgba(22, 119, 255, 0.14);
  color: #1677ff;
  font-size: 24rpx;
  font-weight: 900;
}

.intent-filter.active {
  background: #1677ff;
  color: #ffffff;
  box-shadow: 0 12rpx 26rpx rgba(22, 119, 255, 0.18);
}

.sort-pill.active {
  background: #172033;
  color: #ffffff;
  box-shadow: 0 12rpx 26rpx rgba(23, 32, 51, 0.16);
}

.customer-card {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.customer-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.customer-head-left {
  flex: 1;
  min-width: 0;
}

.customer-head-main {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.customer-avatar {
  flex: 0 0 auto;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #edf5ff;
}

.customer-avatar.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #1677ff, #20c997);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
}

.customer-meta {
  color: #667085;
  font-size: 24rpx;
  line-height: 1.55;
}

.customer-info-block,
.follow-status-block {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 18rpx;
  border-radius: 24rpx;
  background: #f8fbff;
  border: 1rpx solid #e6eef9;
}

.customer-tag-panel {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 16rpx 18rpx;
  border-radius: 22rpx;
  background: #f8fbff;
  border: 1rpx dashed rgba(22, 119, 255, 0.22);
}

.tag-panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.tag-panel-title {
  color: #667085;
  font-size: 22rpx;
  font-weight: 900;
}

.tag-panel-action,
.tag-empty-action {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #edf5ff;
  border: 1rpx solid rgba(22, 119, 255, 0.14);
  color: #1677ff;
  font-size: 21rpx;
  font-weight: 900;
}

.customer-tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.customer-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 46rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #edf5ff;
  border: 1rpx solid rgba(22, 119, 255, 0.14);
  color: #1677ff;
  font-size: 22rpx;
  font-weight: 900;
}

.tag-empty-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  color: #8a96a8;
  font-size: 23rpx;
  font-weight: 800;
}

.info-row {
  display: flex;
  align-items: center;
  min-height: 52rpx;
  gap: 14rpx;
}

.info-label {
  flex: 0 0 auto;
  width: 72rpx;
  color: #8a96a8;
  font-size: 22rpx;
  font-weight: 900;
}

.info-value {
  flex: 1;
  min-width: 0;
  color: #344054;
  font-size: 25rpx;
  line-height: 1.4;
  word-break: break-all;
}

.follow-status-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.follow-status-item {
  flex: 1 1 160rpx;
  min-width: 0;
  padding: 14rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid #edf2f9;
}

.status-label {
  display: block;
  color: #8a96a8;
  font-size: 20rpx;
  font-weight: 900;
}

.status-value {
  display: block;
  margin-top: 6rpx;
  color: #172033;
  font-size: 23rpx;
  font-weight: 900;
}

.latest-follow-text {
  color: #344054;
  font-size: 24rpx;
  line-height: 1.45;
}

.latest-follow-text.order {
  color: #1677ff;
  font-weight: 900;
}

.source-strip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 56rpx;
  padding: 0 18rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid #e6eef9;
}

.source-strip-label {
  flex: 0 0 auto;
  color: #8a96a8;
  font-size: 22rpx;
  font-weight: 900;
}

.source-strip-title {
  flex: 1;
  min-width: 0;
  color: #1677ff;
  font-size: 24rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.copy-pill {
  flex: 0 0 auto;
  min-height: 48rpx;
  padding: 0 18rpx;
  font-size: 22rpx;
}

.copy-pill.call {
  background: #ecfdf3;
  border-color: rgba(17, 146, 77, 0.16);
  color: #11924d;
}

.customer-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.customer-actions.secondary {
  margin-top: -4rpx;
}

.quick-follow-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf2f9;
}

.quick-follow-row text {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #edf5ff;
  border: 1rpx solid rgba(22, 119, 255, 0.16);
  color: #1677ff;
  font-size: 23rpx;
  font-weight: 900;
}

.quick-follow-row text.primary-action {
  background: #1677ff;
  color: #ffffff;
  box-shadow: 0 12rpx 26rpx rgba(22, 119, 255, 0.18);
}

.customer-detail-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  align-items: flex-end;
  padding: 0 24rpx 32rpx;
  background: rgba(15, 23, 42, 0.38);
  box-sizing: border-box;
}

.customer-detail-sheet {
  width: 100%;
  max-height: 82vh;
  overflow-y: auto;
  padding: 30rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 -18rpx 50rpx rgba(20, 31, 52, 0.18);
  box-sizing: border-box;
}

.detail-head {
  display: flex;
  align-items: center;
  min-width: 0;
}

.detail-avatar {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #e8eef7;
}

.detail-avatar.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: linear-gradient(135deg, #1677ff, #44d58a);
  font-size: 34rpx;
  font-weight: 900;
}

.detail-main {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.detail-name {
  overflow: hidden;
  color: #172033;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 31rpx;
  font-weight: 900;
}

.detail-sub {
  margin-top: 8rpx;
  overflow: hidden;
  color: #667085;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 23rpx;
  font-weight: 800;
}

.detail-close {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 58rpx;
  height: 58rpx;
  margin: 0 0 0 14rpx;
  padding: 0;
  line-height: 58rpx;
  border: 0;
  border-radius: 50%;
  color: #667085;
  background: #f2f5f9;
  font-size: 40rpx;
  font-weight: 500;
}

.detail-section {
  margin-top: 26rpx;
}

.detail-section-title {
  color: #172033;
  font-size: 25rpx;
  font-weight: 900;
}

.detail-contact-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  min-width: 0;
  margin-top: 14rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: #f6f9fd;
  box-sizing: border-box;
}

.detail-contact-row text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #263247;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 24rpx;
  font-weight: 800;
}

.detail-contact-row .copy-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 96rpx;
  height: 50rpx;
  margin: 0;
  padding: 0 18rpx;
  line-height: 50rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.detail-empty {
  margin-top: 12rpx;
  color: #8a96a8;
  font-size: 23rpx;
}

.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.detail-tag {
  max-width: 100%;
  overflow: hidden;
  padding: 10rpx 14rpx;
  border-radius: 999rpx;
  background: #f0f5ff;
  color: #2f5fb8;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 22rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.detail-tag.blue {
  background: #edf5ff;
  color: #1677ff;
}

.detail-tag.green {
  background: #ecfdf3;
  color: #11924d;
}

.detail-tag.orange {
  background: #fff7ed;
  color: #c2410c;
}

.detail-tag.gray {
  background: #f2f5f9;
  color: #667085;
}

.detail-note {
  margin-top: 14rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: #f8fbff;
  color: #344054;
  font-size: 23rpx;
  line-height: 1.45;
}

.detail-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 14rpx;
  margin-top: 28rpx;
}

.detail-primary,
.detail-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 74rpx;
  margin: 0;
  padding: 0 16rpx;
  line-height: 74rpx;
  border-radius: 16rpx;
  font-size: 25rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.detail-primary {
  grid-column: 1 / span 2;
  color: #ffffff;
  background: #1677ff;
}

.detail-secondary {
  border: 1rpx solid #d6e1f0;
  color: #334155;
  background: #ffffff;
}
