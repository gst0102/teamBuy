.group-resource-page {
  max-width: 100vw;
  overflow-x: hidden;
  padding-bottom: calc(44rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.hub-hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 34rpx 0 24rpx;
}

.hero-kicker {
  color: #1677ff;
  font-size: 23rpx;
  font-weight: 900;
}

.hero-title {
  margin-top: 10rpx;
  color: #111827;
  font-size: 54rpx;
  line-height: 1.08;
  font-weight: 900;
}

.hero-sub {
  max-width: 470rpx;
  margin-top: 14rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.48;
}

.points-wrap {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

.points-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 118rpx;
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #1677ff;
  background: #ffffff;
  border: 1rpx solid #dbeafe;
  font-size: 22rpx;
  font-weight: 900;
  box-shadow: 0 12rpx 28rpx rgba(31, 88, 168, 0.08);
  box-sizing: border-box;
  white-space: nowrap;
}

.frozen-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 34rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: #fff7ed;
  color: #c2410c;
  font-size: 18rpx;
  font-weight: 900;
  white-space: nowrap;
}

.points-rule-link {
  color: #1677ff;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
}

.search-panel,
.action-panel,
.group-card,
.empty-state {
  width: 100%;
  border: 1rpx solid #dbe6f7;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 16rpx 40rpx rgba(31, 88, 168, 0.08);
  box-sizing: border-box;
}

.search-panel {
  padding: 18rpx;
  overflow: hidden;
}

.search-box {
  display: flex;
  align-items: center;
  gap: 10rpx;
  width: 100%;
  padding: 8rpx;
  border-radius: 999rpx;
  background: #f4f8ff;
  box-sizing: border-box;
  overflow: hidden;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 56rpx;
  padding: 0 14rpx;
  color: #172033;
  font-size: 23rpx;
  box-sizing: border-box;
}

.search-btn {
  flex: 0 0 104rpx;
  width: 104rpx;
  height: 56rpx;
  padding: 0;
  border-radius: 999rpx;
  background: #1677ff;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
  box-shadow: none;
}

.hot-row,
.purpose-row,
.group-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.hot-row {
  margin-top: 16rpx;
}

.hot-chip,
.purpose-row text,
.group-meta text,
.group-status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 38rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  white-space: nowrap;
  font-weight: 900;
}

.hot-chip,
.group-meta text {
  background: #eef5ff;
  color: #1677ff;
  font-size: 20rpx;
}

.stat-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.stat-card {
  min-width: 0;
  padding: 18rpx 10rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #ffffff, #f7fbff);
  border: 1rpx solid #dfe8f5;
  text-align: center;
  box-sizing: border-box;
}

.stat-value {
  color: #111827;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1;
}

.stat-label {
  margin-top: 8rpx;
  color: #6b7688;
  font-size: 20rpx;
  font-weight: 800;
}

.action-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 20rpx;
  padding: 22rpx;
}

.action-title,
.section-title,
.group-title,
.empty-title,
.modal-title {
  color: #172033;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.25;
}

.action-sub,
.section-sub,
.empty-sub,
.modal-desc {
  margin-top: 8rpx;
  color: #7d8898;
  font-size: 22rpx;
  line-height: 1.4;
}

.publish-btn {
  flex: 0 0 96rpx;
  height: 56rpx;
  padding: 0;
  font-size: 22rpx;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin: 26rpx 4rpx 14rpx;
}

.section-link {
  flex: 0 0 auto;
  color: #1677ff;
  font-size: 22rpx;
  font-weight: 900;
}

.group-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.group-card {
  padding: 22rpx;
}

.group-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.group-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.group-status {
  min-height: 40rpx;
  background: #fff7ed;
  color: #c2410c;
  font-size: 19rpx;
}

.group-status.done {
  background: #e8f8ef;
  color: #137a3e;
}

.group-meta,
.purpose-row {
  margin-top: 12rpx;
}

.purpose-row text {
  background: #e8f8ef;
  color: #137a3e;
  font-size: 20rpx;
}

.group-foot {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 14rpx;
  margin-top: 16rpx;
}

.group-signal {
  width: 100%;
  color: #7d8898;
  font-size: 21rpx;
  line-height: 1.35;
  word-break: keep-all;
}

.group-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
  width: 100%;
}

.small-btn {
  flex: 0 0 210rpx;
  height: 56rpx;
  font-size: 22rpx;
}

.delete-btn {
  flex: 0 0 88rpx;
  height: 56rpx;
  padding: 0;
  border-radius: 999rpx;
  background: #f4f7fb;
  color: #98a2b3;
  font-size: 20rpx;
  font-weight: 900;
  box-shadow: none;
}

.empty-state {
  padding: 44rpx 26rpx;
  text-align: center;
}

button.empty-btn,
.empty-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 220rpx;
  height: 64rpx;
  margin: 24rpx auto 0;
  padding: 0;
  font-size: 24rpx;
  line-height: 1;
  box-shadow: 0 14rpx 28rpx rgba(22, 119, 255, 0.18);
}

.flow-page {
  min-height: calc(100vh - 160rpx);
  padding: 18rpx 0 30rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.flow-back {
  width: 52rpx;
  height: 52rpx;
  margin: 0 0 2rpx;
  color: #111827;
  font-size: 50rpx;
  line-height: 46rpx;
  font-weight: 300;
}

.flow-step-title {
  margin: -50rpx 70rpx 22rpx;
  color: #111827;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.35;
  text-align: center;
}

.flow-stat {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  margin-bottom: 30rpx;
  border-radius: 10rpx;
  border: 1rpx solid #f3d9b0;
  background: #fffaf2;
  color: #344054;
  font-size: 22rpx;
  font-weight: 800;
}

.flow-stat text {
  color: #079455;
  font-size: 27rpx;
  font-weight: 900;
  padding: 0 4rpx;
}

.upload-card {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 300rpx;
  border-radius: 20rpx;
  border: 2rpx dashed #b7c0cc;
  background: #ffffff;
  overflow: hidden;
  box-sizing: border-box;
}

.upload-preview {
  width: 100%;
  height: 100%;
}

.upload-placeholder {
  text-align: center;
  color: #667085;
}

.upload-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  margin: 0 auto 26rpx;
  border-radius: 50%;
  border: 3rpx solid #16a34a;
  color: #16a34a;
  font-size: 46rpx;
  font-weight: 900;
}

.upload-title {
  color: #111827;
  font-size: 30rpx;
  font-weight: 900;
}

.upload-sub,
.flow-subtitle,
.flow-lock {
  margin-top: 12rpx;
  color: #667085;
  font-size: 22rpx;
  text-align: center;
}

.recognize-card,
.expire-card,
.optional-card,
.success-card,
.next-card {
  margin-top: 28rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  border: 1rpx solid #e4e7ec;
  background: #ffffff;
  box-sizing: border-box;
}

.recognize-title {
  margin-bottom: 12rpx;
  color: #111827;
  font-size: 25rpx;
  font-weight: 900;
}

.recognize-row,
.why-row,
.next-row {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #edf2f7;
}

.recognize-row:first-of-type,
.why-row:first-of-type,
.next-row:first-of-type {
  border-top: 0;
}

.recognize-icon,
.why-icon,
.next-icon {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: #16a34a;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 900;
}

.recognize-row view view,
.why-row view view,
.next-row view view {
  color: #111827;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.3;
}

.recognize-row text,
.why-row text,
.next-row text {
  display: block;
  margin-top: 6rpx;
  color: #667085;
  font-size: 20rpx;
  line-height: 1.45;
}

.flow-primary,
.flow-secondary {
  width: 100%;
  height: 80rpx;
  margin-top: 40rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 900;
}

.flow-primary {
  background: linear-gradient(180deg, #16a34a, #079455);
  color: #ffffff;
  box-shadow: 0 16rpx 32rpx rgba(7, 148, 85, 0.22);
}

.flow-secondary {
  background: #ffffff;
  color: #079455;
  border: 2rpx solid #16a34a;
  box-shadow: none;
}

.choice-section {
  margin-top: 30rpx;
}

.choice-title {
  color: #111827;
  font-size: 25rpx;
  font-weight: 900;
}

.choice-title text {
  margin-left: 8rpx;
  color: #667085;
  font-size: 18rpx;
  font-weight: 700;
}

.choice-hint {
  margin-top: 8rpx;
  color: #667085;
  font-size: 20rpx;
  line-height: 1.4;
}

.choice-row {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 16rpx;
}

.city-picker-row {
  display: grid;
  grid-template-columns: 128rpx minmax(0, 1fr);
  gap: 16rpx;
  margin-top: 16rpx;
  align-items: stretch;
}

.city-picker-row picker {
  min-width: 0;
}

.choice-chip,
.expire-chip,
.tag-pill,
.tag-add {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 112rpx;
  min-height: 60rpx;
  padding: 0 24rpx;
  border-radius: 12rpx;
  border: 1rpx solid #e4e7ec;
  background: #ffffff;
  color: #111827;
  font-size: 23rpx;
  font-weight: 800;
  box-sizing: border-box;
  white-space: nowrap;
}

.choice-chip.active,
.expire-chip.active {
  border-color: #16a34a;
  background: #ecfdf3;
  color: #079455;
}

.national-chip {
  min-width: 0;
  min-height: 72rpx;
}

.region-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-width: 0;
  min-height: 72rpx;
  padding: 0 24rpx;
  border-radius: 14rpx;
  border: 1rpx solid #e4e7ec;
  background: #ffffff;
  box-sizing: border-box;
}

.region-picker.active {
  border-color: #16a34a;
  background: #ecfdf3;
}

.region-main {
  min-width: 0;
  color: #111827;
  font-size: 24rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.region-picker.active .region-main {
  color: #079455;
}

.region-sub {
  flex: 0 0 auto;
  margin-left: 16rpx;
  color: #98a2b3;
  font-size: 19rpx;
  font-weight: 800;
}

.tag-edit-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.tag-pill {
  background: #f8fafc;
}

.tag-add {
  color: #111827;
}

.expire-row {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 18rpx;
}

.expire-chip {
  min-width: 0;
  min-height: 76rpx;
}

.expire-chip.active {
  background: #079455;
  color: #ffffff;
}

.recommend-badge {
  position: absolute;
  right: -8rpx;
  top: -18rpx;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: #fb923c;
  color: #ffffff;
  font-size: 17rpx;
  font-weight: 900;
}

.why-card {
  margin-top: 28rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  background: #fff8ed;
  border: 1rpx solid #fed7aa;
}

.why-title {
  color: #111827;
  font-size: 25rpx;
  font-weight: 900;
  margin-bottom: 8rpx;
}

.optional-title {
  margin-bottom: 8rpx;
  color: #111827;
  font-size: 23rpx;
  font-weight: 900;
}

.optional-row {
  display: grid;
  grid-template-columns: 130rpx minmax(0, 1fr);
  align-items: center;
  gap: 18rpx;
  min-height: 74rpx;
  border-top: 1rpx solid #edf2f7;
  color: #111827;
  font-size: 23rpx;
  font-weight: 800;
}

.optional-row:first-of-type {
  border-top: 0;
}

.optional-row input {
  min-width: 0;
  color: #111827;
  font-size: 22rpx;
  font-weight: 500;
}

.success-hero {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 26rpx;
  padding: 50rpx 0 28rpx;
}

.success-check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 86rpx;
  height: 86rpx;
  border-radius: 50%;
  background: #16a34a;
  color: #ffffff;
  font-size: 54rpx;
  font-weight: 900;
}

.success-title {
  color: #111827;
  font-size: 38rpx;
  font-weight: 900;
}

.success-points {
  margin-top: 6rpx;
  color: #344054;
  font-size: 26rpx;
  font-weight: 800;
}

.success-points text,
.success-expire {
  color: #f97316;
  font-weight: 900;
}

.success-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.success-avatar {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #16a34a;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
}

.success-group-title {
  color: #111827;
  font-size: 27rpx;
  font-weight: 900;
}

.success-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}

.success-tags text {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 34rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
  background: #f8fafc;
  color: #344054;
  font-size: 19rpx;
}

.success-expire {
  margin-top: 12rpx;
  font-size: 21rpx;
}

.next-title {
  margin-bottom: 8rpx;
  color: #111827;
  font-size: 24rpx;
  font-weight: 900;
}

.qr-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 90;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(15, 23, 42, 0.46);
  box-sizing: border-box;
}

.qr-modal,
.rule-modal {
  width: 100%;
  max-width: 560rpx;
  padding: 30rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.qr-modal {
  text-align: center;
}

.rule-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 22rpx;
}

.rule-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 58rpx;
  padding: 0 18rpx;
  border-radius: 16rpx;
  background: #f4f8ff;
  color: #64748b;
  font-size: 23rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.rule-row strong {
  color: #1677ff;
  font-size: 24rpx;
  font-weight: 900;
  white-space: nowrap;
}

.rule-row.warn strong {
  color: #f97316;
}

.rule-row.danger strong {
  color: #e5484d;
}

.modal-qr {
  width: 360rpx;
  height: 360rpx;
  margin: 24rpx auto 0;
  border-radius: 18rpx;
  background: #eef5ff;
}

.modal-qr.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1677ff;
  font-size: 34rpx;
  font-weight: 900;
}

.modal-btn {
  width: 240rpx;
  height: 68rpx;
  margin: 24rpx auto 0;
  font-size: 24rpx;
  font-weight: 900;
}
