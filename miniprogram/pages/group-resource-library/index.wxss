.live-qr-summary-expiry {
  margin-top: 10rpx;
  color: #5f7567;
  font-size: 18rpx;
  line-height: 1.25;
  white-space: nowrap;
}

.live-qr-summary-status.expiring + .live-qr-summary-expiry {
  color: #b7791f;
}

.live-qr-summary-status.expired + .live-qr-summary-expiry {
  color: #98a2b3;
}

.live-qr-summary-arrow {
  margin-top: 8rpx;
  color: #91a098;
  font-size: 32rpx;
  font-weight: 300;
  line-height: 0.8;
}

.live-qr-list-empty {
  margin-top: 18rpx;
}

.live-qr-detail-toolbar {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 56rpx;
  margin-top: 18rpx;
  color: #1677ff;
}

.live-qr-detail-toolbar:active {
  opacity: 0.7;
}

.live-qr-detail-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  font-size: 42rpx;
  font-weight: 300;
  line-height: 1;
}

.live-qr-detail-back-text {
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
}

.live-qr-detail-card {
  margin-top: 4rpx;
  padding: 24rpx;
  border: 1rpx solid #d9eadf;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 16rpx 40rpx rgba(32, 114, 61, 0.08);
  box-sizing: border-box;
}

.live-qr-detail-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.live-qr-note-row {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #edf3ee;
  color: #5d7464;
  font-size: 20rpx;
  line-height: 1.35;
}

@media (prefers-reduced-motion: reduce) {
  .live-qr-summary-card {
    transition: none;
  }
}

