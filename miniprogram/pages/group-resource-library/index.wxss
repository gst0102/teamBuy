.group-resource-page {
  max-width: 100vw;
  overflow-x: hidden;
  padding-bottom: calc(44rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.group-resource-page .inline-load-error {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  margin: 14rpx 0;
  padding: 12rpx 20rpx;
  border-radius: 14rpx;
  color: #b42318;
  background: #fff1f0;
  font-size: 24rpx;
  text-align: center;
  box-sizing: border-box;
}

.group-resource-page .inline-loading {
  padding: 12rpx 20rpx;
  color: #64748b;
  font-size: 24rpx;
  text-align: center;
}

.hub-hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 34rpx 0 24rpx;
}

.hero-kicker {
  color: #1677ff;
  font-size: 23rpx;
  font-weight: 900;
}

.hero-title {
  margin-top: 10rpx;
  color: #111827;
  font-size: 54rpx;
  line-height: 1.08;
  font-weight: 900;
}

.hero-sub {
  max-width: 470rpx;
  margin-top: 14rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.48;
}

.live-qr-kicker {
  color: #16a34a;
}

.resource-tabs {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 6rpx;
  width: 100%;
  margin-bottom: 18rpx;
  padding: 6rpx;
  border: 1rpx solid #dbe6f7;
  border-radius: 20rpx;
  background: #eef5ff;
  box-shadow: 0 12rpx 30rpx rgba(31, 88, 168, 0.06);
  box-sizing: border-box;
}

.resource-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 68rpx;
  border-radius: 16rpx;
  color: #6b7688;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1;
  white-space: nowrap;
}

.resource-tab.active {
  color: #1677ff;
  background: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(31, 88, 168, 0.1);
}

.resource-tab:last-child.active {
  color: #14863a;
}

.live-qr-intro-card,
.live-qr-empty-card {
  width: 100%;
  border: 1rpx solid #d9eadf;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 16rpx 40rpx rgba(32, 114, 61, 0.08);
  box-sizing: border-box;
}

.live-qr-intro-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx;
}

.live-qr-mark,
.live-qr-empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  color: #ffffff;
  background: #20a948;
  font-weight: 900;
}

.live-qr-mark {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  font-size: 32rpx;
}

.live-qr-intro-copy {
  flex: 1;
  min-width: 0;
}

.live-qr-intro-title,
.live-qr-empty-title {
  color: #172033;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.25;
}

.live-qr-intro-sub,
.live-qr-empty-sub {
  margin-top: 8rpx;
  color: #738279;
  font-size: 22rpx;
  line-height: 1.45;
}

.live-qr-empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-top: 18rpx;
  padding: 56rpx 30rpx;
  text-align: center;
}

.live-qr-empty-icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  font-size: 58rpx;
  line-height: 1;
}

.live-qr-empty-title {
  margin-top: 24rpx;
}

.live-qr-empty-sub {
  max-width: 500rpx;
}

button.live-qr-create-btn,
.live-qr-create-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 220rpx;
  height: 64rpx;
  margin: 28rpx auto 0;
  padding: 0;
  border-radius: 999rpx;
  background: #20a948;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
  box-shadow: 0 14rpx 28rpx rgba(32, 169, 72, 0.2);
}

.live-qr-rule {
  margin: 20rpx 4rpx 0;
  color: #84908a;
  font-size: 20rpx;
  line-height: 1.4;
  text-align: center;
}

.points-wrap {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

.points-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 118rpx;
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #1677ff;
  background: #ffffff;
  border: 1rpx solid #dbeafe;
  font-size: 22rpx;
  font-weight: 900;
  box-shadow: 0 12rpx 28rpx rgba(31, 88, 168, 0.08);
  box-sizing: border-box;
  white-space: nowrap;
}

.frozen-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 34rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: #fff7ed;
  color: #c2410c;
  font-size: 18rpx;
  font-weight: 900;
  white-space: nowrap;
}

.points-rule-link {
  color: #1677ff;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
}

.group-points-card {
  width: 100%;
  margin-bottom: 18rpx;
  padding: 24rpx;
  border: 1rpx solid #b8d2f2;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #dcecff 0%, #f2f7ff 100%);
  box-shadow: 0 16rpx 40rpx rgba(35, 86, 150, 0.14);
  box-sizing: border-box;
}

.group-points-main {
  display: flex;
  align-items: flex-start;
  min-width: 0;
}

.group-points-info {
  min-width: 0;
}

.group-points-label {
  color: #355d8e;
  font-size: 23rpx;
  font-weight: 800;
}

.group-points-line {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 6rpx;
}

.group-points-value {
  color: #172033;
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1;
}

.group-points-unit {
  color: #486b98;
  font-size: 22rpx;
}

.group-points-breakdown {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #b9d3f2;
}

.group-points-breakdown.single {
  grid-template-columns: minmax(0, 1fr);
}

.group-point-item {
  min-width: 0;
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  border: 1rpx solid #e0ebf8;
  background: #ffffff;
  box-sizing: border-box;
}

.group-point-name {
  display: flex;
  align-items: center;
  color: #304d75;
  font-size: 21rpx;
  font-weight: 800;
  white-space: nowrap;
}

.group-point-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #6ca9d5;
}

.group-point-reward .group-point-dot {
  background: #49aa91;
}

.group-point-value {
  margin-top: 8rpx;
  color: #172033;
  font-size: 26rpx;
  font-weight: 900;
}

.group-point-help {
  margin-top: 4rpx;
  overflow: hidden;
  color: #5b7395;
  font-size: 17rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.group-points-rule {
  margin-top: 16rpx;
  color: #405c7e;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.4;
  text-align: center;
}

.search-panel,
.action-panel,
.group-card,
.empty-state {
  width: 100%;
  border: 1rpx solid #dbe6f7;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 16rpx 40rpx rgba(31, 88, 168, 0.08);
  box-sizing: border-box;
}

.search-panel {
  padding: 18rpx;
  overflow: hidden;
}

.search-box {
  display: flex;
  align-items: center;
  gap: 10rpx;
  width: 100%;
  padding: 8rpx;
  border-radius: 999rpx;
  background: #f4f8ff;
  box-sizing: border-box;
  overflow: hidden;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 56rpx;
  padding: 0 14rpx;
  color: #172033;
  font-size: 23rpx;
  box-sizing: border-box;
}

.search-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 104rpx;
  width: 104rpx;
  height: 56rpx;
  padding: 0;
  border-radius: 999rpx;
  background: #1677ff;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
  box-shadow: none;
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.filter-row picker {
  max-width: 100%;
}

.filter-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 54rpx;
  max-width: 260rpx;
  padding: 0 18rpx;
  border: 1rpx solid #dbe6f7;
  border-radius: 999rpx;
  background: #f7fbff;
  color: #5f6f85;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  box-sizing: border-box;
}

.filter-chip.active,
.picker-chip:active {
  border-color: #1677ff;
  background: #eef5ff;
  color: #1677ff;
}

.live-qr-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 18rpx;
}

.live-qr-card {
  padding: 24rpx;
  border: 1rpx solid #d9eadf;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 16rpx 40rpx rgba(32, 114, 61, 0.08);
  box-sizing: border-box;
}

.live-qr-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.live-qr-card-title {
  color: #172033;
  font-size: 28rpx;
  font-weight: 900;
}

.live-qr-card-sub,
.live-qr-url {
  margin-top: 8rpx;
  color: #738279;
  font-size: 21rpx;
  line-height: 1.4;
}

.live-qr-status {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 92rpx;
  min-height: 40rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: #e8f8ef;
  color: #137a3e;
  font-size: 19rpx;
  font-weight: 900;
  white-space: nowrap;
  box-sizing: border-box;
}

.live-qr-status.expired {
  background: #f2f4f7;
  color: #98a2b3;
}

.live-qr-preview {
  display: block;
  width: 360rpx;
  height: 360rpx;
  margin: 20rpx auto 0;
  border-radius: 18rpx;
  background: #f6faf7;
}

.live-qr-url {
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  background: #f6faf7;
  color: #4e6857;
  word-break: break-all;
}

.live-qr-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 18rpx;
}

.live-qr-action-btn {
  flex: 1;
  min-width: 0;
  height: 56rpx;
  padding: 0 10rpx;
  font-size: 20rpx;
}

.live-qr-delete-btn {
  flex: 0 0 80rpx;
  min-width: 0;
  height: 56rpx;
  padding: 0;
  font-size: 20rpx;
}

.hot-row,
.purpose-row,
.group-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.hot-row {
  margin-top: 16rpx;
}

.hot-chip,
.purpose-row text,
.group-meta text,
.group-status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 38rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  white-space: nowrap;
  font-weight: 900;
}

.hot-chip,
.group-meta text {
  background: #eef5ff;
  color: #1677ff;
  font-size: 20rpx;
}

.stat-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.stat-card {
  min-width: 0;
  padding: 18rpx 10rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #ffffff, #f7fbff);
  border: 1rpx solid #dfe8f5;
  text-align: center;
  box-sizing: border-box;
}

.stat-value {
  color: #111827;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1;
}

.stat-label {
  margin-top: 8rpx;
  color: #6b7688;
  font-size: 20rpx;
  font-weight: 800;
}

.action-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 20rpx;
  padding: 22rpx;
}

.action-title,
.section-title,
.group-title,
.empty-title,
.modal-title {
  color: #172033;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.25;
}

.action-sub,
.section-sub,
.empty-sub,
.modal-desc {
  margin-top: 8rpx;
  color: #7d8898;
  font-size: 22rpx;
  line-height: 1.4;
}

.publish-btn {
  flex: 0 0 96rpx;
  height: 56rpx;
  padding: 0;
  font-size: 22rpx;
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  flex-wrap: wrap;
  margin: 26rpx 4rpx 14rpx;
}

.section-heading {
  flex: 1;
  min-width: 260rpx;
}

.section-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex: 0 0 auto;
  gap: 10rpx;
  max-width: 100%;
}

.publish-mine-btn,
.section-actions .admin-add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 164rpx;
  height: 58rpx;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1;
  white-space: nowrap;
  box-sizing: border-box;
}

.publish-mine-btn {
  border: 1rpx solid #1677ff;
  background: #1677ff;
  color: #ffffff;
}

.section-actions .admin-add-btn {
  min-width: 170rpx;
}

.publish-quota-card {
  margin: 18rpx 0 12rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #dbe7f5;
  border-radius: 20rpx;
  background: #f7fbff;
  box-sizing: border-box;
}

.publish-quota-main {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.publish-quota-loading {
  min-height: 52rpx;
  display: flex;
  align-items: center;
  color: #5f7390;
  font-size: 24rpx;
  line-height: 1.4;
}

.publish-quota-value {
  color: #1677ff;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1;
}

.publish-quota-title {
  color: #172033;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.2;
}

.publish-quota-unit {
  margin-top: 4rpx;
  color: #5f7390;
  font-size: 22rpx;
}

.publish-quota-note {
  margin-top: 12rpx;
  color: #65758b;
  font-size: 22rpx;
  line-height: 1.45;
}

.admin-quota-card {
  background: #f0faf4;
  border-color: #ccebd6;
}

.admin-quota-card .publish-quota-title {
  color: #137a3e;
}

.section-link {
  flex: 0 0 auto;
  color: #1677ff;
  font-size: 22rpx;
  font-weight: 900;
}

.admin-add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  min-width: 176rpx;
  height: 58rpx;
  margin: 0;
  padding: 0 20rpx;
  border: 1rpx solid #b9d7ff;
  border-radius: 999rpx;
  background: #edf5ff;
  color: #1677ff;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1;
  white-space: nowrap;
  box-sizing: border-box;
}

.group-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.group-card {
  padding: 22rpx;
}

.group-card.expired {
  opacity: 0.72;
}

.group-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.group-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.group-status {
  min-height: 40rpx;
  background: #fff7ed;
  color: #c2410c;
  font-size: 19rpx;
}

.group-status.done {
  background: #e8f8ef;
  color: #137a3e;
}

.group-status.expired {
  background: #f2f4f7;
  color: #98a2b3;
}

.group-meta,
.purpose-row {
  margin-top: 12rpx;
}

.purpose-row text {
  background: #e8f8ef;
  color: #137a3e;
  font-size: 20rpx;
}

.group-foot {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 14rpx;
  margin-top: 16rpx;
}

.group-signal {
  width: 100%;
  color: #7d8898;
  font-size: 21rpx;
  line-height: 1.35;
  word-break: keep-all;
}

.group-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
  width: 100%;
}

.small-btn {
  flex: 0 0 210rpx;
  height: 56rpx;
  font-size: 22rpx;
}

.expired-action {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 148rpx;
  height: 56rpx;
  border-radius: 999rpx;
  background: #f4f5f7;
  color: #98a2b3;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
}

.delete-btn {
  flex: 1 1 0;
  height: 56rpx;
  padding: 0;
  border-radius: 999rpx;
  background: #fff7f7;
  border: 1rpx solid #f1b8bc;
  color: #c2414c;
  font-size: 20rpx;
  font-weight: 900;
  box-shadow: none;
}

.empty-state {
  padding: 44rpx 26rpx;
  text-align: center;
}

button.empty-btn,
.empty-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 220rpx;
  height: 64rpx;
  margin: 24rpx auto 0;
  padding: 0;
  font-size: 24rpx;
  line-height: 1;
  box-shadow: 0 14rpx 28rpx rgba(22, 119, 255, 0.18);
}

.flow-page {
  min-height: calc(100vh - 160rpx);
  padding: 18rpx 0 30rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.flow-back {
  width: 52rpx;
  height: 52rpx;
  margin: 0 0 2rpx;
  color: #111827;
  font-size: 50rpx;
  line-height: 46rpx;
  font-weight: 300;
}

.flow-step-title {
  margin: -50rpx 70rpx 22rpx;
  color: #111827;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.35;
  text-align: center;
}

.flow-stat {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  margin-bottom: 30rpx;
  border-radius: 10rpx;
  border: 1rpx solid #f3d9b0;
  background: #fffaf2;
  color: #344054;
  font-size: 22rpx;
  font-weight: 800;
}

.flow-stat text {
  color: #079455;
  font-size: 27rpx;
  font-weight: 900;
  padding: 0 4rpx;
}

.upload-card {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 300rpx;
  border-radius: 20rpx;
  border: 2rpx dashed #b7c0cc;
  background: #ffffff;
  overflow: hidden;
  box-sizing: border-box;
}

.upload-preview {
  width: 100%;
  height: 100%;
}

.upload-placeholder {
  text-align: center;
  color: #667085;
}

.upload-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  margin: 0 auto 26rpx;
  border-radius: 50%;
  border: 3rpx solid #16a34a;
  color: #16a34a;
  font-size: 46rpx;
  font-weight: 900;
}

.upload-title {
