<view class="page-shell home-page">
  <custom-nav title="首页" />

  <view class="today-label">今天</view>
  <view class="sales-action-card state-{{salesHomeState.key}}">
    <view class="action-card-copy">
      <view class="action-card-eyebrow">{{salesHomeState.eyebrow}}</view>
      <view class="action-card-title">{{salesHomeState.title}}</view>
      <view class="action-card-desc">{{salesHomeState.desc}}</view>
      <button class="action-card-button" bindtap="handlePrimaryAction">{{salesHomeState.action}}<text>→</text></button>
    </view>
    <view class="home-radar" bindtap="handleGoRadar">
      <view class="home-radar-ring outer"></view>
      <view class="home-radar-ring middle"></view>
      <view class="home-radar-ring inner"></view>
      <view class="home-radar-axis horizontal"></view>
      <view class="home-radar-axis vertical"></view>
      <view class="home-radar-center">客</view>
      <view class="home-radar-tag sent">已分享 <text>{{homeRadarEntry.todayShareCount}}</text></view>
      <view class="home-radar-tag opened">打开 <text>{{homeRadarEntry.todayOpenCount}}</text></view>
      <view class="home-radar-tag followup">跟进 <text>{{homeRadarEntry.todayFollowupCount}}</text></view>
    </view>
  </view>

  <view class="feedback-section">
    <view class="home-section-head feedback-section-head">
      <view>
        <view class="home-section-title">客户反馈</view>
        <view class="home-section-sub">历史数据持续保留，待跟进只显示当前待办。</view>
      </view>
      <view class="feedback-range-tabs" wx:if="{{feedbackRangeReady}}" role="tablist">
        <view
          wx:for="{{overviewRangeOptions}}"
          wx:key="key"
          class="feedback-range-tab {{overviewRange === item.key ? 'active' : ''}}"
          data-range="{{item.key}}"
          bindtap="handleOverviewRangeChange"
          role="tab"
        >{{item.label}}</view>
      </view>
    </view>
    <view class="feedback-range-caption" wx:if="{{feedbackRangeReady}}">{{feedbackRangeTitle}}</view>
    <view class="feedback-actions">
      <view class="feedback-action {{feedbackSummary.sentCount > 0 ? 'active' : ''}}" data-stage="sent" bindtap="handleFeedbackStage">
        <view class="feedback-action-head"><text>已分享</text><text class="feedback-arrow">›</text></view>
        <view class="feedback-value">{{feedbackSummary.sentCount}}<text> 份</text></view>
        <view class="feedback-hint">查看已发资料</view>
      </view>
      <view class="feedback-action {{feedbackSummary.visitorCount > 0 ? 'active' : ''}}" data-stage="opened" bindtap="handleFeedbackStage">
        <view class="feedback-action-head"><text>打开访客</text><text class="feedback-arrow">›</text></view>
        <view class="feedback-value">{{feedbackSummary.visitorCount}}<text> 位</text></view>
        <view class="feedback-hint">查看访客</view>
      </view>
      <view class="feedback-action followup {{feedbackSummary.pendingCount > 0 ? 'active' : ''}}" data-stage="followup" bindtap="handleFeedbackStage">
        <view class="feedback-action-head"><text>待跟进</text><text class="feedback-arrow">›</text></view>
        <view class="feedback-value">{{feedbackSummary.pendingCount}}<text> 条</text></view>
        <view class="feedback-hint">点击处理后移除</view>
      </view>
    </view>
  </view>

  <view class="priority-section" wx:if="{{priorityCustomer.visible}}">
    <view class="priority-eyebrow">{{priorityCustomer.eyebrow}}</view>
    <view class="priority-top">
      <view class="priority-avatar">{{priorityCustomer.avatarText}}</view>
      <view class="priority-identity">
        <view class="priority-name">{{priorityCustomer.name}}</view>
        <view class="priority-signal">{{priorityCustomer.signal}}</view>
      </view>
    </view>
    <view class="priority-source">{{priorityCustomer.source}}</view>
    <view class="priority-suggestion"><text>建议</text>{{priorityCustomer.suggestion}}</view>
    <view class="priority-actions">
      <button class="priority-secondary" wx:if="{{!priorityCustomer.locked}}" bindtap="handlePriorityTrack">查看轨迹</button>
      <button class="priority-primary" bindtap="handlePriorityPrimary">{{priorityCustomer.primaryAction}}</button>
    </view>
  </view>

  <view class="recent-section">
    <view class="home-section-head">
      <view>
        <view class="home-section-title">最近常用</view>
        <view class="home-section-sub">需要发客户时，从这里最快。</view>
      </view>
      <view class="home-section-link" bindtap="handleGoLibrary">全部资料</view>
    </view>
    <scroll-view scroll-x class="recent-resource-scroll" wx:if="{{recentResources.length}}">
      <view class="recent-resource-row">
        <view class="recent-resource-card" wx:for="{{recentResources}}" wx:key="id" data-id="{{item.id}}" bindtap="handleOpenResource">
          <image wx:if="{{item.coverUrl}}" class="recent-resource-cover" src="{{item.coverUrl}}" mode="aspectFill"></image>
          <view wx:else class="recent-resource-cover generated tone-{{item.titleCover.tone}}">
            <view class="recent-resource-badge">{{item.titleCover.badge}}</view>
            <view class="recent-resource-cover-title">{{item.titleCover.line1}}</view>
          </view>
          <view class="recent-resource-title">{{item.title}}</view>
          <view class="recent-resource-meta">{{item.deliveryStatus.text}} · 打开 {{item.stats.pv}}</view>
        </view>
      </view>
    </scroll-view>
    <view class="recent-empty" wx:else bindtap="handleQuickAdd">
      <view class="recent-empty-icon">＋</view>
      <view>
        <view class="recent-empty-title">还没有可发送的资料</view>
        <view class="recent-empty-desc">先添加一份，之后会自动出现在这里。</view>
      </view>
    </view>
  </view>

  <view wx:if="{{assistantBindModalVisible}}" class="bind-guide-mask" catchtouchmove="noop">
    <view class="bind-guide-sheet">
      <view class="bind-guide-head">
        <view>
          <view class="bind-guide-kicker">添加资料助手</view>
          <view class="bind-guide-title">添加后发送消息，完成绑定</view>
        </view>
        <view class="bind-guide-close" catchtap="handleCloseAssistantBindModal">×</view>
      </view>

      <view class="bind-guide-contact">
        <contact-cell
          plugid="{{assistantContactPlugid}}"
          bind:startmessage="handleAssistantContactStart"
          bind:completemessage="handleAssistantContactComplete"
        />
        <view class="bind-guide-contact-hint">点击按钮添加企业微信“资料助手”</view>
      </view>

      <view wx:if="{{assistantBindMessage}}" class="bind-guide-code">
        <view class="bind-guide-code-label">添加成功后，把下面这段完整复制并发送给企业微信资料助手</view>
        <view class="bind-guide-code-text">{{assistantBindMessage}}</view>
      </view>

      <view class="bind-guide-steps">
        <view class="bind-guide-step">
          <view class="bind-guide-step-index">1</view>
          <view>
            <view class="bind-guide-step-title">点击上方按钮，添加资料助手</view>
            <view class="bind-guide-step-desc">添加完成后返回这里。</view>
          </view>
        </view>
        <view class="bind-guide-step">
          <view class="bind-guide-step-index">2</view>
          <view>
            <view class="bind-guide-step-title">复制下面的完整绑定消息</view>
            <view class="bind-guide-step-desc">不要只复制口令，整段消息一起发送。</view>
          </view>
        </view>
        <view class="bind-guide-step">
          <view class="bind-guide-step-index">3</view>
          <view>
            <view class="bind-guide-step-title">粘贴发送给企业微信资料助手</view>
            <view class="bind-guide-step-desc">会话存档收到口令后完成绑定，之后再发资料即可自动进入资料库。</view>
          </view>
        </view>
      </view>

      <view class="bind-guide-actions">
        <button wx:if="{{assistantBindMessage}}" class="bind-guide-secondary" catchtap="handleCopyAssistantBindMessage">复制绑定消息</button>
        <button class="bind-guide-primary" catchtap="handleCloseAssistantBindModal">知道了</button>
      </view>
      <view class="bind-guide-foot">如果口令过期，请重新打开资料助手生成一条新的。</view>
    </view>
  </view>

</view>
