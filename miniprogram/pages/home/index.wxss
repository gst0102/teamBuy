.mode-picker-mask {
  position: fixed;
  inset: 0;
  z-index: 40;
  display: flex;
  align-items: flex-end;
  padding: 24rpx;
  box-sizing: border-box;
  background: rgba(15, 23, 42, 0.24);
}

.home-page {
  padding-bottom: 56rpx;
}

.opportunity-hero,
.opportunity-panel,
.assistant-panel,
.radar-entry-card,
.recent-panel {
  border: 1rpx solid rgba(221, 231, 244, 0.9);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 14rpx 36rpx rgba(31, 88, 168, 0.07);
  box-sizing: border-box;
}

.opportunity-hero {
  margin: 16rpx 0 22rpx;
  position: relative;
  padding: 28rpx 26rpx 24rpx;
  border: 1rpx solid rgba(211, 226, 247, 0.96);
  background: linear-gradient(135deg, rgba(247, 250, 255, 0.98), rgba(255, 255, 255, 0.96) 54%, rgba(242, 247, 255, 0.98));
  box-shadow: 0 18rpx 42rpx rgba(31, 88, 168, 0.08);
  overflow: hidden;
}

.opportunity-hero::after {
  content: "";
  position: absolute;
  right: -64rpx;
  top: -52rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(153, 195, 255, 0.28), rgba(153, 195, 255, 0));
  pointer-events: none;
}

.opportunity-panel {
  margin-bottom: 22rpx;
  padding: 26rpx;
}

.hero-topline {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10rpx;
}

.hero-bottomline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin-top: 20rpx;
}

.hero-scene-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 52rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(237, 245, 255, 0.96);
  color: #1677ff;
  font-size: 22rpx;
  font-weight: 900;
  white-space: nowrap;
}

.home-main-actions {
  justify-content: flex-start;
  flex-wrap: wrap;
}

.home-main-actions .hero-scene-pill {
  min-height: 54rpx;
  padding: 0 22rpx;
  background: #ffffff;
  color: #1677ff;
  box-shadow: 0 8rpx 20rpx rgba(31, 88, 168, 0.07);
}

.home-main-actions .hero-scene-pill.primary {
  background: #1677ff;
  color: #ffffff;
}

.hero-soft-tip {
  min-width: 0;
  color: #718096;
  font-size: 22rpx;
  line-height: 1.45;
  text-align: right;
}

.hero-copy-block {
  flex: 1;
  min-width: 0;
  padding-top: 4rpx;
}

.hero-kicker {
  color: #1677ff;
  font-size: 23rpx;
  font-weight: 900;
}

.hero-kicker-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.mode-switch-mini {
  display: flex;
  align-items: center;
  justify-content: center;
  max-width: 260rpx;
  min-width: 72rpx;
  height: 38rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #edf5ff;
  color: #1677ff;
  font-size: 20rpx;
  font-weight: 900;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  box-sizing: border-box;
}

.opportunity-hero .hero-title {
  margin-top: 8rpx;
  color: #111827;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.18;
  letter-spacing: 0;
}

.opportunity-hero .hero-subtitle {
  max-width: 320rpx;
  margin-top: 14rpx;
  color: #6b7688;
  font-size: 24rpx;
  line-height: 1.5;
  white-space: normal;
  word-break: break-word;
}

.radar-visual {
  position: relative;
  flex: 0 0 338rpx;
  height: 210rpx;
  margin-top: 8rpx;
  margin-right: -8rpx;
}

.radar-orbit {
  position: absolute;
  left: 78rpx;
  top: 6rpx;
  width: 194rpx;
  height: 194rpx;
}

.orbit-ring,
.orbit-cross,
.orbit-center,
.orbit-dot,
.radar-person-card {
  position: absolute;
}

.orbit-ring {
  inset: 0;
  border: 2rpx solid #d8e7ff;
  border-radius: 50%;
}

.orbit-ring.middle {
  inset: 40rpx;
  border-color: #c5dcff;
}

.orbit-ring.outer {
  box-shadow: 0 0 0 18rpx rgba(22, 119, 255, 0.03);
}

.orbit-cross {
  background: #dbe8fb;
}

.orbit-cross.horizontal {
  left: 0;
  top: 96rpx;
  width: 194rpx;
  height: 2rpx;
}

.orbit-cross.vertical {
  left: 96rpx;
  top: 0;
  width: 2rpx;
  height: 194rpx;
}

.orbit-center {
  left: 77rpx;
  top: 77rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #eaf3ff;
  color: #1677ff;
  font-size: 18rpx;
  font-weight: 900;
  box-shadow: 0 0 0 12rpx rgba(22, 119, 255, 0.08);
}

.orbit-dot {
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: #7cb7ff;
}

.orbit-dot.one {
  right: 32rpx;
  top: 60rpx;
}

.orbit-dot.two {
  left: 43rpx;
  bottom: 36rpx;
}

.radar-person-card {
  display: grid;
  gap: 3rpx;
  min-width: 88rpx;
  padding: 10rpx 12rpx;
  border: 1rpx solid #dfe8f5;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 8rpx 20rpx rgba(31, 88, 168, 0.08);
  box-sizing: border-box;
}

.radar-person-card view {
  color: #243044;
  font-size: 19rpx;
  font-weight: 900;
  line-height: 1.1;
}

.radar-person-card text {
  color: #12b76a;
  font-size: 17rpx;
  font-weight: 800;
  line-height: 1.1;
}

.radar-person-card.left {
  left: 0;
  top: 78rpx;
}

.radar-person-card.right {
  right: 0;
}

.radar-person-card.right.top {
  top: 10rpx;
}

.radar-person-card.right.bottom {
  bottom: 14rpx;
}

.radar-person-card.right.top text {
  color: #f97316;
}

.radar-person-card.right.bottom text {
  color: #7b8798;
}

.top-opportunity {
  display: grid;
  grid-template-columns: 92rpx minmax(0, 1fr);
  gap: 16rpx;
  align-items: center;
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  box-sizing: border-box;
}

.top-opportunity.active {
  border: 1rpx solid #fed7aa;
  background: #fff8ed;
}

.top-opportunity.empty {
  border: 1rpx solid #dbeafe;
  background: #f8fbff;
}

.intent-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 46rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: #f97316;
  color: #ffffff;
  font-size: 21rpx;
  font-weight: 900;
  white-space: nowrap;
}

.top-opportunity.empty .intent-pill {
  background: #1677ff;
}

.top-opportunity-main {
  min-width: 0;
}

.top-opportunity-title {
  color: #111827;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.4;
}

.top-opportunity-desc,
.top-opportunity-action {
  margin-top: 6rpx;
  color: #7a4a15;
  font-size: 22rpx;
  line-height: 1.42;
}

.top-opportunity.empty .top-opportunity-title {
  font-size: 25rpx;
  line-height: 1.25;
}

.top-opportunity.empty .top-opportunity-desc {
  margin-top: 4rpx;
  line-height: 1.25;
}

.top-opportunity.empty .top-opportunity-desc,
.top-opportunity.empty .top-opportunity-action {
  color: #5f6f85;
}

.top-opportunity-action {
  color: #475569;
}

.script-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 58rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  background: #111827;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1;
  white-space: nowrap;
}

.script-btn::after {
  border: 0;
}

.home-stat-row {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.home-stat {
  min-width: 0;
  padding: 20rpx 8rpx 18rpx;
  border-radius: 18rpx;
  background: linear-gradient(180deg, #f8fbff, #f1f6fd);
  text-align: center;
}

.home-stat:nth-child(1) {
  background: linear-gradient(180deg, #fff7ed, #ffedd5);
}

.home-stat:nth-child(2) {
  background: linear-gradient(180deg, #eef5ff, #dbeafe);
}

.home-stat:nth-child(3) {
  background: linear-gradient(180deg, #ecfdf3, #dcfce7);
}

.home-stat:nth-child(4) {
  background: linear-gradient(180deg, #f4f0ff, #ede9fe);
}

.home-stat-value {
  color: #111827;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.1;
}

.home-stat-value.text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 22rpx;
  line-height: 38rpx;
}

.home-stat-label {
  margin-top: 6rpx;
  color: #6f7c8f;
  font-size: 21rpx;
  font-weight: 700;
  white-space: nowrap;
}

.assistant-panel {
  margin-bottom: 22rpx;
  padding: 26rpx;
}

.section-head.clean {
  margin-bottom: 18rpx;
}

.assistant-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.assistant-action {
  position: relative;
  display: grid;
  grid-template-columns: 58rpx minmax(0, 1fr) auto;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
  padding: 20rpx;
  border: 1rpx solid #e3ebf6;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.92);
  box-sizing: border-box;
}

.assistant-action.primary {
  border-color: #cdebd9;
  background: linear-gradient(135deg, #f6fcf8, #ffffff);
}

.assistant-action.wecom {
  grid-column: 1 / -1;
  grid-template-columns: 58rpx minmax(0, 1fr) 92rpx;
  border-color: #dcecff;
  background: linear-gradient(135deg, #f7fbff, #ffffff);
}

.assistant-action-icon,
.assistant-action-mark {
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
}

.assistant-action-icon {
  display: block;
  background: #ecfff4;
}

.assistant-action-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #edf5ff;
  color: #1677ff;
  font-size: 24rpx;
  font-weight: 900;
}

.assistant-action-mark.wecom-mark {
  background: #ecfdf3;
  color: #12b76a;
}

.assistant-action-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 46rpx;
  border-radius: 999rpx;
  background: #edf5ff;
  color: #1677ff;
  font-size: 21rpx;
  font-weight: 900;
  white-space: nowrap;
}

.assistant-action-title {
  color: #111827;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.25;
}

.assistant-action-desc {
  margin-top: 6rpx;
  color: #7b8798;
  font-size: 21rpx;
  line-height: 1.35;
}

.contact-overlay {
  position: absolute;
  inset: 0;
  z-index: 3;
  opacity: 0.01;
  overflow: hidden;
}

.bind-guide-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1200;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 28rpx;
  background: rgba(15, 23, 42, 0.48);
  box-sizing: border-box;
}

.bind-guide-sheet {
  width: 100%;
  max-height: 86vh;
  overflow-y: auto;
  padding: 30rpx 30rpx calc(30rpx + env(safe-area-inset-bottom));
  border-radius: 30rpx 30rpx 24rpx 24rpx;
  background: #ffffff;
  box-sizing: border-box;
  box-shadow: 0 24rpx 80rpx rgba(15, 23, 42, 0.22);
}

.bind-guide-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.bind-guide-kicker {
  color: #1677ff;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.3;
}

.bind-guide-title {
  margin-top: 8rpx;
  color: #111827;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.25;
}

.bind-guide-close {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 58rpx;
  width: 58rpx;
  height: 58rpx;
  border-radius: 999rpx;
  background: #f3f6fb;
  color: #6b7280;
  font-size: 38rpx;
  line-height: 1;
}

.bind-guide-code {
  margin-top: 24rpx;
  padding: 22rpx;
  border: 1rpx solid #cfe2ff;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #f5f9ff, #ffffff);
}

.bind-guide-qr {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: #f8fbff;
}

.bind-guide-qr-image {
  width: 300rpx;
  height: 300rpx;
  border-radius: 18rpx;
  background: #ffffff;
}

.bind-guide-qr-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 300rpx;
  height: 300rpx;
  padding: 22rpx;
  border: 2rpx dashed #bdd7ff;
  border-radius: 18rpx;
  background: #ffffff;
  box-sizing: border-box;
  text-align: center;
}

.bind-guide-qr-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: #ecfdf3;
  color: #12b76a;
  font-size: 24rpx;
  font-weight: 900;
}

.bind-guide-qr-title {
  margin-top: 18rpx;
  color: #111827;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.3;
}

.bind-guide-qr-desc {
  margin-top: 8rpx;
  color: #98a2b3;
  font-size: 20rpx;
  line-height: 1.4;
}

.bind-guide-code-label {
  color: #667085;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.4;
}

.bind-guide-code-text {
  margin-top: 10rpx;
  color: #111827;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.45;
  word-break: break-all;
}

.bind-guide-steps {
  margin-top: 24rpx;
}

.bind-guide-step {
  display: grid;
  grid-template-columns: 46rpx minmax(0, 1fr);
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf1f7;
}

.bind-guide-step:last-child {
  border-bottom: 0;
}

.bind-guide-step-index {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 46rpx;
  height: 46rpx;
  border-radius: 999rpx;
  background: #1677ff;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
}

.bind-guide-step-title {
  color: #111827;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.35;
}

.bind-guide-step-desc {
  margin-top: 6rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.45;
}

.bind-guide-actions {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
  margin-top: 26rpx;
}

.bind-guide-primary,
.bind-guide-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-width: 188rpx;
  height: 72rpx;
  margin: 0;
  padding: 0 28rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1;
  box-sizing: border-box;
}

.bind-guide-primary {
  min-width: 166rpx;
}

.bind-guide-primary::after,
.bind-guide-secondary::after {
  border: 0;
}

.bind-guide-primary {
  background: #1677ff;
  color: #ffffff;
}

.bind-guide-secondary {
  background: #edf5ff;
  color: #1677ff;
}

.bind-guide-foot {
  margin-top: 18rpx;
  color: #98a2b3;
  font-size: 21rpx;
  line-height: 1.45;
  text-align: center;
}

.radar-entry-card {
  display: grid;
  grid-template-columns: 82rpx minmax(0, 1fr) auto;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 22rpx;
  padding: 26rpx;
}

.radar-entry-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 82rpx;
  height: 82rpx;
  border-radius: 22rpx;
  background: #1677ff;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
}

.radar-entry-main {
  min-width: 0;
}

.radar-entry-title {
  color: #111827;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.25;
}

.radar-entry-desc {
  margin-top: 8rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.45;
}

.radar-entry-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.radar-entry-tags text {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 38rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #f1f6ff;
  color: #44607c;
  font-size: 20rpx;
  font-weight: 800;
  white-space: nowrap;
}

.radar-entry-action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  height: 54rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #edf5ff;
  color: #1677ff;
  font-size: 22rpx;
  font-weight: 900;
  white-space: nowrap;
}

.recent-panel {
  padding: 26rpx;
}

.scene-soft-link {
  min-height: 62rpx;
  margin: 0 0 18rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  color: #55708f;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(221, 231, 244, 0.86);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  font-weight: 800;
  text-align: center;
  box-sizing: border-box;
}

@media screen and (max-width: 720rpx) {
  .radar-visual {
    flex-basis: 318rpx;
    height: 204rpx;
    margin-right: -8rpx;
  }

  .radar-orbit {
    left: 72rpx;
    width: 186rpx;
    height: 186rpx;
  }

  .orbit-cross.horizontal {
    top: 92rpx;
    width: 186rpx;
  }

  .orbit-cross.vertical {
    left: 92rpx;
    height: 186rpx;
  }

  .orbit-center {
    left: 73rpx;
    top: 73rpx;
  }

  .top-opportunity {
    grid-template-columns: 86rpx minmax(0, 1fr);
  }

  .script-btn {
    grid-column: 2;
    width: 150rpx;
  }

  .radar-entry-card {
    grid-template-columns: 72rpx minmax(0, 1fr);
  }

  .radar-entry-icon {
    width: 72rpx;
    height: 72rpx;
  }

  .radar-entry-action {
    grid-column: 2;
    justify-self: start;
    margin-top: 4rpx;
  }

  .hero-topline {
    flex-direction: column;
  }

  .radar-visual {
    align-self: center;
  }

  .hero-bottomline {
    flex-direction: row;
    align-items: flex-start;
  }

  .hero-soft-tip {
    text-align: left;
  }

  .assistant-footnote {
    grid-template-columns: 1fr;
  }
}

.mode-picker {
  width: 100%;
  max-height: 88vh;
  overflow-y: auto;
  padding: 34rpx 28rpx 30rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-sizing: border-box;
  box-shadow: 0 28rpx 80rpx rgba(15, 23, 42, 0.24);
}

.mode-picker-kicker {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #1677ff;
  background: #edf5ff;
  font-size: 22rpx;
  font-weight: 800;
}

.mode-picker-title {
  margin-top: 20rpx;
  color: #111827;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.25;
}

