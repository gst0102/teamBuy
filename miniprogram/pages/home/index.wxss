.home-hero {
  position: relative;
  display: flex;
  min-height: 390rpx;
  padding: 24rpx 0 18rpx;
}

.hero-copy {
  width: 62%;
  z-index: 2;
}

.feature-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 24rpx 0 28rpx;
}

.feature-pill {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  color: #3477d8;
  background: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
}

.hero-btn {
  width: 260rpx;
  margin: 0;
}

.hero-note {
  margin-top: 16rpx;
  color: #7d8898;
  font-size: 24rpx;
}

.hero-visual {
  position: absolute;
  right: 4rpx;
  top: 16rpx;
  width: 260rpx;
  height: 330rpx;
}

.phone-card {
  position: absolute;
  right: 28rpx;
  top: 24rpx;
  width: 168rpx;
  height: 250rpx;
  border-radius: 34rpx;
  background: linear-gradient(160deg, #3f8dff, #eaf3ff);
  box-shadow: 0 24rpx 48rpx rgba(22, 119, 255, 0.22);
  padding: 28rpx 20rpx;
  box-sizing: border-box;
}

.phone-line {
  height: 18rpx;
  width: 78rpx;
  background: rgba(255, 255, 255, 0.75);
  border-radius: 99rpx;
  margin-bottom: 22rpx;
}

.phone-line.long {
  width: 112rpx;
}

.phone-tile {
  width: 80rpx;
  height: 62rpx;
  border-radius: 16rpx;
  margin-bottom: 18rpx;
}

.phone-tile.blue {
  background: #ffffff;
}

.phone-tile.green {
  background: rgba(255, 255, 255, 0.55);
}

.float-badge {
  position: absolute;
  width: 66rpx;
  height: 66rpx;
  border-radius: 22rpx;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  box-shadow: 0 16rpx 32rpx rgba(31, 88, 168, 0.16);
}

.float-badge.wx {
  left: 4rpx;
  top: 92rpx;
  background: #24c665;
}

.float-badge.link {
  right: 0;
  top: 116rpx;
  background: #7c5cff;
}

.float-badge.file {
  right: 24rpx;
  bottom: 18rpx;
  background: #2f8cff;
}

.stat-icon.blue,
.shortcut-icon.blue {
  background: linear-gradient(135deg, #368cff, #0066ff);
}

.stat-icon.green,
.shortcut-icon.green {
  background: linear-gradient(135deg, #44d58a, #12b76a);
}

.stat-icon.orange,
.shortcut-icon.orange {
  background: linear-gradient(135deg, #ffb24a, #ff7a1a);
}

.stat-icon.purple,
.shortcut-icon.purple {
  background: linear-gradient(135deg, #8b7cff, #6845f5);
}

.shortcut-icon.red {
  background: linear-gradient(135deg, #ff6b6b, #e5484d);
}

.shortcut-panel {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.shortcut-item {
  flex: 0 0 calc((100% - 32rpx) / 3);
  text-align: center;
}

.shortcut-icon {
  width: 78rpx;
  height: 78rpx;
  border-radius: 24rpx;
  color: #fff;
  margin: 0 auto 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
}

.shortcut-title {
  font-size: 26rpx;
  font-weight: 800;
}

.shortcut-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a96a8;
}

.visitor-row {
  display: flex;
  gap: 24rpx;
  overflow-x: auto;
}

.visitor-card {
  min-width: 120rpx;
  text-align: center;
}

.avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #eaf3ff;
}

.visitor-name {
  margin-top: 10rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.visitor-desc {
  margin-top: 4rpx;
  color: #8a96a8;
  font-size: 22rpx;
}

.hot-scroll {
  white-space: nowrap;
}

.hot-card {
  display: inline-block;
  width: 220rpx;
  margin-right: 20rpx;
  vertical-align: top;
}

.hot-cover {
  width: 220rpx;
  height: 140rpx;
  border-radius: 22rpx;
  background: #edf5ff;
}

.hot-cover.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1677ff;
  font-weight: 800;
}

.hot-title {
  margin-top: 14rpx;
  font-size: 26rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.invite-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-radius: 32rpx;
  padding: 30rpx;
  background: linear-gradient(135deg, #fff1df, #fff7ed);
  margin-bottom: 24rpx;
}

.invite-title {
  color: #8a3900;
  font-size: 30rpx;
  font-weight: 900;
}

.invite-desc {
  color: #9a5a21;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.invite-btn {
  padding: 16rpx 28rpx;
  background: linear-gradient(135deg, #ff9f2d, #ff6a00);
  color: #fff;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 800;
}
