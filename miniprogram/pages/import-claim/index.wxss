.claim-page {
  min-height: 100vh;
  padding: 180rpx 32rpx 64rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #eef6ff 0%, #f7fbf8 44%, #ffffff 100%);
}

.claim-card {
  padding: 52rpx 36rpx;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 46rpx rgba(20, 67, 120, 0.1);
  text-align: center;
}

.claim-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto 28rpx;
  border-radius: 32rpx;
  background: #e8f8ef;
  color: #10875a;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1;
}

.claim-title {
  color: #172033;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.35;
}

.claim-desc {
  margin-top: 16rpx;
  color: #6f7d91;
  font-size: 28rpx;
  line-height: 1.55;
}

.claim-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 360rpx;
  height: 84rpx;
  margin: 36rpx auto 0;
  border-radius: 8rpx;
  background: #10875a;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.2;
}
