<view class="page-shell">
  <custom-nav title="新导入资料" showBack="{{true}}" />

  <view class="panel" wx:if="{{notifications.length}}">
    <view class="section-title">导入结果</view>
    <block wx:for="{{notifications}}" wx:key="id">
      <view class="notice-row">
        <view class="notice-dot {{item.status}}"></view>
        <view class="muted">{{item.message}}</view>
      </view>
    </block>
  </view>

  <view class="imports-head">
    <view>
      <view class="imports-title">新导入资料</view>
      <view class="imports-subtitle">第一次认领会绑定房源助手，之后发来的资料自动进你的账号。</view>
    </view>
    <view class="imports-count">{{imports.length}}</view>
  </view>

  <block wx:for="{{imports}}" wx:key="id">
    <view class="import-card">
      <view class="import-section">
        <view class="field-label">标题</view>
        <view class="import-title">{{item.displayTitle}}</view>
      </view>

      <view class="import-section">
        <view class="field-label">内容</view>
        <view class="import-body">{{item.displayBody}}</view>
      </view>

      <view class="template-row">
        <block wx:for="{{templates}}" wx:for-item="template" wx:key="id">
          <button
            class="template-chip {{item.selectedTemplate === template.id ? 'active' : ''}}"
            data-id="{{item.id}}"
            data-template="{{template.id}}"
            bindtap="handleSelectTemplate"
          >{{template.label}}</button>
        </block>
      </view>

      <view class="template-panel">
        <view class="template-hint">{{item.template.hint}}</view>
        <view class="field-tags">
          <block wx:for="{{item.template.fields}}" wx:key="*this">
            <text class="field-tag">{{item}}</text>
          </block>
        </view>
      </view>

      <view class="import-footer">
        <view class="import-meta">{{item.displayMeta}}</view>
        <button class="claim-btn" data-id="{{item.id}}" bindtap="handleClaim">认领并绑定</button>
      </view>
    </view>
  </block>
  <view class="empty-state" wx:if="{{!imports.length && !loading}}">暂无新导入资料。</view>
</view>
