.imports-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 0;
}

.imports-title {
  color: #172033;
  font-size: 40rpx;
  font-weight: 900;
}

.imports-subtitle {
  margin-top: 8rpx;
  color: #6f7d91;
  font-size: 24rpx;
}

.imports-count {
  min-width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 50%;
  background: #1677ff;
  color: #fff;
  font-size: 30rpx;
  font-weight: 900;
  text-align: center;
}

.import-card {
  margin-bottom: 24rpx;
  padding: 24rpx;
  border-radius: 8rpx;
  background: #fff;
  box-shadow: 0 12rpx 34rpx rgba(31, 88, 168, 0.08);
}

.import-section + .import-section {
  margin-top: 22rpx;
}

.field-label {
  margin-bottom: 10rpx;
  color: #6f7d91;
  font-size: 22rpx;
  font-weight: 700;
}

.import-title {
  color: #172033;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.35;
}

.import-body {
  max-height: 220rpx;
  padding: 18rpx;
  border-radius: 8rpx;
  background: #f6f8fb;
  color: #2c3748;
  font-size: 28rpx;
  line-height: 1.55;
  overflow: hidden;
}

.template-row {
  display: flex;
  gap: 14rpx;
  margin-top: 24rpx;
}

.template-chip {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 8rpx;
  background: #eef3f8;
  color: #526070;
  font-size: 26rpx;
}

.template-chip.active {
  background: #1677ff;
  color: #fff;
}

.template-panel {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 8rpx;
  background: #f8fbff;
}

.template-hint {
  color: #526070;
  font-size: 24rpx;
}

.field-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.field-tag {
  padding: 8rpx 14rpx;
  border-radius: 8rpx;
  background: #eaf3ff;
  color: #1677ff;
  font-size: 22rpx;
  font-weight: 700;
}

.import-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 24rpx;
}

.import-meta {
  flex: 1;
  min-width: 0;
  color: #8a96a8;
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.claim-btn {
  width: 220rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 8rpx;
  background: #12b76a;
  color: #fff;
  font-size: 26rpx;
  font-weight: 800;
}

.notice-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf2f8;
}

.notice-row:last-child {
  border-bottom: none;
}

.notice-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #12b76a;
  margin-right: 14rpx;
}

.notice-dot.failed {
  background: #ff7a1a;
}
