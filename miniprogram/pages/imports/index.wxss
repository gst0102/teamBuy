.imports-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 0;
}

.imports-visual {
  width: 178rpx;
  height: 178rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #dcebff, #ffffff);
  color: #1677ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 900;
  box-shadow: 0 18rpx 46rpx rgba(31, 88, 168, 0.12);
}

.step-row {
  display: flex;
  gap: 16rpx;
  margin: 20rpx 0 28rpx;
}

.step-item {
  flex: 1;
  padding: 18rpx 12rpx;
  border-radius: 24rpx;
  background: #f5f9ff;
  color: #526070;
  text-align: center;
  font-size: 22rpx;
}

.step-dot {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  margin: 0 auto 10rpx;
  border-radius: 50%;
  background: #1677ff;
  color: #fff;
  font-weight: 800;
}

.notice-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf2f8;
}

.notice-row:last-child {
  border-bottom: none;
}

.notice-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #12b76a;
  margin-right: 14rpx;
}

.notice-dot.failed {
  background: #ff7a1a;
}

.import-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 14rpx 36rpx rgba(31, 88, 168, 0.08);
}

.import-main {
  flex: 1;
  min-width: 0;
}

.import-title {
  font-size: 30rpx;
  font-weight: 900;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
