.detail-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 30rpx 0 24rpx;
}

.status-pill,
.date-pill,
.detail-actions text {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 58rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #edf5ff;
  border: 1rpx solid rgba(22, 119, 255, 0.14);
  color: #1677ff;
  font-size: 24rpx;
  font-weight: 900;
}

.source-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: #f6f9ff;
  border: 1rpx solid #e6eef9;
}

.source-label {
  color: #8a96a8;
  font-size: 22rpx;
  font-weight: 800;
}

.source-title {
  margin-top: 6rpx;
  color: #172033;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.35;
}

.source-link {
  flex: 0 0 auto;
  color: #1677ff;
  font-size: 24rpx;
  font-weight: 900;
}

.detail-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

.customer-profile-panel {
  border-color: rgba(22, 119, 255, 0.18);
}

.profile-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin: 18rpx 0;
  padding: 20rpx;
  border-radius: 24rpx;
  background: #f6f9ff;
  border: 1rpx solid #e6eef9;
}

.profile-name {
  color: #172033;
  font-size: 30rpx;
  font-weight: 900;
}

.profile-meta {
  margin-top: 6rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.4;
}

.profile-copy {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #edf5ff;
  border: 1rpx solid rgba(22, 119, 255, 0.14);
  color: #1677ff;
  font-size: 23rpx;
  font-weight: 900;
}

.customer-tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: -4rpx 0 16rpx;
}

.customer-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #edf5ff;
  border: 1rpx solid rgba(22, 119, 255, 0.14);
  color: #1677ff;
  font-size: 22rpx;
  font-weight: 900;
}

.tag-input-panel {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 24rpx;
  background: #f8fbff;
  border: 1rpx dashed rgba(22, 119, 255, 0.22);
}

.tag-input-title {
  color: #172033;
  font-size: 25rpx;
  font-weight: 900;
}

.tag-input-sub {
  margin-top: 6rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.45;
}

.tag-input {
  margin-top: 14rpx;
}

.text-area {
  width: 100%;
  min-height: 180rpx;
  box-sizing: border-box;
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 2rpx solid #e5efff;
  color: #172033;
  font-size: 26rpx;
}

.date-pill {
  margin-top: 18rpx;
}

.timeline {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 22rpx;
}

.timeline-item {
  display: flex;
  gap: 14rpx;
}

.timeline-dot {
  flex: 0 0 auto;
  width: 14rpx;
  height: 14rpx;
  margin-top: 14rpx;
  border-radius: 50%;
  background: #1677ff;
}

.timeline-main {
  flex: 1;
  min-width: 0;
}

.timeline-text {
  color: #344054;
  font-size: 26rpx;
  line-height: 1.5;
}

.timeline-time,
.archive-note {
  margin-top: 6rpx;
  color: #8a96a8;
  font-size: 23rpx;
}
