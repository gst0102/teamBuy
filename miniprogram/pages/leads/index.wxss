.viewer-filter-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin: 20rpx 0 18rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: #edf2f8;
}

.viewer-filter {
  min-height: 64rpx;
  line-height: 64rpx;
  border-radius: 999rpx;
  color: #667085;
  font-size: 25rpx;
  font-weight: 900;
  text-align: center;
}

.viewer-filter.active {
  background: #172033;
  color: #ffffff;
  box-shadow: 0 12rpx 26rpx rgba(23, 32, 51, 0.16);
}

.reminder-board {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.reminder-card {
  min-height: 164rpx;
  box-sizing: border-box;
  padding: 22rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(22, 119, 255, 0.14);
  background: #edf5ff;
  box-shadow: 0 14rpx 32rpx rgba(31, 88, 168, 0.08);
}

.reminder-card.overdue {
  background: #fff1f3;
  border-color: rgba(229, 72, 77, 0.14);
}

.reminder-label {
  color: #667085;
  font-size: 24rpx;
  font-weight: 900;
}

.reminder-value {
  margin-top: 8rpx;
  color: #172033;
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1;
}

.reminder-card.today .reminder-value,
.reminder-card.today .reminder-action {
  color: #1677ff;
}

.reminder-card.overdue .reminder-value,
.reminder-card.overdue .reminder-action {
  color: #e5484d;
}

.reminder-action {
  margin-top: 14rpx;
  font-size: 23rpx;
  font-weight: 900;
}

.quick-unhandled {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
  padding: 20rpx 22rpx;
  border-radius: 26rpx;
  background: #ffffff;
  border: 1rpx solid #e6eef9;
  box-shadow: 0 12rpx 28rpx rgba(31, 88, 168, 0.07);
}

.quick-title {
  color: #172033;
  font-size: 28rpx;
  font-weight: 900;
}

.quick-sub {
  margin-top: 6rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.4;
}

.quick-pill {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 54rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #edf5ff;
  border: 1rpx solid rgba(22, 119, 255, 0.14);
  color: #1677ff;
  font-size: 23rpx;
  font-weight: 900;
}

.schedule-filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 0 0 18rpx;
}

.schedule-filter {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 58rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #edf5ff;
  border: 1rpx solid rgba(22, 119, 255, 0.14);
  color: #1677ff;
  font-size: 24rpx;
  font-weight: 900;
}

.schedule-filter.active {
  background: #1677ff;
  color: #ffffff;
  box-shadow: 0 12rpx 26rpx rgba(22, 119, 255, 0.18);
}

.lead-status-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 8rpx;
}

.lead-status {
  color: #738093;
  font-size: 24rpx;
  font-weight: 800;
}

.due-badge {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #edf5ff;
  color: #1677ff;
  font-size: 21rpx;
  font-weight: 900;
}

.due-badge.overdue {
  background: #fff1f3;
  color: #e5484d;
}

.due-badge.today {
  background: #fff7ed;
  color: #f97316;
}

.due-badge.future {
  background: #ecfdf3;
  color: #079455;
}

.due-badge.done {
  background: #f2f4f7;
  color: #667085;
}

.lead-source {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin: 18rpx 0;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: #f6f9ff;
  border: 1rpx solid #e6eef9;
}

.source-label {
  color: #8a96a8;
  font-size: 22rpx;
  font-weight: 800;
}

.source-title {
  margin-top: 6rpx;
  color: #172033;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.35;
}

.source-link {
  flex: 0 0 auto;
  color: #1677ff;
  font-size: 24rpx;
  font-weight: 900;
}

.follow-box {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 22rpx;
  background: #f8fbff;
  border: 1rpx solid #e6eef9;
}

.follow-head {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.follow-date-pill {
  display: inline-flex;
  align-items: center;
  min-height: 54rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #edf5ff;
  border: 1rpx solid rgba(22, 119, 255, 0.14);
  color: #1677ff;
  font-size: 23rpx;
  font-weight: 900;
}

.follow-latest {
  color: #667085;
  font-size: 23rpx;
  line-height: 1.45;
}

.follow-timeline {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 14rpx;
}

.follow-log {
  display: flex;
  gap: 12rpx;
}

.follow-dot {
  flex: 0 0 auto;
  width: 12rpx;
  height: 12rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  background: #1677ff;
}

.follow-log-main {
  flex: 1;
  min-width: 0;
}

.follow-log-text {
  color: #344054;
  font-size: 24rpx;
  line-height: 1.45;
}

.follow-log-time {
  margin-top: 2rpx;
  color: #8a96a8;
  font-size: 21rpx;
}

.follow-input {
  margin-bottom: 0;
}

.stat-icon.red {
  background: linear-gradient(135deg, #ff8a8a, #e5484d);
}

.card-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

.card-actions text {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 58rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #edf5ff;
  border: 1rpx solid rgba(22, 119, 255, 0.14);
  color: #1677ff;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
}

.card-actions .danger-action {
  background: #fff1f3;
  border-color: rgba(229, 72, 77, 0.14);
  color: #e5484d;
}
