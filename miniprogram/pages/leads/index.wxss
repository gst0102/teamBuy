.viewer-filter-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin: 20rpx 0 18rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: #edf2f8;
}

.viewer-filter {
  min-height: 64rpx;
  line-height: 64rpx;
  border-radius: 999rpx;
  color: #667085;
  font-size: 25rpx;
  font-weight: 900;
  text-align: center;
}

.viewer-filter.active {
  background: #172033;
  color: #ffffff;
  box-shadow: 0 12rpx 26rpx rgba(23, 32, 51, 0.16);
}

.lead-source {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin: 18rpx 0;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: #f6f9ff;
  border: 1rpx solid #e6eef9;
}

.source-label {
  color: #8a96a8;
  font-size: 22rpx;
  font-weight: 800;
}

.source-title {
  margin-top: 6rpx;
  color: #172033;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.35;
}

.source-link {
  flex: 0 0 auto;
  color: #1677ff;
  font-size: 24rpx;
  font-weight: 900;
}

.follow-box {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 22rpx;
  background: #f8fbff;
  border: 1rpx solid #e6eef9;
}

.follow-head {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.follow-date-pill {
  display: inline-flex;
  align-items: center;
  min-height: 54rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #edf5ff;
  border: 1rpx solid rgba(22, 119, 255, 0.14);
  color: #1677ff;
  font-size: 23rpx;
  font-weight: 900;
}

.follow-latest {
  color: #667085;
  font-size: 23rpx;
  line-height: 1.45;
}

.follow-input {
  margin-bottom: 0;
}

.card-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

.card-actions text {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 58rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #edf5ff;
  border: 1rpx solid rgba(22, 119, 255, 0.14);
  color: #1677ff;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
}

.card-actions .danger-action {
  background: #fff1f3;
  border-color: rgba(229, 72, 77, 0.14);
  color: #e5484d;
}
