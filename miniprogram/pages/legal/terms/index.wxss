page {
  background: #f8fbff;
}

.legal-page {
  min-height: 100vh;
  padding: 24rpx 28rpx 54rpx;
  background: linear-gradient(180deg, #eef6ff 0%, #ffffff 48%, #ffffff 100%);
  box-sizing: border-box;
}

.legal-card {
  margin-top: 22rpx;
  padding: 30rpx;
  border: 1rpx solid #e5edf7;
  border-radius: 8rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.legal-title {
  color: #111827;
  font-size: 36rpx;
  font-weight: 950;
  line-height: 1.3;
}

.legal-meta {
  margin-top: 10rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.45;
}

.section {
  margin-top: 30rpx;
}

.section-title {
  color: #172033;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.35;
}

.paragraph {
  margin-top: 12rpx;
  color: #475467;
  font-size: 25rpx;
  line-height: 1.68;
}
