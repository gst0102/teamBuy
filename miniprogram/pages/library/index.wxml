<view class="page-shell library-page {{hasAnyCards ? 'has-cards' : 'is-empty'}}">
  <custom-nav title="资料" show-back="{{false}}" />

  <view class="library-mode-switch" aria-label="资料与合集切换">
    <view class="library-mode active">资料</view>
    <view class="library-mode" bindtap="handleOpenCollections">合集</view>
  </view>

  <view class="library-loading-state" wx:if="{{libraryLoading}}">
    <view class="library-loading-dot"></view>
    <view>正在整理资料库…</view>
  </view>

  <block wx:elif="{{hasAnyCards}}">
    <view class="library-search-row">
      <view class="library-search-box">
        <text class="library-search-icon">⌕</text>
        <input class="library-search-input" value="{{keyword}}" placeholder="搜索资料、标签或来源" bindinput="handleKeywordChange" confirm-type="search" bindconfirm="handleSearch" />
      </view>
      <button class="library-filter-trigger {{filterPanelVisible || activeLibraryType !== 'all' || activeDeliveryFilter !== 'all' || activeCategory !== '全部' || activeTag !== '全部' ? 'active' : ''}}" bindtap="handleToggleFilterPanel" aria-label="打开筛选">
        <text class="filter-line top"></text>
        <text class="filter-line middle"></text>
        <text class="filter-line bottom"></text>
        <text class="library-filter-trigger-label">筛选</text>
      </button>
    </view>

    <scroll-view scroll-x class="library-sales-scroll" enable-flex>
      <view class="library-sales-row">
        <view class="library-sales-chip {{activeSalesFilter === item.key ? 'active' : ''}}" wx:for="{{salesFilters}}" wx:key="key" data-key="{{item.key}}" bindtap="handleSalesFilter">{{item.label}}</view>
      </view>
    </scroll-view>

    <view class="library-entry-filter" wx:if="{{entryFilterText}}">
      <text>{{entryFilterText}}</text>
      <text bindtap="handleClearEntryFilter">清除</text>
    </view>

    <view class="library-section-head">
      <view class="library-section-title">{{activeSalesFilter === 'recent' ? '最近使用' : activeSalesFilter === 'frequent' ? '常发资料' : activeSalesFilter === 'feedback' ? '高反馈资料' : '待完善资料'}}</view>
      <view class="library-section-meta">已加载 {{filteredCards.length}} 份 <text class="library-manage-link" bindtap="handleToggleFilterPanel">管理</text></view>
    </view>

    <view class="library-card-list" wx:if="{{displayCards.length}}">
      <view class="library-resource-card" wx:for="{{displayCards}}" wx:key="id" data-id="{{item.id}}" bindtap="handleView">
        <image wx:if="{{item.coverUrl}}" class="library-resource-cover" src="{{item.coverDisplayUrl || item.coverUrl}}" mode="aspectFill"></image>
        <view wx:else class="library-resource-cover generated tone-{{item.titleCover.tone}}">
          <view class="library-cover-badge">{{item.titleCover.badge}}</view>
          <view class="library-cover-title">{{item.titleCover.line1}}</view>
        </view>

        <view class="library-resource-main">
          <view class="library-resource-title">{{item.title}}</view>
          <view wx:if="{{item.isBusinessCardResource && (item.businessCardRole || item.businessCardCompany)}}" class="library-card-identity">{{item.businessCardRole}}<text wx:if="{{item.businessCardRole && item.businessCardCompany}}"> · </text>{{item.businessCardCompany}}</view>
          <view wx:if="{{item.isBusinessCardResource && item.businessCardHeadline}}" class="library-card-headline">{{item.businessCardHeadline}}</view>
          <view class="library-resource-tags" wx:if="{{item.libraryTags.length}}">
            <text class="library-resource-tag tone-{{item.libraryTone}}" wx:for="{{item.libraryTags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
          </view>
          <view class="library-resource-meta">{{item.libraryMeta}}</view>
          <view class="library-resource-signal" wx:if="{{item.hasCustomerSignal || item.customerActivity}}" data-id="{{item.id}}" catchtap="handleManage">{{item.customerLabel}} · 去资料运营</view>
        </view>

        <view class="library-resource-actions">
          <button class="library-more-button" data-id="{{item.id}}" catchtap="handleMoreCardActions" aria-label="更多操作">•••</button>
          <button wx:if="{{item.canShare && item.shareState !== 'revoked' && item.shareImageReady}}" class="library-send-button" open-type="share" catchtap="prepareShare" data-id="{{item.id}}" data-note-id="{{item.sourceNoteId}}" data-title="{{item.title}}">发客户</button>
          <button wx:elif="{{item.canShare && item.shareState !== 'revoked'}}" class="library-send-button pending" data-id="{{item.id}}" catchtap="prepareShare">{{item.shareStatusText}}</button>
          <button wx:elif="{{item.shareState === 'revoked'}}" class="library-send-button disabled" disabled="true">已停止分享</button>
          <button wx:elif="{{item.canPublish}}" class="library-send-button publish" data-id="{{item.id}}" catchtap="handlePublish">发客户</button>
          <button wx:else class="library-send-button edit" data-id="{{item.id}}" catchtap="handleOpen">完善</button>
        </view>
      </view>
    </view>

    <view class="library-filter-empty" wx:else>
      <view class="library-filter-empty-icon">⌕</view>
      <view class="library-filter-empty-title">没有符合条件的资料</view>
      <view class="library-filter-empty-sub">换个关键词，或清除筛选后再找。</view>
      <button class="library-filter-empty-reset" bindtap="handleResetLibraryFilters">清除筛选</button>
    </view>

    <view class="library-load-more" wx:if="{{hasMoreCards}}">{{loadingMoreCards ? '正在加载…' : '继续上滑加载更多'}}</view>
    <view class="library-load-more done" wx:elif="{{filteredCards.length > 10}}">已加载全部 {{filteredCards.length}} 份</view>

    <view class="library-bottom-spacer"></view>
    <view class="library-fixed-actions">
      <button class="library-fixed-primary" bindtap="handleManualAdd"><text>＋</text> 新建资料</button>
      <button class="library-fixed-secondary" bindtap="handleAssistantBindTap">资料助手</button>
    </view>
  </block>

  <view class="library-load-error" wx:elif="{{libraryLoadError}}">
    <view class="library-load-error-icon">!</view>
    <view class="library-load-error-title">资料暂时没有加载出来</view>
    <view class="library-load-error-sub">这不是零数据，检查网络后可以重新加载。</view>
    <button class="library-retry-button" bindtap="handleRetryLibrary">重新加载</button>
  </view>

  <view class="library-first-empty" wx:else>
    <view class="library-first-illustration">
      <view class="empty-folder-back"></view>
      <view class="empty-folder-front"><text class="empty-folder-plus">＋</text></view>
      <view class="empty-spark one">✦</view>
      <view class="empty-spark two">✦</view>
    </view>
    <view class="library-first-title">先添加第一份资料</view>
    <view class="library-first-sub">以后发给客户的内容，都从这里开始。</view>
    <button class="library-first-cta" bindtap="handleManualAdd"><text class="library-first-cta-icon">＋</text> 新建资料</button>

    <view class="library-assistant-card" bindtap="handleAssistantBindTap">
      <view class="library-assistant-icon">微</view>
      <view class="library-assistant-copy">
        <view class="library-assistant-title">添加资料助手 <text class="library-assistant-chip">推荐</text></view>
        <text class="library-assistant-desc">微信内容转发进资料库</text>
      </view>
      <view class="library-assistant-arrow">›</view>
    </view>

    <view class="library-collection-empty" bindtap="handleOpenCollections">
      <view class="collection-empty-icon">▱</view>
      <view><text class="collection-empty-title">合集</text><text class="collection-empty-desc">{{collectionCount}} 个 · 资料添加后，可组合成合集</text></view>
      <text class="collection-empty-arrow">›</text>
    </view>
  </view>

  <view wx:if="{{filterPanelVisible}}" class="library-filter-mask" catchtouchmove="noop" catchtap="handleCloseFilterPanel">
    <view class="library-filter-sheet" catchtap="noop">
      <view class="library-filter-sheet-handle"></view>
      <view class="library-filter-sheet-head">
        <view>
          <view>筛选资料</view>
          <view class="library-filter-sheet-sub">按资料类型、客户进度和标签精准筛选</view>
        </view>
        <view class="library-filter-close" bindtap="handleCloseFilterPanel">×</view>
      </view>
      <view class="library-filter-current">
        <text class="library-filter-current-label">当前筛选</text>
        <text class="library-filter-current-value">{{filterSummaryText}}</text>
      </view>
      <view class="library-filter-label">资料类型</view>
      <view class="library-filter-chips">
        <text wx:for="{{libraryTypeFilters}}" wx:key="key" class="library-filter-chip {{activeLibraryType === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="handleLibraryTypeFilter">{{item.label}} {{item.count}}</text>
      </view>
      <view class="library-filter-label">客户进度</view>
      <view class="library-filter-chips">
        <text wx:for="{{deliveryFilters}}" wx:key="key" class="library-filter-chip {{activeDeliveryFilter === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="handleDeliveryFilter">{{item.label}} {{item.count}}</text>
      </view>
      <block wx:if="{{tagFilters.length > 1}}">
        <view class="library-filter-label">标签</view>
        <view class="library-filter-tag-search">
          <text class="library-filter-tag-search-icon">⌕</text>
          <input value="{{tagKeyword}}" placeholder="搜索标签" bindinput="handleTagKeywordChange" />
        </view>
        <view class="library-filter-chips">
          <text wx:for="{{visibleTagFilters}}" wx:key="name" class="library-filter-chip {{activeTag === item.name ? 'active' : ''}}" data-tag="{{item.name}}" bindtap="handleTagFilter">{{item.name}} {{item.count}}</text>
        </view>
        <text class="library-filter-all-tags" bindtap="handleShowAllTags">{{showAllTags ? '收起标签' : '查看全部标签'}} ›</text>
      </block>
      <view class="library-filter-actions">
        <button class="library-filter-reset" bindtap="handleResetLibraryFilters">重置</button>
        <button class="library-filter-apply" bindtap="handleCloseFilterPanel">完成（{{filteredCards.length}}）</button>
      </view>
    </view>
  </view>

  <view wx:if="{{assistantBindModalVisible}}" class="bind-guide-mask" catchtouchmove="noop">
    <view class="bind-guide-sheet">
      <view class="bind-guide-head">
        <view><view class="bind-guide-kicker">添加资料助手</view><view class="bind-guide-title">添加后发送消息，完成绑定</view></view>
        <view class="bind-guide-close" catchtap="handleCloseAssistantBindModal">×</view>
      </view>
      <view class="bind-guide-qr">
        <contact-cell
          plugid="{{assistantContactPlugid}}"
          bind:startmessage="handleAssistantContactStart"
          bind:completemessage="handleAssistantContactComplete"
        />
      </view>
      <view class="bind-guide-foot">点击按钮添加企业微信“资料助手”，添加成功后复制下面的完整消息发送给它。</view>
      <view wx:if="{{assistantBindMessage}}" class="bind-guide-code">
        <view class="bind-guide-code-label">请复制下面这段完整消息，发送给企业微信资料助手</view>
        <view class="bind-guide-code-text">{{assistantBindMessage}}</view>
      </view>
      <view class="bind-guide-steps">
        <view class="bind-guide-step"><view class="bind-guide-step-index">1</view><view><view class="bind-guide-step-title">点击上方按钮，添加资料助手</view><view class="bind-guide-step-desc">添加完成后返回这里。</view></view></view>
        <view class="bind-guide-step"><view class="bind-guide-step-index">2</view><view><view class="bind-guide-step-title">复制下面的完整绑定消息</view><view class="bind-guide-step-desc">不要只复制口令，整段消息一起发送。</view></view></view>
        <view class="bind-guide-step"><view class="bind-guide-step-index">3</view><view><view class="bind-guide-step-title">粘贴发送给企业微信资料助手</view><view class="bind-guide-step-desc">会话存档收到口令后完成绑定，之后再发资料即可自动进入资料库。</view></view></view>
      </view>
      <view class="bind-guide-actions">
        <button wx:if="{{assistantBindMessage}}" class="bind-guide-secondary" catchtap="handleCopyAssistantBindMessage">复制绑定消息</button>
        <button class="bind-guide-primary" catchtap="handleCloseAssistantBindModal">知道了</button>
      </view>
      <view class="bind-guide-foot">如果口令过期，请重新打开资料助手生成一条新的。</view>
    </view>
  </view>

</view>
