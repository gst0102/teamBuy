  background: #ffffff;
  color: #16723b;
  font-size: 24rpx;
  font-weight: 900;
}

.stat-icon.purple {
  background: linear-gradient(135deg, #8b7cff, #6845f5);
}

.tag-row {
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
  margin: 18rpx 0 24rpx;
}

.topic-row {
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
  margin: 18rpx 0 24rpx;
}

.topic-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 54rpx;
  max-width: 100%;
  padding: 0 22rpx;
