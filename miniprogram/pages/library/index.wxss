.library-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 210rpx;
  padding: 34rpx 0 18rpx;
}

.hero-copy {
  flex: 1;
  min-width: 0;
  padding-right: 22rpx;
}

.hero-kicker {
  margin-bottom: 8rpx;
  color: #1677ff;
  font-size: 23rpx;
  font-weight: 900;
}

.hero-title {
  color: #111827;
  font-size: 56rpx;
  line-height: 1.06;
  font-weight: 900;
}

.hero-subtitle {
  margin-top: 14rpx;
  max-width: 440rpx;
  color: #64748b;
  font-size: 25rpx;
  line-height: 1.56;
}

.library-visual {
  width: 180rpx;
  height: 180rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #dcebff, #ffffff);
  color: #1677ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 900;
  box-shadow: 0 18rpx 46rpx rgba(31, 88, 168, 0.12);
}

.library-sort-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 20rpx;
  padding: 14rpx 18rpx;
  border: 1rpx solid #dbe6f7;
  border-radius: 999rpx;
  background: linear-gradient(135deg, rgba(247, 250, 255, 0.98), rgba(255, 255, 255, 0.96) 56%, rgba(244, 248, 255, 0.98));
  box-shadow: 0 10rpx 24rpx rgba(31, 88, 168, 0.06);
  box-sizing: border-box;
}

.library-sort-bar view {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 38rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #e8f2ff;
  color: #1677ff;
  font-size: 19rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.library-sort-bar text {
  flex: 1;
  min-width: 0;
  color: #667085;
  font-size: 21rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.search-box {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 12rpx 12rpx 12rpx 24rpx;
  background: rgba(255, 255, 255, 0.94);
  border-radius: 999rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #dfe7f1;
  box-shadow: 0 14rpx 36rpx rgba(31, 88, 168, 0.08);
}

.search-input {
  flex: 1;
  min-height: 64rpx;
  font-size: 28rpx;
}

.search-btn {
  width: auto;
  min-width: 96rpx;
  height: 64rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  color: #fff;
  background: #1677ff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.library-tool-head {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.quick-icon.collection { background: #315f9b; }

.quick-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.quick-actions.more-tools {
  padding: 18rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.62);
  border: 1rpx solid #e1eaf5;
}

.quick-action {
  flex: 1 0 42%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx 12rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid #e3ebf6;
  box-shadow: 0 14rpx 36rpx rgba(31, 88, 168, 0.08);
  font-size: 26rpx;
  font-weight: 800;
}

.quick-icon {
  width: 54rpx;
  height: 54rpx;
  border-radius: 18rpx;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 900;
}

.quick-icon.blue,
.stat-icon.blue {
  background: linear-gradient(135deg, #368cff, #0066ff);
}

.quick-icon.green,
.stat-icon.green {
  background: linear-gradient(135deg, #44d58a, #12b76a);
}

.quick-icon.card {
  background: linear-gradient(135deg, #26c661, #078d31);
}

.quick-icon.teal {
  background: linear-gradient(135deg, #35c8b3, #0f9f8c);
}

.business-card-action {
  border: 2rpx solid rgba(7, 141, 49, 0.16);
  color: #0b7f35;
}
.library-card-identity { margin-top:8rpx; overflow:hidden; color:#526178; font-size:21rpx; text-overflow:ellipsis; white-space:nowrap; }
.library-card-headline { margin-top:9rpx; overflow:hidden; color:#7a8799; font-size:20rpx; line-height:1.4; text-overflow:ellipsis; white-space:nowrap; }

.service-offer-action {
  border: 2rpx solid rgba(15, 159, 140, 0.16);
  color: #0b7d70;
}

.quick-icon.orange,
.stat-icon.orange {
  background: linear-gradient(135deg, #ffb24a, #ff7a1a);
}

.quick-icon.purple {
  background: linear-gradient(135deg, #8b7cff, #6845f5);
}

.quick-icon.gray {
  background: linear-gradient(135deg, #94a3b8, #64748b);
}

.muted-action {
  color: #475467;
}

.filter-title {
  margin: 10rpx 0 12rpx;
  color: #5d6b7c;
  font-size: 24rpx;
  font-weight: 700;
}

.filter-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin: 10rpx 0 12rpx;
}

.filter-title-row .filter-title {
  margin: 0;
}

.filter-title-row text {
  flex: 0 0 auto;
  color: #1677ff;
  font-size: 24rpx;
  font-weight: 800;
  white-space: nowrap;
}

.entry-filter-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin: 8rpx 0 18rpx;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: #ecfdf3;
  border: 1rpx solid #c9f0d5;
}

.entry-filter-title {
  color: #166534;
  font-size: 26rpx;
  font-weight: 900;
}

.entry-filter-desc {
  margin-top: 6rpx;
  color: #4b6d5a;
