  color: #172033;
  font-size: 26rpx;
  font-weight: 900;
}

.topic-action-desc {
  margin-top: 6rpx;
  color: #6f7d91;
  font-size: 22rpx;
  line-height: 1.4;
}

.topic-action-card button {
  display: flex;
