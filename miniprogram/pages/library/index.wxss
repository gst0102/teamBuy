  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #1677ff;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1;
  box-sizing: border-box;
  white-space: nowrap;
}

.topic-action-card button::after {
  border: 0;
}

.tag.active {
  background: #1677ff;
  color: #fff;
}

.delivery-filter-row {
  margin-bottom: 24rpx;
}

.type-filter-row {
  margin: 0 0 20rpx;
}

.type-chip {
