}

.card-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 10rpx;
  color: #1677ff;
  font-size: 22rpx;
  font-weight: 700;
  width: 100%;
  box-sizing: border-box;
}

