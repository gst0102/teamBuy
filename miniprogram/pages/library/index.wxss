}

.card-grid.grid-mode {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.card-grid.list-mode {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.card-grid .resource-card {
  width: 100%;
  position: relative;
  background: #ffffff;
  border: 1rpx solid #dfe7f1;
  border-radius: 24rpx;
  padding: 18rpx;
  box-shadow: 0 12rpx 32rpx rgba(23, 45, 77, 0.05);
  box-sizing: border-box;
}

.resource-hot-dot {
