.property-card-actions {
  display: grid;
  align-items: center;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 10rpx;
  width: 100%;
  box-sizing: border-box;
}

.property-card-actions.has-customer {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.property-card-actions.no-customer {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.product-card-actions.has-customer,
.product-card-actions.has-customer {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.product-card-actions.no-customer {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.product-card-actions.has-customer .property-main-action {
  grid-column: auto;
}

.property-main-action,
.property-share-action,
.property-more-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  height: 50rpx;
  margin: 0;
  padding: 0 8rpx;
  line-height: 1;
  border-radius: 8rpx;
  font-size: 21rpx;
  font-weight: 900;
  box-sizing: border-box;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.property-main-action {
  background: #e5484d;
  color: #ffffff;
}

.property-share-action {
  background: #1677ff;
  color: #ffffff;
}

.property-share-action[disabled],
.card-actions .primary-text-action[disabled] {
  background: #edf2f7;
  color: #8a95a6;
}

.property-more-action {
  background: #eef6ff;
  color: #1677ff;
}

.property-main-action.product {
  background: #ea580c;
  color: #ffffff;
}

.property-share-action.product {
  background: #f79009;
  color: #ffffff;
}

.property-more-action.product {
  background: #fff7ed;
  color: #c2410c;
}

.property-share-action.service {
  background: #1677ff;
  color: #ffffff;
}

.property-more-action.service {
  background: #eef6ff;
  color: #1677ff;
}

.property-main-action::after,
.property-share-action::after,
.property-more-action::after {
  border: 0;
}

