.library-fixed-primary text { margin-right: 7rpx; font-size: 33rpx; }
.library-fixed-primary::after, .library-fixed-secondary::after { border: 0; }

.library-filter-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 78rpx 30rpx;
  text-align: center;
}

.library-filter-empty-icon { color: #9eb0c8; font-size: 66rpx; transform: rotate(-18deg); }
.library-filter-empty-title { margin-top: 16rpx; color: #172033; font-size: 29rpx; font-weight: 900; }
.library-filter-empty-sub { margin-top: 10rpx; color: #8a95a6; font-size: 22rpx; }
.library-filter-empty-reset { display:flex; align-items:center; justify-content:center; width: 190rpx; height: 62rpx; margin-top: 26rpx; padding:0; border-radius:999rpx; background:#edf5ff; color:#176be3; font-size:23rpx; font-weight:900; line-height:1; }
.library-filter-empty-reset::after { border: 0; }

.library-first-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 2rpx 20rpx;
}

.library-loading-state,
.library-load-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 620rpx;
  color: #8490a2;
  font-size: 23rpx;
  text-align: center;
}

.library-loading-dot {
  width: 42rpx;
  height: 42rpx;
  margin-bottom: 22rpx;
  border: 5rpx solid #dce9fb;
  border-top-color: #1f78ff;
  border-radius: 999rpx;
  animation: library-loading-spin 0.8s linear infinite;
}

@keyframes library-loading-spin { to { transform: rotate(360deg); } }

.library-load-error-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 70rpx;
  border-radius: 999rpx;
  background: #fff2e8;
  color: #e2732f;
  font-size: 34rpx;
  font-weight: 900;
}

.library-load-error-title { margin-top: 24rpx; color: #172033; font-size: 29rpx; font-weight: 900; }
.library-load-error-sub { margin-top: 12rpx; color: #8a95a6; font-size: 22rpx; }
.library-retry-button { display:flex; align-items:center; justify-content:center; width:190rpx; height:62rpx; margin-top:28rpx; padding:0; border-radius:999rpx; background:#edf5ff; color:#176be3; font-size:23rpx; font-weight:900; line-height:1; }
.library-retry-button::after { border: 0; }

.library-first-illustration { position: relative; width: 230rpx; height: 190rpx; }
.empty-folder-back { position:absolute; left:35rpx; top:47rpx; width:160rpx; height:105rpx; border-radius:18rpx; background:#b8d2fa; transform:rotate(-7deg); }
.empty-folder-back::before { content:""; position:absolute; left:0; top:-20rpx; width:78rpx; height:38rpx; border-radius:14rpx 14rpx 0 0; background:#b8d2fa; }
.empty-folder-front { position:absolute; left:30rpx; top:65rpx; display:flex; align-items:center; justify-content:center; width:174rpx; height:112rpx; border-radius:18rpx; background:linear-gradient(145deg,#4f98ff,#146bed); color:#fff; transform:rotate(3deg); box-shadow:0 16rpx 28rpx rgba(32,113,232,.25); }
.empty-folder-plus { display:flex; align-items:center; justify-content:center; width:64rpx; height:64rpx; border-radius:999rpx; background:#fff; color:#1974f2; font-size:40rpx; font-weight:500; }
.empty-spark { position:absolute; color:#75aaf7; font-size:34rpx; }
.empty-spark.one { right:0; top:25rpx; }
.empty-spark.two { left:5rpx; top:20rpx; font-size:23rpx; }
.library-first-title { margin-top:28rpx; color:#111827; font-size:35rpx; font-weight:900; }
.library-first-sub { margin-top:14rpx; color:#8490a2; font-size:23rpx; text-align:center; }
.library-first-cta { display:flex; align-items:center; justify-content:center; width:285rpx; height:76rpx; margin:38rpx 0 0; padding:0; border-radius:22rpx; background:#1f78ff; color:#fff; font-size:26rpx; font-weight:900; line-height:1; box-shadow:0 12rpx 24rpx rgba(31,120,255,.2); }
.library-first-cta-icon { margin-right:8rpx; font-size:35rpx; }
.library-first-cta::after { border:0; }

.library-assistant-card,
.library-collection-empty {
  display: grid;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
}

.library-assistant-card {
  grid-template-columns: 74rpx minmax(0, 1fr) 30rpx;
  gap: 18rpx;
  margin-top: 76rpx;
  padding: 24rpx;
  border: 1rpx solid #e1e8f1;
  border-radius: 24rpx;
  background: #f8fafc;
}

.library-assistant-icon { display:flex; align-items:center; justify-content:center; width:74rpx; height:74rpx; border-radius:22rpx; background:#2acb68; color:#fff; font-size:26rpx; font-weight:900; }
.library-assistant-copy { min-width:0; }
.library-assistant-title { color:#172033; font-size:26rpx; font-weight:900; }
.library-assistant-chip { display:inline-flex; align-items:center; height:31rpx; margin-left:10rpx; padding:0 10rpx; border-radius:999rpx; background:#e8f2ff; color:#1770ec; font-size:17rpx; vertical-align:middle; }
.library-assistant-desc { display:block; margin-top:8rpx; color:#7f8b9d; font-size:21rpx; }
.library-assistant-arrow { color:#9aa5b4; font-size:39rpx; }

.library-collection-empty { grid-template-columns:54rpx minmax(0,1fr) 26rpx; gap:16rpx; margin-top:18rpx; padding:25rpx 20rpx; border:1rpx solid #e8edf3; border-radius:22rpx; background:#fff; }
.collection-empty-icon { display:flex; align-items:center; justify-content:center; width:54rpx; height:54rpx; border-radius:16rpx; background:#eff4fa; color:#758399; font-size:27rpx; }
.collection-empty-title { display:block; color:#172033; font-size:24rpx; font-weight:900; }
.collection-empty-desc { display:block; margin-top:6rpx; color:#8a95a6; font-size:20rpx; }
.collection-empty-arrow { color:#a1abba; font-size:34rpx; }

.library-filter-mask {
  position: fixed;
  z-index: 1100;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: flex-end;
  padding: 0;
  background: rgba(15, 23, 42, 0.46);
  box-sizing: border-box;
}

.library-filter-sheet {
  width: 100%;
  max-height: 88vh;
  overflow-y: auto;
  padding: 28rpx 32rpx calc(30rpx + env(safe-area-inset-bottom));
  border-radius: 34rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.library-filter-sheet-handle { width: 96rpx; height: 10rpx; margin: 0 auto 24rpx; border-radius: 999rpx; background: #d8dee8; }
.library-filter-sheet-head { display:flex; align-items:flex-start; justify-content:space-between; color:#172033; font-size:34rpx; font-weight:900; line-height:1.2; }
.library-filter-sheet-sub { margin-top: 10rpx; color: #7b8798; font-size: 23rpx; font-weight: 500; line-height: 1.4; }
.library-filter-close { display:flex; align-items:center; justify-content:center; width:54rpx; height:54rpx; border-radius:999rpx; background:#f1f4f8; color:#7f8999; font-size:34rpx; }
.library-filter-current { display:flex; align-items:center; justify-content:space-between; gap:16rpx; margin-top:24rpx; padding:22rpx 24rpx; border:1rpx solid #e4eaf2; border-radius:22rpx; background:#fbfcfe; }
.library-filter-current-label { color:#172033; font-size:25rpx; font-weight:800; }
.library-filter-current-value { padding:11rpx 18rpx; border-radius:999rpx; background:#e5f1ff; color:#176fe9; font-size:22rpx; font-weight:900; white-space:nowrap; }
.library-filter-label { margin-top:26rpx; color:#344054; font-size:25rpx; font-weight:900; }
.library-filter-chips { display:flex; flex-wrap:wrap; gap:12rpx; margin-top:14rpx; }
.library-filter-chip { display:flex; align-items:center; justify-content:center; min-width:104rpx; min-height:58rpx; padding:0 20rpx; border:1rpx solid #e8edf3; border-radius:17rpx; background:#ffffff; color:#344054; font-size:23rpx; font-weight:700; white-space:nowrap; box-sizing:border-box; }
.library-filter-chip.active { border-color:#1677ff; background:#1677ff; color:#ffffff; }
.library-filter-tag-search { display:flex; align-items:center; height:68rpx; margin-top:14rpx; padding:0 20rpx; border:1rpx solid #e5eaf1; border-radius:18rpx; background:#ffffff; box-sizing:border-box; }
.library-filter-tag-search-icon { margin-right:12rpx; color:#9aa7b9; font-size:35rpx; transform:rotate(-18deg); }
.library-filter-tag-search input { flex:1; min-width:0; height:64rpx; color:#172033; font-size:23rpx; }
.library-filter-all-tags { display:block; margin-top:16rpx; color:#1677ff; font-size:22rpx; font-weight:800; }
.library-filter-actions { display:grid; grid-template-columns:1fr 1fr; gap:16rpx; margin-top:30rpx; }
.library-filter-reset,.library-filter-apply { display:flex; align-items:center; justify-content:center; width:100%; min-width:0; height:68rpx; margin:0; padding:0; border-radius:18rpx; background:#f0f4f9; color:#627086; font-size:24rpx; font-weight:900; line-height:1; box-sizing:border-box; }
.library-filter-apply { background:#1f78ff; color:#fff; }
.library-filter-reset::after,.library-filter-apply::after { border:0; }

.bind-guide-mask { position:fixed; z-index:1200; left:0; right:0; top:0; bottom:0; display:flex; align-items:flex-end; padding:28rpx; background:rgba(15,23,42,.48); box-sizing:border-box; }
.bind-guide-sheet { width:100%; max-height:86vh; overflow-y:auto; padding:30rpx 30rpx calc(30rpx + env(safe-area-inset-bottom)); border-radius:30rpx; background:#fff; box-sizing:border-box; }
.bind-guide-head { display:flex; align-items:flex-start; justify-content:space-between; gap:24rpx; }
.bind-guide-kicker { color:#1677ff; font-size:22rpx; font-weight:900; }
.bind-guide-title { margin-top:8rpx; color:#111827; font-size:34rpx; font-weight:900; }
.bind-guide-close { display:flex; align-items:center; justify-content:center; width:58rpx; height:58rpx; border-radius:999rpx; background:#f3f6fb; color:#6b7280; font-size:38rpx; }
.bind-guide-qr { display:flex; align-items:center; justify-content:center; margin-top:24rpx; padding:20rpx; border-radius:24rpx; background:#f8fbff; }
.bind-guide-qr-image { width:300rpx; height:300rpx; border-radius:18rpx; background:#fff; }
.bind-guide-code { margin-top:24rpx; padding:22rpx; border:1rpx solid #cfe2ff; border-radius:20rpx; background:#f5f9ff; }
.bind-guide-code-label { color:#667085; font-size:21rpx; font-weight:800; }
.bind-guide-code-text { margin-top:10rpx; color:#111827; font-size:28rpx; font-weight:900; line-height:1.45; word-break:break-all; }
.bind-guide-steps { margin-top:24rpx; }
.bind-guide-step { display:grid; grid-template-columns:46rpx minmax(0,1fr); gap:16rpx; padding:18rpx 0; border-bottom:1rpx solid #edf1f7; }
.bind-guide-step-index { display:flex; align-items:center; justify-content:center; width:46rpx; height:46rpx; border-radius:999rpx; background:#1677ff; color:#fff; font-size:22rpx; font-weight:900; }
.bind-guide-step-title { color:#111827; font-size:26rpx; font-weight:900; }
.bind-guide-step-desc { margin-top:6rpx; color:#667085; font-size:22rpx; line-height:1.45; }
.bind-guide-actions { display:flex; justify-content:center; gap:22rpx; margin-top:26rpx; }
.bind-guide-primary,.bind-guide-secondary { display:flex; align-items:center; justify-content:center; min-width:176rpx; height:72rpx; margin:0; padding:0 25rpx; border-radius:999rpx; font-size:25rpx; font-weight:900; line-height:1; box-sizing:border-box; }
.bind-guide-primary { background:#1677ff; color:#fff; }
.bind-guide-secondary { background:#edf5ff; color:#1677ff; }
.bind-guide-primary::after,.bind-guide-secondary::after { border:0; }
.bind-guide-foot { margin-top:18rpx; color:#98a2b3; font-size:21rpx; line-height:1.45; text-align:center; }

