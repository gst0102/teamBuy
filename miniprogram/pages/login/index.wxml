<view class="login-page">
  <custom-nav title="登录" />

  <view class="hero">
    <view class="hero-kicker">资料整理助手</view>
    <view class="hero-title">把资料变成你的客户 SCRM</view>
    <view class="hero-subtitle">资料发出去后，客户打开、咨询、留资和跟进状态都沉淀到你的账号里。</view>
  </view>

  <view class="preview-panel">
    <view class="preview-head">
      <view>
        <view class="preview-title">客户线索自动沉淀</view>
        <view class="preview-sub">谁看过、谁咨询、谁要跟进，都能回到你的客户池</view>
      </view>
      <view class="preview-badge">微信官方隔离</view>
    </view>
    <view class="mini-card">
      <image wx:if="{{!loginCoverFailed}}" class="mini-cover" src="/static/workspace/login-room.jpg" mode="aspectFill" binderror="handleLoginCoverError"></image>
      <view wx:else class="mini-cover mini-cover-fallback">资</view>
      <view class="mini-body">
        <view class="mini-name">客户 SCRM</view>
        <view class="mini-meta">打开记录 / 留资 / 跟进</view>
        <view class="mini-contact">客户看到的是你的版本</view>
      </view>
      <view class="mini-map">
        <view class="map-road road-main"></view>
        <view class="map-road road-left"></view>
        <view class="map-road road-right"></view>
        <view class="map-pin"><view></view></view>
        <view class="map-pill">导航</view>
      </view>
    </view>
    <view class="feature-row">
      <view class="feature-item">
        <view>资料获客</view>
      </view>
      <view class="feature-item">
        <view>客户雷达</view>
      </view>
      <view class="feature-item">
        <view>线索跟进</view>
      </view>
      <view class="feature-item">
        <view>成交复盘</view>
      </view>
    </view>
  </view>

  <view class="login-panel">
    <view class="login-title">登录后保存到你的账号</view>
    <view class="login-desc">用于生成你的资料页、查看客户线索，下次打开还能继续跟进。</view>
    <view class="legal-agree-row" bindtap="handleToggleLegalAgree">
      <view class="legal-checkbox {{legalAgreed ? 'checked' : ''}}">{{legalAgreed ? '✓' : ''}}</view>
      <view class="legal-copy">
        我已阅读并同意
        <text catchtap="handleOpenTerms">《用户服务协议》</text>
        和
        <text catchtap="handleOpenPrivacy">《隐私政策》</text>
      </view>
    </view>
    <button class="wechat-btn" loading="{{loggingIn}}" disabled="{{loggingIn}}" bindtap="handleWechatLogin">微信一键登录</button>
    <button wx:if="{{allowMockLogin}}" class="mock-btn" loading="{{loggingIn}}" disabled="{{loggingIn}}" bindtap="handleMockLogin">便捷登录</button>
  </view>
</view>
