<view class="page-shell" wx:if="{{card}}">
  <custom-nav title="&#x7EBF;&#x7D22;&#x7BA1;&#x7406;" showBack="{{true}}" />

  <view class="manager-hero">
    <view>
      <view class="hero-title">访问详情</view>
      <view class="hero-subtitle">查看访客、接龙名单和跟进状态。</view>
    </view>
    <view class="manager-visual">线索</view>
  </view>

  <view class="panel">
    <view class="manager-card-head">
      <view>
        <view class="section-title">{{card.title}}</view>
        <view class="muted">{{card.projectName || '未设置项目名'}} ｜ {{card.status}}</view>
      </view>
      <button class="mini-btn" bindtap="handleOpenCard">查看</button>
    </view>
    <view class="stat-grid manager-stats">
      <view class="stat-item">
        <view class="stat-icon blue">PV</view>
        <text class="stat-value">{{stats.pv || 0}}</text>
        <text class="stat-label">总访问</text>
      </view>
      <view class="stat-item">
        <view class="stat-icon green">UV</view>
        <text class="stat-value">{{stats.uv || 0}}</text>
        <text class="stat-label">访客</text>
      </view>
      <view class="stat-item">
        <view class="stat-icon orange">匿</view>
        <text class="stat-value">{{summary.anonymousPv}}</text>
        <text class="stat-label">匿名PV</text>
      </view>
      <view class="stat-item">
        <view class="stat-icon purple">接</view>
        <text class="stat-value">{{summary.relayCount}}</text>
        <text class="stat-label">接龙</text>
      </view>
    </view>
    <view class="manager-actions">
      <button class="ghost-btn" bindtap="handleEditCard">编辑资源</button>
      <button class="ghost-btn" bindtap="handleDuplicate">一键复用</button>
    </view>
  </view>

  <view class="panel leads-panel">
    <view class="section-head">
      <view>
        <view class="section-title">接龙名单</view>
        <view class="muted">按跟进状态处理线索</view>
      </view>
      <view class="section-link">{{summary.pendingFollow}} 个待跟进</view>
    </view>
    <view class="relay-filter-row">
      <view class="relay-filter {{relayFilter === 'pending' ? 'active' : ''}}" data-filter="pending" bindtap="handleRelayFilterChange">待跟进 {{pendingRelays.length}}</view>
      <view class="relay-filter {{relayFilter === 'followed' ? 'active' : ''}}" data-filter="followed" bindtap="handleRelayFilterChange">已跟进 {{followedRelays.length}}</view>
      <view class="relay-filter {{relayFilter === 'all' ? 'active' : ''}}" data-filter="all" bindtap="handleRelayFilterChange">全部 {{relays.length}}</view>
    </view>
    <relay-list relays="{{filteredRelays}}" isOwner="{{true}}" bind:delete="handleDelete" bind:follow="handleFollow" />
    <view class="empty-state compact" wx:if="{{!filteredRelays.length}}">{{relayFilterEmptyText}}</view>
  </view>

  <view class="panel">
    <view class="section-head">
      <view>
        <view class="section-title">已登录访客</view>
        <view class="muted">重复访问但未接龙的访客会标记为高意向</view>
      </view>
      <view class="section-link">{{summary.highIntentViewers}} 个高意向</view>
    </view>
    <view class="viewer-filter-row">
      <view class="viewer-filter {{viewerFilter === 'intent' ? 'active' : ''}}" data-filter="intent" bindtap="handleViewerFilterChange">高意向 {{highIntentViewers.length}}</view>
      <view class="viewer-filter {{viewerFilter === 'recent' ? 'active' : ''}}" data-filter="recent" bindtap="handleViewerFilterChange">最近 {{viewers.length}}</view>
      <view class="viewer-filter {{viewerFilter === 'all' ? 'active' : ''}}" data-filter="all" bindtap="handleViewerFilterChange">全部 {{viewers.length}}</view>
    </view>
    <block wx:for="{{filteredViewers}}" wx:key="userId">
      <view class="viewer-row {{item.isHighIntent ? 'high-intent' : ''}}">
        <image class="avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image>
        <view class="viewer-main">
          <view class="viewer-name-row">
            <view class="viewer-name">{{item.nickname}}</view>
            <view class="viewer-badge {{item.isHighIntent ? 'intent' : item.hasRelay ? 'relay' : ''}}">{{item.intentText}}</view>
          </view>
          <view class="muted">查看 {{item.viewCount}} 次，最近 {{item.viewedText}}</view>
        </view>
        <view class="viewer-time">{{item.viewedText}}</view>
      </view>
    </block>
    <view class="empty-state compact" wx:if="{{!filteredViewers.length}}">{{viewerFilterEmptyText}}</view>
  </view>

</view>
