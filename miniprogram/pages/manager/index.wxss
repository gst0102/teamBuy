.manager-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 0 24rpx;
}

.manager-visual {
  width: 176rpx;
  height: 176rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #dcebff, #ffffff);
  color: #1677ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 900;
  box-shadow: 0 18rpx 46rpx rgba(31, 88, 168, 0.12);
}

.manager-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.mini-btn {
  width: 120rpx;
  height: 58rpx;
  line-height: 58rpx;
  border-radius: 999rpx;
  background: #edf5ff;
  color: #1677ff;
  font-size: 24rpx;
}

.manager-stats {
  margin-top: 26rpx;
}

.stat-icon.blue {
  background: linear-gradient(135deg, #368cff, #0066ff);
}

.stat-icon.green {
  background: linear-gradient(135deg, #44d58a, #12b76a);
}

.stat-icon.orange {
  background: linear-gradient(135deg, #ffb24a, #ff7a1a);
}

.stat-icon.purple {
  background: linear-gradient(135deg, #8b7cff, #6845f5);
}

.manager-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.manager-actions button {
  flex: 1;
}

.leads-panel {
  border: 1rpx solid #ffd29a;
  background: linear-gradient(180deg, #fffaf2, #ffffff);
}

.relay-filter-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 20rpx;
  margin-bottom: 10rpx;
  padding: 8rpx;
  border-radius: 24rpx;
  background: #f3f7ff;
}

.relay-filter {
  height: 62rpx;
  line-height: 62rpx;
  border-radius: 18rpx;
  color: #667085;
  font-size: 24rpx;
  font-weight: 800;
  text-align: center;
}

.relay-filter.active {
  background: #1677ff;
  color: #fff;
  box-shadow: 0 12rpx 26rpx rgba(22, 119, 255, 0.18);
}

.viewer-filter-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 20rpx;
  margin-bottom: 8rpx;
  padding: 8rpx;
  border-radius: 24rpx;
  background: #f6f8fb;
}

.viewer-filter {
  height: 62rpx;
  line-height: 62rpx;
  border-radius: 18rpx;
  color: #667085;
  font-size: 24rpx;
  font-weight: 800;
  text-align: center;
}

.viewer-filter.active {
  background: #172033;
  color: #fff;
  box-shadow: 0 12rpx 26rpx rgba(23, 32, 51, 0.16);
}

.viewer-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #edf2f8;
}

.viewer-row.high-intent {
  margin: 16rpx 0;
  padding: 22rpx;
  border: 1rpx solid #ffd29a;
  border-radius: 24rpx;
  background: #fffaf2;
}

.viewer-row:last-child {
  border-bottom: none;
}

.avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  background: #edf5ff;
}

.avatar.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #ffffff;
  background: linear-gradient(135deg, #1677ff, #20c997);
  font-size: 28rpx;
  font-weight: 900;
}

.viewer-main {
  flex: 1;
  margin-left: 18rpx;
}

.viewer-name {
  font-size: 28rpx;
  font-weight: 900;
}

.viewer-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.viewer-badge {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #edf5ff;
  color: #1677ff;
  font-size: 20rpx;
  font-weight: 800;
}

.viewer-badge.intent {
  background: #fff1df;
  color: #f97316;
}

.viewer-badge.relay {
  background: #dcfae6;
  color: #079455;
}

.viewer-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.viewer-note-input {
  width: 100%;
  min-height: 64rpx;
  box-sizing: border-box;
  margin-top: 14rpx;
  padding: 0 20rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid #edf2f8;
  color: #172033;
  font-size: 24rpx;
}

.viewer-action {
  margin: 0;
  padding: 0 18rpx;
  height: 54rpx;
  line-height: 54rpx;
  border-radius: 999rpx;
  background: #edf5ff;
  color: #1677ff;
  font-size: 22rpx;
  font-weight: 800;
}

.viewer-action.primary {
  background: #172033;
  color: #fff;
}

.viewer-action.done {
  background: #dcfae6;
  color: #079455;
}

.viewer-action.danger {
  background: #fff1f3;
  color: #e5484d;
}

.viewer-action::after {
  border: none;
}

.viewer-time {
  color: #8a96a8;
  font-size: 24rpx;
}
