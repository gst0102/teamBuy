.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(132rpx + env(safe-area-inset-bottom));
  background: #eef6ff;
  color: #172033;
  box-sizing: border-box;
}

.thread-head {
  margin-bottom: 18rpx;
  padding: 22rpx;
  border-radius: 8rpx;
  background: #ffffff;
}

.page-home-entry {
  margin: 0 0 18rpx;
}

.home-link {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 64rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid #c9d8ef;
  border-radius: 8rpx;
  background: #ffffff;
  color: #1677ff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
  box-sizing: border-box;
}

.home-link::after {
  border: 0;
}

.title {
  font-size: 30rpx;
  font-weight: 900;
}

.subtitle {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 24rpx;
}

.radar-link {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 64rpx;
  margin: 18rpx 0 0;
  padding: 0;
  border: 1rpx solid #bfe3ce;
  border-radius: 8rpx;
  background: #effaf3;
  color: #11924d;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
  box-sizing: border-box;
}

.radar-link::after {
  border: 0;
}

.message-list {
  max-height: calc(100vh - 260rpx);
}

.message-row {
  display: flex;
  align-items: flex-start;
  justify-content: flex-start;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.message-row.mine {
  justify-content: flex-end;
}

.mine .avatar {
  order: 2;
}

.mine .message-main {
  order: 1;
}

.avatar {
  flex: 0 0 auto;
  width: 72rpx;
  height: 72rpx;
  border-radius: 8rpx;
  background: #dbe5f2;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #11924d;
  font-size: 28rpx;
  font-weight: 900;
}

.message-main {
  max-width: 74%;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.mine .message-main {
  align-items: flex-end;
}

.sender-name {
  margin: 0 0 8rpx;
  color: #94a3b8;
  font-size: 22rpx;
  line-height: 1.2;
}

.bubble {
  padding: 18rpx 20rpx;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(15, 23, 42, 0.05);
}

.mine .bubble {
  background: #95ec69;
}

.bubble text {
  display: block;
  color: #172033;
  font-size: 27rpx;
  line-height: 1.45;
  word-break: break-all;
}

.bubble view {
  margin-top: 8rpx;
  color: #94a3b8;
  font-size: 21rpx;
  text-align: right;
}

.mine .bubble view {
  color: rgba(23, 32, 51, 0.48);
}

.composer {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 12rpx;
  padding: 14rpx;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 -6rpx 22rpx rgba(15, 23, 42, 0.08);
  box-sizing: border-box;
}

.composer input {
  flex: 1;
  height: 72rpx;
  min-width: 0;
  padding: 0 18rpx;
  border-radius: 8rpx;
  background: #f8fafc;
  font-size: 26rpx;
  box-sizing: border-box;
}

.composer button {
  flex: 0 0 132rpx;
  height: 72rpx;
  line-height: 72rpx;
  margin: 0;
  border-radius: 8rpx;
  background: #11924d;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 900;
}

.composer button::after {
  border: 0;
}

.empty {
  padding: 56rpx 20rpx;
  border-radius: 8rpx;
  background: #ffffff;
  color: #94a3b8;
  text-align: center;
}
