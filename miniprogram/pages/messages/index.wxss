.page {
  min-height: 100vh;
  padding: 24rpx;
  background: #eef6ff;
  color: #172033;
  box-sizing: border-box;
}

.summary {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.summary view {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 22rpx;
  border-radius: 8rpx;
  background: #ffffff;
  text-align: center;
}

.summary text:first-child {
  font-size: 36rpx;
  font-weight: 900;
}

.summary text:last-child {
  color: #64748b;
  font-size: 23rpx;
}

.thread-card {
  position: relative;
  display: flex;
  gap: 18rpx;
  margin-bottom: 16rpx;
  padding: 20rpx;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.cover {
  flex-shrink: 0;
  width: 108rpx;
  height: 108rpx;
  border-radius: 8rpx;
  background: #e8eef7;
}

.cover.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #11924d;
  font-weight: 900;
}

.thread-main {
  flex: 1;
  min-width: 0;
}

.topline {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.title {
  color: #172033;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.3;
}

.time {
  flex-shrink: 0;
  color: #94a3b8;
  font-size: 22rpx;
}

.subtitle,
.last {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.last {
  color: #334155;
}

.unread {
  position: absolute;
  right: 18rpx;
  bottom: 18rpx;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: #ef4444;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 36rpx;
  text-align: center;
  box-sizing: border-box;
}

.empty {
  margin-top: 40rpx;
  padding: 56rpx 20rpx;
  border-radius: 8rpx;
  background: #ffffff;
  color: #94a3b8;
  text-align: center;
}
