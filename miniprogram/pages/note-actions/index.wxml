<view class="page">
  <view class="summary-band">
    <view>
      <text>{{isProductRelay ? summary.orderIntent : summary.total}}</text>
      <text>{{isProductRelay ? '下单' : '客户动作'}}</text>
    </view>
    <view>
      <text>{{summary.leadContact}}</text>
      <text>留资</text>
    </view>
    <view>
      <text>{{summary.appointment}}</text>
      <text>预约</text>
    </view>
    <view class="{{summary.pending ? 'warn' : ''}}">
      <text>{{summary.pending}}</text>
      <text>待跟进</text>
    </view>
  </view>

  <view class="section" wx:if="{{isProductRelay}}">
    <view class="section-title">{{productListTitle}}</view>
    <view class="sku-filter-row" wx:if="{{skuFilters.length > 1}}">
      <text class="sku-filter {{!selectedSkuFilter ? 'active' : ''}}" data-key="" bindtap="handleSkuFilter">全部 {{relayActions.length}}</text>
      <block wx:for="{{skuFilters}}" wx:key="key">
        <text class="sku-filter {{selectedSkuFilter === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="handleSkuFilter">{{item.label}} {{item.count}}</text>
      </block>
    </view>
    <button class="plain-btn summary-copy-btn" wx:if="{{filteredRelayActions.length}}" bindtap="handleCopyRelaySummary">复制汇总</button>
    <view class="empty" wx:if="{{!loading && !filteredRelayActions.length}}">{{selectedSkuFilter ? '当前规格暂无记录' : productEmptyText}}</view>
    <block wx:for="{{filteredRelayActions}}" wx:key="id">
      <view class="action-item">
        <view class="item-head">
          <view class="relay-person">
            <image class="relay-avatar" wx:if="{{item.customerAvatarUrl || item.payload.avatarUrl}}" src="{{item.customerAvatarUrl || item.payload.avatarUrl}}" mode="aspectFill" />
            <view class="relay-main">
              <view class="item-title">{{item.customerName}}</view>
              <view class="item-time">{{item.createdText}}</view>
            </view>
          </view>
          <view class="status-pill">{{item.actionKey === 'relay-intent' ? '已接龙' : '已下单'}}</view>
        </view>
        <view class="detail-lines">
          <text wx:for="{{item.details}}" wx:key="*this">{{item}}</text>
        </view>
        <view class="relay-buttons">
          <button class="plain-btn" data-index="{{index}}" bindtap="handleCopyRelay">复制这条</button>
          <button class="plain-btn" wx:if="{{item.payload.phone}}" data-value="{{item.payload.phone}}" bindtap="handleCopyContact">复制电话</button>
          <button class="plain-btn" wx:if="{{item.payload.wechat}}" data-value="{{item.payload.wechat}}" bindtap="handleCopyContact">复制微信</button>
          <button class="plain-btn" wx:if="{{item.payload.phone}}" data-phone="{{item.payload.phone}}" bindtap="handleCallPhone">拨号</button>
          <message-entry variant="pill" title="发消息" desc="" note-id="{{noteId}}" order-action-id="{{item.id}}" />
        </view>
      </view>
    </block>
  </view>

  <block wx:if="{{!isProductRelay}}">
  <view class="section">
    <view class="section-title">新线索 / 待跟进</view>
    <view class="empty" wx:if="{{!loading && !pendingLeads.length}}">暂无待跟进线索</view>
    <block wx:for="{{pendingLeads}}" wx:key="id">
      <view class="lead-item hot" data-id="{{item.id}}" bindtap="handleOpenLead">
        <view class="item-head">
          <view>
            <view class="item-title">{{item.nickname}}</view>
            <view class="item-time">更新 {{item.updatedText}}</view>
          </view>
          <view class="status-pill">{{item.statusText}}</view>
        </view>
        <view class="lead-meta">
          <view class="phone-row" wx:if="{{item.customerPhone}}">
            <text>电话 {{item.customerPhone}}</text>
            <text class="call-action" data-id="{{item.id}}" data-phone="{{item.customerPhone}}" catchtap="handleCallPhone">拨号</text>
          </view>
          <text wx:if="{{item.customerWechat}}">微信 {{item.customerWechat}}</text>
          <text>跟进 {{item.nextFollowUpText}}</text>
        </view>
      </view>
    </block>
  </view>

  <view class="section">
    <view class="section-title">预约看房</view>
    <view class="empty" wx:if="{{!loading && !appointmentActions.length}}">暂无预约</view>
    <block wx:for="{{appointmentActions}}" wx:key="id">
      <view class="action-item">
        <view class="item-head">
          <view>
            <view class="item-title">{{item.title}}</view>
            <view class="item-time">{{item.createdText}}</view>
          </view>
        </view>
        <view class="detail-lines">
          <text wx:for="{{item.details}}" wx:key="*this">{{item}}</text>
        </view>
        <button class="plain-btn" wx:if="{{item.leadReminderId}}" data-id="{{item.leadReminderId}}" bindtap="handleOpenLead">查看线索详情</button>
      </view>
    </block>
  </view>
  </block>

  <block wx:if="{{!isProductRelay}}">
  <view class="section">
    <view class="section-title">已联系 / 已归档</view>
    <view class="empty" wx:if="{{!loading && !finishedLeads.length}}">暂无已处理线索</view>
    <block wx:for="{{finishedLeads}}" wx:key="id">
      <view class="lead-item" data-id="{{item.id}}" bindtap="handleOpenLead">
        <view class="item-head">
          <view>
            <view class="item-title">{{item.nickname}}</view>
            <view class="item-time">更新 {{item.updatedText}}</view>
          </view>
          <view class="status-pill">{{item.statusText}}</view>
        </view>
        <view class="lead-meta">
          <view class="phone-row" wx:if="{{item.customerPhone}}">
            <text>电话 {{item.customerPhone}}</text>
            <text class="call-action" data-id="{{item.id}}" data-phone="{{item.customerPhone}}" catchtap="handleCallPhone">拨号</text>
          </view>
          <text wx:if="{{item.customerWechat}}">微信 {{item.customerWechat}}</text>
          <text>跟进 {{item.nextFollowUpText}}</text>
        </view>
      </view>
    </block>
  </view>

  <view class="section">
    <view class="section-title">全部客户动作</view>
    <view class="empty" wx:if="{{!loading && !otherActions.length}}">暂无其他动作</view>
    <block wx:for="{{otherActions}}" wx:key="id">
      <view class="action-item">
        <view class="item-head">
          <view>
            <view class="item-title">{{item.title}}</view>
            <view class="item-time">{{item.createdText}}</view>
          </view>
        </view>
        <view class="detail-lines">
          <text wx:for="{{item.details}}" wx:key="*this">{{item}}</text>
        </view>
        <button class="plain-btn" wx:if="{{item.leadReminderId}}" data-id="{{item.leadReminderId}}" bindtap="handleOpenLead">查看线索详情</button>
      </view>
    </block>
  </view>
  </block>
</view>
