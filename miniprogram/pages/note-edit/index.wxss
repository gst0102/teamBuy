.page-shell {
  min-height: 100vh;
  padding: 0 28rpx 48rpx;
  background: #f6f8fb;
  box-sizing: border-box;
}

.form-panel,
.media-panel {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 8rpx;
  background: #fff;
}

.bookmark-article {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 8rpx;
  background: #fff;
}

.bookmark-cover {
  width: 100%;
  height: 300rpx;
  border-radius: 8rpx;
  background: #e8eef7;
}

.bookmark-cover.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1677ff;
  font-size: 58rpx;
  font-weight: 900;
}

.bookmark-source {
  margin-top: 18rpx;
  color: #6f7d91;
  font-size: 24rpx;
}

.bookmark-title {
  margin-top: 10rpx;
  color: #172033;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.35;
}

.bookmark-summary {
  margin-top: 12rpx;
  color: #5f6d80;
  font-size: 26rpx;
  line-height: 1.5;
}

.bookmark-info {
  display: grid;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 18rpx;
  border-radius: 8rpx;
  background: #f6f8fb;
}

.bookmark-info view {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  color: #172033;
  font-size: 24rpx;
}

.bookmark-info text:first-child {
  color: #6f7d91;
}

.bookmark-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.bookmark-tags text {
  padding: 6rpx 14rpx;
  border-radius: 6rpx;
  background: #fff4e6;
  color: #a25800;
  font-size: 22rpx;
  font-weight: 700;
}

.bookmark-buttons {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 22rpx;
}

.workbench-hero,
.note-hero {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 8rpx;
  background: #ffffff;
  overflow: hidden;
}

.workbench-hero {
  border-left: 8rpx solid #11924d;
}

.workbench-hero.groupbuy {
  border-left-color: #d97706;
}

.hero-topline,
.note-type-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  color: #6f7d91;
  font-size: 23rpx;
}

.hero-topline text:first-child {
  color: #11924d;
  font-weight: 900;
}

.workbench-hero.groupbuy .hero-topline text:first-child {
  color: #d97706;
}

.hero-title,
.note-hero-title {
  margin-top: 14rpx;
  color: #172033;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.25;
}

.hero-subtitle,
.note-hero-summary {
  margin-top: 10rpx;
  color: #4b5565;
  font-size: 27rpx;
  line-height: 1.5;
}

.miniapp-panel {
  margin-top: 20rpx;
  padding: 22rpx;
  border: 1rpx solid #d6e6ff;
  border-radius: 8rpx;
  background: #f7fbff;
}

.miniapp-mark {
  display: inline-flex;
  padding: 6rpx 14rpx;
  border-radius: 6rpx;
  background: #e8f1ff;
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 900;
}

.miniapp-title {
  margin-top: 14rpx;
  color: #172033;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.35;
}

.miniapp-source,
.miniapp-code {
  margin-top: 8rpx;
  color: #5f6d80;
  font-size: 25rpx;
  line-height: 1.45;
}

.miniapp-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 18rpx;
}

.miniapp-actions button {
  height: 72rpx;
  padding: 0;
  border-radius: 8rpx;
  background: #e8f1ff;
  color: #2563eb;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 72rpx;
}

.miniapp-actions button + button {
  background: #e8f7ef;
  color: #11924d;
}

.ocr-panel {
  margin-top: 20rpx;
  padding: 22rpx;
  border: 1rpx solid #dbe5f0;
  border-radius: 8rpx;
  background: #ffffff;
}

.ocr-head {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 210rpx;
  gap: 18rpx;
  align-items: center;
}

.ocr-mark {
  display: inline-flex;
  padding: 6rpx 14rpx;
  border-radius: 6rpx;
  background: #eef2ff;
  color: #334db5;
  font-size: 22rpx;
  font-weight: 900;
}

.ocr-title {
  margin-top: 12rpx;
  color: #172033;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.35;
}

.ocr-hint {
  margin-top: 8rpx;
  color: #5f6d80;
  font-size: 24rpx;
  line-height: 1.45;
}

.ocr-action {
  height: 78rpx;
  margin: 0;
  padding: 0 12rpx;
  border-radius: 8rpx;
  background: #172033;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 78rpx;
}

.ocr-meta {
  display: grid;
  gap: 8rpx;
  margin-top: 16rpx;
  color: #6f7d91;
  font-size: 23rpx;
  line-height: 1.45;
}

.ocr-text {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 8rpx;
  background: #f6f8fb;
  color: #172033;
  font-size: 25rpx;
  line-height: 1.55;
  white-space: pre-wrap;
}

.hero-actions,
.suggest-actions,
.feature-grid {
  display: grid;
  gap: 14rpx;
  margin-top: 24rpx;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: stretch;
  width: 100%;
}

.hero-actions button,
.suggest-actions button,
.feature-grid button,
.text-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  min-height: 72rpx;
  line-height: 1.18;
  margin: 0;
  padding: 0 8rpx;
  border-radius: 8rpx;
  background: #eef6f1;
  color: #157347;
  font-size: 24rpx;
  font-weight: 800;
  min-width: 0;
  box-sizing: border-box;
  white-space: nowrap;
}

.hero-actions .hero-action-btn {
  flex: 1 1 188rpx;
  width: auto;
  min-width: 0;
  height: 86rpx;
  min-height: 86rpx;
  padding: 0 10rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.hero-action-btn text {
  display: block;
  width: 100%;
  line-height: 1.2;
  text-align: center;
  white-space: normal;
  word-break: keep-all;
}

.hero-actions button::after,
.suggest-actions button::after,
.feature-grid button::after,
.text-btn::after {
  border: 0;
}

@media screen and (max-width: 360px) {
  .hero-actions {
    gap: 10rpx;
  }

  .hero-actions button {
    height: 82rpx;
    min-height: 82rpx;
    padding: 0 4rpx;
    font-size: 23rpx;
  }
}

.hero-weak-actions {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.poster-weak-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: fit-content;
  min-width: 176rpx;
  height: 58rpx;
  margin: 0;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #6f7d91;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
  box-sizing: border-box;
  white-space: nowrap;
}

.suggest-actions {
  grid-template-columns: repeat(3, 1fr);
}

.feature-grid {
  grid-template-columns: repeat(2, 1fr);
}

.feature-grid button {
  background: #f6f8fb;
  color: #5f6d80;
}

.feature-grid button.active {
  background: #e8f7ef;
  color: #11924d;
}

.block-panel {
  overflow: hidden;
}

.block-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.block-head .section-title {
  margin-bottom: 4rpx;
}

.text-btn {
  width: 112rpx;
  flex-shrink: 0;
  background: #e8f7ef;
  color: #11924d;
  font-size: 24rpx;
}

.media-head-actions {
  display: flex;
  flex-shrink: 0;
  gap: 10rpx;
}

.media-head-actions .text-btn {
  width: 104rpx;
}

.media-head-actions .upload-btn {
  background: #e8f7ef;
  color: #11924d;
}

.hidden-tip,
.empty-line {
  padding: 18rpx;
  border-radius: 8rpx;
  background: #f6f8fb;
  color: #6f7d91;
  font-size: 25rpx;
}

.open-btn,
.organize-btn {
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: 800;
}

.open-btn {
  background: #1677ff;
  color: #fff;
}

.organize-btn {
  background: #fff4e6;
  color: #a25800;
}

.template-bar {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 8rpx;
  background: #fff;
}

.type-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 8rpx;
  background: #fff;
}

.type-label {
  color: #172033;
  font-size: 30rpx;
  font-weight: 900;
}

.type-desc {
  margin-top: 6rpx;
  color: #6f7d91;
  font-size: 23rpx;
  line-height: 1.45;
}

.organize-btn.compact {
  width: 156rpx;
  flex-shrink: 0;
  background: #11924d;
  color: #fff;
}

.typed-form .field + .field {
  margin-top: 20rpx;
}

.template-label {
  color: #172033;
  font-size: 28rpx;
  font-weight: 900;
}

.template-desc {
  margin-top: 6rpx;
  color: #6f7d91;
  font-size: 22rpx;
}

.template-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.template-tag {
  padding: 8rpx 14rpx;
  border-radius: 8rpx;
  background: #eaf3ff;
  color: #1677ff;
  font-size: 22rpx;
  font-weight: 700;
}

.field + .field {
  margin-top: 18rpx;
}

.field {
  padding: 18rpx;
  border: 1rpx solid #e3e8f0;
  border-radius: 8rpx;
  background: #fbfcfe;
}

.section-title {
  margin-bottom: 20rpx;
  color: #172033;
  font-size: 28rpx;
  font-weight: 900;
}

.section-hint {
  margin: -8rpx 0 18rpx;
  color: #6f7d91;
  font-size: 23rpx;
  line-height: 1.45;
}

.section-title.spaced {
  margin-top: 24rpx;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #edf0f5;
}

.switch-row:first-of-type {
  border-top: 0;
}

.switch-text {
  flex: 1;
  min-width: 0;
}

.switch-label {
  color: #172033;
  font-size: 27rpx;
  font-weight: 800;
}

.switch-desc {
  margin-top: 6rpx;
  color: #6f7d91;
  font-size: 23rpx;
  line-height: 1.4;
}

.option-row,
.editable-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.option-chip,
.editable-tags text {
  padding: 10rpx 18rpx;
  border-radius: 8rpx;
  background: #f6f8fb;
  color: #5f6d80;
  font-size: 24rpx;
}

.option-chip.active {
  background: #e8f7ef;
  color: #11924d;
  font-weight: 800;
}

.editable-tags text {
  background: #fff4e6;
  color: #a25800;
  font-weight: 700;
}

.inline-input {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 18rpx;
  width: 100%;
  box-sizing: border-box;
}

.inline-input input {
  width: 100%;
  height: 72rpx;
  padding: 0 18rpx;
  border-radius: 8rpx;
  background: #f6f8fb;
  font-size: 26rpx;
  box-sizing: border-box;
}

.inline-input button {
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  margin: 0;
  padding: 0;
  border-radius: 8rpx;
  background: #11924d;
  color: #fff;
  font-size: 25rpx;
  box-sizing: border-box;
}

.inline-input button::after {
  border: 0;
}

@media screen and (min-width: 430px) {
  .inline-input {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 128rpx;
  }

  .inline-input button {
    width: 128rpx;
  }
}

.label {
  margin-bottom: 10rpx;
  color: #172033;
  font-size: 26rpx;
  font-weight: 700;
}

.input,
.textarea {
  width: 100%;
  border-radius: 8rpx;
  border: 1rpx solid #d9e1ec;
  background: #ffffff;
  color: #172033;
  font-size: 28rpx;
  box-sizing: border-box;
}

.input {
  height: 76rpx;
  padding: 0 20rpx;
}

.textarea {
  min-height: 300rpx;
  padding: 18rpx 20rpx;
  line-height: 1.55;
}

.quick-options {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.quick-options text {
  padding: 7rpx 13rpx;
  border-radius: 6rpx;
  background: #eef6f1;
  color: #157347;
  font-size: 22rpx;
  font-weight: 700;
}

.status-options {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.status-options text {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 136rpx;
  height: 58rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #f6f8fb;
  color: #5f6d80;
  font-size: 24rpx;
  font-weight: 800;
}

.status-options text.active {
  background: #e8f7ef;
  color: #11924d;
}

.map-preview {
  margin-top: 16rpx;
  overflow: hidden;
  border: 1rpx solid #d9e1ec;
  border-radius: 8rpx;
  background: #fff;
}

.map-preview map {
  width: 100%;
  height: 220rpx;
}

.map-empty {
  display: grid;
  gap: 8rpx;
  place-items: center;
  min-height: 180rpx;
  padding: 18rpx;
  background: #f8fafc;
}

.map-empty text:first-child {
  color: #11924d;
  font-size: 23rpx;
  font-weight: 900;
}

.map-empty text:last-child {
  color: #6f7d91;
  font-size: 25rpx;
  line-height: 1.45;
}

.topic-tags text {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.textarea.small {
  min-height: 132rpx;
}

.cover {
  width: 100%;
  height: 320rpx;
  border-radius: 8rpx;
  background: #e8eef7;
}

.media-count {
  margin-top: 16rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.bottom-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 28rpx;
  width: 100%;
  box-sizing: border-box;
}

.generate-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 18rpx;
}

.secondary-btn,
.generate-btn {
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.secondary-btn {
  background: #e8f7ef;
  color: #11924d;
}

.generate-btn {
  background: #11924d;
  color: #fff;
}

.delete-btn,
.save-btn {
  flex: 0 0 calc((100% - 24rpx) / 2);
  width: calc((100% - 24rpx) / 2);
  height: 84rpx;
  line-height: 84rpx;
  margin: 0;
  padding: 0;
  border-radius: 8rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.delete-btn::after,
.save-btn::after {
  border: 0;
}

.delete-btn {
  background: #fff0f0;
  color: #e5484d;
}

.save-btn {
  background: #1677ff;
  color: #fff;
}

.floating-save-area {
  position: fixed;
  left: 0;
  top: 0;
  z-index: 50;
  width: 100vw;
  height: 100vh;
  pointer-events: none;
}

.floating-save {
  width: 84rpx;
  height: 84rpx;
  pointer-events: auto;
}

.floating-save button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  min-width: 0;
  margin: 0;
  padding: 0;
  line-height: 1;
  border-radius: 999rpx;
  border: 1rpx solid #bfe8cf;
  background: #e8f7ef;
  color: #11924d;
  box-shadow: 0 8rpx 22rpx rgba(17, 146, 77, 0.16);
  font-size: 30rpx;
  font-weight: 900;
}

.floating-save button::after {
  border: 0;
}

.floating-save.moving button {
  background: #d9f2e4;
  box-shadow: 0 14rpx 32rpx rgba(17, 146, 77, 0.24);
}

.workflow-panel {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  margin-top: 22rpx;
  padding: 18rpx;
  border-radius: 8rpx;
  background: #fff;
}

.workflow-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  color: #8a95a6;
  font-size: 22rpx;
}

.workflow-dot {
  width: 42rpx;
  height: 42rpx;
  line-height: 42rpx;
  border-radius: 50%;
  background: #eef2f7;
  color: #748094;
  text-align: center;
  font-size: 22rpx;
  font-weight: 800;
}

.workflow-step.done .workflow-dot,
.workflow-step.active .workflow-dot {
  background: #11924d;
  color: #fff;
}

.workflow-step.active .workflow-label {
  color: #11924d;
  font-weight: 900;
}

.state-hero {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 8rpx;
  background: #fff;
}

.state-eyebrow {
  color: #11924d;
  font-size: 23rpx;
  font-weight: 900;
}

.state-title {
  margin-top: 8rpx;
  color: #172033;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.25;
}

.state-hint {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.45;
}

.state-badge {
  height: 48rpx;
  padding: 0 16rpx;
  line-height: 48rpx;
  border-radius: 8rpx;
  background: #e8f7ef;
  color: #11924d;
  font-size: 22rpx;
  font-weight: 800;
}

.capture-panel {
  margin-top: 22rpx;
  border-left: 8rpx solid #11924d;
  padding-left: 26rpx;
}

.collected-topline {
  color: #11924d;
  font-size: 25rpx;
  font-weight: 900;
}

.chip-line {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.chip-line.compact {
  margin-top: 12rpx;
}

.chip-line text {
  padding: 7rpx 13rpx;
  border-radius: 6rpx;
  background: #eef6f1;
  color: #157347;
  font-size: 22rpx;
  font-weight: 700;
}

.raw-box {
  display: grid;
  gap: 12rpx;
  margin-top: 22rpx;
  padding: 8rpx 0 4rpx;
  border-radius: 8rpx;
  color: #2a3445;
  font-size: 30rpx;
  line-height: 1.55;
}

.media-strip {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
  overflow: hidden;
}

.media-strip image,
.media-video {
  width: 150rpx;
  height: 112rpx;
  flex-shrink: 0;
  border-radius: 8rpx;
  background: #e8eef7;
}

.media-video {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #64748b;
  font-size: 23rpx;
  font-weight: 800;
}

.media-strip.large {
  overflow-x: auto;
}

.media-strip.large image,
.media-strip.large .media-video {
  width: 188rpx;
  height: 140rpx;
}

.media-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.media-card {
  position: relative;
  overflow: hidden;
  border: 1rpx solid #e3e8f0;
  border-radius: 8rpx;
  background: #fbfcfe;
}

.media-card image,
.media-card video,
.media-card .media-video {
  width: 100%;
  height: 196rpx;
  border-radius: 0;
}

.media-card video {
  display: block;
  background: #172033;
}

.media-upload-empty {
  display: grid;
  gap: 8rpx;
  place-items: center;
  min-height: 156rpx;
  padding: 22rpx;
  border: 1rpx dashed #b9dfc7;
  border-radius: 8rpx;
  background: #f4fbf7;
  text-align: center;
}

.media-upload-empty text:first-child {
  color: #11924d;
  font-size: 27rpx;
  font-weight: 900;
}

.media-upload-empty text:last-child {
  color: #6f7d91;
  font-size: 23rpx;
  line-height: 1.45;
}

.media-badge {
  position: absolute;
  left: 10rpx;
  top: 10rpx;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  background: rgba(23, 32, 51, 0.72);
  color: #fff;
  font-size: 21rpx;
  font-weight: 800;
}

.media-badge.is-cover-badge {
  color: #e5484d;
}

.media-actions {
  display: flex;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 12rpx;
  color: #1677ff;
  font-size: 24rpx;
  font-weight: 800;
}

.media-actions .danger {
  color: #e5484d;
}

.suggest-panel {
  margin-top: 22rpx;
  padding: 24rpx;
  border-radius: 8rpx;
  background: #fff;
}

.suggest-title {
  color: #172033;
  font-size: 36rpx;
  font-weight: 900;
}

.suggest-text {
  margin-top: 12rpx;
  color: #64748b;
  font-size: 29rpx;
  line-height: 1.55;
}

.suggest-actions .suggest-action {
  flex-direction: column;
  gap: 6rpx;
  height: auto;
  min-height: 96rpx;
  padding: 14rpx 18rpx;
}

.suggest-action-title {
  font-size: 28rpx;
  font-weight: 900;
}

.suggest-action-meta {
  color: #64748b;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.3;
}

.suggest-action.muted {
  color: #334155;
  background: #f8fafc;
}

.collected-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 22rpx;
  margin-top: 30rpx;
}

.collected-actions .save-btn,
.collected-actions .secondary-btn {
  height: 92rpx;
  line-height: 92rpx;
  font-size: 31rpx;
  font-weight: 900;
}

.preview-head {
  display: flex;
  gap: 18rpx;
  margin-top: 22rpx;
  padding: 22rpx;
  border-radius: 8rpx;
  background: #fff;
}

.preview-cover {
  width: 164rpx;
  height: 132rpx;
  flex-shrink: 0;
  border-radius: 8rpx;
  background: #e8eef7;
}

.preview-cover.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #11924d;
  font-size: 42rpx;
  font-weight: 900;
}

.preview-copy {
  min-width: 0;
  flex: 1;
}

.preview-title {
  color: #172033;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.35;
}

.preview-subtitle {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.4;
}

.result-panel {
  margin-top: 22rpx;
  padding: 24rpx;
  border-radius: 8rpx;
  background: #fff;
  border-left: 6rpx solid #11924d;
}

.result-status,
.generated-status {
  color: #11924d;
  font-size: 24rpx;
  font-weight: 900;
}

.result-title {
  margin-top: 10rpx;
  color: #172033;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.35;
}

.warning-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.warning-list text {
  padding: 8rpx 14rpx;
  border-radius: 6rpx;
  background: #fff7e6;
  color: #a25800;
  font-size: 22rpx;
  font-weight: 800;
}

.review-row {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #edf0f5;
  color: #172033;
  font-size: 25rpx;
}

.review-row:first-of-type {
  border-top: 0;
}

.review-row text:first-child {
  color: #64748b;
}

.review-row.warning text:last-child {
  color: #a25800;
  font-weight: 800;
}

.generated-screen {
  margin-top: 22rpx;
}

.generated-status {
  padding: 0 4rpx 14rpx;
}

.promo-preview {
  overflow: hidden;
  border-radius: 8rpx;
  background: #fff;
}

.promo-cover {
  width: 100%;
  height: 300rpx;
  background: #e8eef7;
}

.promo-cover.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #11924d;
  font-size: 44rpx;
  font-weight: 900;
}

.promo-body {
  padding: 22rpx;
}

.promo-title {
  color: #172033;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.3;
}

.promo-price {
  margin-top: 10rpx;
  color: #e5484d;
  font-size: 36rpx;
  font-weight: 900;
}

.action-grid,
.scrm-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}

.action-grid view {
  padding: 18rpx 12rpx;
  border-radius: 8rpx;
  background: #f0f8f4;
  color: #11924d;
  text-align: center;
  font-size: 24rpx;
  font-weight: 800;
}

.scrm-grid {
  grid-template-columns: repeat(3, 1fr);
}

.scrm-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.scrm-alert-dot,
.scrm-entry-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ef4444;
  box-shadow: 0 0 0 6rpx rgba(239, 68, 68, 0.12);
}

.scrm-grid > view {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 18rpx 8rpx;
  border-radius: 8rpx;
  background: #f7f9fc;
}

.scrm-grid text:first-child {
  color: #172033;
  font-size: 34rpx;
  font-weight: 900;
}

.scrm-grid text:last-child {
  color: #64748b;
  font-size: 22rpx;
}

.scrm-entry {
  grid-column: 1 / -1;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 6rpx;
  margin: 4rpx 0 0;
  padding: 20rpx 22rpx;
  border: 2rpx solid #dbeafe;
  border-radius: 8rpx;
  background: #f8fbff;
  color: #172033;
  line-height: 1.35;
  text-align: left;
}

.scrm-entry-component {
  grid-column: 1 / -1;
}

.scrm-entry.is-hot {
  border-color: #fee2e2;
  background: #fff7f7;
}

.scrm-entry::after {
  border: 0;
}

.scrm-entry text:first-child {
  color: #172033;
  font-size: 28rpx;
  font-weight: 900;
}

.scrm-entry text:nth-child(2) {
  color: #64748b;
  font-size: 22rpx;
}

.scrm-entry-dot {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
}

.topic-tags {
  margin-top: 18rpx;
}

.sku-panel {
  margin-top: 24rpx;
  padding: 20rpx;
  border: 1rpx solid #dfe7f2;
  border-radius: 8rpx;
  background: #fbfcfe;
}

.single-price-field {
  margin-top: 18rpx;
  padding: 18rpx;
  border: 1rpx solid #e3e8f0;
  border-radius: 8rpx;
  background: #ffffff;
}

.sku-head,
.sku-group-head,
.sku-soldout {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.sku-title {
  color: #172033;
  font-size: 28rpx;
  font-weight: 900;
}

.sku-hint,
.sku-empty {
  margin-top: 6rpx;
  color: #64748b;
  font-size: 23rpx;
  line-height: 1.45;
}

.sku-group {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 8rpx;
  background: #ffffff;
}

.sku-group-head input,
.sku-option-row input,
.sku-grid input {
  height: 66rpx;
  padding: 0 16rpx;
  border: 1rpx solid #d9e1ec;
  border-radius: 8rpx;
  background: #ffffff;
  color: #172033;
  font-size: 25rpx;
  box-sizing: border-box;
}

.sku-group-head input {
  flex: 1;
}

.sku-group-head text,
.sku-option-row text {
  flex: 0 0 auto;
  color: #ef4444;
  font-size: 24rpx;
  font-weight: 800;
}

.sku-option-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 12rpx;
}

.sku-option-row input {
  flex: 1;
}

.plain-mini-btn {
  margin: 14rpx 0 0;
  padding: 0 18rpx;
  border-radius: 8rpx;
  background: #e8f7ef;
  color: #11924d;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 58rpx;
  text-align: center;
}

.plain-mini-btn::after {
  border: 0;
}

.sku-list-title {
  margin-top: 22rpx;
  color: #172033;
  font-size: 27rpx;
  font-weight: 900;
}

.sku-card {
  margin-top: 14rpx;
  padding: 18rpx;
  border-radius: 8rpx;
  background: #ffffff;
}

.sku-name {
  color: #172033;
  font-size: 27rpx;
  font-weight: 900;
}

.sku-grid {
  display: grid;
  grid-template-columns: 180rpx 1fr;
  gap: 12rpx;
  margin-top: 12rpx;
}

.sku-soldout {
  margin-top: 12rpx;
  color: #64748b;
  font-size: 24rpx;
}
