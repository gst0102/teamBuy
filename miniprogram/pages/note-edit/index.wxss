.page-shell {
  min-height: 100vh;
  padding: 0 28rpx 48rpx;
  background: #f6f8fb;
  box-sizing: border-box;
}

.form-panel,
.media-panel {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 8rpx;
  background: #fff;
}

.bookmark-article {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 8rpx;
  background: #fff;
}

.bookmark-cover {
  width: 100%;
  height: 300rpx;
  border-radius: 8rpx;
  background: #e8eef7;
}

.bookmark-cover.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1677ff;
  font-size: 58rpx;
  font-weight: 900;
}

.bookmark-source {
  margin-top: 18rpx;
  color: #6f7d91;
  font-size: 24rpx;
}

.bookmark-title {
  margin-top: 10rpx;
  color: #172033;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.35;
}

.bookmark-summary {
  margin-top: 12rpx;
  color: #5f6d80;
  font-size: 26rpx;
  line-height: 1.5;
}

.bookmark-info {
  display: grid;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 18rpx;
  border-radius: 8rpx;
  background: #f6f8fb;
}

.bookmark-info view {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  color: #172033;
  font-size: 24rpx;
}

.bookmark-info text:first-child {
  color: #6f7d91;
}

.bookmark-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.bookmark-tags text {
  padding: 6rpx 14rpx;
  border-radius: 6rpx;
  background: #fff4e6;
  color: #a25800;
  font-size: 22rpx;
  font-weight: 700;
}

.bookmark-buttons {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 22rpx;
}

.open-btn,
.organize-btn {
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: 800;
}

.open-btn {
  background: #1677ff;
  color: #fff;
}

.organize-btn {
  background: #fff4e6;
  color: #a25800;
}

.template-bar {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 8rpx;
  background: #fff;
}

.type-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 8rpx;
  background: #fff;
}

.type-label {
  color: #172033;
  font-size: 30rpx;
  font-weight: 900;
}

.type-desc {
  margin-top: 6rpx;
  color: #6f7d91;
  font-size: 23rpx;
  line-height: 1.45;
}

.organize-btn.compact {
  width: 156rpx;
  flex-shrink: 0;
  background: #11924d;
  color: #fff;
}

.typed-form .field + .field {
  margin-top: 20rpx;
}

.template-label {
  color: #172033;
  font-size: 28rpx;
  font-weight: 900;
}

.template-desc {
  margin-top: 6rpx;
  color: #6f7d91;
  font-size: 22rpx;
}

.template-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.template-tag {
  padding: 8rpx 14rpx;
  border-radius: 8rpx;
  background: #eaf3ff;
  color: #1677ff;
  font-size: 22rpx;
  font-weight: 700;
}

.field + .field {
  margin-top: 24rpx;
}

.section-title {
  margin-bottom: 20rpx;
  color: #172033;
  font-size: 28rpx;
  font-weight: 900;
}

.section-title.spaced {
  margin-top: 24rpx;
}

.option-row,
.editable-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.option-chip,
.editable-tags text {
  padding: 10rpx 18rpx;
  border-radius: 8rpx;
  background: #f6f8fb;
  color: #5f6d80;
  font-size: 24rpx;
}

.option-chip.active {
  background: #e8f7ef;
  color: #11924d;
  font-weight: 800;
}

.editable-tags text {
  background: #fff4e6;
  color: #a25800;
  font-weight: 700;
}

.inline-input {
  display: grid;
  grid-template-columns: 1fr 128rpx;
  gap: 14rpx;
  margin-top: 18rpx;
}

.inline-input input {
  height: 72rpx;
  padding: 0 18rpx;
  border-radius: 8rpx;
  background: #f6f8fb;
  font-size: 26rpx;
  box-sizing: border-box;
}

.inline-input button {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0;
  border-radius: 8rpx;
  background: #11924d;
  color: #fff;
  font-size: 25rpx;
}

.label {
  margin-bottom: 10rpx;
  color: #172033;
  font-size: 26rpx;
  font-weight: 700;
}

.input,
.textarea {
  width: 100%;
  border-radius: 8rpx;
  background: #f6f8fb;
  color: #172033;
  font-size: 28rpx;
  box-sizing: border-box;
}

.input {
  height: 76rpx;
  padding: 0 20rpx;
}

.textarea {
  min-height: 300rpx;
  padding: 18rpx 20rpx;
  line-height: 1.55;
}

.textarea.small {
  min-height: 132rpx;
}

.cover {
  width: 100%;
  height: 320rpx;
  border-radius: 8rpx;
  background: #e8eef7;
}

.media-count {
  margin-top: 16rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.bottom-actions {
  display: grid;
  grid-template-columns: 180rpx 1fr;
  gap: 20rpx;
  margin-top: 28rpx;
}

.delete-btn,
.save-btn {
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 8rpx;
  font-size: 30rpx;
}

.delete-btn {
  background: #fff0f0;
  color: #e5484d;
}

.save-btn {
  background: #1677ff;
  color: #fff;
}
