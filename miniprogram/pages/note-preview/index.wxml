<view class="page-shell">
  <custom-nav title="{{view && view.isBusinessCard ? '电子名片' : view && view.isServiceOffer ? '服务方案' : '客户页预览'}}" showBack="{{true}}" />

  <view class="preview-page" wx:if="{{view}}">
    <block wx:if="{{view.isBusinessCard}}">
      <view class="business-card-detail-page {{view.templateToneClass}} {{view.templateId}}">
        <view class="business-card-hero">
          <view class="bc-card-bg"></view>
          <image wx:if="{{view.businessCardHero.avatarUrl}}" class="bc-avatar" src="{{view.businessCardHero.avatarUrl}}" mode="aspectFill"></image>
          <view wx:else class="bc-avatar placeholder">{{view.businessCardHero.initial}}</view>
          <view class="bc-main">
            <view class="bc-name">{{view.businessCardHero.name}}</view>
            <view wx:if="{{view.businessCardHero.role}}" class="bc-role">{{view.businessCardHero.role}}</view>
            <view wx:if="{{view.businessCardHero.company}}" class="bc-company">{{view.businessCardHero.company}}</view>
            <view wx:if="{{view.businessCardHero.serviceScope}}" class="bc-service">{{view.businessCardHero.serviceScope}}</view>
          </view>
        </view>

        <view class="bc-contact-selected" wx:if="{{selectedContactCard}}">
          <text>{{selectedContactCard.label}}</text>
          <view>{{selectedContactCard.value}}</view>
          <text>{{selectedContactCard.hint}}</text>
        </view>

        <view class="bc-section bc-contact-section bc-contact-primary">
          <view class="bc-contact-heading">
            <view>
              <view class="bc-section-title">联系{{view.businessCardHero.name}}</view>
              <text wx:if="{{view.businessCardContactLocked && !isOwnerViewing}}">联系方式需在商机合作中解锁查看</text>
              <text wx:else>客户可直接拨打电话、复制微信或查看二维码</text>
            </view>
            <view class="bc-contact-heading-mark">直接联系</view>
          </view>
          <view wx:if="{{view.businessCardDetail.phone}}" class="bc-contact-action-row" data-key="contact" bindtap="handleAction">
            <view class="bc-contact-action-icon phone">电</view>
            <view class="bc-contact-action-copy"><text>电话</text><view>{{view.businessCardDetail.phone}}</view></view>
            <view class="bc-contact-action-button">拨打电话</view>
          </view>
          <view wx:if="{{view.businessCardDetail.wechat}}" class="bc-contact-action-row" data-key="private" bindtap="handleAction">
            <view class="bc-contact-action-icon wechat">微</view>
            <view class="bc-contact-action-copy"><text>微信</text><view>{{view.businessCardDetail.wechat}}</view></view>
            <view class="bc-contact-action-button">复制微信</view>
          </view>
          <view wx:if="{{view.businessCardDetail.email}}" class="bc-contact-action-row" data-key="email" bindtap="handleAction">
            <view class="bc-contact-action-icon email">邮</view>
            <view class="bc-contact-action-copy"><text>邮箱</text><view>{{view.businessCardDetail.email}}</view></view>
            <view class="bc-contact-action-button secondary">复制邮箱</view>
          </view>
          <view wx:if="{{view.businessCardDetail.website}}" class="bc-contact-action-row" data-key="website" bindtap="handleAction">
            <view class="bc-contact-action-icon website">网</view>
            <view class="bc-contact-action-copy"><text>网站</text><view>{{view.businessCardDetail.website}}</view></view>
            <view class="bc-contact-action-button secondary">复制网址</view>
          </view>
          <view wx:if="{{view.businessCardDetail.qrCodeUrl}}" class="bc-contact-qr-row" data-url="{{view.businessCardDetail.qrCodeUrl}}" bindtap="handlePreviewImage">
            <image class="bc-contact-qr-thumb" src="{{view.businessCardDetail.qrCodeUrl}}" mode="aspectFill"></image>
            <view class="bc-contact-qr-copy"><view>微信二维码</view><text>点击查看大图，添加微信</text></view>
            <text class="bc-contact-row-arrow">›</text>
          </view>
          <view wx:if="{{!view.businessCardDetail.hasContact && !view.businessCardContactLocked}}" class="bc-contact-empty">
            <view>尚未设置联系方式</view>
            <text wx:if="{{isOwnerViewing}}">客户打开后暂时无法直接联系你</text>
            <text wx:else>可以先通过留言咨询联系发布者</text>
            <button wx:if="{{isOwnerViewing}}" bindtap="handleEditBusinessCard">去编辑补充</button>
          </view>
          <view wx:if="{{!view.businessCardDetail.hasContact && view.businessCardContactLocked && !isOwnerViewing}}" class="bc-contact-empty locked">
            <view>联系方式已隐藏</view>
            <text>请从商机合作中解锁后查看</text>
          </view>
        </view>

        <view class="bc-section bc-opportunity-profile" wx:if="{{view.businessCardDetail.industryTags.length}}">
          <view class="bc-section-title">合作标签</view>
          <view class="bc-keyword-row"><text wx:for="{{view.businessCardDetail.industryTags}}" wx:key="*this">{{item}}</text></view>
        </view>

        <view class="bc-section bc-intent-section" wx:if="{{view.businessCardDetail.cooperationIntent.text && view.businessCardDetail.cooperationIntent.active}}">
          <view class="bc-intent-heading"><view class="bc-section-title">{{view.businessCardDetail.cooperationIntent.direction || '当前合作意向'}}</view><text>动态</text></view>
          <view class="bc-section-body">{{view.businessCardDetail.cooperationIntent.text}}</view>
        </view>

        <view class="bc-section" wx:if="{{view.businessCardDetail.keywords.length}}">
          <view class="bc-section-title">我能提供</view>
          <view class="bc-keyword-row"><text wx:for="{{view.businessCardDetail.keywords}}" wx:key="*this">{{item}}</text></view>
        </view>

        <view class="bc-section" wx:if="{{view.businessCardDetail.intro}}">
          <view class="bc-section-title">关于我</view>
          <view class="bc-section-body">{{view.businessCardDetail.intro}}</view>
        </view>

        <view class="bc-section" wx:if="{{view.businessCardDetail.featuredResources.length}}">
          <view class="bc-section-title">精选资料</view>
          <view class="bc-featured-list">
            <view class="bc-featured-item" wx:for="{{view.businessCardDetail.featuredResources}}" wx:key="id" data-id="{{item.id}}" bindtap="handleOpenFeaturedResource">
              <image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill" />
              <view wx:else class="bc-featured-icon">{{item.typeInitial}}</view>
              <view class="bc-featured-copy"><view>{{item.title}}</view><text>{{item.typeLabel}} · {{item.summary || '点击查看资料'}}</text><view wx:if="{{item.media.length}}" class="bc-featured-media-strip"><block wx:for="{{item.media}}" wx:key="id"><image wx:if="{{item.type === 'image'}}" src="{{item.url}}" mode="aspectFill" data-id="{{item.id}}" data-url="{{item.url}}" catchtap="handleFeaturedAttachment" /><view wx:elif="{{item.type === 'pdf'}}" class="bc-featured-media-mark pdf" data-id="{{item.id}}" data-type="pdf" data-url="{{item.url}}" catchtap="handleFeaturedAttachment">PDF</view><view wx:else class="bc-featured-media-mark link" data-id="{{item.id}}" data-type="link" data-url="{{item.url}}" catchtap="handleFeaturedAttachment">链</view></block></view></view>
              <text>›</text>
            </view>
          </view>
        </view>

        <view wx:if="{{isOwnerViewing}}" class="bc-owner-preview-tip"><view>当前为本人预览</view><text>{{view.businessCardDetail.hasContact ? '客户打开后可直接拨打电话、复制微信或发起沟通' : '联系方式尚未补充，客户暂时无法直接联系你'}}</text></view>
        <customer-communication
          wx:if="{{!isOwnerViewing}}"
          actions="{{view.communicationActions}}"
          primary-action="{{view.primaryCommunicationAction}}"
          hint="电话、微信、邮箱和留言都可以直接发起"
          share-ready="{{shareImageReady}}"
          bind:action="handleCommunicationAction"
          bind:share="handleShareTap"
        />
        <view class="property-same-card business-same-card" wx:if="{{!isOwnerViewing}}">
          <view class="property-same-main"><view class="property-same-title">生成我的同款名片</view><view class="property-same-sub">仅复用样式，不复制原作者姓名、头像、联系方式与内容。</view></view>
          <button class="property-same-btn" loading="{{generatingSame}}" disabled="{{generatingSame}}" bindtap="handleGenerateSame">生成同款</button>
        </view>
      </view>
    </block>
    <block wx:elif="{{view.isServiceOffer}}">
      <view class="service-public-page">
        <image wx:if="{{view.serviceOfferDetail.coverUrl}}" class="service-public-cover" src="{{view.serviceOfferDetail.coverUrl}}" mode="aspectFill" data-url="{{view.serviceOfferDetail.coverUrl}}" bindtap="handlePreviewImage" />
        <view class="service-public-hero">
          <view class="service-public-badge">服务 / 合作</view>
          <view class="service-public-title">{{view.serviceOfferDetail.serviceName}}</view>
          <view wx:if="{{view.serviceOfferDetail.headline}}" class="service-public-headline">{{view.serviceOfferDetail.headline}}</view>
          <view class="service-public-publisher">
            <image wx:if="{{view.serviceOfferDetail.publisherAvatarUrl}}" src="{{view.serviceOfferDetail.publisherAvatarUrl}}" mode="aspectFill" />
            <view wx:else class="service-public-avatar">{{view.serviceOfferDetail.publisherInitial}}</view>
            <view><text>{{view.serviceOfferDetail.publisherName}}</text><text wx:if="{{view.serviceOfferDetail.publisherRole}}">{{view.serviceOfferDetail.publisherRole}}</text></view>
          </view>
          <view class="service-public-trust">可直接沟通 · 按需求了解合作</view>
        </view>

        <view class="service-public-highlights" wx:if="{{view.salesHighlights.length}}">
          <view class="service-public-highlight" wx:for="{{view.salesHighlights}}" wx:key="label">
            <text>{{item.label}}</text>
            <view>{{item.value}}</view>
          </view>
        </view>
        <view class="service-public-section" wx:for="{{view.salesSections}}" wx:key="key">
          <view>{{item.title}}</view>
          <text>{{item.body}}</text>
        </view>
        <view class="service-public-section service-public-gallery" wx:if="{{view.galleryImages.length}}">
          <view>图片 / 资料预览</view>
          <swiper class="service-public-gallery-swiper" indicator-dots="{{true}}" indicator-active-color="#5a31cc" indicator-color="#d7cdf5">
            <block wx:for="{{view.galleryImages}}" wx:key="*this">
              <swiper-item>
                <image src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="handlePreviewImage" />
              </swiper-item>
            </block>
          </swiper>
          <text class="service-public-gallery-hint">左右滑动查看图片 · 点击图片查看大图</text>
        </view>
        <customer-communication
          wx:if="{{!isOwnerViewing}}"
          actions="{{view.communicationActions}}"
          primary-action="{{view.primaryCommunicationAction}}"
          hint="{{view.communicationHint}}"
          share-ready="{{shareImageReady}}"
          bind:action="handleCommunicationAction"
          bind:share="handleShareTap"
        />
        <view class="property-same-card" wx:if="{{!isOwnerViewing}}">
          <view class="property-same-main"><view class="property-same-title">生成我的同款资料</view><view class="property-same-sub">仅复用公开结构，不复制发布者身份和联系方式。</view></view>
          <button class="property-same-btn" loading="{{generatingSame}}" disabled="{{generatingSame}}" bindtap="handleGenerateSame">生成同款</button>
        </view>
      </view>
    </block>
    <block wx:elif="{{view.isArticle}}">
      <view class="article-reader-page">
        <image wx:if="{{view.articleDetail.coverUrl}}" class="article-reader-cover" src="{{view.articleDetail.coverUrl}}" mode="aspectFill" />
        <view class="article-reader-card">
          <view class="article-reader-source">{{view.articleDetail.sourceLabel}} · {{view.articleDetail.sourceName}}</view>
          <view class="article-reader-title">{{view.title}}</view>
          <view class="article-reader-recommendation" wx:if="{{view.articleDetail.recommendation}}"><text>推荐给你</text><view>{{view.articleDetail.recommendation}}</view></view>
          <view class="article-reader-section" wx:if="{{view.articleDetail.description}}"><view>内容简介</view><text>{{view.articleDetail.description}}</text></view>
          <button class="article-source-button" bindtap="handleOpenArticleSource">查看原文</button>
          <view class="article-source-note">原文内容与版权归原作者所有</view>
        </view>
        <customer-communication
          wx:if="{{!isOwnerViewing}}"
          actions="{{view.communicationActions}}"
          primary-action="{{view.primaryCommunicationAction}}"
          hint="{{view.communicationHint}}"
          share-ready="{{shareImageReady}}"
          bind:action="handleCommunicationAction"
          bind:share="handleShareTap"
        />
        <view class="property-same-card" wx:if="{{!isOwnerViewing}}">
          <view class="property-same-main"><view class="property-same-title">也想这样分享链接？</view><view class="property-same-sub">免费换成你的推荐语和销售身份。</view></view>
          <button class="property-same-btn" loading="{{generatingSame}}" disabled="{{generatingSame}}" bindtap="handleGenerateSame">免费生成同款</button>
        </view>
      </view>
    </block>
    <block wx:elif="{{view.isContentStream}}">
      <view class="text-reader-page">
        <view class="text-reader-card content-stream-card">
          <view class="text-reader-label">图文资料</view>
          <view class="text-reader-title">{{view.title}}</view>
          <block wx:for="{{view.contentBlocks}}" wx:key="id">
            <view wx:if="{{item.type === 'text'}}" class="content-stream-text">{{item.text}}</view>
            <image wx:elif="{{item.type === 'image'}}" class="content-stream-image" src="{{item.url}}" mode="widthFix" data-url="{{item.url}}" bindtap="handlePreviewImage" />
          </block>
        </view>
        <customer-communication
          wx:if="{{!isOwnerViewing}}"
          actions="{{view.communicationActions}}"
          primary-action="{{view.primaryCommunicationAction}}"
          hint="{{view.communicationHint}}"
          share-ready="{{shareImageReady}}"
          bind:action="handleCommunicationAction"
          bind:share="handleShareTap"
        />
        <view class="text-reader-consult" wx:if="{{!isOwnerViewing}}">
          <view class="text-reader-same" bindtap="handleGenerateSame">也想做这样的资料？<text>免费生成同款 →</text></view>
        </view>
      </view>
    </block>
    <block wx:elif="{{view.isImageNote}}">
      <view class="image-reader-page">
        <view class="image-reader-card">
          <view class="image-reader-label">图片资料</view>
          <view class="image-reader-title">{{view.title}}</view>
          <view wx:if="{{view.imageCaption}}" class="image-reader-caption">{{view.imageCaption}}</view>
          <image wx:if="{{view.coverUrl}}" class="image-reader-main" src="{{view.coverUrl}}" mode="widthFix" data-url="{{view.coverUrl}}" bindtap="handlePreviewImage" />
          <block wx:for="{{view.galleryImages}}" wx:key="*this">
            <image class="image-reader-main image-reader-extra" src="{{item}}" mode="widthFix" data-url="{{item}}" bindtap="handlePreviewImage" />
          </block>
        </view>
        <customer-communication
          wx:if="{{!isOwnerViewing}}"
          actions="{{view.communicationActions}}"
          primary-action="{{view.primaryCommunicationAction}}"
          hint="{{view.communicationHint}}"
          share-ready="{{shareImageReady}}"
          bind:action="handleCommunicationAction"
          bind:share="handleShareTap"
        />
        <view class="text-reader-consult" wx:if="{{!isOwnerViewing}}">
          <view class="text-reader-same" bindtap="handleGenerateSame">也想做这样的资料？<text>免费生成同款 →</text></view>
        </view>
      </view>
    </block>
    <block wx:elif="{{view.isTextNote}}">
      <view class="text-reader-page">
        <view class="text-reader-card">
          <view class="text-reader-label">文字资料</view>
          <view class="text-reader-title">{{view.title}}</view>
          <view wx:if="{{view.subtitle}}" class="text-reader-summary">{{view.subtitle}}</view>
          <view wx:if="{{view.publisherName}}" class="text-reader-author">{{view.publisherName}}{{view.publisherRole ? ' · ' + view.publisherRole : ''}}</view>
          <view wx:if="{{view.remark}}" class="text-reader-body">{{view.remark}}</view>
        </view>
        <customer-communication
          wx:if="{{!isOwnerViewing}}"
          actions="{{view.communicationActions}}"
          primary-action="{{view.primaryCommunicationAction}}"
          hint="{{view.communicationHint}}"
          share-ready="{{shareImageReady}}"
          bind:action="handleCommunicationAction"
          bind:share="handleShareTap"
        />
        <view class="text-reader-consult" wx:if="{{!isOwnerViewing}}">
          <view class="text-reader-same" bindtap="handleGenerateSame">也想做这样的资料？<text>免费生成同款 →</text></view>
        </view>
      </view>
    </block>
    <block wx:else>
    <image wx:if="{{view.coverUrl}}" class="cover" src="{{view.coverUrl}}" mode="aspectFill"></image>
    <view class="content">
      <view class="badge">{{view.badge}}</view>
      <view class="title">{{view.title}}</view>
      <view class="property-highlight-row" wx:if="{{view.propertyHighlightChips.length}}">
        <text wx:for="{{view.propertyHighlightChips}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="subtitle" wx:if="{{view.subtitle}}">{{view.subtitle}}</view>
      <view class="availability {{view.availability ? view.availability.status : ''}}" wx:if="{{view.availability}}">
        <view>{{view.availability.title}}</view>
        <text>{{view.availability.desc}}</text>
      </view>
      <view class="rows">
        <block wx:for="{{view.rows}}" wx:key="label">
          <view class="row">
            <text>{{item.label}}</text>
            <text>{{item.value}}</text>
          </view>
        </block>
      </view>
      <view class="product-sku-section" wx:if="{{view.isGroupbuy && view.skuConfig.skus.length}}">
        <view class="section-title">选择规格</view>
        <view class="sku-group-select" wx:if="{{skuSelectionGroups.length}}">
          <block wx:for="{{skuSelectionGroups}}" wx:key="id" wx:for-item="group" wx:for-index="groupIndex">
            <view class="sku-select-group">
              <view class="sku-select-title">{{group.name}}</view>
              <view class="sku-option-buttons">
                <block wx:for="{{group.options}}" wx:key="id" wx:for-item="option">
                  <view
                    class="sku-option-button {{option.active ? 'active' : ''}} {{option.disabled ? 'disabled' : ''}}"
                    data-group-id="{{group.id}}"
                    data-group-index="{{groupIndex}}"
                    data-option-id="{{option.id}}"
                    data-disabled="{{option.disabled}}"
                    bindtap="handleSelectSkuOption"
                  >{{option.label}}</view>
                </block>
              </view>
            </view>
          </block>
          <block wx:for="{{view.skuConfig.skus}}" wx:key="key">
            <view class="sku-selected-summary" wx:if="{{selectedSkuKey === item.key}}">
              <view>{{item.name}}</view>
              <text wx:if="{{item.soldOut}}">已售罄</text>
              <text wx:elif="{{item.price}}">{{item.price}}</text>
              <text wx:elif="{{item.description}}">{{item.description}}</text>
            </view>
          </block>
        </view>
        <view class="sku-choice-grid" wx:else>
          <block wx:for="{{view.skuConfig.skus}}" wx:key="key">
            <view class="sku-choice {{selectedSkuKey === item.key ? 'active' : ''}} {{item.soldOut ? 'soldout' : ''}}" data-key="{{item.key}}" data-sold-out="{{item.soldOut}}" bindtap="handleSelectSku">
              <view>{{item.name}}</view>
              <text wx:if="{{item.soldOut}}">已售罄</text>
              <text wx:elif="{{item.price}}">{{item.price}}</text>
              <text wx:elif="{{item.description}}">{{item.description}}</text>
            </view>
          </block>
        </view>
      </view>
      <view class="gallery" wx:if="{{view.galleryImages.length}}">
        <view class="section-title">{{view.badge === '房源' ? '房源图片' : view.badge === '商品' ? '商品图片' : view.badge === '名片' ? '二维码 / 图片' : '案例图片'}}</view>
        <swiper class="gallery-swiper" indicator-dots="{{true}}" indicator-active-color="#1677ff" indicator-color="#cbd5e1" circular="{{false}}">
          <block wx:for="{{view.galleryImages}}" wx:key="*this">
            <swiper-item>
              <view class="gallery-slide">
                <image src="{{item}}" mode="aspectFit" data-url="{{item}}" bindtap="handlePreviewImage"></image>
              </view>
            </swiper-item>
          </block>
        </swiper>
        <view class="gallery-count">左右滑动查看图片 · 点击图片查看大图</view>
      </view>
      <view class="gallery" wx:if="{{view.galleryVideos.length}}">
        <view class="section-title">{{view.badge === '房源' ? '房源视频' : view.badge === '商品' ? '商品视频' : '展示视频'}}</view>
        <scroll-view scroll-x class="gallery-scroll video-scroll">
          <block wx:for="{{view.galleryVideos}}" wx:key="*this">
            <video src="{{item}}" controls object-fit="cover"></video>
          </block>
        </scroll-view>
      </view>
      <view class="remark" wx:if="{{view.remark}}">{{view.remark}}</view>
      <view class="map-card" wx:if="{{view.hasMap}}">
        <view class="map-head">
          <text>{{view.isGroupbuy ? '自提位置' : '房源定位'}}</text>
          <text wx:if="{{view.mapLocation.hasPoint}}">腾讯地图</text>
          <text wx:elif="{{resolvingMap}}">正在匹配默认地址</text>
          <text wx:else>按默认地址定位</text>
        </view>
        <map
          wx:if="{{view.mapLocation.hasPoint}}"
          id="previewMap"
          latitude="{{view.mapLocation.latitude}}"
          longitude="{{view.mapLocation.longitude}}"
          markers="{{view.mapLocation.markers}}"
          scale="16"
          show-location="{{false}}"
          bindtap="handleOpenMap"
        ></map>
        <view wx:else class="map-empty" bindtap="handleOpenMap">{{resolvingMap ? '正在生成地图定位' : '点这里用默认地址打开地图'}}</view>
      </view>
      <customer-communication
        wx:if="{{!isOwnerViewing}}"
        actions="{{view.communicationActions}}"
        primary-action="{{view.primaryCommunicationAction}}"
        hint="{{view.communicationHint}}"
        share-ready="{{shareImageReady}}"
        bind:action="handleCommunicationAction"
        bind:share="handleShareTap"
      />
      <view class="actions" wx:if="{{view.sceneActions.length && !isOwnerViewing}}">
        <block wx:for="{{view.sceneActions}}" wx:key="key">
          <view class="action-card {{item.key}}" data-key="{{item.key}}" bindtap="handleAction">
            <view>{{item.title}}</view>
            <text>{{item.desc}}</text>
          </view>
        </block>
      </view>
      <view class="property-same-card" wx:if="{{!isOwnerViewing}}">
        <view class="property-same-main">
          <view class="property-same-title">生成我的同款资料</view>
          <view class="property-same-sub">复制公开内容与样式，身份、联系方式、客户和统计不会复制。</view>
        </view>
        <button class="property-same-btn" loading="{{generatingSame}}" disabled="{{generatingSame}}" bindtap="handleGenerateSame">生成同款</button>
      </view>
      <view class="appointment-form" wx:if="{{showAppointmentForm && !isOwnerViewing}}">
        <view class="quick-date">
          <text data-offset="0" bindtap="handleQuickAppointment">今天</text>
          <text data-offset="1" bindtap="handleQuickAppointment">明天</text>
        </view>
        <view class="picker-row">
          <picker mode="date" value="{{appointmentDraft.date}}" bindchange="handleAppointmentDate">
            <view>日期：{{appointmentDraft.date}}</view>
          </picker>
          <picker mode="time" value="{{appointmentDraft.time}}" bindchange="handleAppointmentTime">
            <view>时间：{{appointmentDraft.time}}</view>
          </picker>
        </view>
        <input value="{{appointmentDraft.remark}}" bindinput="handleAppointmentRemark" placeholder="备注，可选，例如两个人看房" />
        <button loading="{{submittingAction === 'appointment'}}" bindtap="handleSubmitAppointment">提交预约</button>
      </view>
      <view class="product-order-panel" wx:if="{{view.isGroupbuy && view.enableGroupRelay && view.skuConfig.skus.length && !isOwnerViewing}}">
        <view class="order-panel-head">
          <view>
            <view class="section-title">团购接龙</view>
            <text>选择规格和数量后提交接龙</text>
          </view>
          <button bindtap="handleOpenOrderSheet">{{view.orderButtonText}}</button>
        </view>
      </view>
      <view class="status-line" wx:if="{{appointmentText}}">预约意向：{{appointmentText}}</view>
      <view class="status-line" wx:if="{{productOrderSubmitted}}">{{productOrderStatusText || (view.enableGroupRelay ? '已记录接龙意向' : '已下单')}}</view>
    </view>
    </block>
    <view id="leadForm" class="lead-form lead-form-global" wx:if="{{showLeadForm && !isOwnerViewing}}">
      <view class="lead-form-heading">
        <view class="lead-form-mark">留</view>
        <view class="lead-form-heading-copy">
          <view class="lead-form-title">留下你的需求</view>
          <view class="lead-form-hint">留下联系方式和需求，发布者会尽快联系你</view>
        </view>
      </view>
      <view class="lead-form-guide"><text class="lead-form-guide-title">联系信息</text><text class="lead-form-guide-hint">手机号或微信号至少填写一项</text></view>
      <view class="lead-field">
        <view class="lead-field-label">怎么称呼你？<text>选填</text></view>
        <input value="{{leadDraft.name}}" data-key="name" bindinput="handleLeadInput" placeholder="例如：张先生" />
      </view>
      <view class="lead-field">
        <view class="lead-field-label">手机号<text>电话或微信至少填写一项</text></view>
        <input value="{{leadDraft.phone}}" data-key="phone" bindinput="handleLeadInput" placeholder="请输入手机号" type="number" />
      </view>
      <view class="lead-field">
        <view class="lead-field-label">微信号<text>选填</text></view>
        <input value="{{leadDraft.wechat}}" data-key="wechat" bindinput="handleLeadInput" placeholder="方便微信联系时填写" />
      </view>
      <view class="lead-field">
        <view class="lead-field-label">你想了解什么？<text>选填</text></view>
        <textarea value="{{leadDraft.remark}}" data-key="remark" bindinput="handleLeadInput" placeholder="例如：预算、城市或合作需求"></textarea>
      </view>
      <button loading="{{submittingAction === 'lead-contact'}}" bindtap="handleSubmitLead">提交需求</button>
      <view class="lead-form-privacy">仅用于本次联系，不会公开展示</view>
    </view>
    <view class="status-line lead-submit-status" wx:if="{{leadSubmittedText}}">{{leadSubmittedText}}</view>
    <view class="public-attachments shared" wx:if="{{view.attachments.length}}">
      <view class="section-title">相关资料</view>
      <view wx:for="{{view.attachments}}" wx:key="id" wx:for-index="index" class="public-attachment" data-index="{{index}}" bindtap="handleAttachment">
        <image wx:if="{{item.type === 'image'}}" src="{{item.url}}" mode="aspectFill"></image>
        <view wx:else class="public-attachment-mark {{item.type}}">{{item.type === 'pdf' ? 'PDF' : '链'}}</view>
        <view class="public-attachment-copy"><view>{{item.title || item.name || (item.type === 'pdf' ? 'PDF 文件' : '外部链接')}}</view><text>{{item.type === 'image' ? '查看大图' : item.type === 'pdf' ? '打开文档' : '复制链接打开'}}</text></view>
        <text class="public-attachment-open">打开</text>
      </view>
    </view>
    <view class="floating-share-actions">
      <button wx:if="{{shareImageReady}}" class="share-primary" open-type="share" catchtap="handleShareTap">发送给客户</button>
      <view wx:elif="{{shareImageState === 'preparing'}}" class="share-primary share-status">分享图生成中</view>
      <button wx:elif="{{isOwnerViewing}}" class="share-primary share-status" bindtap="prepareShareSnapshot">{{shareStatusText}}</button>
      <view wx:else class="share-primary share-status disabled">{{shareStatusText}}</view>
      <button class="share-secondary" bindtap="handleTimelineHint">朋友圈</button>
    </view>

    <view class="order-sheet-mask" wx:if="{{showOrderSheet}}" catchtap="handleCloseOrderSheet" catchtouchmove="noop">
      <view class="order-sheet" catchtap="noop">
        <view class="sheet-head">
          <view>
            <view class="sheet-title">填写下单信息</view>
            <view class="sheet-subtitle">{{view.orderButtonText}}</view>
          </view>
          <text bindtap="handleCloseOrderSheet">关闭</text>
        </view>
        <view class="sheet-selected">
          <block wx:for="{{view.skuConfig.skus}}" wx:key="key">
            <view wx:if="{{selectedSkuKey === item.key}}">
              <text>已选</text>
              <text>{{item.name}}{{item.price ? ' · ' + item.price : ''}}</text>
            </view>
          </block>
        </view>
        <view class="sheet-form">
          <input value="{{relayDraft.quantity}}" data-key="quantity" bindinput="handleRelayInput" placeholder="数量" type="number" />
          <input value="{{relayDraft.receiverName}}" data-key="receiverName" bindinput="handleRelayInput" placeholder="收货人，可选" />
          <input value="{{relayDraft.phone}}" data-key="phone" bindinput="handleRelayInput" placeholder="电话（必填）" type="number" />
          <input value="{{relayDraft.address}}" data-key="address" bindinput="handleRelayInput" placeholder="地址（必填）" />
          <input value="{{relayDraft.wechat}}" data-key="wechat" bindinput="handleRelayInput" placeholder="微信号，可选" />
          <textarea value="{{relayDraft.remark}}" data-key="remark" bindinput="handleRelayInput" placeholder="备注，可选，例如自提时间、配送要求"></textarea>
          <button loading="{{submittingAction === 'relay-intent' || submittingAction === 'order-intent'}}" bindtap="handleSubmitProductOrder">{{view.orderButtonText}}</button>
        </view>
      </view>
    </view>
  </view>

  <view class="standalone-return" wx:if="{{openedStandalone && view}}">
    <button bindtap="handleBackHome">回到首页</button>
  </view>

  <view class="floating-home-button" wx:if="{{openedStandalone && view}}" bindtap="handleBackHome">
    <text class="floating-home-icon">⌂</text>
    <text>首页</text>
  </view>

  <view class="public-load-error" wx:if="{{publicLoadError}}">
    <view class="public-load-error-icon">!</view>
    <view class="public-load-error-title">{{publicLoadErrorTitle}}</view>
    <view class="public-load-error-message">{{publicLoadErrorMessage}}</view>
    <button class="public-load-error-retry" bindtap="handleRetryPublicNote">重新加载</button>
    <button class="public-load-error-home" bindtap="handleBackHome">回到首页</button>
  </view>

</view>
