.page-shell {
  min-height: 100vh;
  padding: 0 28rpx 48rpx;
  background: #f6f8fb;
  box-sizing: border-box;
}

.preview-page {
  margin-top: 24rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: #fff;
}

.standalone-return {
  padding: 24rpx 0 12rpx;
}

.standalone-return button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  margin: 0;
  padding: 0 28rpx;
  border: 1rpx solid #d7e4f5;
  border-radius: 8rpx;
  background: #ffffff;
  color: #1677ff;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1;
}

.standalone-return button::after {
  border: 0;
}

.sales-page {
  padding: 24rpx;
  background: #f8fafc;
}

.business-card-detail-page {
  padding: 24rpx;
  background: linear-gradient(180deg, #f4faf7 0%, #ffffff 42%, #f7fafc 100%);
}

.business-card-hero {
  position: relative;
  display: grid;
  grid-template-columns: 260rpx minmax(0, 1fr);
  gap: 28rpx;
  align-items: center;
  min-height: 360rpx;
  padding: 34rpx 34rpx 54rpx;
  border: 3rpx solid rgba(17, 122, 74, 0.16);
  border-radius: 18rpx;
  background: linear-gradient(135deg, #eef9f2 0%, #f8fffb 54%, #dff2e8 100%);
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.76), 0 14rpx 34rpx rgba(17, 82, 52, 0.08);
  box-sizing: border-box;
  overflow: hidden;
}

.bc-card-bg {
  position: absolute;
  right: -78rpx;
  top: 28rpx;
  width: 250rpx;
  height: 250rpx;
  border-radius: 44rpx;
  background: rgba(255, 255, 255, 0.48);
  transform: rotate(22deg);
}

.bc-avatar {
  position: relative;
  z-index: 1;
  width: 240rpx;
  height: 240rpx;
  border: 7rpx solid rgba(255, 255, 255, 0.95);
  border-radius: 50%;
  background: #e8eef7;
  box-shadow: 0 18rpx 34rpx rgba(23, 74, 52, 0.15);
  box-sizing: border-box;
}

.bc-avatar.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: #1f7a4e;
  font-size: 82rpx;
  font-weight: 900;
}

.bc-main {
  position: relative;
  z-index: 1;
  min-width: 0;
}

.bc-name {
  color: #0f442b;
  font-size: 58rpx;
  font-weight: 900;
  line-height: 1.12;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.bc-role {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 54rpx;
  margin-top: 16rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #1d7046;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 900;
  white-space: nowrap;
}

.bc-company {
  margin-top: 22rpx;
  color: #172033;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.28;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.bc-service {
  margin-top: 12rpx;
  color: #263445;
  font-size: 28rpx;
  line-height: 1.38;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.bc-contact {
  margin-top: 16rpx;
  color: #245c42;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.35;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.bc-action-bar {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  margin: -30rpx 28rpx 0;
  padding: 24rpx 10rpx;
  border-radius: 14rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 34rpx rgba(15, 23, 42, 0.11);
}

.bc-action-bar.count-1 {
  grid-template-columns: 1fr;
}

.bc-action-bar.count-2 {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.bc-action-bar.count-3 {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.bc-action-item {
  min-width: 0;
  padding: 0 8rpx;
  border-right: 1rpx solid #e5eaf0;
  text-align: center;
  box-sizing: border-box;
}

.bc-action-item:last-child {
  border-right: 0;
}

.bc-action-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin: 0 auto 12rpx;
  border-radius: 50%;
  background: #1d7046;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
}

.bc-action-item text {
  display: block;
  color: #172033;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.26;
  word-break: keep-all;
}

.bc-form {
  margin-top: 22rpx;
}

.bc-contact-selected {
  display: grid;
  grid-template-columns: 82rpx minmax(0, 1fr);
  gap: 8rpx 14rpx;
  margin: 18rpx 28rpx 0;
  padding: 18rpx 20rpx;
  border-radius: 10rpx;
  background: #effaf5;
  border: 1rpx solid #ccebd8;
  box-sizing: border-box;
}

.bc-contact-selected text:first-child {
  color: #1d7046;
  font-size: 25rpx;
  font-weight: 900;
}

.bc-contact-selected view {
  min-width: 0;
  color: #172033;
  font-size: 27rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bc-contact-selected text:last-child {
  grid-column: 2;
  color: #64748b;
  font-size: 22rpx;
}

.bc-section {
  margin-top: 24rpx;
  padding: 26rpx;
  border-radius: 12rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.06);
}

.bc-section-title {
  color: #172033;
  font-size: 32rpx;
  font-weight: 900;
}

.bc-section-body {
  margin-top: 16rpx;
  color: #344255;
  font-size: 28rpx;
  line-height: 1.65;
  white-space: pre-wrap;
}

.bc-scope-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 20rpx;
}

.bc-scope-item {
  display: grid;
  grid-template-columns: 52rpx minmax(0, 1fr);
  gap: 12rpx;
  min-height: 124rpx;
  padding: 16rpx;
  border-right: 1rpx solid #edf1f4;
  box-sizing: border-box;
}

.bc-scope-item:last-child {
  border-right: 0;
}

.bc-scope-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border: 2rpx solid #b9dbc8;
  border-radius: 12rpx;
  color: #1d7046;
  font-size: 22rpx;
  font-weight: 900;
}

.bc-scope-item view view {
  color: #172033;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.3;
}

.bc-scope-item text {
  display: block;
  margin-top: 8rpx;
  color: #64748b;
  font-size: 22rpx;
  line-height: 1.35;
}

.bc-contact-section {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 208rpx;
  gap: 24rpx;
  align-items: center;
}

.bc-contact-row {
  display: grid;
  grid-template-columns: 86rpx minmax(0, 1fr);
  gap: 12rpx;
  margin-top: 18rpx;
  color: #172033;
  font-size: 29rpx;
}

.bc-contact-row text {
  color: #1d7046;
  font-weight: 900;
}

.bc-contact-row view {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bc-save-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 164rpx;
  height: 58rpx;
  margin: 22rpx 0 0;
  padding: 0;
  border-radius: 999rpx;
  background: #1d7046;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 900;
  line-height: normal;
}

.bc-save-btn::after {
  border: 0;
}

.bc-qr {
  width: 196rpx;
  height: 196rpx;
  border-radius: 10rpx;
  background: #f1f5f9;
}

.bc-qr.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #b9dbc8;
  color: #1d7046;
  font-size: 26rpx;
  font-weight: 900;
}

.business-card-detail-page.store_sales_card {
  background: linear-gradient(180deg, #f1fbf5 0%, #ffffff 48%, #f5fbf7 100%);
}

.business-card-detail-page.store_sales_card .business-card-hero {
  border-color: rgba(17, 146, 77, 0.22);
  background: linear-gradient(135deg, #e8f8ee 0%, #ffffff 56%, #d7f1e1 100%);
}

.business-card-detail-page.store_sales_card .bc-role,
.business-card-detail-page.store_sales_card .bc-action-icon,
.business-card-detail-page.store_sales_card .bc-save-btn {
  background: #11924d;
}

.business-card-detail-page.store_sales_card .bc-section {
  border-left: 7rpx solid #11924d;
}

.business-card-detail-page.expert_personal_brand {
  background: linear-gradient(180deg, #f8f5ff 0%, #ffffff 42%, #fbf9ff 100%);
}

.business-card-detail-page.expert_personal_brand .business-card-hero {
  border-color: rgba(105, 69, 214, 0.22);
  background: linear-gradient(135deg, #f5efff 0%, #ffffff 56%, #e9ddff 100%);
}

.business-card-detail-page.expert_personal_brand .bc-name,
.business-card-detail-page.expert_personal_brand .bc-contact-row text,
.business-card-detail-page.expert_personal_brand .bc-scope-icon {
  color: #4c2aa4;
}

.business-card-detail-page.expert_personal_brand .bc-role,
.business-card-detail-page.expert_personal_brand .bc-action-icon,
.business-card-detail-page.expert_personal_brand .bc-save-btn {
  background: #6545d6;
}

.business-card-detail-page.expert_personal_brand .bc-section {
  box-shadow: 0 12rpx 30rpx rgba(101, 69, 214, 0.08);
}

.business-card-detail-page.wechat_simple_card {
  background: #f6f8fb;
}

.business-card-detail-page.wechat_simple_card .business-card-hero {
  display: grid;
  grid-template-columns: 1fr;
  justify-items: center;
  text-align: center;
  padding-top: 44rpx;
  background: #ffffff;
  border-color: #e5eaf0;
}

.business-card-detail-page.wechat_simple_card .bc-avatar {
  width: 190rpx;
  height: 190rpx;
}

.business-card-detail-page.wechat_simple_card .bc-name {
  font-size: 50rpx;
}

.business-card-detail-page.wechat_simple_card .bc-role,
.business-card-detail-page.wechat_simple_card .bc-action-icon,
.business-card-detail-page.wechat_simple_card .bc-save-btn {
  background: #172033;
}

.business-card-detail-page.wechat_simple_card .bc-card-bg {
  display: none;
}

.business-card-detail-page.wechat_simple_card .bc-scope-grid {
  grid-template-columns: 1fr;
}

.business-card-detail-page.wechat_simple_card .bc-scope-item {
  border-right: 0;
  border-bottom: 1rpx solid #edf1f4;
}

.business-card-detail-page.wechat_simple_card .bc-scope-item:last-child {
  border-bottom: 0;
}

.sales-hero {
  padding: 28rpx;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(15, 23, 42, 0.06);
}

.namecard-hero-card {
  position: relative;
  display: grid;
  grid-template-columns: 168rpx minmax(0, 1fr);
  gap: 24rpx;
  align-items: center;
  min-height: 300rpx;
  padding: 28rpx;
  border: 2rpx solid rgba(22, 119, 255, 0.22);
  border-radius: 18rpx;
  background: linear-gradient(135deg, #f7fbff 0%, #e7f3ff 100%);
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.72);
  box-sizing: border-box;
  overflow: hidden;
}

.namecard-shine {
  position: absolute;
  right: -64rpx;
  top: -70rpx;
  width: 230rpx;
  height: 230rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.54);
}

.namecard-avatar-img {
  position: relative;
  z-index: 1;
  width: 158rpx;
  height: 158rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 50%;
  background: #e8eef7;
  box-shadow: 0 10rpx 26rpx rgba(15, 23, 42, 0.16);
  box-sizing: border-box;
}

.namecard-avatar-img.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1677ff;
  color: #ffffff;
  font-size: 56rpx;
  font-weight: 900;
}

.namecard-main {
  position: relative;
  z-index: 1;
  min-width: 0;
}

.namecard-name {
  color: #123047;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.12;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.namecard-role {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 46rpx;
  margin-top: 14rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #145c4a;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 900;
  white-space: nowrap;
}

.namecard-org {
  margin-top: 12rpx;
  color: #172033;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.namecard-service {
  margin-top: 8rpx;
  color: #334155;
  font-size: 23rpx;
  line-height: 1.35;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.namecard-contact {
  margin-top: 10rpx;
  color: #0f6f45;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.35;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sales-hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.sales-template-label,
.sales-template-scene {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 40rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 900;
  white-space: nowrap;
}

.sales-template-label {
  background: #172033;
  color: #ffffff;
}

.sales-template-scene {
  max-width: 240rpx;
  color: #64748b;
  background: #f1f5f9;
  overflow: hidden;
  text-overflow: ellipsis;
}

.business-profile {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.profile-avatar {
  flex: 0 0 132rpx;
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: #e8eef7;
}

.profile-avatar.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: #172033;
  font-size: 52rpx;
  font-weight: 900;
}

.profile-main {
  min-width: 0;
}

.sales-title {
  color: #172033;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.22;
  word-break: break-word;
}

.sales-subtitle {
  margin-top: 12rpx;
  color: #4b5565;
  font-size: 28rpx;
  line-height: 1.5;
}

.sales-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 22rpx;
}

.sales-tags text {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 42rpx;
  padding: 0 16rpx;
  border-radius: 8rpx;
  background: rgba(22, 119, 255, 0.08);
  color: currentColor;
  font-size: 23rpx;
  font-weight: 900;
  white-space: nowrap;
}

.sales-highlight-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 24rpx;
}

.sales-highlight-grid > view {
  min-height: 102rpx;
  padding: 14rpx;
  border-radius: 8rpx;
  background: #f8fafc;
  box-sizing: border-box;
}

.sales-highlight-grid text {
  color: #64748b;
  font-size: 21rpx;
  font-weight: 800;
}

.sales-highlight-grid view view {
  margin-top: 8rpx;
  color: #172033;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.25;
  word-break: break-all;
}

.sales-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.sales-action {
  min-height: 116rpx;
  padding: 18rpx;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
  box-sizing: border-box;
}

.sales-action.contact,
.sales-action.private {
  background: #172033;
}

.sales-action view {
  color: #172033;
  font-size: 28rpx;
  font-weight: 900;
}

.sales-action.contact view,
.sales-action.private view {
  color: #ffffff;
}

.sales-action text {
  display: block;
  margin-top: 8rpx;
  color: #64748b;
  font-size: 23rpx;
  line-height: 1.35;
}

.sales-action.contact text,
.sales-action.private text {
  color: rgba(255, 255, 255, 0.82);
}

.sales-section-list,
.sales-contact-card,
.sales-gallery {
  display: grid;
  gap: 14rpx;
  margin-top: 20rpx;
}

.sales-section,
.sales-contact-card,
.sales-gallery {
  padding: 22rpx;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.04);
}

.sales-section-title {
  color: #172033;
  font-size: 29rpx;
  font-weight: 900;
}

.sales-section-body {
  margin-top: 12rpx;
  color: #4b5565;
  font-size: 27rpx;
  line-height: 1.62;
  white-space: pre-wrap;
}

.sales-page.tone-blue {
  color: #1677ff;
  background: #eef5ff;
}

.sales-page.tone-blue .profile-avatar.placeholder,
.sales-page.tone-blue .namecard-avatar-img.placeholder,
.sales-page.tone-blue .namecard-role,
.sales-page.tone-blue .sales-template-label,
.sales-page.tone-blue .sales-action.contact,
.sales-page.tone-blue .sales-action.private {
  background: #1677ff;
}

.sales-page.tone-green {
  color: #11924d;
  background: #eefbf3;
}

.sales-page.tone-green .profile-avatar.placeholder,
.sales-page.tone-green .namecard-avatar-img.placeholder,
.sales-page.tone-green .namecard-role,
.sales-page.tone-green .sales-template-label,
.sales-page.tone-green .sales-action.contact,
.sales-page.tone-green .sales-action.private {
  background: #11924d;
}

.sales-page.tone-green .namecard-hero-card {
  border-color: rgba(17, 146, 77, 0.24);
  background: linear-gradient(135deg, #f6fffa 0%, #dff7e9 100%);
}

.sales-page.tone-purple {
  color: #7c3aed;
  background: #f5f0ff;
}

.sales-page.tone-purple .profile-avatar.placeholder,
.sales-page.tone-purple .namecard-avatar-img.placeholder,
.sales-page.tone-purple .namecard-role,
.sales-page.tone-purple .sales-template-label,
.sales-page.tone-purple .sales-action.contact,
.sales-page.tone-purple .sales-action.private {
  background: #7c3aed;
}

.sales-page.tone-purple .namecard-hero-card {
  border-color: rgba(124, 58, 237, 0.24);
  background: linear-gradient(135deg, #fbf8ff 0%, #ece2ff 100%);
}

.sales-page.tone-minimal {
  color: #334155;
  background: #f8fafc;
}

.sales-page.tone-minimal .profile-avatar.placeholder,
.sales-page.tone-minimal .namecard-avatar-img.placeholder,
.sales-page.tone-minimal .namecard-role,
.sales-page.tone-minimal .sales-template-label,
.sales-page.tone-minimal .sales-action.contact,
.sales-page.tone-minimal .sales-action.private {
  background: #334155;
}

.sales-page.tone-minimal .namecard-hero-card {
  border-color: #d8e0ea;
  background: linear-gradient(135deg, #ffffff 0%, #f1f5f9 100%);
}

.sales-page.tone-warm {
  color: #d97706;
  background: #fff7ed;
}

.sales-page.tone-warm .profile-avatar.placeholder,
.sales-page.tone-warm .sales-template-label,
.sales-page.tone-warm .sales-action.contact,
.sales-page.tone-warm .sales-action.private {
  background: #d97706;
}

.sales-page.tone-orange {
  color: #ea580c;
  background: #fff1e8;
}

.sales-page.tone-orange .profile-avatar.placeholder,
.sales-page.tone-orange .sales-template-label,
.sales-page.tone-orange .sales-action.contact,
.sales-page.tone-orange .sales-action.private {
  background: #ea580c;
}

.sales-page.store_sales_card .sales-hero {
  border-left: 10rpx solid #11924d;
}

.sales-page.expert_personal_brand .sales-highlight-grid {
  grid-template-columns: 1fr;
