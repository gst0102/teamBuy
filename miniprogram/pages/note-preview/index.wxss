  justify-items: center;
  align-content: center;
  gap: 6rpx;
  box-sizing: border-box;
}

.service-metric-card view {
  color: #101828;
  font-size: 30rpx;
  font-weight: 900;
}

.service-metric-card text {
  color: #667085;
  font-size: 19rpx;
}

.service-section,
.service-gallery,
.service-contact-card {
  margin-top: 18rpx;
  padding: 26rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(15, 23, 42, 0.06);
}

.service-section-title {
  color: #101828;
  font-size: 31rpx;
  line-height: 1.25;
  font-weight: 900;
}

.service-section-body {
  margin-top: 16rpx;
  color: #475467;
  font-size: 25rpx;
  line-height: 1.62;
}

.service-bullet-row {
  display: flex;
  gap: 10rpx;
  margin-top: 14rpx;
  color: #475467;
  font-size: 24rpx;
  line-height: 1.48;
}

.service-bullet-row text:first-child {
  color: #3b82f6;
  font-weight: 900;
  flex: 0 0 auto;
}

.service-feature-grid {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.service-feature-item {
  min-height: 116rpx;
  padding: 16rpx 14rpx;
  border-radius: 24rpx;
  background: #f8fafc;
  display: grid;
  justify-items: center;
  align-content: center;
  gap: 10rpx;
  box-sizing: border-box;
}

.service-feature-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 18rpx;
  background: rgba(37, 99, 235, 0.1);
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 900;
}

.service-feature-item text {
  color: #344054;
  font-size: 22rpx;
  line-height: 1.35;
  text-align: center;
}

.service-price-tag-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.service-price-tag {
  min-height: 66rpx;
  padding: 12rpx;
  border-radius: 20rpx;
  background: #f4f7f5;
  color: #2f6d3d;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 22rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.service-process {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.service-process > view {
  min-height: 118rpx;
  padding: 18rpx;
  border-radius: 22rpx;
  background: #f8fafc;
  display: flex;
  align-items: center;
  gap: 14rpx;
  box-sizing: border-box;
}

.service-process text {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  color: #ffffff;
  background: #16a34a;
  font-size: 22rpx;
  font-weight: 900;
  flex: 0 0 auto;
}

.service-process view view {
  color: #344054;
  font-size: 24rpx;
  line-height: 1.3;
  font-weight: 800;
}

.service-case-row {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.service-case-card {
  display: grid;
  gap: 10rpx;
}

.service-case-card image,
.service-case-placeholder {
  width: 100%;
  height: 126rpx;
  border-radius: 20rpx;
  display: block;
}

.service-case-placeholder {
  background: linear-gradient(180deg, #e9d7c4, #b9855d);
}

.service-case-card text {
  color: #694123;
  font-size: 21rpx;
  line-height: 1.38;
  text-align: center;
}

.service-gallery-scroll {
  white-space: nowrap;
  margin-top: 18rpx;
}

.service-gallery image,
.service-gallery video {
  width: 220rpx;
  height: 160rpx;
  margin-right: 14rpx;
  border-radius: 20rpx;
  background: #eef2f7;
}

.service-contact-head {
  display: grid;
  gap: 10rpx;
}

.service-contact-row {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 20rpx;
  background: #f8fafc;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.service-contact-row text {
  color: #667085;
  font-size: 23rpx;
  font-weight: 800;
  flex: 0 0 auto;
}

.service-contact-row view {
  color: #101828;
  font-size: 25rpx;
  line-height: 1.35;
  font-weight: 800;
  text-align: right;
  word-break: break-all;
}

.service-appoint-note {
  color: #475467;
  font-size: 23rpx;
  line-height: 1.42;
}

.service-secondary-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.service-secondary-action {
  min-height: 50rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #2563eb;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 900;
  white-space: nowrap;
}

.service-form {
  margin-top: 18rpx;
  margin-bottom: 18rpx;
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(15, 23, 42, 0.08);
}

.service-bottom-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(18rpx + env(safe-area-inset-bottom));
  z-index: 45;
  padding: 14rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 2rpx solid rgba(226, 232, 240, 0.92);
  box-shadow: 0 18rpx 40rpx rgba(15, 23, 42, 0.12);
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
  box-sizing: border-box;
}

.service-bottom-action {
  min-height: 84rpx;
  border-radius: 22rpx;
  background: #f8fafc;
  display: grid;
  justify-items: center;
  align-content: center;
  gap: 8rpx;
}

.service-bottom-action view {
  color: #16a34a;
  font-size: 22rpx;
  font-weight: 900;
}

.service-bottom-action text {
  color: #344054;
  font-size: 19rpx;
  white-space: nowrap;
}

.service-offer-page.service_consultation .service-offer-hero,
.service-offer-page.service_campaign .service-offer-hero {
  color: #ffffff;
}

.service-offer-page.service_consultation .service-offer-hero {
  background:
    radial-gradient(circle at 92% 8%, rgba(255, 255, 255, 0.22), transparent 170rpx),
    linear-gradient(135deg, #0f2a4c 0%, #1761a0 100%);
}

.service-offer-page.service_campaign .service-offer-hero {
  background:
    radial-gradient(circle at 92% 8%, rgba(255, 255, 255, 0.24), transparent 170rpx),
    linear-gradient(135deg, #5b21b6 0%, #a855f7 100%);
}

.service-offer-page.service_pricing .service-offer-hero {
  color: #173723;
  background:
    radial-gradient(circle at 90% 0%, rgba(22, 163, 74, 0.16), transparent 160rpx),
    linear-gradient(135deg, #e9f7eb 0%, #ffffff 56%, #d4ead6 100%);
}

.service-offer-page.service_case_story .service-offer-hero {
  color: #3b260e;
  background:
    radial-gradient(circle at 92% 8%, rgba(217, 148, 50, 0.18), transparent 170rpx),
    linear-gradient(135deg, #fff7e8 0%, #ffffff 48%, #f4d9a2 100%);
}

.service-offer-page.service_consultation .service-template-label,
.service-offer-page.service_consultation .service-tags text,
.service-offer-page.service_campaign .service-template-label,
.service-offer-page.service_campaign .service-tags text {
  color: #ffffff;
  background: rgba(255, 255, 255, 0.16);
}

.service-offer-page.service_pricing .service-template-label,
.service-offer-page.service_pricing .service-tags text {
  color: #17633a;
  background: rgba(22, 163, 74, 0.12);
}

.service-offer-page.service_case_story .service-template-label,
.service-offer-page.service_case_story .service-tags text {
  color: #8a4b11;
  background: rgba(217, 148, 50, 0.16);
}

.service-offer-page.service_case_story .service-metric-card {
  background: rgba(255, 255, 255, 0.82);
}

.service-offer-page.service_campaign .service-bottom-action view,
.service-offer-page.service_campaign .service-feature-icon {
  color: #6d28d9;
}

.service-offer-page.service_campaign .service-feature-icon {
  background: rgba(109, 40, 217, 0.1);
}

.service-offer-page.service_pricing .service-price-tag {
  background: #edf7ef;
}

.service-offer-page.service_case_story .service-case-card text {
  color: #8a4b11;
}
