.page-shell {
  min-height: 100vh;
  background: #f6f8fb;
  padding: 0 28rpx 48rpx;
  box-sizing: border-box;
}

.notes-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0 20rpx;
}

.notes-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #172033;
}

.notes-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.notes-count {
  min-width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: #1677ff;
  color: #fff;
  text-align: center;
  line-height: 64rpx;
  font-weight: 700;
}

.search-box {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.search-input {
  flex: 1;
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: 8rpx;
  background: #fff;
  font-size: 28rpx;
  box-sizing: border-box;
}

.search-btn {
  width: 132rpx;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0;
  border-radius: 8rpx;
  background: #172033;
  color: #fff;
  font-size: 28rpx;
}

.note-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.bookmark-card {
  display: grid;
  grid-template-columns: 156rpx 1fr;
  gap: 18rpx;
  padding: 20rpx;
  border-radius: 8rpx;
  background: #fff;
}

.bookmark-cover {
  width: 156rpx;
  height: 156rpx;
  border-radius: 8rpx;
  background: #e8eef7;
}

.bookmark-cover.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1677ff;
  font-size: 46rpx;
  font-weight: 900;
}

.bookmark-source {
  color: #6f7d91;
  font-size: 22rpx;
  line-height: 1.3;
}

.bookmark-title {
  margin-top: 8rpx;
  color: #172033;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.bookmark-summary {
  margin-top: 8rpx;
  color: #5f6d80;
  font-size: 24rpx;
  line-height: 1.45;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.bookmark-meta,
.bookmark-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.bookmark-meta text,
.bookmark-tags text {
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
}

.bookmark-meta text {
  background: #eef5ff;
  color: #1677ff;
}

.bookmark-tags text {
  background: #fff4e6;
  color: #a25800;
}

.bookmark-actions {
  grid-column: 1 / -1;
  display: flex;
  justify-content: flex-end;
  gap: 28rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #edf0f5;
  color: #1677ff;
  font-size: 26rpx;
}

.bookmark-actions .danger {
  color: #e5484d;
}

.note-card {
  display: grid;
  grid-template-columns: 128rpx 1fr;
  gap: 18rpx;
  padding: 20rpx;
  border-radius: 8rpx;
  background: #fff;
}

.note-cover {
  width: 128rpx;
  height: 128rpx;
  border-radius: 8rpx;
  background: #e8eef7;
}

.note-cover.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1677ff;
  font-size: 42rpx;
  font-weight: 700;
}

.note-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #172033;
  line-height: 1.35;
}

.note-summary {
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.note-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.note-meta text {
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: #eef5ff;
  color: #1677ff;
  font-size: 22rpx;
}

.note-actions {
  grid-column: 1 / -1;
  display: flex;
  justify-content: flex-end;
  gap: 28rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #edf0f5;
  color: #1677ff;
  font-size: 26rpx;
}

.note-actions .danger {
  color: #e5484d;
}

.empty-state {
  margin-top: 160rpx;
  text-align: center;
  color: #6b7280;
  font-size: 30rpx;
}

.empty-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #9aa4b2;
}
