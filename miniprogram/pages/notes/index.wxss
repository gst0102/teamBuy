.page-shell {
  min-height: 100vh;
  background: #f6f8fb;
  padding: 0 28rpx 48rpx;
  box-sizing: border-box;
}

.notes-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0 20rpx;
}

.notes-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #172033;
}

.notes-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.notes-count {
  min-width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: #1677ff;
  color: #fff;
  text-align: center;
  line-height: 64rpx;
  font-weight: 700;
}

.search-box {
  margin-bottom: 24rpx;
}

.search-input {
  width: 100%;
  height: 76rpx;
  padding: 0 22rpx;
  border-radius: 8rpx;
  background: #fff;
  font-size: 27rpx;
  box-sizing: border-box;
}

.filter-row {
  margin-bottom: 18rpx;
}

.filter-title {
  margin-bottom: 12rpx;
  color: #6f7d91;
  font-size: 24rpx;
}

.filter-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.filter-line.expanded {
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.filter-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 52rpx;
  padding: 0 18rpx;
  border-radius: 8rpx;
  background: #fff;
  color: #5f6d80;
  font-size: 23rpx;
  white-space: nowrap;
}

.filter-chip.active {
  background: #11924d;
  color: #fff;
}

.filter-chip.icon {
  width: 52rpx;
  padding: 0;
  font-size: 28rpx;
  font-weight: 900;
}

.filter-chip.add {
  color: #11924d;
  background: #e8f7ef;
  font-weight: 800;
}

.filter-scroll {
  width: 100%;
  white-space: nowrap;
}

.filter-scroll .filter-chip,
.topic-chip {
  display: inline-flex;
  margin-right: 12rpx;
  max-width: 220rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  vertical-align: top;
}

.list-meta {
  display: flex;
  justify-content: space-between;
  gap: 22rpx;
  margin: 10rpx 0 18rpx;
  color: #6f7d91;
  font-size: 24rpx;
}

.list-meta text.active {
  color: #11924d;
  font-weight: 800;
}

.note-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.bookmark-card {
  display: grid;
  grid-template-columns: 156rpx 1fr;
  gap: 18rpx;
  padding: 20rpx;
  border-radius: 8rpx;
  background: #fff;
}

.bookmark-cover {
  width: 156rpx;
  height: 156rpx;
  border-radius: 8rpx;
  background: #e8eef7;
}

.bookmark-cover.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1677ff;
  font-size: 46rpx;
  font-weight: 900;
}

.bookmark-source {
  color: #6f7d91;
  font-size: 22rpx;
  line-height: 1.3;
}

.bookmark-title {
  margin-top: 8rpx;
  color: #172033;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.bookmark-summary {
  margin-top: 8rpx;
  color: #5f6d80;
  font-size: 24rpx;
  line-height: 1.45;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.bookmark-meta,
.bookmark-tags,
.bookmark-topics {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.bookmark-meta text,
.bookmark-tags text,
.bookmark-topics text {
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
}

.bookmark-meta text {
  background: #eef5ff;
  color: #1677ff;
}

.bookmark-tags text {
  background: #fff4e6;
  color: #a25800;
}

.bookmark-topics text {
  background: #eaf7ef;
  color: #11924d;
}

.bookmark-actions,
.typed-actions,
.note-actions {
  grid-column: 1 / -1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 22rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #edf0f5;
  font-size: 26rpx;
}

.bookmark-actions {
  color: #1677ff;
}

.bookmark-actions .danger {
  color: #e5484d;
}

.note-card {
  display: grid;
  grid-template-columns: 128rpx 1fr;
  gap: 18rpx;
  padding: 20rpx;
  border-radius: 8rpx;
  background: #fff;
}

.typed-card {
  position: relative;
  display: grid;
  grid-template-columns: 156rpx 1fr;
  gap: 18rpx;
  padding: 20rpx;
  border-radius: 8rpx;
  background: #fff;
}

.card-unread-dot {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  z-index: 2;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #ef4444;
  box-shadow: 0 0 0 7rpx rgba(239, 68, 68, 0.12);
}

.scrm-shortcut {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #edf5ff;
  color: #1677ff;
  font-size: 23rpx;
  font-weight: 900;
}

.scrm-shortcut.hot {
  background: #ffe8ea;
  color: #e5484d;
}

.typed-cover {
  width: 156rpx;
  height: 156rpx;
  border-radius: 8rpx;
  background: #e8eef7;
}

.typed-cover.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e8f7ef;
  color: #11924d;
  font-size: 46rpx;
  font-weight: 900;
}

.typed-cover.placeholder.orange {
  background: #fff4e6;
  color: #c05a00;
}

.typed-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.typed-head text {
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: #e8f7ef;
  color: #11924d;
  font-size: 22rpx;
  font-weight: 800;
}

.typed-head .property-status.rented {
  background: #fff1f2;
  color: #e5484d;
}

.typed-head .property-status.paused {
  background: #fff7ed;
  color: #b45309;
}

.typed-head.groupbuy text {
  background: #fff4e6;
  color: #a25800;
}

.typed-title {
  margin-top: 8rpx;
  color: #172033;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.typed-primary {
  margin-top: 8rpx;
  color: #172033;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.35;
}

.typed-primary.price {
  color: #e5484d;
}

.typed-secondary {
  margin-top: 8rpx;
  color: #5f6d80;
  font-size: 24rpx;
  line-height: 1.45;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.typed-actions {
  color: #11924d;
}

.typed-actions .inline-share {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto;
  height: auto;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: inherit;
  font-size: 26rpx;
  line-height: 1.4;
}

.typed-actions .inline-share::after {
  border: 0;
}

.groupbuy-card .typed-actions {
  color: #a25800;
}

.typed-actions .danger {
  color: #e5484d;
}

.note-cover {
  width: 128rpx;
  height: 128rpx;
  border-radius: 8rpx;
  background: #e8eef7;
}

.note-cover.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1677ff;
  font-size: 42rpx;
  font-weight: 700;
}

.note-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #172033;
  line-height: 1.35;
}

.note-summary {
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.suggestion-line {
  display: inline-flex;
  margin-top: 10rpx;
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
  background: #fff4e6;
  color: #a25800;
  font-size: 22rpx;
  font-weight: 800;
}

.note-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.note-meta text {
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: #eef5ff;
  color: #1677ff;
  font-size: 22rpx;
}

.note-actions {
  color: #1677ff;
}

.note-actions .danger {
  color: #e5484d;
}

.upload-time {
  margin-right: auto;
  color: #8a95a6;
  font-size: 24rpx;
}

.empty-state {
  margin-top: 160rpx;
  text-align: center;
  color: #6b7280;
  font-size: 30rpx;
}

.empty-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #9aa4b2;
}
