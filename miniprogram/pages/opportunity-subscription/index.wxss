.subscription-page {
  padding-bottom: 56rpx;
}

.sub-hero,
.config-panel,
.watching-card {
  width: 100%;
  border: 1rpx solid #dbe6f7;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 16rpx 40rpx rgba(31, 88, 168, 0.08);
  box-sizing: border-box;
}

.sub-hero {
  margin-top: 14rpx;
  padding: 30rpx 26rpx;
  background: linear-gradient(135deg, #f0f7ff, #ffffff 58%, #eefcf5);
}

.hero-kicker {
  color: #079455;
  font-size: 22rpx;
  font-weight: 900;
}

.hero-title {
  margin-top: 8rpx;
  color: #101828;
  font-size: 44rpx;
  font-weight: 900;
}

.hero-sub {
  margin-top: 12rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.45;
}

.config-panel {
  margin-top: 18rpx;
  padding: 24rpx;
}

.config-group + .config-group {
  margin-top: 26rpx;
}

.group-title,
.watching-title {
  color: #101828;
  font-size: 27rpx;
  font-weight: 900;
}

.group-hint {
  margin-top: 8rpx;
  color: #667085;
  font-size: 21rpx;
  line-height: 1.45;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.option-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #475467;
  background: #f2f4f7;
  font-size: 22rpx;
  font-weight: 900;
  white-space: nowrap;
}

.option-chip.active {
  color: #1677ff;
  background: #eaf2ff;
}

.keyword-input {
  width: 100%;
  height: 72rpx;
  margin-top: 14rpx;
  padding: 0 18rpx;
  border-radius: 16rpx;
  color: #172033;
  background: #f8fbff;
  font-size: 24rpx;
  box-sizing: border-box;
}

.watching-card {
  margin-top: 18rpx;
  padding: 24rpx;
}

.watching-line {
  margin-top: 12rpx;
  color: #172033;
  font-size: 26rpx;
  line-height: 1.4;
  font-weight: 900;
}

.watching-sub {
  margin-top: 12rpx;
  color: #667085;
  font-size: 22rpx;
}

.save-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 82rpx;
  margin: 24rpx 0 0;
  padding: 0;
  border-radius: 18rpx;
  color: #ffffff;
  background: #1677ff;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1;
}

.save-btn::after {
  border: 0;
}
