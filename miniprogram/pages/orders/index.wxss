.page {
  min-height: 100vh;
  padding: 24rpx;
  background: #eef6ff;
  color: #172033;
  box-sizing: border-box;
}

.order-card {
  display: flex;
  gap: 18rpx;
  margin-bottom: 18rpx;
  padding: 20rpx;
  border-radius: 8rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.order-summary {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.drill-panel {
  margin-bottom: 18rpx;
  padding: 22rpx;
  border-radius: 8rpx;
  background: #ffffff;
  border: 1rpx solid #e6eef9;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
}

.drill-head,
.source-group-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.drill-title {
  color: #172033;
  font-size: 28rpx;
  font-weight: 900;
}

.drill-sub,
.source-group-sub {
  margin-top: 6rpx;
  color: #64748b;
  font-size: 23rpx;
  line-height: 1.4;
}

.drill-more,
.source-group-count {
  flex: 0 0 auto;
  color: #1677ff;
  font-size: 23rpx;
  font-weight: 900;
}

.stage-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.stage-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 108rpx;
  border-radius: 8rpx;
  background: #f6f9ff;
  border: 1rpx solid #e6eef9;
}

.stage-card.active {
  background: #1677ff;
  border-color: #1677ff;
}

.stage-value {
  color: #172033;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.15;
}

.stage-label {
  margin-top: 6rpx;
  color: #64748b;
  font-size: 21rpx;
  font-weight: 900;
}

.stage-card.active .stage-value,
.stage-card.active .stage-label {
  color: #ffffff;
}

.source-group-line {
  min-height: 80rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf2f8;
}

.source-group-line:first-of-type {
  margin-top: 14rpx;
}

.source-group-main {
  flex: 1;
  min-width: 0;
}

.source-group-title {
  color: #172033;
  font-size: 25rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-summary view {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 18rpx 10rpx;
  border-radius: 8rpx;
  background: #ffffff;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
}

.order-summary text:first-child {
  color: #172033;
  font-size: 34rpx;
  font-weight: 900;
}

.order-summary text:last-child {
  color: #64748b;
  font-size: 22rpx;
}

.status-filter-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 18rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.status-filter {
  flex: 0 0 auto;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #64748b;
  font-size: 24rpx;
  font-weight: 800;
}

.status-filter.active {
  background: #1677ff;
  color: #ffffff;
}

.active-view-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
  padding: 20rpx 22rpx;
  border-radius: 8rpx;
  background: #ffffff;
  border: 1rpx solid #dbeafe;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
}

.active-view-title {
  color: #172033;
  font-size: 26rpx;
  font-weight: 900;
}

.active-view-sub {
  margin-top: 6rpx;
  color: #64748b;
  font-size: 23rpx;
  line-height: 1.4;
}

.active-view-reset {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  min-width: 128rpx;
  height: 58rpx;
  padding: 0 20rpx;
  line-height: 1.2;
  border-radius: 999rpx;
  background: #edf5ff;
  color: #1677ff;
  font-size: 23rpx;
  font-weight: 900;
}

.cover {
  width: 132rpx;
  height: 132rpx;
  border-radius: 8rpx;
  background: #e8eef7;
  flex-shrink: 0;
}

.cover.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #11924d;
  font-weight: 900;
}

.buyer-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #edf5ff;
  flex-shrink: 0;
}

.buyer-avatar.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #1677ff, #20c997);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
}

.main {
  flex: 1;
  min-width: 0;
}

.topline {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
}

.title {
  color: #172033;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.3;
}

.status {
  flex-shrink: 0;
  color: #e5484d;
  font-size: 23rpx;
  font-weight: 900;
}

.summary,
.info,
.meta {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.4;
}

.info {
  color: #334155;
  word-break: break-all;
}

.meta {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
}

.order-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.order-actions button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 112rpx;
  height: 50rpx;
  margin: 0;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #ecfdf3;
  color: #11924d;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 50rpx;
}

.order-actions button + button {
  background: #edf5ff;
  color: #1677ff;
}

.order-actions button::after {
  border: 0;
}

.empty {
  margin-top: 40rpx;
  padding: 56rpx 20rpx;
  border-radius: 8rpx;
  background: #fff;
  color: #94a3b8;
  text-align: center;
}

.empty view {
  color: #172033;
  font-size: 28rpx;
  font-weight: 900;
}

.empty text {
  display: block;
  margin-top: 10rpx;
  color: #64748b;
  font-size: 24rpx;
}

.empty.error view {
  color: #e5484d;
  line-height: 1.45;
}

.empty button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-width: 180rpx;
  height: 64rpx;
  min-height: 64rpx;
  margin: 22rpx auto 0;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: #e8f7ef;
  color: #11924d;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 64rpx;
}

.empty button::after {
  border: 0;
}

.order-detail-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  align-items: flex-end;
  padding: 0 24rpx 32rpx;
  background: rgba(15, 23, 42, 0.38);
  box-sizing: border-box;
}

.order-detail-sheet {
  width: 100%;
  max-height: 82vh;
  overflow-y: auto;
  padding: 30rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 -18rpx 50rpx rgba(20, 31, 52, 0.18);
  box-sizing: border-box;
}

.detail-head {
  display: flex;
  align-items: center;
  min-width: 0;
}

.detail-avatar {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #edf5ff;
}

.detail-avatar.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: linear-gradient(135deg, #1677ff, #20c997);
  font-size: 34rpx;
  font-weight: 900;
}

.detail-main {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.detail-name {
  overflow: hidden;
  color: #172033;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 31rpx;
  font-weight: 900;
}

.detail-sub {
  margin-top: 8rpx;
  overflow: hidden;
  color: #667085;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 23rpx;
  font-weight: 800;
}

.detail-close {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 58rpx;
  height: 58rpx;
  margin: 0 0 0 14rpx;
  padding: 0;
  line-height: 58rpx;
  border: 0;
  border-radius: 50%;
  color: #667085;
  background: #f2f5f9;
  font-size: 40rpx;
  font-weight: 500;
}

.detail-section {
  margin-top: 26rpx;
}

.detail-section-title {
  color: #172033;
  font-size: 25rpx;
  font-weight: 900;
}

.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.detail-tag {
  max-width: 100%;
  overflow: hidden;
  padding: 10rpx 14rpx;
  border-radius: 999rpx;
  background: #f0f5ff;
  color: #2f5fb8;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 22rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.detail-tag.blue {
  background: #edf5ff;
  color: #1677ff;
}

.detail-tag.green {
  background: #ecfdf3;
  color: #11924d;
}

.detail-tag.orange {
  background: #fff7ed;
  color: #c2410c;
}

.detail-note {
  margin-top: 14rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: #f8fbff;
  color: #344054;
  font-size: 23rpx;
  line-height: 1.45;
}

.detail-contact-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  min-width: 0;
  margin-top: 14rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: #f6f9fd;
  box-sizing: border-box;
}

.detail-contact-row text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #263247;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 24rpx;
  font-weight: 800;
}

.detail-contact-row button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 108rpx;
  height: 50rpx;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #ecfdf3;
  color: #11924d;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 50rpx;
  box-sizing: border-box;
}

.detail-contact-row button.wechat {
  background: #edf5ff;
  color: #1677ff;
}

.detail-contact-row button::after {
  border: 0;
}

.detail-empty {
  margin-top: 12rpx;
  color: #8a96a8;
  font-size: 23rpx;
}

.detail-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 14rpx;
  margin-top: 28rpx;
}

.detail-primary,
.detail-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 74rpx;
  margin: 0;
  padding: 0 16rpx;
  line-height: 74rpx;
  border-radius: 16rpx;
  font-size: 25rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.detail-primary {
  color: #ffffff;
  background: #1677ff;
}

.detail-secondary {
  border: 1rpx solid #d6e1f0;
  color: #334155;
  background: #ffffff;
}
