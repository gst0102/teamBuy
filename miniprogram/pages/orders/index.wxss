.page {
  min-height: 100vh;
  padding: 24rpx;
  background: #eef6ff;
  color: #172033;
  box-sizing: border-box;
}

.order-card {
  display: flex;
  gap: 18rpx;
  margin-bottom: 18rpx;
  padding: 20rpx;
  border-radius: 8rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.cover {
  width: 132rpx;
  height: 132rpx;
  border-radius: 8rpx;
  background: #e8eef7;
  flex-shrink: 0;
}

.cover.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #11924d;
  font-weight: 900;
}

.main {
  flex: 1;
  min-width: 0;
}

.topline {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
}

.title {
  color: #172033;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.3;
}

.status {
  flex-shrink: 0;
  color: #e5484d;
  font-size: 23rpx;
  font-weight: 900;
}

.summary,
.info,
.meta {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.4;
}

.info {
  color: #334155;
  word-break: break-all;
}

.meta {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
}

.empty {
  margin-top: 40rpx;
  padding: 56rpx 20rpx;
  border-radius: 8rpx;
  background: #fff;
  color: #94a3b8;
  text-align: center;
}

.empty view {
  color: #172033;
  font-size: 28rpx;
  font-weight: 900;
}

.empty text {
  display: block;
  margin-top: 10rpx;
  color: #64748b;
  font-size: 24rpx;
}

.empty.error view {
  color: #e5484d;
  line-height: 1.45;
}

.empty button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-width: 180rpx;
  height: 64rpx;
  min-height: 64rpx;
  margin: 22rpx auto 0;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: #e8f7ef;
  color: #11924d;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 64rpx;
}

.empty button::after {
  border: 0;
}
