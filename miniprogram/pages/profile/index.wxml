<view class="page-shell">
  <custom-nav title="&#x6211;&#x7684;" />

  <view class="profile-card" wx:if="{{user}}">
    <image class="profile-avatar" src="{{user.avatarUrl}}" mode="aspectFill"></image>
    <view class="profile-main">
      <view class="profile-name">{{user.nickname}}</view>
      <view class="profile-sub">微信内容资源助手</view>
    </view>
    <button class="edit-btn" bindtap="handleSettingsPlaceholder">编辑资料</button>
  </view>

  <view class="panel">
    <view class="stat-grid">
      <view class="stat-item">
        <view class="stat-icon blue">资</view>
        <text class="stat-value">{{totalResources}}</text>
        <text class="stat-label">我的资源</text>
      </view>
      <view class="stat-item">
        <view class="stat-icon green">访</view>
        <text class="stat-value">{{totalPv}}</text>
        <text class="stat-label">访问总量</text>
      </view>
      <view class="stat-item">
        <view class="stat-icon orange">线</view>
        <text class="stat-value">{{totalRelay}}</text>
        <text class="stat-label">接龙线索</text>
      </view>
      <view class="stat-item">
        <view class="stat-icon purple">邀</view>
        <text class="stat-value">--</text>
        <text class="stat-label">邀请权益</text>
      </view>
    </view>
  </view>

  <view class="profile-section">
    <view class="section-title">会员服务</view>
    <view class="panel icon-grid">
      <view class="icon-item" bindtap="handleMemberPlaceholder">
        <view class="icon-badge green">会</view>
        <text>会员中心</text>
      </view>
      <view class="icon-item" bindtap="handleMemberPlaceholder">
        <view class="icon-badge blue">邀</view>
        <text>邀请好友</text>
      </view>
      <view class="icon-item" bindtap="handleSettingsPlaceholder">
        <view class="icon-badge gray">设</view>
        <text>设置中心</text>
      </view>
    </view>
  </view>

  <view class="profile-section">
    <view class="section-title">笔记区域</view>
    <view class="panel icon-grid">
      <view class="icon-item" bindtap="handleGoLibrary">
        <view class="icon-badge blue">库</view>
        <text>资源库</text>
      </view>
      <view class="icon-item" bindtap="handleGoNotes">
        <view class="icon-badge green">记</view>
        <text>我的笔记</text>
      </view>
      <view class="icon-item" bindtap="handleGoTopics">
        <view class="icon-badge orange">题</view>
        <text>专题</text>
      </view>
      <view class="icon-item" bindtap="handleGoShowcases">
        <view class="icon-badge blue">展</view>
        <text>展示页</text>
      </view>
      <view class="icon-item" bindtap="handleGoVisits">
        <view class="icon-badge purple">访</view>
        <text>访问记录</text>
      </view>
    </view>
  </view>

  <view class="profile-section">
    <view class="section-title">线索 / 订单</view>
    <view class="panel icon-grid">
      <view class="icon-item" bindtap="handleGoLeads">
        <view class="icon-badge orange">联</view>
        <text>待联系</text>
      </view>
      <view class="icon-item" bindtap="handleGoCustomers">
        <view class="icon-badge blue">客</view>
        <text>客户库</text>
      </view>
      <view class="icon-item" bindtap="handleGoBuyerOrders">
        <view class="icon-badge green">买</view>
        <text>我的订单</text>
      </view>
      <view class="icon-item" bindtap="handleGoSellerOrders">
        <view class="icon-badge purple">卖</view>
        <text>商家订单</text>
      </view>
    </view>
  </view>

  <view class="profile-section">
    <view class="section-title">消息专区</view>
    <view class="panel menu-panel">
      <message-entry mode="center" variant="row" title="站内消息" desc="{{messageUnread ? messageUnread + ' 条未读' : '查看会话列表'}}" unread-count="{{messageUnread}}" />
    </view>
  </view>

  <view class="profile-section">
    <view class="section-title">开发 / 测试</view>
    <view class="panel icon-grid">
      <view class="icon-item demo-item" bindtap="handleCreateDemoData">
        <view class="icon-badge green">测</view>
        <text>测试数据</text>
      </view>
    </view>
  </view>

  <button class="ghost-btn logout-btn" bindtap="handleLogout">退出登录</button>
</view>
