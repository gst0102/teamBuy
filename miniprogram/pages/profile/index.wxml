<view class="page-shell">
  <custom-nav title="我的" />

  <!-- 身份卡 -->
  <view class="profile-card" wx:if="{{user}}">
    <view class="profile-card-top">
      <view class="profile-avatar-shell" bindtap="handleOpenProfileEditor">
        <image class="profile-avatar" wx:if="{{user.avatarUrl}}" src="{{user.avatarUrl}}" mode="aspectFill"></image>
        <image class="profile-avatar" wx:else src="/static/images/avatar-default.png" mode="aspectFill"></image>
      </view>
      <view class="profile-main">
        <view class="profile-name">{{user.nickname}}</view>
        <view class="profile-sub">{{user.profileSubtitle}}</view>
      </view>
      <button class="profile-edit-btn" bindtap="handleOpenProfileEditor">编辑</button>
    </view>
  </view>

  <view class="profile-card profile-guest-card" wx:else>
    <view class="profile-card-top">
      <view class="profile-avatar-shell">
        <image class="profile-avatar" src="/static/images/avatar-default.png" mode="aspectFill"></image>
      </view>
      <view class="profile-main">
        <view class="profile-name">游客浏览</view>
        <view class="profile-sub">先浏览资料，需要编辑或保存时再登录。</view>
      </view>
      <button class="profile-edit-btn" bindtap="handleOpenProfileEditor">登录</button>
    </view>
  </view>

  <!-- 资产区 -->
  <view class="profile-section">
    <view class="section-title">我的资产</view>
    <view class="panel assets-panel">
      <view class="asset-grid">
        <view class="asset-item" bindtap="handleGoLibrary">
          <image class="asset-icon" src="/static/icons/asset-library.svg" mode="aspectFit"></image>
          <text>资料</text>
        </view>
        <view class="asset-item" bindtap="handleGoShowcases">
          <image class="asset-icon" src="/static/icons/asset-showcase.svg" mode="aspectFit"></image>
          <text>合集</text>
        </view>
        <button wx:if="{{businessCardShareReady}}" class="asset-item asset-share-button" open-type="share" catchtap="handleShareTap" hover-class="none">
          <image class="asset-icon" src="/static/icons/asset-card.svg" mode="aspectFit"></image>
          <text>发名片</text>
        </button>
        <view wx:elif="{{businessCardShareGenerating}}" class="asset-item asset-share-pending">
          <image class="asset-icon" src="/static/icons/asset-card.svg" mode="aspectFit"></image>
          <text>准备中</text>
        </view>
        <view wx:else class="asset-item" bindtap="handleBusinessCardAction">
          <image class="asset-icon" src="/static/icons/asset-card.svg" mode="aspectFit"></image>
          <text>{{businessCardActionLabel}}</text>
        </view>
      </view>
      <view class="asset-message-row" bindtap="handleGoMessages">
        <view class="asset-message-leading">
          <image class="asset-message-icon" src="/static/icons/asset-message.svg" mode="aspectFit"></image>
          <text>消息</text>
          <view class="asset-unread" wx:if="{{messageUnread}}">{{messageUnread > 9 ? '9+' : messageUnread}}</view>
        </view>
        <view class="asset-arrow">›</view>
      </view>
    </view>
  </view>

  <view class="profile-section tools-section">
    <view class="section-title">我的工具</view>
    <view class="panel tools-panel">
      <view class="tools-grid">
        <view class="tool-item" bindtap="handleOpenMutualHelp">
          <view class="tool-item-icon mutual">互</view>
          <text class="tool-item-title">互帮互助</text>
        </view>
        <view class="tool-item disabled" bindtap="handleOpenUnavailableTool">
          <view class="tool-item-icon groups">群</view>
          <text class="tool-item-title">微信群工具</text>
          <text class="tool-item-status">即将上线</text>
        </view>
      </view>
    </view>
  </view>

  <view class="profile-section view-history-section" wx:if="{{user}}">
    <view class="section-title">最近看过</view>
    <view class="panel view-history-panel">
      <view class="view-history-empty" wx:if="{{viewHistoryLoading}}">正在读取浏览记录…</view>
      <view class="view-history-empty retry" wx:elif="{{viewHistoryLoadError}}" bindtap="handleRetryViewHistory">最近看过暂时无法读取，点击重试</view>
      <view class="view-history-empty" wx:elif="{{!viewHistory.length}}">暂时没有最近的记录</view>
      <view class="view-history-item" wx:for="{{viewHistory}}" wx:key="historyKey" data-type="{{item.targetType}}" data-id="{{item.id}}" bindtap="handleOpenViewedItem">
        <image class="view-history-cover" wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill"></image>
        <image class="view-history-cover" wx:else src="/static/images/avatar-default.png" mode="aspectFill"></image>
        <view class="view-history-main">
          <view class="view-history-title">{{item.title}}</view>
          <view class="view-history-time">{{item.viewedAtText}}</view>
        </view>
        <view class="view-history-arrow">›</view>
      </view>
      <view class="view-history-more" wx:if="{{viewHistoryHasMore}}" bindtap="handleOpenViewHistory">
        <text>查看全部浏览记录</text>
        <text class="view-history-more-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 没有客户信号时不展示会员和推广入口 -->
  <view class="profile-section sales-scrm-section" wx:if="{{membershipVisible}}">
    <view class="customer-signal-entry" bindtap="handleOpenMembership">
      <view class="customer-signal-copy">
        <view class="customer-signal-title">已有客户信号</view>
        <view class="customer-signal-sub">查看客户权益</view>
      </view>
      <view class="customer-signal-arrow">›</view>
    </view>
  </view>

  <view class="profile-section referral-section" wx:if="{{user}}">
    <view class="referral-entry" bindtap="handleOpenReferralCenter">
      <view class="referral-entry-leading">
        <image class="referral-entry-icon" src="/static/icons/referral.svg" mode="aspectFit"></image>
        <view>
          <view class="referral-entry-title">推广中心</view>
          <view class="referral-entry-sub">查看推广进度、收益与提现</view>
        </view>
      </view>
      <view class="referral-entry-trailing">
        <view class="referral-entry-value">去查看</view>
        <view class="referral-entry-arrow">›</view>
      </view>
    </view>
  </view>

  <!-- 设置与帮助 -->
  <view class="profile-section">
    <view class="section-title">设置与帮助</view>
    <view class="panel settings-panel">
      <view class="settings-row" bindtap="handleOpenProfileEditor">
        <view class="settings-leading">
          <image class="settings-icon" src="/static/icons/settings-profile.svg" mode="aspectFit"></image>
          <view class="settings-title">个人资料</view>
        </view>
        <view class="settings-arrow">›</view>
      </view>
      <view class="settings-row" bindtap="handleOpenPrivacy">
        <view class="settings-leading">
          <image class="settings-icon" src="/static/icons/settings-privacy.svg" mode="aspectFit"></image>
          <view>
            <view class="settings-title">隐私说明</view>
            <view class="settings-desc">查看我们使用的用户信息</view>
          </view>
        </view>
        <view class="settings-arrow">›</view>
      </view>
      <view class="settings-row" bindtap="handleOpenHelp">
        <view class="settings-leading">
          <image class="settings-icon" src="/static/icons/settings-help.svg" mode="aspectFit"></image>
          <view class="settings-title">帮助与反馈</view>
        </view>
        <view class="settings-arrow">›</view>
      </view>
      <view class="settings-row danger" wx:if="{{user}}" bindtap="handleLogout">
        <view class="settings-leading">
          <image class="settings-icon" src="/static/icons/settings-logout.svg" mode="aspectFit"></image>
          <view class="settings-title">退出登录</view>
        </view>
        <view class="settings-arrow">›</view>
      </view>
    </view>
  </view>

  <!-- 资源工具整块本轮隐藏（代码保留，后续恢复时取消注释渲染） -->

  <view class="profile-editor-mask" wx:if="{{showProfileEditor}}" bindtap="handleCloseProfileEditor">
    <view class="profile-editor" catchtap="noop">
      <view class="editor-header">
        <view>
          <view class="editor-title">个人资料</view>
          <view class="editor-desc">用于资源页、资料页和客户联系展示</view>
        </view>
        <view class="editor-close" bindtap="handleCloseProfileEditor">×</view>
      </view>

      <view class="editor-avatar-row">
        <button class="editor-avatar-button" type="default" bindtap="handleChooseAvatarFromAlbum" hover-class="editor-avatar-button-hover">
          <image class="editor-avatar" wx:if="{{profileDraft.avatarUrl}}" src="{{profileDraft.avatarUrl}}" mode="aspectFill"></image>
          <image class="editor-avatar" wx:else src="/static/images/avatar-default.png" mode="aspectFill"></image>
          <view class="editor-avatar-action-text">点击从相册更换</view>
        </button>
      </view>

      <view class="form-field">
        <view class="field-label">昵称</view>
        <input class="field-input" type="nickname" value="{{profileDraft.nickname}}" placeholder="填写你的昵称" bindinput="handleProfileNicknameInput" />
      </view>
      <view class="form-field">
        <view class="field-label">手机号</view>
        <input class="field-input" type="number" value="{{profileDraft.phone}}" placeholder="用于客户联系，可不填" bindinput="handleProfilePhoneInput" />
      </view>
      <view class="form-field">
        <view class="field-label-row">
          <view class="field-label">微信号</view>
          <view class="same-phone-btn" catchtap="handleUsePhoneAsWechat">同号</view>
        </view>
        <input class="field-input" value="{{profileDraft.wechat}}" placeholder="填写你的微信号，可不填" bindinput="handleProfileWechatInput" />
      </view>

      <view class="profile-legal-row" bindtap="handleToggleProfileLegalAgree">
        <view class="profile-legal-checkbox {{profileLegalAgreed ? 'checked' : ''}}">{{profileLegalAgreed ? '✓' : ''}}</view>
        <view class="profile-legal-copy">
          我已阅读并同意
          <text catchtap="handleOpenTerms">《用户服务协议》</text>
          和
          <text catchtap="handleOpenPrivacy">《隐私政策》</text>
        </view>
      </view>

      <view class="editor-actions">
        <button class="editor-secondary" bindtap="handleCloseProfileEditor">取消</button>
        <button class="editor-primary" bindtap="handleSaveProfile">保存资料</button>
      </view>
    </view>
  </view>

  <view class="resource-rule-mask" wx:if="{{showResourceRules}}" bindtap="handleCloseResourceRules">
    <view class="resource-rule-modal" catchtap="noop">
      <view class="rule-modal-title">积分规则</view>
      <view class="rule-modal-row"><text>查看群资源</text><strong>-30</strong></view>
      <view class="rule-modal-row"><text>发布群</text><strong>冻结 +20</strong></view>
      <view class="rule-modal-row"><text>冻结积分</text><strong>确认可进后到账</strong></view>
      <view class="rule-modal-row"><text>企业查询</text><strong>-5/项</strong></view>
      <view class="rule-modal-row"><text>24 小时缓存</text><strong>不重复扣</strong></view>
      <button class="editor-primary rule-modal-btn" bindtap="handleCloseResourceRules">知道了</button>
    </view>
  </view>

  <canvas canvas-id="profileBusinessCardShareCanvas" class="profile-business-card-share-canvas"></canvas>
</view>
