.profile-card {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 18rpx 46rpx rgba(31, 88, 168, 0.09);
  margin-bottom: 24rpx;
}

.profile-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: #edf5ff;
}

.profile-main {
  flex: 1;
  margin-left: 22rpx;
}

.profile-name {
  font-size: 34rpx;
  font-weight: 900;
}

.profile-sub {
  margin-top: 8rpx;
  color: #7d8898;
  font-size: 24rpx;
}

.edit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 58rpx;
  line-height: 1.2;
  border-radius: 999rpx;
  background: #edf5ff;
  color: #1677ff;
  font-size: 24rpx;
}

.member-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-radius: 32rpx;
  padding: 30rpx;
  background: linear-gradient(135deg, #2f3545, #8a5a2d);
  margin-bottom: 24rpx;
  color: #fff;
}

.member-title {
  font-size: 32rpx;
  font-weight: 900;
}

.member-desc {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 24rpx;
}

.member-btn {
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 24rpx;
}

.profile-section {
  margin-top: 24rpx;
}

.section-title {
  margin: 0 0 12rpx 4rpx;
  color: #172033;
  font-size: 28rpx;
  font-weight: 900;
}

.stat-icon.blue {
  background: linear-gradient(135deg, #368cff, #0066ff);
}

.stat-icon.green {
  background: linear-gradient(135deg, #44d58a, #12b76a);
}

.stat-icon.orange {
  background: linear-gradient(135deg, #ffb24a, #ff7a1a);
}

.stat-icon.purple {
  background: linear-gradient(135deg, #8b7cff, #6845f5);
}

.menu-panel {
  padding: 6rpx 28rpx;
}

.icon-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18rpx 10rpx;
  padding: 26rpx 14rpx 22rpx;
}

.icon-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  min-width: 0;
}

.icon-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.08);
}

.icon-badge.blue {
  background: #1677ff;
}

.icon-badge.green {
  background: #11924d;
}

.icon-badge.orange {
  background: #f59e0b;
}

.icon-badge.purple {
  background: #7c3aed;
}

.icon-badge.gray {
  background: #64748b;
}

.icon-item > text {
  display: block;
  width: 100%;
  margin-top: 12rpx;
  color: #172033;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.25;
  text-align: center;
  word-break: keep-all;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #edf2f8;
  font-size: 28rpx;
  font-weight: 700;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-arrow {
  color: #9aa4b2;
  font-size: 24rpx;
  font-weight: 400;
}

.demo-item {
  color: #11924d;
}

.demo-item .menu-arrow {
  color: #11924d;
  font-weight: 900;
}

.logout-btn {
  margin-top: 18rpx;
}
