.profile-card {
  display: flex;
  flex-direction: column;
  padding: 30rpx;
  border: 1rpx solid #dbe6f7;
  border-radius: 30rpx;
  background: linear-gradient(135deg, rgba(247, 250, 255, 0.98), rgba(255, 255, 255, 0.96) 62%, rgba(244, 248, 255, 0.98));
  box-shadow: 0 18rpx 46rpx rgba(31, 88, 168, 0.09);
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.profile-guest-card .profile-avatar-shell {
  flex-basis: 128rpx;
}

.profile-card-top {
  display: flex;
  align-items: flex-start;
  width: 100%;
  gap: 18rpx;
}

.profile-avatar-shell {
  position: relative;
  flex: 0 0 128rpx;
}

.profile-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: #edf5ff;
}

.profile-avatar.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #1677ff, #20c997);
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 900;
}

.profile-main {
  flex: 1;
  min-width: 0;
}

.profile-kicker {
  color: #1677ff;
  font-size: 20rpx;
  font-weight: 900;
}

.profile-name {
  margin-top: 6rpx;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.15;
}

.profile-sub {
  margin-top: 10rpx;
  color: #7d8898;
  font-size: 22rpx;
  line-height: 1.4;
}

.profile-edit-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(31, 88, 168, 0.08);
}

.profile-edit-icon-image {
  width: 24rpx;
  height: 24rpx;
}

.profile-section {
  margin-top: 24rpx;
}

.view-history-panel {
  padding: 0 22rpx;
  overflow: hidden;
}

.view-history-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 118rpx;
  color: #8994a5;
  font-size: 23rpx;
  line-height: 1.4;
  text-align: center;
}

.view-history-empty.retry {
  color: #1677ff;
}

.view-history-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 126rpx;
  border-bottom: 1rpx solid #edf1f6;
}

.view-history-item:last-child {
  border-bottom: 0;
}

.view-history-cover {
  flex: 0 0 78rpx;
  width: 78rpx;
  height: 78rpx;
  border-radius: 16rpx;
  background: #eef4ff;
}

.view-history-main {
  flex: 1;
  min-width: 0;
}

.view-history-title {
  overflow: hidden;
  color: #172033;
  font-size: 27rpx;
  font-weight: 850;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.view-history-time {
  margin-top: 8rpx;
  color: #8994a5;
  font-size: 22rpx;
  line-height: 1.3;
}

.view-history-arrow {
  flex: 0 0 auto;
  color: #a0aabd;
  font-size: 38rpx;
  line-height: 1;
}

.view-history-more {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 82rpx;
  border-top: 1rpx solid #edf1f6;
  color: #1677ff;
  font-size: 23rpx;
  font-weight: 800;
}

.view-history-more-arrow {
  color: #6e9de8;
  font-size: 34rpx;
  font-weight: 400;
  line-height: 1;
}

.membership-entry,
.referral-entry {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  box-sizing: border-box;
}

.membership-entry {
  position: relative;
  overflow: hidden;
  min-height: 126rpx;
  color: #ffffff;
  background: linear-gradient(118deg, #155eef 0%, #1489df 48%, #13a99f 100%);
  box-shadow: 0 18rpx 42rpx rgba(21, 94, 239, 0.2);
}

.membership-entry::before {
  content: "";
  position: absolute;
  right: -72rpx;
  top: -104rpx;
  width: 270rpx;
  height: 270rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  box-shadow: 0 0 0 26rpx rgba(255, 255, 255, 0.05), 0 0 0 52rpx rgba(255, 255, 255, 0.035);
  pointer-events: none;
}

.membership-entry-mark {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 82rpx;
  height: 82rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 26rpx;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.3), rgba(255, 255, 255, 0.11));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.24), 0 10rpx 22rpx rgba(5, 72, 162, 0.18);
}

.membership-entry-icon {
  width: 62rpx;
  height: 62rpx;
}

.membership-entry-main { position: relative; z-index: 1; flex: 1; min-width: 0; }
.membership-entry-title, .referral-entry-title { font-size: 28rpx; font-weight: 900; }
.membership-entry-sub, .referral-entry-sub { margin-top: 7rpx; font-size: 21rpx; line-height: 1.45; opacity: 0.9; }
.membership-entry-sub { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.membership-entry-action {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  min-width: 76rpx;
  height: 48rpx;
  padding: 0 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.34);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.15);
  font-size: 22rpx;
  font-weight: 900;
  box-sizing: border-box;
}
.referral-entry { justify-content: space-between; margin-top: 14rpx; border: 1rpx solid #dbeafe; background: #ffffff; }
.referral-entry-sub { color: #718096; }
.referral-entry-value { color: #f59e0b; font-size: 32rpx; font-weight: 900; }

.namecard-entry {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 14rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #dbeafe;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #ffffff, #f6fbff);
  box-shadow: 0 14rpx 34rpx rgba(31, 88, 168, 0.07);
  box-sizing: border-box;
}

.namecard-mark {
  flex: 0 0 auto;
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: #1677ff;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 900;
}

.namecard-main {
  flex: 1;
  min-width: 0;
}

.namecard-title {
  color: #172033;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.25;
}

.namecard-sub {
  margin-top: 6rpx;
  color: #7d8898;
  font-size: 21rpx;
  line-height: 1.35;
}

.namecard-action {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 86rpx;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #eef6ff;
  color: #1677ff;
  font-size: 20rpx;
  font-weight: 900;
  white-space: nowrap;
  box-sizing: border-box;
}

.section-title {
  margin: 0 0 12rpx 4rpx;
  color: #172033;
  font-size: 28rpx;
  font-weight: 900;
}

.resource-hub-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #d8e8ff;
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(247, 250, 255, 0.98), rgba(255, 255, 255, 0.96) 56%, rgba(244, 248, 255, 0.98));
  box-shadow: 0 16rpx 40rpx rgba(31, 88, 168, 0.08);
  box-sizing: border-box;
}

.resource-hub-top,
.scene-card-top,
.settings-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.resource-hub-top {
  align-items: flex-start;
}

.resource-hub-top > view:first-child {
  flex: 1;
  min-width: 0;
}

.resource-hub-title {
  color: #111827;
  font-size: 29rpx;
  font-weight: 900;
}

.resource-hub-sub {
  margin-top: 6rpx;
  color: #6b7688;
  font-size: 22rpx;
  line-height: 1.4;
}

.resource-score-box {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
  max-width: 360rpx;
  flex-wrap: wrap;
}

.resource-score-main,
.resource-score-sub,
.resource-rule-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 42rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  white-space: nowrap;
}

.resource-score-main {
  color: #1677ff;
  background: #ffffff;
  border: 1rpx solid #dbeafe;
  font-size: 20rpx;
  font-weight: 900;
}

.resource-score-main text {
  margin-right: 6rpx;
  color: #f59e0b;
  font-size: 32rpx;
  line-height: 1;
  font-weight: 900;
}

.resource-score-sub {
  color: #1677ff;
  background: #eef5ff;
  font-size: 19rpx;
  font-weight: 900;
}

.resource-rule-btn {
  color: #172033;
  background: #ffffff;
  border: 1rpx solid #e4e7ec;
  font-size: 19rpx;
  font-weight: 900;
}

.resource-primary-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid #dfe8f5;
  box-shadow: 0 10rpx 24rpx rgba(31, 88, 168, 0.06);
  box-sizing: border-box;
}

.resource-primary-main {
  min-width: 0;
  flex: 1;
}

.resource-primary-title {
  color: #111827;
  font-size: 26rpx;
  font-weight: 900;
}

.resource-primary-desc {
  margin-top: 4rpx;
  color: #6b7688;
  font-size: 20rpx;
  line-height: 1.35;
}

.resource-primary-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 120rpx;
  height: 48rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #1677ff;
  color: #ffffff;
  font-size: 21rpx;
  font-weight: 900;
  white-space: nowrap;
}

.resource-tool-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
}

.resource-tool-card {
  min-width: 0;
  min-height: 142rpx;
  padding: 16rpx 8rpx 12rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid #dfe8f5;
  box-shadow: 0 10rpx 24rpx rgba(31, 88, 168, 0.06);
  box-sizing: border-box;
}

.resource-tool-card.open {
  border-color: #bfdbfe;
}

.resource-tool-card.muted {
  background: rgba(255, 255, 255, 0.68);
}

.resource-tool-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  margin: 0 auto;
  border-radius: 16rpx;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
}

.resource-tool-icon.green {
  background: #16a34a;
}

.resource-tool-icon.blue {
  background: #1677ff;
}

.resource-tool-icon.orange {
  background: #f59e0b;
}

.resource-tool-title {
  margin-top: 12rpx;
  color: #111827;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.25;
  text-align: center;
  min-height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.resource-tool-desc {
  margin-top: 6rpx;
  color: #6b7688;
  font-size: 17rpx;
  line-height: 1.3;
  text-align: center;
}

.resource-hub-note {
  display: flex;
  align-items: center;
  min-height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(244, 247, 251, 0.92);
  color: #667085;
  font-size: 20rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.resource-secondary-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
}

.resource-secondary-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  min-width: 0;
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid #e3ebf6;
  box-sizing: border-box;
}

.resource-secondary-name {
  min-width: 0;
  color: #344054;
  font-size: 21rpx;
  font-weight: 800;
}

.resource-secondary-tag {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 30rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: #f4f7fb;
  color: #667085;
  font-size: 16rpx;
  font-weight: 900;
  white-space: nowrap;
}

.scene-card {
  padding: 24rpx;
}

.scene-current-title {
  color: #172033;
  font-size: 28rpx;
  font-weight: 900;
}

.scene-current-sub {
  margin-top: 6rpx;
  color: #7d8898;
  font-size: 22rpx;
  line-height: 1.36;
}

.scene-card-main {
  min-width: 0;
  flex: 1;
}

.scene-edit-btn {
  flex: 0 0 auto;
  min-width: 126rpx;
  height: 52rpx;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #1677ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
  box-sizing: border-box;
}

.scene-edit-btn::after {
  border: 0;
}

.mode-choice-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 18rpx;
}

.mode-choice-grid.compact {
  margin-top: 16rpx;
}

.mode-choice {
  min-width: 0;
  padding: 16rpx 8rpx 14rpx;
  border: 1rpx solid #e7edf5;
  border-radius: 16rpx;
  background: #f8fbff;
  text-align: center;
  box-sizing: border-box;
}

.mode-choice.active {
  border-color: #1677ff;
  background: linear-gradient(180deg, #eef5ff, #e3efff);
  box-shadow: 0 10rpx 22rpx rgba(22, 119, 255, 0.08);
}

.mode-choice-icon {
  width: 48rpx;
  height: 48rpx;
  margin: 0 auto 8rpx;
  border-radius: 14rpx;
  color: #ffffff;
  background: #1677ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 900;
}

.mode-choice-name {
  color: #344054;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.2;
}

.content-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  padding: 18rpx 16rpx;
}

.content-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 168rpx;
  padding: 14rpx 10rpx 12rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #ffffff, #fbfcff);
  border: 1rpx solid #e7edf5;
  box-sizing: border-box;
}

.icon-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  min-width: 0;
}

.icon-badge {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.08);
}

.icon-badge.blue {
  background: #1677ff;
}

.icon-badge.green {
  background: #11924d;
}

.icon-badge-dot {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: #e5484d;
  color: #ffffff;
  font-size: 16rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.content-item > text {
  display: block;
  width: 100%;
  margin-top: 14rpx;
  color: #172033;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.25;
  text-align: center;
  word-break: keep-all;
}

.settings-panel {
  margin-top: 14rpx;
  padding: 8rpx 24rpx 4rpx;
}

.settings-row {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #edf2f8;
}

.settings-row:last-child {
  border-bottom: none;
}

.settings-title {
  color: #172033;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.25;
}

.settings-desc {
  margin-top: 6rpx;
  color: #7d8898;
  font-size: 21rpx;
  line-height: 1.4;
}

.settings-arrow {
  color: #9aa4b2;
  font-size: 36rpx;
  font-weight: 400;
  line-height: 1;
}

.settings-row.danger .settings-title {
  color: #e5484d;
}

/* 我的页按参考稿收口：身份、资产、客户信号和设置四层信息。 */
.profile-card {
  padding: 34rpx 30rpx;
  border-radius: 30rpx;
  margin-bottom: 28rpx;
}

.profile-card-top {
  align-items: center;
  gap: 24rpx;
}

.profile-avatar {
  width: 128rpx;
  height: 128rpx;
  border: 4rpx solid #ffffff;
  box-sizing: border-box;
  box-shadow: 0 8rpx 20rpx rgba(44, 73, 117, 0.12);
}

.profile-avatar.fallback {
  position: relative;
  overflow: hidden;
  background: #d9dde7;
  color: #ffffff;
  font-size: 0;
}

.profile-avatar.fallback::before {
  content: "";
  position: absolute;
  left: 45rpx;
  top: 23rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
}

.profile-avatar.fallback::after {
  content: "";
  position: absolute;
  left: 25rpx;
  top: 68rpx;
  width: 78rpx;
  height: 42rpx;
  border-radius: 48rpx 48rpx 26rpx 26rpx;
  background: rgba(255, 255, 255, 0.9);
}

.profile-main {
  flex: 1 1 auto;
  min-width: 0;
  align-self: center;
}

.profile-name {
  margin-top: 0;
  font-size: 38rpx;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.profile-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #60708a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.profile-edit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 160rpx;
  width: 160rpx;
  min-width: 160rpx;
  max-width: 160rpx;
  height: 64rpx;
  margin-left: auto;
  margin-right: 0;
  padding: 0;
  border: 2rpx solid #b9d7ff;
  border-radius: 14rpx;
  color: #1677ff;
  background: rgba(255, 255, 255, 0.72);
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1;
  white-space: nowrap;
  box-sizing: border-box;
}

.profile-edit-btn::after {
  border: 0;
}

.profile-section {
  margin-top: 28rpx;
}

.section-title {
  margin: 0 0 16rpx 4rpx;
  font-size: 32rpx;
  line-height: 1.25;
}

.assets-panel {
  padding: 0;
  overflow: hidden;
}

.asset-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.asset-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 190rpx;
  border-right: 1rpx solid #e8edf5;
  box-sizing: border-box;
}

.asset-share-button {
  width: auto;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  color: inherit;
  background: transparent;
  font-size: inherit;
  line-height: inherit;
}

.asset-share-button::after {
  border: 0;
}

.asset-share-pending {
  color: #98a2b3;
}

.asset-item:last-child {
  border-right: 0;
}

.asset-icon {
  width: 64rpx;
  height: 64rpx;
}

.asset-item text {
  margin-top: 16rpx;
  color: #172033;
  font-size: 27rpx;
  line-height: 1.2;
  text-align: center;
}

.profile-business-card-share-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 750rpx;
  height: 1800rpx;
  pointer-events: none;
}

.asset-message-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 102rpx;
  padding: 0 28rpx;
  border-top: 1rpx solid #e8edf5;
  box-sizing: border-box;
}

.asset-message-leading,
.referral-entry-leading,
.referral-entry-trailing,
.settings-leading {
  display: flex;
  align-items: center;
}

.asset-message-leading {
  gap: 18rpx;
}

.asset-message-icon {
  width: 46rpx;
  height: 46rpx;
}

.asset-message-leading > text {
  color: #172033;
  font-size: 28rpx;
}

.asset-unread {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #e5484d;
  color: #ffffff;
  font-size: 19rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.asset-arrow,
.customer-signal-arrow,
.referral-entry-arrow,
.settings-arrow {
  color: #98a2b3;
  font-size: 46rpx;
  font-weight: 300;
  line-height: 1;
}

.customer-signal-entry {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 168rpx;
  padding: 30rpx 30rpx 30rpx 34rpx;
  overflow: hidden;
  border-radius: 28rpx;
  color: #0b4ba3;
  background: linear-gradient(118deg, #dbe8ff 0%, #c9dbff 66%, #eaf2ff 100%);
  box-sizing: border-box;
}

.customer-signal-entry::after {
  content: "";
  position: absolute;
  right: -30rpx;
  bottom: -78rpx;
  width: 380rpx;
  height: 200rpx;
  border: 1rpx solid rgba(59, 130, 246, 0.2);
  border-radius: 50%;
  box-shadow: 0 0 0 28rpx rgba(59, 130, 246, 0.08);
  pointer-events: none;
}

.customer-signal-copy {
  position: relative;
  z-index: 1;
}

.customer-signal-title {
  color: #0b4ba3;
  font-size: 34rpx;
  font-weight: 900;
}

.customer-signal-sub {
  margin-top: 12rpx;
  color: #496a9d;
  font-size: 26rpx;
}

.customer-signal-arrow {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  color: #2477de;
  background: #ffffff;
  font-size: 48rpx;
}

.referral-entry {
  min-height: 102rpx;
  margin-top: 18rpx;
  padding: 0 28rpx;
  border: 1rpx solid #f6dcae;
  border-radius: 24rpx;
  background: #fffaf1;
  box-sizing: border-box;
}

.referral-entry-leading {
  gap: 18rpx;
}

.referral-entry-icon {
  width: 48rpx;
  height: 48rpx;
}

.referral-entry-title {
  color: #172033;
  font-size: 28rpx;
  font-weight: 800;
}

.referral-entry-trailing {
  gap: 8rpx;
}

.referral-entry-value {
  color: #f59e0b;
  font-size: 32rpx;
  font-weight: 900;
}

.referral-entry-arrow {
  color: #a7adb7;
  font-size: 42rpx;
}

.settings-panel {
  margin-top: 0;
  padding: 0 28rpx;
}

.settings-row {
  min-height: 94rpx;
  padding: 18rpx 0;
}

.settings-leading {
  min-width: 0;
  gap: 18rpx;
}

.settings-icon {
  flex: 0 0 auto;
  width: 42rpx;
  height: 42rpx;
}

.settings-title {
  font-size: 27rpx;
  font-weight: 800;
}

.settings-desc {
  margin-top: 5rpx;
  font-size: 21rpx;
}

.settings-row.danger .settings-title {
  color: #172033;
}

.profile-editor-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 80;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: rgba(15, 23, 42, 0.42);
}

.profile-editor {
  position: relative;
  width: 100%;
  max-height: 86vh;
  padding: 30rpx 30rpx calc(34rpx + env(safe-area-inset-bottom));
  border-radius: 30rpx 30rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
  overflow-y: auto;
}

.editor-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 66rpx;
}

.editor-title {
  color: #172033;
  font-size: 34rpx;
  font-weight: 900;
}

.editor-desc {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.45;
}

.editor-close {
  position: absolute;
  top: 22rpx;
  right: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  line-height: 1;
  border-radius: 50%;
  background: transparent;
  color: #64748b;
  font-size: 36rpx;
  font-weight: 900;
  z-index: 2;
}

.editor-avatar-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-top: 26rpx;
}

.editor-avatar-button {
  position: relative;
  z-index: 3;
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 260rpx;
  height: 178rpx;
  margin: 0;
  padding: 12rpx 18rpx;
  border: 2rpx solid #d6e4f2;
  border-radius: 20rpx;
  background: #f8fbff;
  box-sizing: border-box;
  color: #1677ff;
  line-height: 1.2;
  font-size: 21rpx;
  overflow: visible;
}

.editor-avatar-button::after {
  border: 0;
}

.editor-avatar-button-hover {
  background: #eef6ff;
  border-color: #9cc7ff;
}

.editor-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: #edf5ff;
  pointer-events: none;
}

.editor-avatar.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #1677ff, #20c997);
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 900;
}

.editor-avatar-action-text {
  margin-top: 8rpx;
  color: #1677ff;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.2;
  white-space: nowrap;
}

.editor-secondary,
.editor-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.editor-secondary::after,
.editor-primary::after {
  border: 0;
}

.form-field {
  margin-top: 22rpx;
}

.field-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.field-label {
  color: #344054;
  font-size: 24rpx;
  font-weight: 800;
}

.same-phone-btn {
  flex: 0 0 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 38rpx;
  margin: 0;
  padding: 0;
  border-radius: 10rpx;
  background: transparent;
  color: #1677ff;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 1;
  white-space: nowrap;
  box-sizing: border-box;
}

.field-input {
  width: 100%;
  height: 82rpx;
  margin-top: 12rpx;
  padding: 0 22rpx;
  border-radius: 18rpx;
  background: #f8fafc;
  color: #172033;
  font-size: 25rpx;
  box-sizing: border-box;
}

.profile-legal-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 24rpx;
  color: #667085;
  font-size: 21rpx;
  line-height: 1.5;
}

.profile-legal-checkbox {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  margin-top: 1rpx;
  border: 2rpx solid #cbd5e1;
  border-radius: 8rpx;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1;
  box-sizing: border-box;
}

.profile-legal-checkbox.checked {
  border-color: #1677ff;
  background: #1677ff;
}

.profile-legal-copy {
  flex: 1;
  min-width: 0;
}

.profile-legal-copy text {
  color: #1662c4;
  font-weight: 900;
}

.editor-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 30rpx;
}

.editor-secondary,
.editor-primary {
  width: 100%;
  height: 72rpx;
  font-size: 25rpx;
  font-weight: 900;
}

.editor-secondary {
  color: #667085;
  background: #f4f7fb;
}

.editor-primary {
  color: #ffffff;
  background: #1677ff;
}

.resource-rule-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 90;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 28rpx;
  background: rgba(15, 23, 42, 0.36);
  box-sizing: border-box;
}

.resource-rule-modal {
  width: 100%;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 24rpx 70rpx rgba(15, 23, 42, 0.18);
  box-sizing: border-box;
}

.rule-modal-title {
  color: #111827;
  font-size: 30rpx;
  font-weight: 900;
}

.rule-modal-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 64rpx;
  border-top: 1rpx solid #edf2f7;
  color: #344054;
  font-size: 23rpx;
  font-weight: 800;
}

.rule-modal-row:nth-child(2) {
  margin-top: 14rpx;
  border-top: 0;
}

.rule-modal-row strong {
  color: #079455;
  font-size: 24rpx;
  font-weight: 900;
  white-space: nowrap;
}

.rule-modal-btn {
  width: 100%;
  height: 72rpx;
  margin-top: 22rpx;
}
