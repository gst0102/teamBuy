<view class="page-shell referral-page">
  <custom-nav showBack="{{true}}" title="推广中心" />

  <view wx:if="{{loading}}" class="state-card">
    <view class="state-spinner"></view>
    <view class="state-title">正在加载推广中心</view>
    <view class="state-copy">正在读取收益、推广和提现规则。</view>
  </view>

  <view wx:elif="{{loadError}}" class="state-card error-state-card">
    <view class="state-icon">!</view>
    <view class="state-title">暂时无法加载推广数据</view>
    <view class="state-copy">{{loadError}}</view>
    <button class="state-retry-btn" bindtap="retryLoad">重新加载</button>
  </view>

  <block wx:elif="{{loaded}}">
    <view wx:if="{{refreshing}}" class="refresh-status">正在更新最新推广数据…</view>
    <view wx:if="{{refreshError}}" class="refresh-error">{{refreshError}}</view>

    <view class="overview-card {{center.canWithdraw ? 'overview-ready' : ''}}">
      <view class="overview-topline">
        <view class="overview-kicker">分享内容自动归因</view>
        <view class="eligibility-pill" wx:if="{{center.eligibleForRewards}}">当前会员有效</view>
        <view class="eligibility-pill muted" wx:else>当前未开通会员</view>
      </view>
      <view class="overview-copy">分享商品、资料或合集后，好友完成有效会员付费，按规则获得推广奖励。</view>
      <view class="balance-row">
        <view class="balance-main">
          <view class="balance-label">可提现</view>
          <view class="balance-amount">¥{{center.totals.availableYuan}}</view>
        </view>
        <view class="withdraw-entry" bindtap="goToWithdrawal">
          <text>去提现</text>
          <text class="entry-arrow">›</text>
        </view>
      </view>
      <view class="balance-meta" wx:if="{{center.rulesReady}}">最低提现 ¥{{center.minimumWithdrawalYuan}} · {{center.feeText}}</view>
      <view class="balance-meta warning" wx:else>提现规则暂未加载完成，当前不能申请提现。</view>
    </view>

    <view class="share-action-card">
      <view class="share-action-copy">
        <view class="section-kicker">继续分享，积累有效推广</view>
        <view class="share-action-title">分享你已经整理好的内容</view>
        <view class="share-action-sub">分享资料、名片或合集，好友开通会员后可按规则获得奖励。</view>
      </view>
      <button class="share-action-btn" bindtap="goToLibrary">去分享资料</button>
    </view>

    <view class="stats-card">
      <view class="stats-title-row">
        <view class="section-title">推广进度</view>
        <view class="stats-hint">点击数字查看详情</view>
      </view>
      <view class="stats-grid">
        <view class="stat-item" bindtap="goToDetail" data-tab="friends">
          <view class="stat-icon coral">邀</view>
          <view class="stat-value">{{center.inviteeCount}}</view>
          <view class="stat-label">已邀请</view>
          <view class="stat-arrow">›</view>
        </view>
        <view class="stat-item" bindtap="goToDetail" data-tab="friends">
          <view class="stat-icon sage">开</view>
          <view class="stat-value">{{center.paidInviteeCount}}</view>
          <view class="stat-label">已开通</view>
          <view class="stat-arrow">›</view>
        </view>
        <view class="stat-item" bindtap="goToDetail" data-tab="earnings">
          <view class="stat-icon amber">¥</view>
          <view class="stat-value money">¥{{center.rewardTotalYuan}}</view>
          <view class="stat-label">累计收益</view>
          <view class="stat-arrow">›</view>
        </view>
      </view>
      <view class="progress-note" wx:if="{{center.canWithdraw}}">当前可提现余额已达到最低申请金额。</view>
      <view class="progress-note" wx:elif="{{center.rulesReady && center.balanceReady}}">达到最低提现金额 ¥{{center.minimumWithdrawalYuan}} 后即可申请提现。</view>
      <view class="progress-note warning" wx:else>收益和提现规则加载完成后，会显示下一步操作。</view>
    </view>

    <view class="activity-card" wx:if="{{center.recentRewards.length}}">
      <view class="section-head">
        <view class="section-title">最近推广动态</view>
        <view class="view-more" bindtap="goToDetail" data-tab="earnings">查看全部 ›</view>
      </view>
      <view class="activity-row" wx:for="{{center.recentRewards}}" wx:key="id">
        <view class="activity-icon">奖</view>
        <view class="activity-main">
          <view class="activity-title">{{item.inviteeNickname}}开通会员</view>
          <view class="activity-time">{{item.createdAtText}}</view>
        </view>
        <view class="activity-side">
          <view class="activity-amount">+¥{{item.amountYuan}}</view>
          <view class="activity-status">{{item.statusLabel}}</view>
        </view>
      </view>
    </view>

    <view class="entry-card">
      <view class="entry-row" bindtap="goToDetail" data-tab="earnings">
        <view class="entry-icon coral">账</view>
        <view class="entry-copy">
          <view class="entry-title">收益与推广</view>
          <view class="entry-sub">查看收益记录和推广好友</view>
        </view>
        <view class="entry-arrow">›</view>
      </view>
      <view class="entry-row" bindtap="toggleCommissionRules">
        <view class="entry-icon amber">规</view>
        <view class="entry-copy">
          <view class="entry-title">推广规则</view>
          <view class="entry-sub">了解奖励、会员资格和异常处理</view>
        </view>
        <view class="entry-arrow">{{showCommissionRules ? '⌃' : '⌄'}}</view>
      </view>
    </view>

    <view wx:if="{{showCommissionRules}}" class="commission-rules-card">
      <view class="rules-title">推广规则</view>
      <view class="rule-row">
        <view class="rule-mark coral">链</view>
        <view class="rule-content">
          <view class="rule-label">分享归因</view>
          <view class="rule-copy">好友通过你的商品、资料或合集链接进入并使用，系统自动将你记为直接推广人，无需复制邀请码。</view>
        </view>
      </view>
      <view class="rule-row">
        <view class="rule-mark sage">会</view>
        <view class="rule-content">
          <view class="rule-label">会员资格</view>
          <view class="rule-copy">{{center.rewardEligibilityText}}</view>
        </view>
      </view>
      <view class="rule-row">
        <view class="rule-mark amber">50%</view>
        <view class="rule-content">
          <view class="rule-label">奖励比例</view>
          <view class="rule-copy">有效首购和续费按好友实际支付金额的 {{center.rewardRatioPercent}}% 计算。</view>
        </view>
      </view>
      <view class="rule-row">
        <view class="rule-mark muted">级</view>
        <view class="rule-content">
          <view class="rule-label">邀请层级</view>
          <view class="rule-copy">仅一级直接邀请，不做二级自动奖励。</view>
        </view>
      </view>
      <view class="rule-row last">
        <view class="rule-mark muted">退</view>
        <view class="rule-content">
          <view class="rule-label">异常处理</view>
          <view class="rule-copy">退款、刷单或异常交易会撤销或冻结对应奖励。</view>
        </view>
      </view>
    </view>
  </block>
</view>
