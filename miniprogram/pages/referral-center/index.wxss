page {
  background: #fff8f1;
  color: #3c2b27;
}

.page-shell {
  min-height: 100vh;
  padding: 12rpx 28rpx 56rpx;
  background:
    radial-gradient(circle at 92% 4%, rgba(246, 178, 107, 0.28), transparent 260rpx),
    linear-gradient(180deg, #fff8f1 0%, #fffaf5 46%, #fffdfb 100%);
  box-sizing: border-box;
}

button,
button::after {
  border: 0;
}

button {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 24rpx;
  line-height: 1;
  box-sizing: border-box;
}

.state-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 20rpx;
  padding: 72rpx 34rpx;
  border: 1rpx solid #f2dfd1;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 16rpx 42rpx rgba(155, 76, 44, 0.08);
  text-align: center;
}

.state-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 6rpx solid #f9d9c6;
  border-top-color: #e86f51;
  border-radius: 50%;
  animation: referral-spin 0.9s linear infinite;
}

@keyframes referral-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.state-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #fff0e8;
  color: #c5573f;
  font-size: 34rpx;
  font-weight: 900;
}

.state-title {
  margin-top: 24rpx;
  color: #3c2b27;
  font-size: 30rpx;
  font-weight: 900;
}

.state-copy {
  max-width: 600rpx;
  margin-top: 12rpx;
  color: #8e756b;
  font-size: 23rpx;
  line-height: 1.6;
}

.state-retry-btn {
  min-width: 220rpx;
  min-height: 76rpx;
  margin-top: 28rpx;
  border-radius: 20rpx;
  background: #e86f51;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 900;
}

.refresh-status,
.refresh-error {
  margin: 12rpx 4rpx 0;
  color: #9a786b;
  font-size: 21rpx;
  line-height: 1.5;
  text-align: center;
}

.refresh-error {
  color: #b85a43;
}

.overview-card {
  position: relative;
  overflow: hidden;
  margin-top: 18rpx;
  padding: 30rpx 30rpx 28rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #ef7655 0%, #e85e45 62%, #d9543c 100%);
  color: #ffffff;
  box-shadow: 0 20rpx 46rpx rgba(197, 82, 55, 0.22);
}

.overview-card::after {
  content: "";
  position: absolute;
  right: -110rpx;
  top: -90rpx;
  width: 360rpx;
  height: 360rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 50%;
  box-shadow: 0 0 0 42rpx rgba(255, 255, 255, 0.06), 0 0 0 84rpx rgba(255, 255, 255, 0.04);
  pointer-events: none;
}

.overview-topline,
.balance-row,
.stats-title-row,
.section-head,
.entry-row,
.activity-row {
  display: flex;
  align-items: center;
}

.overview-topline {
  position: relative;
  z-index: 1;
  justify-content: space-between;
  gap: 16rpx;
}

.overview-kicker {
  color: rgba(255, 255, 255, 0.9);
  font-size: 23rpx;
  font-weight: 900;
}

.eligibility-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 46rpx;
  padding: 0 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.34);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  color: #fff9f2;
  font-size: 20rpx;
  font-weight: 800;
  white-space: nowrap;
}

.eligibility-pill.muted {
  color: #fff1e8;
}

.overview-copy {
  position: relative;
  z-index: 1;
  margin-top: 16rpx;
  max-width: 620rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 23rpx;
  line-height: 1.55;
}

.balance-row {
  position: relative;
  z-index: 1;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 30rpx;
}

.balance-main {
  min-width: 0;
}

.balance-label {
  color: rgba(255, 255, 255, 0.84);
  font-size: 22rpx;
  font-weight: 800;
}

.balance-amount {
  margin-top: 6rpx;
  color: #ffffff;
  font-size: 70rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 900;
  letter-spacing: 1rpx;
  line-height: 1.05;
}

.withdraw-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 158rpx;
  min-height: 74rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.56);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.17);
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 900;
  white-space: nowrap;
}

.entry-arrow {
  margin-left: 8rpx;
  font-size: 34rpx;
  font-weight: 400;
  line-height: 1;
}

.balance-meta {
  position: relative;
  z-index: 1;
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: 21rpx;
  line-height: 1.5;
}

.balance-meta.warning {
  color: #ffe6d6;
}

.share-action-card,
.stats-card,
.activity-card,
.entry-card,
.commission-rules-card {
  margin-top: 18rpx;
  border: 1rpx solid #f2e3d8;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 12rpx 32rpx rgba(155, 76, 44, 0.06);
  box-sizing: border-box;
}

.share-action-card {
  padding: 24rpx 24rpx 22rpx;
}

.section-kicker,
.stats-hint,
.activity-time,
.entry-sub,
.rule-copy {
  color: #9a8177;
  font-size: 21rpx;
  line-height: 1.55;
}

.share-action-title {
  margin-top: 8rpx;
  color: #3c2b27;
  font-size: 31rpx;
  font-weight: 900;
}

.share-action-sub {
  margin-top: 8rpx;
  color: #7f675d;
  font-size: 22rpx;
  line-height: 1.6;
}

.share-action-btn {
  width: 100%;
  min-height: 76rpx;
  margin-top: 18rpx;
  border-radius: 20rpx;
  background: #e86f51;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
}

.stats-card {
  padding: 24rpx 22rpx 20rpx;
}

.stats-title-row {
  justify-content: space-between;
  gap: 16rpx;
}

.section-title,
.rules-title {
  color: #3c2b27;
  font-size: 29rpx;
  font-weight: 900;
}

.stats-hint {
  color: #b09284;
  white-space: nowrap;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 20rpx;
}

.stat-item {
  position: relative;
  min-width: 0;
  padding: 14rpx 8rpx 16rpx;
  border-radius: 18rpx;
  background: #fff8f1;
  text-align: center;
}

.stat-icon,
.entry-icon,
.activity-icon,
.rule-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  font-weight: 900;
}

.stat-icon {
  width: 44rpx;
  height: 44rpx;
  margin: 0 auto;
  border-radius: 14rpx;
  font-size: 21rpx;
}

.stat-icon.coral,
.entry-icon.coral,
.activity-icon,
.rule-mark.coral { background: #ffe2d6; color: #d45e43; }
.stat-icon.sage,
.rule-mark.sage { background: #e8f2e5; color: #6b8e69; }
.stat-icon.amber,
.entry-icon.amber,
.rule-mark.amber { background: #fff0d7; color: #c78326; }
.entry-icon.muted,
.rule-mark.muted { background: #f2ece7; color: #8e756b; }

.stat-value {
  margin-top: 10rpx;
  color: #3c2b27;
  font-size: 38rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 900;
  line-height: 1.1;
}

.stat-value.money {
  font-size: 28rpx;
  letter-spacing: -1rpx;
}

.stat-label {
  margin-top: 6rpx;
  color: #967d72;
  font-size: 21rpx;
  white-space: nowrap;
}

.stat-arrow {
  position: absolute;
  top: 8rpx;
  right: 12rpx;
  color: #c9a99a;
  font-size: 28rpx;
}

.progress-note {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  background: #fff4e9;
  color: #a6664e;
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
}

.progress-note.warning {
  background: #fff1e9;
  color: #b85a43;
}

.activity-card {
  padding: 24rpx;
}

.section-head {
  justify-content: space-between;
  gap: 16rpx;
}

.view-more {
  color: #d45e43;
  font-size: 22rpx;
  white-space: nowrap;
}

.activity-row {
  gap: 14rpx;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f4e9e1;
}

.activity-icon {
  flex: 0 0 54rpx;
  width: 54rpx;
  height: 54rpx;
  border-radius: 18rpx;
  font-size: 22rpx;
}

.activity-main,
.entry-copy,
.rule-content {
  flex: 1;
  min-width: 0;
}

.activity-title,
.entry-title,
.rule-label {
  color: #49332b;
  font-size: 25rpx;
  font-weight: 800;
}

.activity-time {
  margin-top: 4rpx;
}

.activity-side {
  flex: 0 0 auto;
  text-align: right;
}

.activity-amount {
  color: #d45e43;
  font-size: 26rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 900;
}

.activity-status {
  margin-top: 4rpx;
  color: #a17855;
  font-size: 20rpx;
  white-space: nowrap;
}

.entry-card {
  overflow: hidden;
}

.entry-row {
  gap: 16rpx;
  min-height: 92rpx;
  padding: 0 24rpx;
}

.entry-row + .entry-row {
  border-top: 1rpx solid #f4e9e1;
}

.entry-icon {
  flex: 0 0 52rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 17rpx;
  font-size: 22rpx;
}

.entry-title {
  font-size: 27rpx;
}

.entry-sub {
  margin-top: 3rpx;
}

.entry-row > .entry-arrow {
  margin-left: 0;
  color: #c09a8a;
}

.commission-rules-card {
  padding: 24rpx;
}

.rules-title {
  padding-bottom: 4rpx;
}

.rule-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #f4e9e1;
}

.rule-row:first-of-type {
  margin-top: 12rpx;
}

.rule-row.last {
  padding-bottom: 2rpx;
}

.rule-mark {
  flex: 0 0 52rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  font-size: 21rpx;
  white-space: nowrap;
}

.rule-copy {
  margin-top: 4rpx;
  color: #806b61;
}
