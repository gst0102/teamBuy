<view class="page-shell capture-page">
  <custom-nav title="放进笔记库" />

  <view class="capture-head">
    <view class="hero-title">放进笔记库</view>
    <view class="hero-subtitle">随手记一条，房源和团购文案会自动整理成资料草稿。</view>
  </view>

  <view class="capture-space"></view>

  <view class="capture-panel">
    <textarea
      class="capture-input"
      value="{{inputText}}"
      focus="{{inputFocused}}"
      placeholder="记账、备忘、客户需求，或粘贴房源/团购文案..."
      maxlength="3000"
      show-confirm-bar="{{false}}"
      adjust-position="{{true}}"
      bindinput="handleInput"
    ></textarea>

    <view class="capture-toolbar">
      <button class="tool-btn text-tool" bindtap="handleInsertTag">#</button>
      <button class="tool-btn" loading="{{ocrUploading}}" disabled="{{ocrUploading}}" bindtap="handleImageUpload">图片</button>
      <button class="tool-btn" bindtap="handleInsertList">列表</button>
      <button class="tool-btn more-tool" bindtap="handleMore">...</button>
      <button class="send-btn" loading="{{saving}}" disabled="{{saving}}" bindtap="handleSubmit">发送</button>
    </view>
  </view>

  <view class="saved-bar" wx:if="{{savedBarVisible}}">
    <text>{{savedText}}</text>
    <text class="saved-link" bindtap="handleViewSaved">查看详情</text>
  </view>

  <view class="property-batch-card" wx:if="{{propertyBatchVisible}}">
    <view class="property-batch-head">
      <view>
        <view class="property-batch-kicker">房源批量识别</view>
        <view class="property-batch-title">识别到 {{propertyBatchCount}} 套房源</view>
      </view>
      <view class="property-batch-count">已选 {{propertyBatchSelectedCount}}</view>
    </view>

    <view class="property-private-notice">
      <text class="property-private-lock">私密</text>
      <text>已把{{propertyBatchPrivacyText}}放进上游备注，客户页不展示。</text>
    </view>

    <view class="property-candidate-list">
      <view
        class="property-candidate {{item.selected ? 'selected' : ''}}"
        wx:for="{{propertyBatchCandidates}}"
        wx:key="candidateId"
        data-index="{{index}}"
        bindtap="togglePropertyCandidate"
      >
        <view class="property-candidate-check">{{item.selected ? '✓' : ''}}</view>
        <view class="property-candidate-body">
          <view class="property-candidate-title">{{item.title}}</view>
          <view class="property-candidate-summary">{{item.summary || '待补充卖点'}}</view>
          <view class="property-candidate-price">{{item.price}}</view>
          <view class="property-tag-row" wx:if="{{item.publicTagsText}}">
            <text class="property-tag public">{{item.publicTagsText}}</text>
          </view>
          <view class="property-tag-row" wx:if="{{item.privateTagsText}}">
            <text class="property-tag private">仅自己看：{{item.privateTagsText}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="property-batch-actions">
      <button class="property-batch-secondary" bindtap="handlePropertyBatchSaveRaw">按普通资料保存</button>
      <button
        class="property-batch-primary"
        loading="{{propertyBatchCreating}}"
        disabled="{{propertyBatchCreating || !propertyBatchSelectedCount}}"
        bindtap="handlePropertyBatchCreate"
      >生成房源卡</button>
    </view>
  </view>

  <view class="business-card" wx:if="{{businessPromptVisible}}">
    <view class="business-close" bindtap="handleBusinessCancel">×</view>
    <view class="business-icon">{{businessPromptIcon}}</view>
    <view class="business-body">
      <view class="business-badge">已自动整理</view>
      <view class="business-title">{{businessPromptTitle}}</view>
      <view class="business-content">{{businessPromptContent}}</view>
    </view>
    <view class="workspace-suggestion">
      <view class="workspace-suggestion-title">是否切换到{{businessPromptWorkspaceName}}？</view>
      <view class="workspace-suggestion-desc">只切换首页和工作台展示，不改变资料归属，也不会删除资料。</view>
      <view class="workspace-actions">
        <button class="workspace-secondary" bindtap="handleWorkspaceStay">继续当前工作台</button>
        <button class="workspace-primary" bindtap="handleWorkspaceSwitch">切换到对应工作台</button>
      </view>
    </view>
    <view class="business-actions">
      <button class="business-secondary" bindtap="handleBusinessCancel">先放笔记库</button>
      <button class="business-primary" bindtap="handleBusinessConfirm">{{businessPromptConfirmText}}</button>
    </view>
  </view>
</view>
