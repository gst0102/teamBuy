.create-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 0 24rpx;
}

.create-visual {
  width: 176rpx;
  height: 176rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #dcebff, #ffffff);
  color: #1677ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 70rpx;
  font-weight: 900;
  box-shadow: 0 18rpx 46rpx rgba(31, 88, 168, 0.12);
}

.type-row {
  margin-bottom: 22rpx;
}

.textarea {
  min-height: 210rpx;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #edf2f8;
}

.switch-row:last-child {
  border-bottom: none;
}

.switch-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #172033;
}

.submit-bar {
  position: sticky;
  bottom: 0;
  padding: 18rpx 0 10rpx;
  background: rgba(248, 251, 255, 0.94);
}
