.capture-page {
  min-height: calc(100vh - 130rpx);
  display: flex;
  flex-direction: column;
  padding-bottom: 150rpx;
}

.capture-head {
  padding: 32rpx 0 18rpx;
}

.capture-space {
  flex: 1;
  min-height: 260rpx;
}

.capture-panel {
  width: 100%;
  min-height: 500rpx;
  box-sizing: border-box;
  padding: 30rpx 28rpx 24rpx;
  border-radius: 34rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 44rpx rgba(24, 39, 75, 0.08);
}

.capture-input {
  width: 100%;
  min-height: 360rpx;
  box-sizing: border-box;
  color: #182235;
  font-size: 34rpx;
  line-height: 1.55;
}

.capture-input::placeholder {
  color: #9aa8ba;
}

.capture-toolbar {
  min-height: 86rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #edf2f8;
}

.tool-btn,
.send-btn {
  margin: 0;
  padding: 0;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  white-space: nowrap;
}

.tool-btn::after,
.send-btn::after {
  border: none;
}

.tool-btn {
  min-width: 76rpx;
  height: 66rpx;
  border-radius: 16rpx;
  background: #f5f8fc;
  color: #41506a;
  font-size: 24rpx;
  font-weight: 800;
}

.text-tool {
  min-width: 64rpx;
  color: #1f2a3d;
  font-size: 38rpx;
}

.more-tool {
  letter-spacing: 2rpx;
}

.send-btn {
  width: 132rpx;
  height: 72rpx;
  margin-left: auto;
  border-radius: 999rpx;
  background: #25cf79;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  box-shadow: 0 12rpx 28rpx rgba(37, 207, 121, 0.26);
}

.send-btn[disabled] {
  background: #9ee6c4;
  color: rgba(255, 255, 255, 0.92);
}

.saved-bar {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(126rpx + env(safe-area-inset-bottom));
  z-index: 20;
  min-height: 76rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: rgba(20, 31, 48, 0.92);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  font-size: 25rpx;
  font-weight: 700;
  box-shadow: 0 14rpx 36rpx rgba(15, 23, 42, 0.2);
}

.saved-link {
  color: #7ee7b7;
  white-space: nowrap;
}

.property-batch-card {
  width: 100%;
  box-sizing: border-box;
  margin-top: 20rpx;
  padding: 28rpx;
  border-radius: 26rpx;
  background: #ffffff;
  border: 1rpx solid #dceee7;
  box-shadow: 0 18rpx 44rpx rgba(20, 83, 61, 0.1);
}

.property-batch-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.property-batch-kicker {
  color: #10805b;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.2;
}

.property-batch-title {
  margin-top: 8rpx;
  color: #162033;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.28;
}

.property-batch-count {
  min-width: 112rpx;
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #eefbf5;
  color: #10805b;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  font-weight: 900;
  white-space: nowrap;
}

.property-private-notice {
  margin-top: 18rpx;
  min-height: 70rpx;
  box-sizing: border-box;
  padding: 14rpx 16rpx;
  border-radius: 18rpx;
  background: #f8fbff;
  color: #4f6076;
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  line-height: 1.35;
}

.property-private-lock {
  min-width: 62rpx;
  height: 36rpx;
  border-radius: 999rpx;
  background: #142033;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 900;
  white-space: nowrap;
}

.property-candidate-list {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.property-candidate {
  box-sizing: border-box;
  padding: 18rpx;
  border-radius: 20rpx;
  border: 1rpx solid #e6edf5;
  background: #fbfdff;
  display: grid;
  grid-template-columns: 46rpx minmax(0, 1fr);
  gap: 16rpx;
}

.property-candidate.selected {
  border-color: #0f8b63;
  background: #f4fcf8;
}

.property-candidate-check {
  width: 42rpx;
  height: 42rpx;
  border-radius: 999rpx;
  background: #e9eff6;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 900;
}

.property-candidate.selected .property-candidate-check {
  background: #0f8b63;
}

.property-candidate-body {
  min-width: 0;
}

.property-candidate-title {
  color: #162033;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.35;
  word-break: break-word;
}

.property-candidate-summary {
  margin-top: 6rpx;
  color: #68778d;
  font-size: 23rpx;
  line-height: 1.35;
  word-break: break-word;
}

.property-candidate-price {
  margin-top: 8rpx;
  color: #c2472f;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.2;
}

.property-tag-row {
  margin-top: 10rpx;
  display: flex;
}

.property-tag {
  max-width: 100%;
  min-height: 40rpx;
  box-sizing: border-box;
  padding: 7rpx 12rpx;
  border-radius: 10rpx;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.25;
  word-break: break-word;
}

.property-tag.public {
  background: #e8f8f0;
  color: #0c7b58;
}

.property-tag.private {
  background: #fff5e6;
  color: #9b5a12;
}

.property-batch-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 16rpx;
  margin-top: 22rpx;
}

.property-batch-primary,
.property-batch-secondary {
  height: 82rpx;
  margin: 0;
  padding: 0 12rpx;
  border: none;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.15;
  font-size: 25rpx;
  font-weight: 900;
  white-space: nowrap;
}

.property-batch-primary::after,
.property-batch-secondary::after {
  border: none;
}

.property-batch-primary {
  background: #0f8b63;
  color: #ffffff;
}

.property-batch-primary[disabled] {
  background: #9cd8c2;
  color: rgba(255, 255, 255, 0.92);
}

.property-batch-secondary {
  background: #ffffff;
  color: #253149;
  border: 1rpx solid #dce5f0;
}

.business-card {
  position: relative;
  width: 100%;
  box-sizing: border-box;
  margin-top: 20rpx;
  padding: 34rpx 28rpx 26rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 44rpx rgba(24, 39, 75, 0.1);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.business-close {
  position: absolute;
  right: 24rpx;
  top: 22rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 999rpx;
  color: #5f7088;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  line-height: 1;
}

.business-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 999rpx;
  background: #25cf79;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 900;
  box-shadow: 0 14rpx 32rpx rgba(37, 207, 121, 0.26);
}

.business-body {
  width: 100%;
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.business-badge {
  min-width: 150rpx;
  max-width: 100%;
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #edfdf5;
  color: #16a968;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 900;
  white-space: nowrap;
}

.business-title {
  margin-top: 18rpx;
  color: #162033;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.28;
}

.business-content {
  margin-top: 12rpx;
  color: #5f7088;
  font-size: 26rpx;
  line-height: 1.55;
}

.workspace-suggestion {
  width: 100%;
  box-sizing: border-box;
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: #f6fbff;
  border: 1rpx solid #dcecff;
}

.workspace-suggestion-title {
  color: #162033;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.35;
  text-align: center;
}

.workspace-suggestion-desc {
  margin-top: 10rpx;
  color: #5f7088;
  font-size: 24rpx;
  line-height: 1.45;
  text-align: center;
}

.workspace-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 14rpx;
  margin-top: 20rpx;
}

.workspace-primary,
.workspace-secondary {
  min-height: 78rpx;
  margin: 0;
  padding: 0 14rpx;
  border: none;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.15;
  font-size: 24rpx;
  font-weight: 900;
  white-space: normal;
}

.workspace-primary::after,
.workspace-secondary::after {
  border: none;
}

.workspace-primary {
  background: #1677ff;
  color: #ffffff;
}

.workspace-secondary {
  background: #ffffff;
  color: #253149;
  border: 1rpx solid #dce5f0;
}

.business-actions {
  width: 100%;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
  gap: 16rpx;
  margin-top: 26rpx;
}

.business-primary,
.business-secondary {
  height: 82rpx;
  margin: 0;
  padding: 0 12rpx;
  border: none;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  font-size: 26rpx;
  font-weight: 900;
  white-space: nowrap;
}

.business-primary::after,
.business-secondary::after {
  border: none;
}

.business-primary {
  background: #1677ff;
  color: #ffffff;
}

.business-secondary {
  background: #ffffff;
  color: #253149;
  border: 1rpx solid #dce5f0;
}
