  min-height: 84rpx;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: #f8fafc;
  border: 2rpx solid #e5e7eb;
  color: #101828;
  font-size: 27rpx;
  line-height: 1.45;
  box-sizing: border-box;
}

.inline-editor-textarea {
  min-height: 180rpx;
}

.inline-editor-save {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 82rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #2563eb, #3b82f6);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1;
}

.inline-editor-save::after {
  display: none;
}

.image-editable {
  position: relative;
  outline: 3rpx solid rgba(37, 99, 235, 0.18);
  outline-offset: -3rpx;
}

.contact-add-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
