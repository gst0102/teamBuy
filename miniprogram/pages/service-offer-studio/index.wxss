  border: 2rpx dashed rgba(37, 99, 235, 0.18);
}

.inline-editable.light {
  display: grid;
  gap: 4rpx;
  padding-right: 72rpx;
  border-color: rgba(255, 255, 255, 0.28);
  background: rgba(255, 255, 255, 0.04);
}

.inline-editable.flat {
  border-radius: 14rpx;
}

.inline-edit-tip {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  height: 34rpx;
  min-width: 56rpx;
  padding: 0 12rpx;
