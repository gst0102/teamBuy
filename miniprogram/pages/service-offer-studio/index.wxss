}

.inline-editor-mask {
  position: fixed;
  inset: 0;
  z-index: 80;
  background: rgba(15, 23, 42, 0.34);
  display: flex;
  align-items: flex-end;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.inline-editor-panel {
  width: 100%;
  padding: 24rpx;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 -18rpx 60rpx rgba(15, 23, 42, 0.18);
  display: grid;
  gap: 18rpx;
  box-sizing: border-box;
}

.inline-editor-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.inline-editor-head view {
  color: #101828;
  font-size: 30rpx;
  line-height: 1.25;
  font-weight: 900;
}

.inline-editor-head text {
  flex: 0 0 auto;
  color: #667085;
  font-size: 24rpx;
  font-weight: 800;
}

.inline-editor-input,
