.service-studio {
  min-height: 100vh;
  width: 100%;
  padding-bottom: calc(250rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
  background:
    radial-gradient(circle at 0 0, rgba(59, 130, 246, 0.14), transparent 32%),
    linear-gradient(180deg, #f7fbff 0%, #f6f8fc 46%, #ffffff 100%);
}

.service-studio view,
.service-studio text,
.service-studio image,
.service-studio button,
.service-studio input,
.service-studio textarea,
.service-studio scroll-view {
  box-sizing: border-box;
}

.studio-surface {
  display: grid;
  gap: 24rpx;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  overflow-x: hidden;
  box-sizing: border-box;
}

.page-error-card {
  margin: 24rpx;
  padding: 28rpx;
  border-radius: 32rpx;
  background: #ffffff;
  border: 2rpx solid rgba(239, 68, 68, 0.18);
  box-shadow: 0 18rpx 40rpx rgba(15, 23, 42, 0.08);
}

.page-error-card > view:first-child {
  color: #b42318;
  font-size: 32rpx;
  font-weight: 900;
}

.page-error-card > text {
  display: block;
  margin-top: 12rpx;
  color: #667085;
  font-size: 25rpx;
  line-height: 1.5;
}

.page-error-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.page-error-actions button,
.bottom-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  line-height: 1;
  box-sizing: border-box;
}

.page-error-actions button {
  flex: 1;
  height: 76rpx;
  min-height: 76rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #2563eb;
  font-size: 26rpx;
  font-weight: 900;
}

.page-error-actions button:first-child {
  background: linear-gradient(135deg, #2563eb, #3b82f6);
  color: #ffffff;
}

.page-error-actions button::after,
.bottom-btn::after {
  display: none;
}

.studio-hero,
.existing-offer,
.stage-panel,
.studio-bottom {
  margin: 0;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

.studio-hero {
  padding: 30rpx 6rpx 0;
  min-width: 0;
}

.hero-kicker,
.style-preview-tip,
.template-menu-tag,
.style-feature-pill,
.form-top-switch,
.confirm-template-pill,
.mini-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.hero-kicker {
  height: 42rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(37, 99, 235, 0.1);
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 900;
}

.studio-title {
  margin-top: 18rpx;
  color: #0f172a;
  font-size: 44rpx;
  line-height: 1.18;
  font-weight: 900;
  max-width: 100%;
  white-space: normal;
  word-break: break-all;
}

.studio-subtitle {
  margin-top: 14rpx;
  color: #667085;
  font-size: 26rpx;
  line-height: 1.55;
  max-width: 100%;
  white-space: normal;
  word-break: break-word;
}

.existing-offer {
  padding: 24rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 2rpx solid rgba(37, 99, 235, 0.1);
  box-shadow: 0 16rpx 40rpx rgba(15, 23, 42, 0.07);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.existing-main {
  flex: 1;
  min-width: 0;
}

.existing-kicker {
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 900;
}

.existing-title {
  margin-top: 8rpx;
  color: #0f172a;
  font-size: 30rpx;
  line-height: 1.3;
  font-weight: 900;
}

.existing-sub {
  margin-top: 10rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.45;
}

.existing-actions {
  display: grid;
  gap: 12rpx;
}

.existing-actions view {
  min-width: 160rpx;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #f2f7ff;
  color: #2563eb;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  font-weight: 900;
  white-space: nowrap;
  box-sizing: border-box;
}

.template-menu-scroll {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  display: block;
  overflow: hidden;
  white-space: nowrap;
  padding: 0 2rpx;
  box-sizing: border-box;
}

.step-bar {
  width: 100%;
  max-width: 100%;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  box-sizing: border-box;
}

.step-item {
  min-width: 0;
  min-height: 78rpx;
  padding: 10rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.84);
  border: 2rpx solid rgba(15, 23, 42, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  box-sizing: border-box;
}

.step-item.active {
  border-color: rgba(37, 99, 235, 0.22);
  background: linear-gradient(135deg, #2563eb, #3b82f6);
  box-shadow: 0 16rpx 34rpx rgba(37, 99, 235, 0.22);
}

.step-index {
  width: 34rpx;
  height: 34rpx;
  border-radius: 12rpx;
  background: rgba(15, 23, 42, 0.08);
  color: #0f172a;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 900;
  flex: 0 0 auto;
}

.step-item.active .step-index {
  background: #ffffff;
  color: #2563eb;
}

.step-copy {
  display: grid;
  gap: 2rpx;
  min-width: 0;
}

.step-copy text:first-child {
  color: #0f172a;
  font-size: 25rpx;
  font-weight: 900;
  white-space: nowrap;
}

.step-copy text:last-child {
  color: #667085;
  font-size: 20rpx;
  white-space: nowrap;
}

.step-item.active .step-copy text:first-child,
.step-item.active .step-copy text:last-child {
  color: #ffffff;
}

.stage-panel {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  padding: 24rpx 22rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 20rpx 50rpx rgba(15, 23, 42, 0.08);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  display: grid;
  gap: 22rpx;
}

.stage-head {
  display: grid;
  gap: 10rpx;
}

.stage-title {
  color: #0f172a;
  font-size: 32rpx;
  line-height: 1.25;
  font-weight: 900;
  word-break: break-word;
}

.stage-desc {
  color: #667085;
  font-size: 24rpx;
  line-height: 1.5;
  white-space: normal;
  word-break: break-word;
}

.template-menu {
  display: inline-flex;
  gap: 14rpx;
  padding-bottom: 4rpx;
  padding-right: 2rpx;
  box-sizing: border-box;
}

.template-menu-item {
  width: 216rpx;
  min-height: 206rpx;
  padding: 18rpx 16rpx;
  border-radius: 24rpx;
  border: 2rpx solid rgba(15, 23, 42, 0.06);
  background: #f8fbff;
  display: grid;
  align-content: start;
  gap: 12rpx;
  box-sizing: border-box;
}

.template-menu-item.active {
  border-color: rgba(37, 99, 235, 0.28);
  background: linear-gradient(135deg, #eef5ff, #ffffff);
  box-shadow: 0 14rpx 30rpx rgba(37, 99, 235, 0.12);
}

.template-menu-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  min-width: 0;
}

.template-menu-badge {
  width: 48rpx;
  height: 48rpx;
  border-radius: 16rpx;
  background: #dbeafe;
  color: #2563eb;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 900;
  flex: 0 0 auto;
}

.template-menu-name {
  color: #0f172a;
  font-size: 27rpx;
  line-height: 1.25;
  font-weight: 900;
  white-space: normal;
  word-break: break-word;
}

.template-menu-tag {
  max-width: 128rpx;
  height: 34rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: rgba(37, 99, 235, 0.1);
  color: #2563eb;
  font-size: 20rpx;
  font-weight: 900;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.template-menu-desc {
  color: #667085;
  font-size: 22rpx;
  line-height: 1.4;
  white-space: normal;
  word-break: break-word;
}

.template-menu-state {
  min-height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(15, 23, 42, 0.05);
  color: #475467;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  justify-self: start;
  font-size: 20rpx;
  font-weight: 800;
  white-space: nowrap;
}

.template-menu-item.active .template-menu-state {
  background: rgba(37, 99, 235, 0.1);
  color: #2563eb;
}

.style-preview-wrap {
  width: calc(100% - 4rpx);
  max-width: 100%;
  min-width: 0;
  margin: 0 2rpx;
  padding: 20rpx;
  border-radius: 30rpx;
  background: linear-gradient(180deg, rgba(245, 248, 255, 0.96), #ffffff 76%);
  border: 2rpx solid rgba(226, 232, 240, 0.9);
  display: grid;
  gap: 20rpx;
}

.style-preview-head,
.form-top-card {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16rpx;
  min-width: 0;
}

.style-preview-head > view:first-child,
.form-top-card > view:first-child {
  flex: 1;
  min-width: 0;
}

.style-preview-title {
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.25;
  white-space: normal;
  word-break: break-word;
}

.style-preview-subtitle {
  margin-top: 8rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.45;
  white-space: normal;
  word-break: break-word;
}

.style-preview-tip {
  flex: 0 1 auto;
  max-width: 100%;
  height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #eef5ff;
  color: #2563eb;
  font-size: 20rpx;
  font-weight: 900;
  white-space: nowrap;
}

.preview-phone,
.confirm-phone {
  min-width: 0;
  width: calc(100% - 4rpx);
  max-width: 100%;
  margin: 0 2rpx;
  overflow: hidden;
  border-radius: 34rpx;
  background: #ffffff;
  border: 2rpx solid rgba(226, 232, 240, 0.92);
  box-shadow: 0 20rpx 40rpx rgba(15, 23, 42, 0.08);
}

.phone-status-row,
.confirm-phone-status {
  height: 48rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #0f172a;
  font-size: 20rpx;
  font-weight: 800;
}

.phone-hero,
.confirm-hero {
  margin: 0 12rpx 16rpx;
  border-radius: 28rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.phone-hero.consultation,
.phone-hero.campaign,
.confirm-hero.consultation,
.confirm-hero.campaign {
  min-height: 260rpx;
  padding: 24rpx 20rpx 0;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12rpx;
  box-sizing: border-box;
}

.phone-hero.pricing,
.confirm-hero.pricing {
  background: #f4fbf5;
}

.phone-hero.case,
.confirm-hero.case {
  padding: 24rpx 20rpx;
  box-sizing: border-box;
}

.case-hero-cover {
  width: 100%;
  height: 220rpx;
  margin-bottom: 18rpx;
  border-radius: 24rpx;
  display: block;
  background: linear-gradient(180deg, #eadbc8, #bb8963);
}

.case-hero-cover.placeholder {
  background: linear-gradient(180deg, #eadbc8, #bb8963);
}

.hero-copy,
.confirm-hero-copy {
  flex: 1;
  min-width: 0;
  display: grid;
  gap: 12rpx;
}

.hero-title,
.confirm-hero-title {
  color: #ffffff;
  font-size: 34rpx;
  line-height: 1.18;
  font-weight: 900;
  white-space: pre-line;
  word-break: break-word;
}

.hero-headline,
.confirm-hero-headline {
  color: rgba(255, 255, 255, 0.92);
  font-size: 23rpx;
  line-height: 1.45;
  white-space: normal;
  word-break: break-word;
}

.hero-chip-row,
.confirm-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.hero-chip-row text,
.confirm-chip-row text {
  min-height: 38rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 800;
  white-space: nowrap;
}

.hero-portrait,
.confirm-hero-portrait,
.confirm-hero-image {
  width: 148rpx;
  height: 188rpx;
  border-radius: 26rpx 26rpx 0 0;
  flex: 0 0 auto;
  display: block;
}

.hero-portrait.placeholder,
.confirm-hero-placeholder {
  width: 148rpx;
  height: 188rpx;
  border-radius: 26rpx 26rpx 0 0;
  background: rgba(255, 255, 255, 0.16);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 900;
}

.hero-cover-block {
  padding: 18rpx 18rpx 0;
}

.hero-cover-image,
.confirm-cover-image {
  width: 100%;
  height: 240rpx;
  border-radius: 24rpx;
  display: block;
}

.hero-cover-fallback,
.confirm-cover-fallback {
  position: relative;
  width: 100%;
  height: 240rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #e7d8c6 0%, #f6efe7 44%, #d0b598 100%);
  overflow: hidden;
}

.room-wall {
  position: absolute;
  top: 30rpx;
  left: 26rpx;
  width: 126rpx;
  height: 126rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.54);
}

.room-sofa {
  position: absolute;
  right: 28rpx;
  bottom: 28rpx;
  width: 160rpx;
  height: 84rpx;
  border-radius: 28rpx;
  background: #9b7147;
}

.room-table {
  position: absolute;
  left: 176rpx;
  bottom: 22rpx;
  width: 74rpx;
  height: 48rpx;
  border-radius: 18rpx;
  background: rgba(111, 78, 55, 0.84);
}

.pricing-copy {
  padding: 22rpx 22rpx 24rpx;
  display: grid;
  gap: 10rpx;
}

.pricing-copy .hero-title,
.pricing-copy .hero-headline,
.confirm-hero.pricing .confirm-hero-title,
.confirm-hero.pricing .confirm-hero-headline {
  color: #2a1d16;
}

.mini-section,
.confirm-section,
.media-card,
.group-card,
.confirm-contact-card {
  width: calc(100% - 4rpx);
  max-width: 100%;
  min-width: 0;
  margin-left: 2rpx;
  margin-right: 2rpx;
  padding: 22rpx;
  border-radius: 26rpx;
  background: #ffffff;
  border: 2rpx solid rgba(226, 232, 240, 0.86);
}

.mini-section-title,
.group-card-title,
.confirm-section-title,
.confirm-contact-title {
  color: #0f172a;
  font-size: 26rpx;
  font-weight: 900;
}

.mini-bullet,
.confirm-bullet-row {
  display: flex;
  gap: 10rpx;
  margin-top: 14rpx;
  color: #475467;
  font-size: 23rpx;
  line-height: 1.45;
}

.mini-bullet text:first-child,
.confirm-bullet-row text:first-child {
  color: #3b82f6;
  font-weight: 900;
  flex: 0 0 auto;
}

.mini-icon-grid,
.confirm-icon-grid {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.mini-icon-grid.compact {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.mini-icon-item,
.confirm-icon-item {
  min-height: 116rpx;
  padding: 14rpx 10rpx;
  border-radius: 22rpx;
  background: #f8fafc;
  display: grid;
  justify-items: center;
  align-content: start;
  gap: 10rpx;
  box-sizing: border-box;
}

.mini-icon-circle,
.confirm-icon-circle {
  width: 44rpx;
  height: 44rpx;
  border-radius: 18rpx;
  background: rgba(59, 130, 246, 0.1);
  color: #2563eb;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 900;
}

.mini-icon-item text,
.confirm-icon-item text {
  color: #344054;
  font-size: 21rpx;
  line-height: 1.35;
  text-align: center;
}

.mini-action-row {
  margin: 0 12rpx 16rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.mini-action-row view {
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 900;
  white-space: nowrap;
  min-width: 0;
}

.mini-action-row .primary {
  background: #2563eb;
  color: #ffffff;
}

.mini-action-row .secondary {
  background: rgba(255, 255, 255, 0.9);
  color: #2563eb;
  border: 2rpx solid rgba(37, 99, 235, 0.14);
}

.mini-action-row.dark .primary {
  background: #1f2937;
}

.mini-action-row.dark .secondary {
  color: #1f2937;
  border-color: rgba(31, 41, 55, 0.12);
}

.mini-action-row.warm .primary {
  background: #9a4f14;
}

.mini-action-row.warm .secondary {
  color: #9a4f14;
  border-color: rgba(154, 79, 20, 0.14);
}

.mini-action-row.purple .primary {
  background: #6d28d9;
}

.mini-action-row.purple .secondary {
  color: #6d28d9;
  border-color: rgba(109, 40, 217, 0.14);
}

.pricing-tag-row,
.confirm-price-tag-row {
  margin: 0 12rpx 16rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
}

.pricing-tag,
.confirm-price-tag {
  min-height: 64rpx;
  padding: 12rpx;
  border-radius: 20rpx;
  background: #f4f7f5;
  color: #264c34;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.3;
  box-sizing: border-box;
}

.case-metric-row,
.confirm-stat-row {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.case-metric-card,
.confirm-stat-card {
  min-height: 92rpx;
  padding: 16rpx 10rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.16);
  display: grid;
  justify-items: center;
  align-content: center;
  gap: 6rpx;
  box-sizing: border-box;
}

.case-metric-card view,
.confirm-stat-card view {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
}

.case-metric-card text,
.confirm-stat-card text {
  color: rgba(255, 255, 255, 0.9);
  font-size: 19rpx;
}

.case-thumb-row,
.confirm-case-row {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.case-thumb-card,
.confirm-case-card {
  display: grid;
  gap: 10rpx;
}

.case-thumb-image,
.confirm-case-placeholder,
.confirm-case-card image {
  width: 100%;
  height: 124rpx;
  border-radius: 20rpx;
  display: block;
  background: linear-gradient(180deg, #e8d7c4, #b9855d);
}

.case-thumb-card text,
.confirm-case-card text {
  color: #694123;
  font-size: 20rpx;
  line-height: 1.35;
  text-align: center;
}

.countdown-row {
  margin: 0 12rpx 16rpx;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
}

.countdown-card {
  min-height: 88rpx;
  padding: 12rpx 8rpx;
  border-radius: 20rpx;
  background: rgba(109, 40, 217, 0.08);
  display: grid;
  justify-items: center;
  align-content: center;
  gap: 6rpx;
  box-sizing: border-box;
}

.countdown-card view {
  color: #6d28d9;
  font-size: 30rpx;
  font-weight: 900;
}

.countdown-card text {
  color: #7c3aed;
  font-size: 18rpx;
}

.style-feature-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.style-feature-pill {
