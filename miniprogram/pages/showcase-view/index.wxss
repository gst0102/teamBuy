page {
  background: #f6f7f9;
}

.page-shell {
  min-height: 100vh;
  padding: 22rpx 24rpx 190rpx;
  box-sizing: border-box;
}

.tpl-page {
  min-height: 100vh;
  max-width: 720rpx;
  margin-left: auto;
  margin-right: auto;
  box-sizing: border-box;
}

.empty {
  padding: 80rpx 24rpx;
  text-align: center;
  color: #7b8494;
  font-size: 28rpx;
}

.empty-title {
  color: #162033;
  font-size: 34rpx;
  font-weight: 900;
}

.empty-sub {
  margin-top: 14rpx;
  color: #758196;
  font-size: 25rpx;
  line-height: 1.6;
}

.share-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
  padding: 18rpx;
  border: 1rpx solid #dbe8ff;
  border-radius: 8rpx;
  background: #eef5ff;
}

.share-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #1f2a3d;
}

.share-sub {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #5f6f86;
  line-height: 1.35;
}

.share-btn {
  flex: 0 0 168rpx;
  height: 68rpx;
  margin: 0;
  border-radius: 8rpx;
  line-height: 68rpx;
  color: #fff;
  background: #1677ff;
  font-size: 25rpx;
}

.fallback,
.fallback-small {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 8rpx;
  background: #eef5ff;
  color: #1677ff;
  font-weight: 900;
}

.tone-0 {
  background: linear-gradient(135deg, #eff6ff, #dbeafe);
  color: #1d4ed8;
}

.tone-1 {
  background: linear-gradient(135deg, #ecfdf3, #d1fae5);
  color: #15803d;
}

.tone-2 {
  background: linear-gradient(135deg, #fff7ed, #ffedd5);
  color: #c2410c;
}

.tone-3 {
  background: linear-gradient(135deg, #f5f3ff, #ede9fe);
  color: #6d28d9;
}

.title-cover-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 34rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  color: currentColor;
  font-size: 18rpx;
  font-weight: 900;
  line-height: 1;
}

.title-cover-badge.compact {
  min-height: 30rpx;
  padding: 0 10rpx;
  font-size: 16rpx;
}

.title-cover-line {
  max-width: 88%;
  text-align: center;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.title-cover-line.second {
  font-size: 24rpx;
}

.sticky-share {
  position: fixed;
  display: flex;
  align-items: center;
  justify-content: center;
  left: 34rpx;
  right: 34rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  width: auto;
  max-width: 720rpx;
  height: 82rpx;
  margin: 0;
  border-radius: 8rpx;
  line-height: 1.2;
  color: #fff;
  background: #00613d;
  font-size: 28rpx;
  font-weight: 900;
  box-shadow: 0 16rpx 34rpx rgba(0, 97, 61, 0.22);
  box-sizing: border-box;
}

.sticky-share.warm {
  background: #b85f31;
  box-shadow: 0 16rpx 34rpx rgba(184, 95, 49, 0.22);
}

.showcase-share-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 750rpx;
  height: 420rpx;
  pointer-events: none;
}

.sticky-share.teal {
  background: #126b5f;
  box-shadow: 0 16rpx 34rpx rgba(18, 107, 95, 0.22);
}

.sticky-share[disabled],
.share-btn[disabled] {
  background: #edf2f7;
  color: #8a95a6;
  box-shadow: none;
}

.hero {
  position: relative;
  overflow: hidden;
  border-radius: 8rpx;
  background: #fff;
}

.hero-image {
  width: 100%;
  display: block;
}

.hero-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.05), rgba(0, 60, 38, 0.62));
}

.hero-title {
  color: #fff;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.2;
}

.hero-desc {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 25rpx;
  line-height: 1.45;
}

.contact-actions {
  display: flex;
  gap: 16rpx;
}

.contact-actions button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 72rpx;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 8rpx;
  line-height: 1.2;
  font-size: 26rpx;
  font-weight: 900;
  white-space: nowrap;
  box-sizing: border-box;
}

.section-headline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 28rpx 0 14rpx;
  color: #1d2939;
  font-size: 30rpx;
  font-weight: 900;
}

.section-headline .more {
  color: #8b95a5;
  font-size: 23rpx;
  font-weight: 500;
}

.tpl-featured_window {
  background: #fff;
}

.featured-hero {
  height: 300rpx;
}

.featured-hero .hero-image {
  height: 300rpx;
}

.featured-hero-copy {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 28rpx;
  z-index: 2;
}

.agency-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: -26rpx;
  padding: 20rpx;
  border-radius: 8rpx;
  background: #fff;
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.12);
}

.agency-logo {
  width: 82rpx;
  height: 82rpx;
  border-radius: 42rpx;
  background: #00613d;
  color: #fff;
  text-align: center;
  line-height: 82rpx;
  font-size: 40rpx;
  font-weight: 900;
}

.image-avatar {
  display: block;
}

.agency-main {
  flex: 1;
  min-width: 0;
}

.agency-name {
  color: #172033;
  font-size: 30rpx;
  font-weight: 900;
}

.agency-sub {
  margin-top: 6rpx;
  color: #667085;
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.agency-pill {
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  color: #9a6200;
  background: #fff1d6;
  font-size: 21rpx;
}

.stat-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin: 18rpx 0;
  text-align: center;
}

.stat-row strong {
  display: block;
  color: #172033;
  font-size: 27rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stat-row text {
  color: #667085;
  font-size: 22rpx;
}

.property-filter-panel {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin: 12rpx 0 22rpx;
  padding: 16rpx 0 16rpx 16rpx;
  border: 1rpx solid #e4e7ec;
  border-radius: 8rpx;
  background: #fff;
  box-sizing: border-box;
}

.property-filter-row {
  display: grid;
  grid-template-columns: 72rpx minmax(0, 1fr);
  align-items: center;
  gap: 12rpx;
  min-height: 54rpx;
}

.property-filter-label {
  color: #667085;
  font-size: 22rpx;
  font-weight: 800;
  white-space: nowrap;
}

.property-filter-scroll {
  width: 100%;
  white-space: nowrap;
}

.property-filter-options {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding-right: 16rpx;
  box-sizing: border-box;
}

.property-filter-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  min-width: 76rpx;
  height: 48rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  color: #42526b;
  background: #f2f4f7;
  font-size: 22rpx;
  font-weight: 800;
  white-space: nowrap;
  box-sizing: border-box;
}

.property-filter-chip.active {
  color: #fff;
  background: #1677ff;
}

.property-filter-count {
  min-width: 24rpx;
  color: inherit;
  font-size: 18rpx;
  opacity: 0.78;
  text-align: center;
}

.featured-actions {
  margin-bottom: 26rpx;
}

.featured-actions button:first-child {
  color: #fff;
  background: #00613d;
}

.featured-actions button:last-child {
  color: #172033;
  background: #fff;
  border: 1rpx solid #d0d5dd;
}

.showcase-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 16rpx;
}

.filter-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 108rpx;
  margin-bottom: 16rpx;
  border: 1rpx dashed #d0d5dd;
  border-radius: 8rpx;
  color: #667085;
  background: #f9fafb;
  font-size: 24rpx;
  text-align: center;
}

.showcase-grid.layout-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.showcase-grid.layout-list .showcase-card {
  display: grid;
  grid-template-columns: 220rpx minmax(0, 1fr);
  align-items: stretch;
}

.showcase-card {
  overflow: hidden;
  border: 1rpx solid #e4e7ec;
  border-radius: 8rpx;
  background: #fff;
}

.card-cover {
  width: 100%;
  height: 170rpx;
  display: block;
  background: #e8eef7;
}

.showcase-grid.layout-list .card-cover {
  width: 220rpx;
  height: 100%;
  min-height: 190rpx;
}

.showcase-grid.layout-list .card-title,
.showcase-grid.layout-list .card-summary,
.showcase-grid.layout-list .product-meta-row,
.showcase-grid.layout-list .tag-grid,
.showcase-grid.layout-list .card-bottom {
  grid-column: 2;
}

.showcase-grid.layout-list .card-title {
  align-self: end;
}

.card-title {
  margin: 12rpx 14rpx 0;
  color: #172033;
  font-size: 25rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-summary {
  margin: 6rpx 14rpx 0;
  color: #667085;
  font-size: 21rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  margin: 10rpx 14rpx 14rpx;
}

.price {
  color: #e5484d;
  font-size: 28rpx;
  font-weight: 900;
}

.product-action-text {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 40rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  color: #9a3412;
  background: #ffedd5;
  font-size: 19rpx;
  font-weight: 900;
  white-space: nowrap;
}

.product-meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin: 10rpx 14rpx 0;
}

.product-meta-row text {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 36rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  color: #c2410c;
  background: #fff7ed;
  font-size: 18rpx;
  font-weight: 800;
  white-space: nowrap;
}

.product-meta-row.story,
.product-meta-row.catalog {
  margin: 10rpx 0 0;
}

.tag-grid {
  display: grid;
  gap: 8rpx;
  margin: 10rpx 14rpx 0;
  width: auto;
}

.tag-grid.tag-count-1 {
  grid-template-columns: 1fr;
}

.tag-grid.tag-count-2 {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.tag-grid.tag-count-3 {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.tag-grid.tag-count-4 {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.tag-grid text {
  min-width: 0;
  padding: 6rpx 6rpx;
  border-radius: 6rpx;
  color: #0f7f72;
  background: #e3f5ef;
  font-size: 18rpx;
  line-height: 1.25;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tpl-moments_story {
  background: #fff7ef;
}

.story-page {
  color: #3a2a21;
}

.story-hero {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 240rpx;
  gap: 18rpx;
  align-items: center;
  min-height: 260rpx;
  padding: 22rpx 18rpx;
  border-radius: 8rpx;
  background: #fffaf5;
}

.story-title {
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.15;
  word-break: break-word;
}

.story-desc {
  margin-top: 16rpx;
  color: #7a6255;
  font-size: 24rpx;
  line-height: 1.45;
}

.script-text {
  margin-top: 16rpx;
  color: #b86135;
  font-size: 34rpx;
  font-style: italic;
}

.story-hero-img {
  width: 240rpx;
  height: 220rpx;
  border-radius: 8rpx;
  background: #ecd2bf;
}

.service-bar {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  margin-top: 18rpx;
  padding: 22rpx 10rpx;
  border-radius: 8rpx;
  color: #fff;
  background: #bd6539;
  text-align: center;
  font-size: 22rpx;
}

.service-bar view {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.story-block,
.story-section {
  margin-top: 24rpx;
}

.story-page.layout-grid .story-section {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.story-page.layout-grid .story-block-title {
  grid-column: 1 / -1;
}

.story-page.layout-grid .story-row {
  grid-template-columns: minmax(0, 1fr);
}

.story-page.layout-grid .story-row image {
  width: 100%;
  height: 170rpx;
}

.story-block-title {
  margin-bottom: 14rpx;
  color: #a94f25;
  font-size: 28rpx;
  font-weight: 900;
}

.story-feature {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 220rpx;
  gap: 16rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: #fff;
}

.story-feature > view {
  padding: 20rpx;
}

.story-feature image {
  width: 220rpx;
  height: 190rpx;
}

.story-feature-title {
  color: #3a2a21;
  font-size: 30rpx;
  font-weight: 900;
  word-break: break-word;
}

.story-feature-sub {
  margin-top: 10rpx;
  color: #7a6255;
  font-size: 23rpx;
  line-height: 1.45;
}

.story-more {
  display: inline-flex;
  margin-top: 14rpx;
  padding: 8rpx 14rpx;
  border-radius: 8rpx;
  color: #fff;
  background: #a94f25;
  font-size: 22rpx;
}

.story-row {
  position: relative;
  display: grid;
  grid-template-columns: 180rpx minmax(0, 1fr);
  gap: 16rpx;
  margin-bottom: 14rpx;
  padding: 14rpx;
  border-radius: 8rpx;
  background: #fff;
}

.story-row image {
  width: 180rpx;
  height: 128rpx;
  border-radius: 8rpx;
}

.story-row > view {
  min-width: 0;
}

.story-row-title {
  color: #3a2a21;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.3;
  word-break: break-word;
}

.story-row-sub {
  margin-top: 8rpx;
  color: #7a6255;
  font-size: 22rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.story-price {
  margin-top: 8rpx;
  color: #d9480f;
  font-size: 25rpx;
  font-weight: 900;
}

.story-row .tag-grid {
  margin: 10rpx 0 0;
}

.story-row .tag-grid text {
  min-width: 0;
}

.story-row .tag-grid text {
  color: #b54708;
  background: #fff0df;
}

.tpl-catalog_list {
  background: #f5f8fd;
}

.catalog-search {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 72rpx;
  padding: 0 18rpx;
  border: 1rpx solid #d7e3f2;
  border-radius: 8rpx;
  background: #fff;
  color: #8a96a8;
  font-size: 24rpx;
}

.count-chip {
  padding: 8rpx 14rpx;
  border-radius: 6rpx;
  color: #1f6fd6;
  background: #eaf2ff;
  font-size: 22rpx;
}

.catalog-tabs {
  display: flex;
  align-items: center;
  gap: 12rpx;
  overflow: hidden;
  white-space: nowrap;
}

.catalog-tabs {
  margin-top: 20rpx;
  color: #667085;
  font-size: 25rpx;
}

.catalog-tabs text {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #667085;
  background: #eef3f8;
  font-size: 22rpx;
}

.catalog-row {
  position: relative;
  display: grid;
  grid-template-columns: 172rpx minmax(0, 1fr) 136rpx;
  gap: 16rpx;
  align-items: center;
  margin-bottom: 14rpx;
  padding: 14rpx;
  border: 1rpx solid #e0e8f2;
  border-radius: 8rpx;
  background: #fff;
}

.catalog-page.layout-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.catalog-page.layout-grid .catalog-search,
.catalog-page.layout-grid .catalog-tabs,
.catalog-page.layout-grid .bottom-contact,
.catalog-page.layout-grid .agent-same-card {
  grid-column: 1 / -1;
}

.catalog-page.layout-grid .catalog-row {
  grid-template-columns: minmax(0, 1fr);
  gap: 10rpx;
}

.catalog-page.layout-grid .catalog-cover {
  width: 100%;
  height: 180rpx;
}

.catalog-page.layout-grid .detail-btn {
  width: 100%;
}

.row-badge {
  position: absolute;
  left: 14rpx;
  top: 14rpx;
  z-index: 2;
  padding: 4rpx 8rpx;
  border-radius: 6rpx;
  color: #fff;
  background: #e5772f;
  font-size: 19rpx;
}

.catalog-cover {
  width: 172rpx;
  height: 132rpx;
  border-radius: 8rpx;
  background: #dbe6f3;
}

.catalog-main {
  min-width: 0;
}

.catalog-title {
  color: #162943;
  font-size: 27rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.catalog-summary {
  margin-top: 8rpx;
  color: #637083;
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.catalog-row .tag-grid {
  margin: 10rpx 0 0;
}

.catalog-row .tag-grid text {
  color: #637083;
  background: #f2f5f9;
}

.catalog-price {
  margin-top: 8rpx;
  color: #f05a28;
  font-size: 27rpx;
  font-weight: 900;
}

.detail-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 136rpx;
  height: 52rpx;
  margin: 0;
  padding: 0;
  border-radius: 8rpx;
  color: #1f6fd6;
  background: #eaf2ff;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 1.2;
  white-space: nowrap;
  box-sizing: border-box;
}

.bottom-contact {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.28fr);
  gap: 12rpx;
  max-width: 720rpx;
  margin: 0 auto;
  box-sizing: border-box;
}

.bottom-contact.single {
  grid-template-columns: minmax(0, 1fr);
}

.bottom-contact button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 76rpx;
  margin: 0;
  padding: 0 16rpx;
  border-radius: 8rpx;
  color: #fff;
  background: #2b72dc;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.2;
  white-space: nowrap;
  box-sizing: border-box;
}

.bottom-contact button::after {
  border: 0;
}

.tpl-brand_card {
  background: #f5fbf9;
}

.brand-hero {
  display: grid;
  grid-template-columns: 126rpx minmax(0, 1fr);
  gap: 22rpx;
  align-items: center;
  margin: 0;
  padding: 44rpx 34rpx 60rpx;
  border-radius: 8rpx;
  color: #fff;
  background: linear-gradient(135deg, #12191f, #173f3a);
}

.brand-avatar {
  width: 126rpx;
  height: 126rpx;
  border-radius: 64rpx;
  background: #e7f5ef;
}

.text-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #145a50;
  font-size: 46rpx;
  font-weight: 900;
}

.brand-name {
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.25;
  word-break: break-word;
}

.brand-sub {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 23rpx;
  line-height: 1.45;
}

.brand-pill {
  display: inline-flex;
  margin-top: 14rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #4a3520;
  background: #f5dfbf;
  font-size: 22rpx;
}

.brand-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin: -32rpx 10rpx 18rpx;
  padding: 24rpx 0;
  border-radius: 8rpx;
  background: #fff;
  text-align: center;
  box-shadow: 0 14rpx 32rpx rgba(15, 23, 42, 0.12);
}

.brand-stats strong {
  display: block;
  color: #173f3a;
  font-size: 27rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.brand-stats text {
  color: #667085;
  font-size: 22rpx;
}

.brand-contact {
  padding: 20rpx;
  border-radius: 8rpx;
  background: #fff;
}

.contact-title {
  margin-bottom: 16rpx;
  color: #172033;
  font-size: 30rpx;
  font-weight: 900;
}

.brand-contact .contact-actions button:first-child {
  color: #fff;
  background: #17895e;
}

.brand-contact .contact-actions button:last-child {
  color: #805a23;
  background: #f4dfc4;
}

.brand-scroll {
  width: 100%;
  white-space: nowrap;
}

.brand-scroll.layout-list {
  display: grid;
  gap: 14rpx;
  white-space: normal;
}

.brand-case {
  display: inline-block;
  width: 210rpx;
  margin-right: 14rpx;
  overflow: hidden;
  border: 1rpx solid #e4e7ec;
  border-radius: 8rpx;
  background: #fff;
  vertical-align: top;
}

.brand-scroll.layout-list .brand-case {
  display: grid;
  grid-template-columns: 188rpx minmax(0, 1fr);
  align-items: stretch;
  width: 100%;
  min-height: 188rpx;
  margin-right: 0;
}

.brand-case image,
.brand-case-cover {
  width: 210rpx;
  height: 160rpx;
  display: block;
}

.brand-scroll.layout-list .brand-case image,
.brand-scroll.layout-list .brand-case-cover {
  width: 188rpx;
  height: 188rpx;
}

.brand-case-body {
  display: grid;
  grid-template-rows: auto auto auto 1fr;
  min-width: 0;
  min-height: 0;
  padding: 12rpx 14rpx;
  box-sizing: border-box;
}

.brand-case-title {
  margin: 0;
  color: #172033;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.25;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.brand-case-sub {
  margin: 8rpx 0 0;
  color: #667085;
  font-size: 21rpx;
  line-height: 1.25;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.brand-case .tag-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 6rpx;
  margin: 10rpx 0 0;
}

.brand-case .tag-grid text {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 34rpx;
  padding: 0 6rpx;
  font-size: 18rpx;
  line-height: 1.15;
  white-space: nowrap;
}

.brand-case-price {
  align-self: end;
  margin: 8rpx 0 0;
  color: #8a5a21;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.trust-strip {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 24rpx;
  padding: 18rpx 10rpx;
  border-radius: 8rpx;
  color: #fff;
  background: #161d24;
  text-align: center;
  font-size: 20rpx;
}

.trust-strip text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.agent-same-card {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(156rpx, 188rpx);
  gap: 16rpx;
  align-items: center;
  margin-top: 24rpx;
  max-width: 720rpx;
  margin-left: auto;
  margin-right: auto;
  padding: 20rpx;
  border: 1rpx solid #d8eadf;
  border-radius: 8rpx;
  background: #f2fbf5;
  box-sizing: border-box;
}

.agent-same-main {
  min-width: 0;
}

.agent-same-title {
  color: #0f5f3d;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.35;
}

.agent-same-sub {
  margin-top: 8rpx;
  color: #52645b;
  font-size: 23rpx;
  line-height: 1.45;
}

.agent-same-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  height: 72rpx;
  margin: 0;
  padding: 0;
  border-radius: 8rpx;
  color: #fff;
  background: #0f7a4c;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.2;
  white-space: nowrap;
  box-sizing: border-box;
}

@media screen and (min-width: 1200rpx) {
  .sticky-share,
  .bottom-contact {
    left: 50%;
    right: auto;
    width: 720rpx;
    transform: translateX(-50%);
  }
}

@media screen and (max-width: 720rpx) {
  .agent-same-card {
    grid-template-columns: minmax(0, 1fr);
  }

  .agent-same-btn {
    height: 76rpx;
  }
}
