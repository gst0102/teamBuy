  align-items: center;
  justify-content: center;
  min-width: 0;
  color: #9aa4b2;
  font-size: 22rpx;
  line-height: 1;
}

.showcase-tab-item.active { color: #1677ff; }

.showcase-tab-icon {
  display: block;
  width: 50rpx;
  height: 50rpx;
  margin-bottom: 7rpx;
}

.showcase-tab-label {
  display: block;
  white-space: nowrap;
}

.showcase-filter-empty,
.showcase-loading,
.showcase-load-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 620rpx;
  color: #8490a2;
  font-size: 23rpx;
  text-align: center;
}

.showcase-filter-empty-icon { color: #9eb0c8; font-size: 66rpx; transform: rotate(-18deg); }
.showcase-filter-empty-title, .showcase-error-title { margin-top: 16rpx; color: #172033; font-size: 29rpx; font-weight: 900; }
.showcase-filter-empty-sub, .showcase-error-sub { margin-top: 10rpx; color: #8a95a6; font-size: 22rpx; }
.showcase-filter-empty-reset, .showcase-retry-button { display:flex; align-items:center; justify-content:center; width:190rpx; height:62rpx; margin-top:26rpx; padding:0; border-radius:999rpx; background:#edf5ff; color:#176be3; font-size:23rpx; font-weight:900; line-height:1; }
.showcase-filter-empty-reset::after, .showcase-retry-button::after { border: 0; }
.showcase-loading-dot { width:42rpx; height:42rpx; margin-bottom:22rpx; border:5rpx solid #dce9fb; border-top-color:#1f78ff; border-radius:999rpx; animation:showcase-spin .8s linear infinite; }
@keyframes showcase-spin { to { transform: rotate(360deg); } }
.showcase-error-icon { display:flex; align-items:center; justify-content:center; width:70rpx; height:70rpx; border-radius:999rpx; background:#fff2e8; color:#e2732f; font-size:34rpx; font-weight:900; }

.showcase-first-empty { display:flex; flex-direction:column; align-items:center; padding:58rpx 0 20rpx; }
.showcase-empty-illustration { position:relative; width:230rpx; height:190rpx; }
.empty-card { position:absolute; left:45rpx; top:44rpx; width:145rpx; height:105rpx; border-radius:18rpx; background:#c5d9fa; transform:rotate(-10deg); }
.empty-card.middle { left:52rpx; top:50rpx; background:#83b2f7; transform:rotate(5deg); }
.empty-card.front { left:42rpx; top:62rpx; display:flex; align-items:center; justify-content:center; background:linear-gradient(145deg,#4f98ff,#146bed); box-shadow:0 16rpx 28rpx rgba(32,113,232,.25); transform:rotate(0deg); }
.empty-card.front text { display:flex; align-items:center; justify-content:center; width:62rpx; height:62rpx; border-radius:999rpx; background:#ffffff; color:#1974f2; font-size:38rpx; }
.showcase-empty-illustration .empty-spark { position:absolute; color:#75aaf7; }
.showcase-empty-illustration .empty-spark.one { right:0; top:23rpx; font-size:34rpx; }
.showcase-empty-illustration .empty-spark.two { left:8rpx; top:28rpx; font-size:23rpx; }
.showcase-first-title { margin-top:26rpx; color:#111827; font-size:34rpx; font-weight:900; text-align:center; }
.showcase-first-sub { margin-top:15rpx; color:#8490a2; font-size:23rpx; line-height:1.55; text-align:center; }
.showcase-first-cta { display:flex; align-items:center; justify-content:center; min-width:310rpx; height:76rpx; margin:38rpx 0 0; padding:0 28rpx; border-radius:22rpx; background:#1f78ff; color:#ffffff; font-size:25rpx; font-weight:900; line-height:1; box-shadow:0 12rpx 24rpx rgba(31,120,255,.2); box-sizing:border-box; }
.showcase-first-cta::after { border:0; }
.showcase-first-cta text { margin-right:8rpx; font-size:34rpx; }
.showcase-back-library { margin-top:28rpx; color:#8a95a6; font-size:22rpx; }
.showcase-back-library text { color:#146de7; font-weight:900; }

.showcase-filter-mask { position:fixed; z-index:1100; left:0; right:0; top:0; bottom:0; display:flex; align-items:flex-end; padding:24rpx; background:rgba(15,23,42,.46); box-sizing:border-box; }
.showcase-filter-sheet { width:100%; padding:30rpx 28rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius:30rpx; background:#ffffff; box-sizing:border-box; }
.showcase-filter-head { display:flex; align-items:center; justify-content:space-between; color:#172033; font-size:32rpx; font-weight:900; }
.showcase-filter-close { display:flex; align-items:center; justify-content:center; width:54rpx; height:54rpx; border-radius:999rpx; background:#f1f4f8; color:#7f8999; font-size:34rpx; }
.showcase-filter-label { margin-top:28rpx; color:#4d5a6e; font-size:22rpx; font-weight:900; }
.showcase-filter-chips { display:flex; flex-wrap:wrap; gap:12rpx; margin-top:14rpx; }
.showcase-filter-chip { display:flex; align-items:center; justify-content:center; min-width:118rpx; height:52rpx; padding:0 18rpx; border-radius:999rpx; background:#f2f5f9; color:#657186; font-size:21rpx; font-weight:800; white-space:nowrap; box-sizing:border-box; }
.showcase-filter-chip.active { background:#e8f2ff; color:#126bea; }
.showcase-filter-actions { display:grid; grid-template-columns:repeat(2, minmax(0, 1fr)); gap:16rpx; margin-top:34rpx; }
.showcase-filter-reset, .showcase-filter-apply { display:flex; align-items:center; justify-content:center; width:100%; min-width:0; height:68rpx; margin:0; padding:0; border-radius:18rpx; background:#f0f4f9; color:#627086; font-size:24rpx; font-weight:900; line-height:1; box-sizing:border-box; }
.showcase-filter-apply { background:#1f78ff; color:#ffffff; }
.showcase-filter-reset::after, .showcase-filter-apply::after { border:0; }

