page {
  background: #f5f7fb;
}

.page-shell {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  margin: 18rpx 0 24rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #182334;
}

.page-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #697386;
  line-height: 1.45;
}

.primary-btn,
.ghost-btn {
  margin: 0;
  border-radius: 8rpx;
  font-size: 26rpx;
  line-height: 72rpx;
}

.primary-btn {
  min-width: 144rpx;
  height: 72rpx;
  color: #fff;
  background: #1677ff;
}

.primary-btn.wide {
  width: 260rpx;
  margin-top: 24rpx;
}

.ghost-btn {
  height: 64rpx;
  line-height: 64rpx;
  color: #1677ff;
  background: #eef5ff;
}

.empty {
  padding: 80rpx 36rpx;
  text-align: center;
  color: #7b8494;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #243044;
}

.empty-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.showcase-row {
  display: flex;
  gap: 18rpx;
  align-items: center;
  padding: 18rpx;
  background: #fff;
  border: 1rpx solid #e6ebf2;
  border-radius: 8rpx;
}

.banner {
  width: 112rpx;
  height: 112rpx;
  border-radius: 8rpx;
  flex: 0 0 112rpx;
}

.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1677ff;
  background: #eef5ff;
  font-weight: 700;
  font-size: 36rpx;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2a3d;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #697386;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta-line {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8a94a6;
}

.status {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  color: #697386;
  background: #f0f3f7;
}

.status.published {
  color: #067647;
  background: #e7f8ef;
}

.status.archived {
  color: #a15c00;
  background: #fff4dd;
}

.row-actions {
  flex: 0 0 auto;
}
