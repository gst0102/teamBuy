  box-sizing: border-box;
}

.showcase-fixed-action button::after { border: 0; }
.showcase-fixed-action text { margin-right: 8rpx; font-size: 34rpx; }

.showcase-tabbar {
  position: fixed;
  z-index: 40;
  left: 0;
  right: 0;
  bottom: 0;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  height: calc(112rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid #eef2f7;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -8rpx 24rpx rgba(31, 61, 105, 0.06);
