.showcase-more-action { height: 48rpx; background: transparent; color: #68758a; font-size: 27rpx; }
.showcase-primary-action::after, .showcase-more-action::after { border: 0; }

.showcase-bottom-spacer { height: 240rpx; }

.showcase-fixed-action {
  position: fixed;
  z-index: 30;
  left: 60rpx;
  right: 60rpx;
  bottom: calc(116rpx + env(safe-area-inset-bottom));
  padding: 13rpx;
  border: 1rpx solid rgba(219, 227, 239, 0.92);
  border-radius: 27rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 14rpx 38rpx rgba(31, 61, 105, 0.13);
