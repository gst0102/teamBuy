page {
  background: #f5f7fb;
}

.page-shell {
  min-height: 100vh;
  padding: 0 20rpx 28rpx;
  box-sizing: border-box;
}

.library-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 220rpx;
  padding: 42rpx 0 20rpx;
  box-sizing: border-box;
}

.hero-copy {
  flex: 1;
  min-width: 0;
  padding-right: 26rpx;
}

.hero-kicker {
  margin-bottom: 12rpx;
  color: #1677ff;
  font-size: 24rpx;
  font-weight: 900;
}

.hero-title {
  color: #111827;
  font-size: 58rpx;
  line-height: 1.05;
  font-weight: 900;
}

.hero-subtitle {
  max-width: 460rpx;
  margin-top: 14rpx;
  color: #64748b;
  font-size: 25rpx;
  line-height: 1.58;
}

.library-visual {
  width: 176rpx;
  height: 176rpx;
  border-radius: 46rpx;
  background: linear-gradient(135deg, #dcebff, #ffffff);
  color: #1677ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 900;
  box-shadow: 0 22rpx 54rpx rgba(31, 88, 168, 0.12);
}

.showcase-hero-panel {
  margin-bottom: 18rpx;
  padding: 24rpx;
  border: 1rpx solid #dbe6f7;
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(247, 250, 255, 0.98), rgba(255, 255, 255, 0.96) 56%, rgba(244, 248, 255, 0.98));
  box-shadow: 0 16rpx 40rpx rgba(31, 88, 168, 0.08);
  box-sizing: border-box;
}

.showcase-hero-label {
  color: #1677ff;
  font-size: 22rpx;
  font-weight: 900;
}

.showcase-hero-title {
  margin-top: 10rpx;
  color: #111827;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.2;
}

.showcase-hero-sub {
  margin-top: 12rpx;
  color: #64748b;
  font-size: 23rpx;
  line-height: 1.46;
}

.showcase-hero-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.showcase-hero-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  color: #526174;
  font-size: 20rpx;
  font-weight: 900;
}

.showcase-hero-badge.primary {
  background: #edf5ff;
  color: #1677ff;
}

.showcase-action-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: -2rpx;
  margin-bottom: 18rpx;
}

.mode-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 38rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #e8f7ef;
  color: #11924d;
  font-size: 21rpx;
  font-weight: 900;
  white-space: nowrap;
  box-sizing: border-box;
  margin-bottom: 0;
}

.showcase-filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 0 0 22rpx;
}

.showcase-filter {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 104rpx;
  min-height: 54rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #eef3f8;
  color: #526174;
  font-size: 23rpx;
  font-weight: 900;
  box-sizing: border-box;
  white-space: nowrap;
}

.showcase-filter.active {
  background: #1677ff;
  color: #ffffff;
}

.primary-btn,
.ghost-btn,
.danger-btn,
.more-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  border-radius: 8rpx;
  font-size: 26rpx;
  line-height: 1;
}

.primary-btn::after,
.ghost-btn::after,
.danger-btn::after,
.more-btn::after {
  border: 0;
}

.primary-btn {
  min-width: 144rpx;
  height: 60rpx;
  color: #fff;
  background: #1677ff;
  font-size: 23rpx;
}

.compact-create {
  flex: 0 0 auto;
  min-width: 310rpx;
  height: 64rpx;
  padding: 0 28rpx;
  font-size: 24rpx;
}

.primary-btn.wide {
  width: 260rpx;
  margin-top: 24rpx;
}

.ghost-btn.wide {
  width: 260rpx;
  margin: 16rpx auto 0;
}

.secondary-empty-btn {
  height: 68rpx;
  font-size: 24rpx;
}

.service-empty-actions {
  margin-top: 16rpx;
  display: flex;
  justify-content: center;
  gap: 14rpx;
}

.service-empty-actions .ghost-btn.wide {
  width: 360rpx;
  margin: 0;
}

.primary-btn.small {
  width: 100%;
  min-width: 0;
  height: 60rpx;
  font-size: 24rpx;
}

.ghost-btn {
  height: 56rpx;
  color: #1677ff;
  background: #eef5ff;
  font-size: 22rpx;
}

.ghost-btn.small {
  width: 100%;
  height: 60rpx;
  background: #f3f7ff;
}

.danger-btn {
  height: 64rpx;
  color: #e5484d;
  background: #fff1f2;
  font-size: 24rpx;
}

.more-btn {
  width: 100%;
  height: 54rpx;
  color: #64748b;
  background: transparent;
  border: 1rpx solid #d7deea;
  font-size: 23rpx;
}

.empty {
  padding: 80rpx 36rpx;
  text-align: center;
  color: #7b8494;
}

.refresh-tip {
  margin: -4rpx 0 18rpx;
  color: #7b8494;
  font-size: 23rpx;
  text-align: center;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #243044;
}

.empty-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.showcase-row {
  display: flex;
  flex-wrap: nowrap;
  gap: 16rpx;
  align-items: center;
  padding: 20rpx;
  background: #fff;
  border: 1rpx solid #dfe7f1;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(23, 45, 77, 0.05);
}

.banner {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  flex: 0 0 120rpx;
}

.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 8rpx;
  color: #1677ff;
  background: #eef5ff;
  font-weight: 700;
  font-size: 36rpx;
}

.fallback.lite {
  align-items: flex-start;
  justify-content: space-between;
  gap: 10rpx;
  padding: 16rpx;
  box-sizing: border-box;
}

.fallback.lite .title-cover-line,
.fallback.lite .title-cover-hint {
  max-width: 100%;
  text-align: left;
}

.fallback.lite .title-cover-line {
  font-size: 28rpx;
}

.title-cover-hint {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 30rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  color: currentColor;
  font-size: 16rpx;
  font-weight: 900;
  line-height: 1;
  white-space: nowrap;
}

.fallback.tone-0 {
  background: linear-gradient(135deg, #eff6ff, #dbeafe);
  color: #1d4ed8;
}

.fallback.tone-1 {
  background: linear-gradient(135deg, #ecfdf3, #d1fae5);
  color: #15803d;
}

.fallback.tone-2 {
  background: linear-gradient(135deg, #fff7ed, #ffedd5);
  color: #c2410c;
}

.fallback.tone-3 {
  background: linear-gradient(135deg, #f5f3ff, #ede9fe);
  color: #6d28d9;
}

.title-cover-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 34rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  color: currentColor;
  font-size: 18rpx;
  font-weight: 900;
  line-height: 1;
}

.title-cover-badge.compact {
  min-height: 30rpx;
  padding: 0 10rpx;
  font-size: 16rpx;
}

.title-cover-line {
  max-width: 84%;
  text-align: center;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.08;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.title-cover-line.second {
  font-size: 22rpx;
}

.share-image-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 750rpx;
  height: 420rpx;
  pointer-events: none;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-title {
  font-size: 30rpx;
  font-weight: 900;
  color: #1f2a3d;
  line-height: 1.35;
}

.row-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #697386;
  line-height: 1.45;
}

.row-created-time {
  margin-top: 6rpx;
  color: #98a2b3;
  font-size: 22rpx;
  line-height: 1.35;
  white-space: nowrap;
}

.meta-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a94a6;
}

.effect-line {
  margin-top: 6rpx;
  color: #475467;
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.showcase-purpose {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 10rpx;
  padding: 12rpx 14rpx;
  border-radius: 16rpx;
  background: #eef5ff;
  border: 1rpx solid #d8e8ff;
  box-sizing: border-box;
}

.showcase-purpose text {
  flex: 0 0 auto;
  color: #1677ff;
  font-size: 21rpx;
  font-weight: 900;
  white-space: nowrap;
}

.showcase-purpose view {
  min-width: 0;
  color: #667085;
  font-size: 20rpx;
  line-height: 1.35;
}

.showcase-purpose.compare {
  background: #fff7ed;
  border-color: #fed7aa;
}

.showcase-purpose.compare text,
.showcase-purpose.product text {
  color: #ea580c;
}

.showcase-purpose.product {
  background: #fff7ed;
  border-color: #fed7aa;
}

.showcase-purpose.service {
  background: #ecfdf3;
  border-color: #bbf7d0;
}

.showcase-purpose.service text {
  color: #11924d;
}

.showcase-purpose.property {
  background: #eef5ff;
}

.showcase-purpose.notes {
  background: #f4f0ff;
  border-color: #ddd6fe;
}

.showcase-purpose.notes text {
  color: #6d5dfc;
}

.compact-status-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 36rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: #eef5ff;
  color: #1677ff;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
  white-space: nowrap;
}

.status-pill.count {
  background: #f1f5f9;
  color: #64748b;
}

.status-pill.compare,
.status-pill.product,
.status-pill.warm {
  background: #fff7ed;
  color: #ea580c;
}

.status-pill.service {
  background: #ecfdf3;
  color: #11924d;
}

.status-pill.notes {
  background: #f4f0ff;
  color: #6d5dfc;
}

.status-pill.sent,
.status-pill.idle {
  background: #f1f5f9;
  color: #475467;
}

.status-pill.hot {
  background: #fff1f2;
  color: #e5484d;
}

.delivery-status {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 10rpx;
  padding: 12rpx 14rpx;
  border-radius: 8rpx;
  background: #f6f8fb;
  box-sizing: border-box;
}

.delivery-status text {
  flex: 0 0 auto;
  color: #475467;
  font-size: 21rpx;
  font-weight: 900;
  white-space: nowrap;
}

.delivery-status view {
  min-width: 0;
  color: #7b8798;
  font-size: 20rpx;
  line-height: 1.35;
}

.delivery-status.view {
  background: #eef5ff;
}

.delivery-status.view text {
  color: #1677ff;
}

.delivery-status.sent {
  background: #f1f5f9;
}

.delivery-status.sent text {
  color: #475467;
}

.delivery-status.warm {
  background: #fff7ed;
}

.delivery-status.warm text {
  color: #ea580c;
}

.delivery-status.hot {
  background: #fff1f2;
}

.delivery-status.hot text {
  color: #e5484d;
}

.share-growth-tip {
  margin-top: 8rpx;
  color: #1677ff;
  font-size: 20rpx;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 70rpx;
  box-sizing: border-box;
  min-height: 36rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  color: #697386;
  background: #f0f3f7;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
  white-space: nowrap;
}

.status.published {
  color: #067647;
  background: #e7f8ef;
}

.status.archived {
  color: #a15c00;
  background: #fff4dd;
}

.row-actions {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: center;
  gap: 8rpx;
  flex: 0 0 148rpx;
  max-width: 148rpx;
}

.row-actions .primary-btn.small,
.row-actions .ghost-btn.small {
  width: 100%;
  height: 56rpx;
  font-size: 21rpx;
}

.row-actions .more-btn {
  width: 100%;
  min-width: 0;
  height: 52rpx;
  padding: 0;
}

.analytics-panel {
  flex: 0 0 100%;
  padding-top: 14rpx;
  border-top: 1rpx solid #eef1f5;
}

.analytics-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
}

.analytics-grid view {
  padding: 14rpx 8rpx;
  border-radius: 8rpx;
  background: #f6f8fb;
  text-align: center;
}

.analytics-grid strong {
  display: block;
  color: #182334;
  font-size: 28rpx;
}

.analytics-grid text {
  color: #697386;
  font-size: 21rpx;
}

.analytics-block {
  margin-top: 16rpx;
}

.analytics-title {
  margin-bottom: 10rpx;
  color: #1f2a3d;
  font-size: 24rpx;
  font-weight: 800;
}

.analytics-empty {
  color: #8a94a6;
  font-size: 22rpx;
  line-height: 1.5;
}

.viewer-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.viewer-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  flex: 0 0 48rpx;
}

.fallback-small {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1677ff;
  background: #eef5ff;
  font-size: 18rpx;
  font-weight: 800;
}

.viewer-main {
  min-width: 0;
  color: #1f2a3d;
  font-size: 24rpx;
}

.viewer-main text {
  display: block;
  margin-top: 2rpx;
  color: #8a94a6;
  font-size: 21rpx;
}

.note-click-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #f0f3f7;
  color: #475467;
  font-size: 23rpx;
}

.note-click-row text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.note-click-row strong {
  color: #1677ff;
}

.note-action {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: 64rpx;
  height: 38rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: #eaf7ef;
  color: #11924d;
  font-size: 20rpx;
  font-weight: 900;
  white-space: nowrap;
}
