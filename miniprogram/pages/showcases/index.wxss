page {
  background: #f5f7fb;
}

.page-shell {
  min-height: 100vh;
  padding: 0 20rpx 28rpx;
  box-sizing: border-box;
}

.library-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 220rpx;
  padding: 42rpx 0 20rpx;
  box-sizing: border-box;
}

.hero-copy {
  flex: 1;
  min-width: 0;
  padding-right: 26rpx;
}

.hero-kicker {
  margin-bottom: 12rpx;
  color: #1677ff;
  font-size: 24rpx;
  font-weight: 900;
}

.hero-title {
  color: #111827;
  font-size: 58rpx;
  line-height: 1.05;
  font-weight: 900;
}

.hero-subtitle {
  max-width: 460rpx;
  margin-top: 14rpx;
  color: #64748b;
  font-size: 25rpx;
  line-height: 1.58;
}

.library-visual {
  width: 176rpx;
  height: 176rpx;
  border-radius: 46rpx;
  background: linear-gradient(135deg, #dcebff, #ffffff);
  color: #1677ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 900;
  box-shadow: 0 22rpx 54rpx rgba(31, 88, 168, 0.12);
}

.showcase-hero-panel {
  margin-bottom: 18rpx;
  padding: 24rpx;
  border: 1rpx solid #dbe6f7;
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(247, 250, 255, 0.98), rgba(255, 255, 255, 0.96) 56%, rgba(244, 248, 255, 0.98));
  box-shadow: 0 16rpx 40rpx rgba(31, 88, 168, 0.08);
  box-sizing: border-box;
}

.showcase-hero-label {
  color: #1677ff;
  font-size: 22rpx;
  font-weight: 900;
}

.showcase-hero-title {
  margin-top: 10rpx;
  color: #111827;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.2;
}

.showcase-hero-sub {
  margin-top: 12rpx;
  color: #64748b;
  font-size: 23rpx;
  line-height: 1.46;
}

.showcase-hero-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.showcase-hero-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  color: #526174;
  font-size: 20rpx;
  font-weight: 900;
}

.showcase-hero-badge.primary {
  background: #edf5ff;
  color: #1677ff;
}

.showcase-action-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: -2rpx;
  margin-bottom: 18rpx;
}

.mode-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 38rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #e8f7ef;
  color: #11924d;
  font-size: 21rpx;
  font-weight: 900;
  white-space: nowrap;
  box-sizing: border-box;
  margin-bottom: 0;
}

.showcase-filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 0 0 22rpx;
}

.showcase-filter {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 104rpx;
  min-height: 54rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #eef3f8;
  color: #526174;
  font-size: 23rpx;
  font-weight: 900;
  box-sizing: border-box;
  white-space: nowrap;
}

.showcase-filter.active {
  background: #1677ff;
  color: #ffffff;
}

.primary-btn,
.ghost-btn,
.danger-btn,
.more-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  border-radius: 8rpx;
  font-size: 26rpx;
  line-height: 1;
}

.primary-btn::after,
.ghost-btn::after,
.danger-btn::after,
.more-btn::after {
  border: 0;
}

.primary-btn {
  min-width: 144rpx;
  height: 60rpx;
  color: #fff;
  background: #1677ff;
  font-size: 23rpx;
}

.compact-create {
  flex: 0 0 auto;
  min-width: 310rpx;
  height: 64rpx;
  padding: 0 28rpx;
  font-size: 24rpx;
}

.primary-btn.wide {
  width: 260rpx;
  margin-top: 24rpx;
}

.ghost-btn.wide {
  width: 260rpx;
  margin: 16rpx auto 0;
}

.secondary-empty-btn {
  height: 68rpx;
  font-size: 24rpx;
}

.service-empty-actions {
  margin-top: 16rpx;
  display: flex;
  justify-content: center;
  gap: 14rpx;
}

.service-empty-actions .ghost-btn.wide {
  width: 360rpx;
  margin: 0;
}

.primary-btn.small {
  width: 100%;
  min-width: 0;
  height: 60rpx;
  font-size: 24rpx;
}

.primary-btn.small[disabled] {
  background: #edf2f7;
  color: #8a95a6;
}

.ghost-btn {
  height: 56rpx;
  color: #1677ff;
  background: #eef5ff;
  font-size: 22rpx;
}

.ghost-btn.small {
  width: 100%;
  height: 60rpx;
  background: #f3f7ff;
}

.danger-btn {
  height: 64rpx;
  color: #e5484d;
  background: #fff1f2;
  font-size: 24rpx;
}

.more-btn {
  width: 100%;
  height: 54rpx;
  color: #64748b;
  background: transparent;
  border: 1rpx solid #d7deea;
  font-size: 23rpx;
}

.empty {
  padding: 80rpx 36rpx;
  text-align: center;
  color: #7b8494;
}

.refresh-tip {
  margin: -4rpx 0 18rpx;
  color: #7b8494;
  font-size: 23rpx;
  text-align: center;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #243044;
}

.empty-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.showcase-row {
  display: flex;
  flex-wrap: nowrap;
  gap: 16rpx;
  align-items: center;
  padding: 20rpx;
  background: #fff;
  border: 1rpx solid #dfe7f1;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(23, 45, 77, 0.05);
}

.banner {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  flex: 0 0 120rpx;
}

.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 8rpx;
  color: #1677ff;
  background: #eef5ff;
  font-weight: 700;
  font-size: 36rpx;
}

.fallback.lite {
  align-items: flex-start;
  justify-content: space-between;
  gap: 10rpx;
  padding: 16rpx;
  box-sizing: border-box;
}

.fallback.lite .title-cover-line,
.fallback.lite .title-cover-hint {
  max-width: 100%;
  text-align: left;
}

.fallback.lite .title-cover-line {
  font-size: 28rpx;
}

.title-cover-hint {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 30rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  color: currentColor;
  font-size: 16rpx;
  font-weight: 900;
  line-height: 1;
  white-space: nowrap;
}

.fallback.tone-0 {
  background: linear-gradient(135deg, #eff6ff, #dbeafe);
  color: #1d4ed8;
}

.fallback.tone-1 {
  background: linear-gradient(135deg, #ecfdf3, #d1fae5);
  color: #15803d;
}

.fallback.tone-2 {
  background: linear-gradient(135deg, #fff7ed, #ffedd5);
  color: #c2410c;
}

.fallback.tone-3 {
  background: linear-gradient(135deg, #f5f3ff, #ede9fe);
  color: #6d28d9;
}

.title-cover-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 34rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  color: currentColor;
  font-size: 18rpx;
  font-weight: 900;
  line-height: 1;
}

.title-cover-badge.compact {
  min-height: 30rpx;
  padding: 0 10rpx;
  font-size: 16rpx;
}

.title-cover-line {
  max-width: 84%;
  text-align: center;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.08;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.title-cover-line.second {
  font-size: 22rpx;
}

.share-image-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 750rpx;
  height: 1800rpx;
  pointer-events: none;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-title {
  font-size: 30rpx;
  font-weight: 900;
  color: #1f2a3d;
  line-height: 1.35;
}

.row-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #697386;
  line-height: 1.45;
}

.row-created-time {
  margin-top: 6rpx;
  color: #98a2b3;
  font-size: 22rpx;
  line-height: 1.35;
  white-space: nowrap;
}

.meta-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a94a6;
}

.effect-line {
  margin-top: 6rpx;
  color: #475467;
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.showcase-purpose {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 10rpx;
  padding: 12rpx 14rpx;
  border-radius: 16rpx;
  background: #eef5ff;
  border: 1rpx solid #d8e8ff;
  box-sizing: border-box;
}

.showcase-purpose text {
  flex: 0 0 auto;
  color: #1677ff;
  font-size: 21rpx;
  font-weight: 900;
  white-space: nowrap;
}

.showcase-purpose view {
  min-width: 0;
  color: #667085;
  font-size: 20rpx;
  line-height: 1.35;
}

.showcase-purpose.compare {
  background: #fff7ed;
  border-color: #fed7aa;
}

.showcase-purpose.compare text,
.showcase-purpose.product text {
  color: #ea580c;
}

.showcase-purpose.product {
  background: #fff7ed;
  border-color: #fed7aa;
}

.showcase-purpose.service {
  background: #ecfdf3;
  border-color: #bbf7d0;
}

.showcase-purpose.service text {
  color: #11924d;
}

.showcase-purpose.property {
  background: #eef5ff;
}

.showcase-purpose.notes {
  background: #f4f0ff;
  border-color: #ddd6fe;
}

.showcase-purpose.notes text {
  color: #6d5dfc;
}

.compact-status-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 36rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: #eef5ff;
  color: #1677ff;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
  white-space: nowrap;
}

.status-pill.count {
  background: #f1f5f9;
  color: #64748b;
}

.status-pill.compare,
.status-pill.product,
.status-pill.warm {
  background: #fff7ed;
  color: #ea580c;
}

.status-pill.service {
  background: #ecfdf3;
  color: #11924d;
}

.status-pill.notes {
  background: #f4f0ff;
  color: #6d5dfc;
}

.status-pill.sent,
.status-pill.idle {
  background: #f1f5f9;
  color: #475467;
}

.status-pill.hot {
  background: #fff1f2;
  color: #e5484d;
}

.delivery-status {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 10rpx;
  padding: 12rpx 14rpx;
  border-radius: 8rpx;
  background: #f6f8fb;
  box-sizing: border-box;
}

.delivery-status text {
  flex: 0 0 auto;
  color: #475467;
  font-size: 21rpx;
  font-weight: 900;
  white-space: nowrap;
}

/* 合集一级页：与资料页共用视觉语言，只保留查找、回看和发送主路径。 */
.showcase-page {
  width: 100%;
  min-height: 100vh;
  padding: 0 34rpx 260rpx;
  overflow-x: hidden;
  background: #f6f9fe;
  box-sizing: border-box;
}

.showcase-page.is-empty { background: #ffffff; }

.showcase-mode-switch {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  height: 78rpx;
  margin: 14rpx 0 30rpx;
  padding: 5rpx;
  border-radius: 999rpx;
  background: #edf1f7;
  box-sizing: border-box;
}

.showcase-mode {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  color: #78849a;
  font-size: 29rpx;
  font-weight: 800;
}

.showcase-mode.active {
  background: #ffffff;
  color: #0f67ed;
  box-shadow: 0 5rpx 16rpx rgba(41, 72, 118, 0.1);
}

.showcase-search-row {
  width: 100%;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 78rpx;
  gap: 16rpx;
  align-items: center;
}

.showcase-search-box {
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 25rpx;
  border: 1rpx solid #e2e8f2;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(46, 78, 125, 0.05);
  box-sizing: border-box;
}

.showcase-search-icon {
  margin-right: 14rpx;
  color: #8d98aa;
  font-size: 39rpx;
  transform: rotate(-18deg);
}

.showcase-search-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  color: #172033;
  font-size: 25rpx;
}

.showcase-filter-trigger {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  width: 78rpx;
  height: 76rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid #e2e8f2;
  border-radius: 22rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.showcase-filter-trigger::after { border: 0; }
.showcase-filter-trigger.active { border-color: #8db9ff; background: #eef5ff; }

.showcase-filter-line {
  display: block;
  height: 3rpx;
  border-radius: 999rpx;
  background: #59657a;
}

.showcase-filter-line.top { width: 30rpx; }
.showcase-filter-line.middle { width: 21rpx; }
.showcase-filter-line.bottom { width: 11rpx; }

.showcase-quick-scroll {
  width: 100%;
  margin-top: 26rpx;
  white-space: nowrap;
}

.showcase-quick-row { display: flex; gap: 14rpx; }

.showcase-quick-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 126rpx;
  height: 62rpx;
  padding: 0 24rpx;
  border: 1rpx solid #e6ebf2;
  border-radius: 999rpx;
  background: #ffffff;
  color: #68758a;
  font-size: 24rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.showcase-quick-chip.active {
  border-color: #1f78ff;
  background: #1f78ff;
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(31, 120, 255, 0.22);
}

.showcase-section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 38rpx 2rpx 20rpx;
}

.showcase-section-title { color: #111827; font-size: 32rpx; font-weight: 900; }
.showcase-section-meta { color: #8a95a6; font-size: 22rpx; }
.showcase-manage-link { margin-left: 20rpx; color: #0f67ed; font-weight: 800; }
.showcase-refresh-tip { margin: -8rpx 0 18rpx; color: #8490a2; font-size: 21rpx; text-align: center; }

.showcase-list { display: grid; gap: 18rpx; }

.showcase-card {
  display: grid;
  grid-template-columns: 150rpx minmax(0, 1fr) 104rpx;
  gap: 16rpx;
  min-height: 190rpx;
  padding: 20rpx;
  border: 1rpx solid #e5eaf2;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(39, 70, 113, 0.06);
  box-sizing: border-box;
  overflow: hidden;
}

.showcase-cover {
  width: 150rpx;
  height: 150rpx;
  border-radius: 17rpx;
  background: #edf3fa;
}

.showcase-cover.generated {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
  padding: 18rpx;
  color: #ffffff;
  box-sizing: border-box;
}

.showcase-cover.tone-0 { background: linear-gradient(145deg, #6d91b8, #2d577d); }
.showcase-cover.tone-1 { background: linear-gradient(145deg, #8fc8a6, #397b5a); }
.showcase-cover.tone-2 { background: linear-gradient(145deg, #ffba72, #db6c36); }
.showcase-cover.tone-3 { background: linear-gradient(145deg, #a895df, #6350a5); }

.showcase-cover-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 50rpx;
  height: 34rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #335572;
  font-size: 17rpx;
  font-weight: 900;
}

.showcase-cover-title {
  position: relative;
  z-index: 2;
  display: -webkit-box;
  overflow: hidden;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1.35;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.showcase-cover-stack { position: absolute; right: -8rpx; bottom: 14rpx; width: 72rpx; height: 62rpx; opacity: 0.42; }
.showcase-cover-stack text { position: absolute; display: block; width: 58rpx; height: 38rpx; border: 3rpx solid #ffffff; border-radius: 7rpx; transform: rotate(-7deg); }
.showcase-cover-stack text:nth-child(2) { left: 7rpx; top: 8rpx; transform: rotate(0deg); }
.showcase-cover-stack text:nth-child(3) { left: 14rpx; top: 16rpx; transform: rotate(7deg); }

.showcase-card-main { min-width: 0; padding-top: 2rpx; }
.showcase-card-title { overflow: hidden; color: #131b2c; font-size: 27rpx; font-weight: 900; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }
.showcase-card-tags { display: flex; gap: 8rpx; margin-top: 12rpx; }

.showcase-type-tag,
.showcase-status-tag {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 35rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
  font-weight: 800;
  white-space: nowrap;
  box-sizing: border-box;
}

.showcase-type-tag { background: #edf5ff; color: #2770d2; }
.showcase-type-tag.tone-orange { background: #fff2e5; color: #d76b24; }
.showcase-type-tag.tone-purple { background: #f1edff; color: #7655c7; }
.showcase-type-tag.tone-green { background: #eaf8ef; color: #268a54; }
.showcase-status-tag { background: #eef1f5; color: #6e798b; }
.showcase-status-tag.status-published { background: #eaf8ef; color: #278a55; }
.showcase-status-tag.status-archived { background: #f2f3f5; color: #8a909a; }

.showcase-same-style-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 64rpx;
  height: 35rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: #e8f7ee;
  color: #15803d;
  font-size: 18rpx;
  font-weight: 800;
  line-height: 1;
  white-space: nowrap;
  box-sizing: border-box;
}

.showcase-card-count { margin-top: 13rpx; color: #5f6c80; font-size: 20rpx; font-weight: 800; }
.showcase-card-effect { margin-top: 9rpx; overflow: hidden; color: #8490a2; font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.showcase-feedback-link { margin-top: 8rpx; overflow: hidden; color: #e86f25; font-size: 19rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }

.showcase-card-actions { display: flex; flex-direction: column; align-items: stretch; justify-content: space-between; gap: 0; min-width:0; }

.showcase-primary-action,
.showcase-more-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  font-weight: 900;
  line-height: 1;
  box-sizing: border-box;
}

.showcase-primary-action { min-height: 64rpx; padding: 0 8rpx; background: #1f78ff; color: #ffffff; font-size: 21rpx; }
