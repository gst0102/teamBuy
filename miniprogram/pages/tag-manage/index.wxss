.tag-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 0 24rpx;
}

.tag-visual {
  width: 176rpx;
  height: 176rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #dcebff, #ffffff);
  color: #1677ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 900;
  box-shadow: 0 18rpx 46rpx rgba(31, 88, 168, 0.12);
}

.tag-input-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 20rpx;
}

.tag-input {
  flex: 1;
  margin-bottom: 0;
}

.add-btn {
  width: 132rpx;
  margin: 0;
}

.tag-row-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #edf2f8;
}

.tag-row-item:last-child {
  border-bottom: none;
}

.tag-name {
  font-size: 30rpx;
  font-weight: 900;
  color: #172033;
}

.mini-danger {
  width: 116rpx;
  height: 58rpx;
  line-height: 58rpx;
  border-radius: 999rpx;
  background: #fff1f0;
  color: #d92d20;
  font-size: 24rpx;
}
