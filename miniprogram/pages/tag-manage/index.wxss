.tag-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 0 24rpx;
}

.tag-visual {
  width: 176rpx;
  height: 176rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #dcebff, #ffffff);
  color: #1677ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 900;
  box-shadow: 0 18rpx 46rpx rgba(31, 88, 168, 0.12);
}

.tag-input-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 20rpx;
}

.tag-guide {
  margin-top: 0;
}

.guide-title {
  color: #172033;
  font-size: 30rpx;
  font-weight: 900;
}

.guide-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.guide-grid view {
  min-width: 0;
  min-height: 142rpx;
  padding: 16rpx;
  border-radius: 8rpx;
  background: #f6fbf8;
  box-sizing: border-box;
}

.guide-grid text {
  display: block;
}

.guide-grid text:first-child {
  color: #11924d;
  font-size: 23rpx;
  font-weight: 900;
}

.guide-grid text:last-child {
  margin-top: 8rpx;
  color: #6f7d91;
  font-size: 21rpx;
  line-height: 1.35;
}

.tag-input {
  flex: 1;
  margin-bottom: 0;
}

.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 156rpx;
  height: 72rpx;
  margin: 0;
  padding: 0;
  line-height: 1;
  font-size: 25rpx;
  font-weight: 900;
}

.tag-row-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #edf2f8;
}

.tag-row-item:last-child {
  border-bottom: none;
}

.tag-name {
  font-size: 30rpx;
  font-weight: 900;
  color: #172033;
}

.mini-danger {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 136rpx;
  height: 64rpx;
  line-height: 1;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  background: #fff1f0;
  color: #d92d20;
  font-size: 24rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.add-btn::after,
.mini-danger::after {
  border: 0;
}
