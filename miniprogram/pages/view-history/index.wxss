.view-history-page {
  padding-bottom: 56rpx;
}

.view-history-intro {
  margin: 20rpx 4rpx 18rpx;
}

.view-history-intro-title {
  color: #172033;
  font-size: 34rpx;
  font-weight: 900;
}

.view-history-intro-sub {
  margin-top: 8rpx;
  color: #8994a5;
  font-size: 23rpx;
}

.view-history-list {
  padding: 0 24rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 18rpx 46rpx rgba(31, 88, 168, 0.09);
  box-sizing: border-box;
}

.view-history-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 144rpx;
  border-bottom: 1rpx solid #edf1f6;
}

.view-history-row:last-child {
  border-bottom: 0;
}

.view-history-row-cover {
  flex: 0 0 96rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 18rpx;
  background: #eef4ff;
}

.view-history-row-main {
  flex: 1;
  min-width: 0;
}

.view-history-row-title {
  overflow: hidden;
  color: #172033;
  font-size: 28rpx;
  font-weight: 850;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.view-history-row-time {
  margin-top: 10rpx;
  color: #8994a5;
  font-size: 22rpx;
  line-height: 1.3;
}

.view-history-row-arrow {
  flex: 0 0 auto;
  color: #a0aabd;
  font-size: 40rpx;
  line-height: 1;
}

.view-history-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 360rpx;
  padding: 48rpx 32rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.94);
  color: #8994a5;
  text-align: center;
  box-sizing: border-box;
}

.view-history-state-icon {
  width: 92rpx;
  height: 92rpx;
  margin-bottom: 22rpx;
  border-radius: 50%;
  background: #eef4ff;
}

.view-history-state-icon.text-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1677ff;
  font-size: 42rpx;
  font-weight: 900;
}

.view-history-state-title {
  color: #172033;
  font-size: 28rpx;
  font-weight: 900;
}

.view-history-state-sub {
  max-width: 520rpx;
  margin-top: 12rpx;
  color: #8994a5;
  font-size: 23rpx;
  line-height: 1.5;
}

.view-history-primary,
.view-history-secondary {
  width: 280rpx;
  min-height: 76rpx;
  margin-top: 26rpx;
  border-radius: 18rpx;
  font-size: 25rpx;
  font-weight: 800;
}

.view-history-primary {
  background: #1677ff;
  color: #ffffff;
}

.view-history-secondary {
  margin-top: 14rpx;
  background: #eef4ff;
  color: #55708f;
}
/* Typography scale v2: make browsing history useful at a glance. */
.view-history-page .view-history-intro-title { font-size: 34rpx; }
.view-history-page .view-history-intro-sub { font-size: 24rpx; }
.view-history-page .view-history-state-title { font-size: 30rpx; }
.view-history-page .view-history-state-sub { font-size: 24rpx; }
.view-history-page .view-history-primary,
.view-history-page .view-history-secondary { display: flex; align-items: center; justify-content: center; min-height: 72rpx; font-size: 26rpx; }
.view-history-page .view-history-row-title { font-size: 27rpx; }
.view-history-page .view-history-row-time { font-size: 22rpx; }
.view-history-page .view-history-row-arrow { font-size: 34rpx; }
