.radar-page {
  padding-bottom: 56rpx;
}
/* Radar workbench: the customer workflow is intentionally compact and
 * semantic. Every action is visible, and each status has a stable color. */
.radar-workbench {
  padding-bottom: 52rpx;
  background:
    radial-gradient(circle at 88% 7%, rgba(160, 206, 255, 0.34), transparent 230rpx),
    linear-gradient(180deg, #edf5ff 0%, #f7fbff 48%, #ffffff 100%);
}

.radar-workbench-intro {
  margin: 10rpx 0 20rpx;
  padding: 28rpx 26rpx 24rpx;
  border: 1rpx solid #cddff4;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #ffffff 0%, #f6faff 100%);
  box-shadow: 0 14rpx 34rpx rgba(37, 93, 156, 0.08);
}

.radar-workbench-kicker {
  color: #1677ff;
  font-size: 22rpx;
  font-weight: 900;
}

.radar-workbench-title {
  margin-top: 12rpx;
  color: #132139;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.2;
}

.radar-workbench-subtitle {
  margin-top: 12rpx;
  color: #697b92;
  font-size: 24rpx;
  line-height: 1.5;
}

.radar-workbench-private {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  color: #20845e;
  font-size: 20rpx;
  font-weight: 800;
}

.radar-workbench-private-dot,
.radar-workbench-refresh-dot {
  display: inline-block;
  width: 14rpx;
  height: 14rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #35ba87;
}

.radar-workbench-metrics {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.radar-workbench-metric {
  position: relative;
  min-width: 0;
  min-height: 132rpx;
  padding: 22rpx 18rpx 18rpx;
  border: 1rpx solid #d5e3f3;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 8rpx 22rpx rgba(47, 91, 139, 0.06);
  box-sizing: border-box;
}

.radar-workbench-metric:active { background: #edf5ff; }
.radar-workbench-metric.pending { border-color: #f0d18e; background: #fffaf0; }
.radar-workbench-metric.visitors { border-color: #c9dcf6; background: #f4f8ff; }
.radar-workbench-metric.abandoned { border-color: #f3d0a5; background: #fff7ed; }
.radar-workbench-metric.following { border-color: #b9e4ce; background: #f1fbf5; }

.radar-workbench-metric-value {
  color: #142139;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1;
}

.radar-workbench-metric-label {
  margin-top: 13rpx;
  overflow: hidden;
  color: #718198;
  font-size: 21rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.radar-workbench-metric-arrow {
  position: absolute;
  right: 15rpx;
  top: 14rpx;
  color: #8195ad;
  font-size: 30rpx;
  line-height: 1;
}

.radar-workbench-tabs {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8rpx;
  margin-bottom: 18rpx;
  padding: 7rpx;
  border: 1rpx solid #d7e5f5;
  border-radius: 22rpx;
  background: rgba(232, 241, 251, 0.86);
  box-sizing: border-box;
}

.radar-workbench-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 72rpx;
  border-radius: 16rpx;
  color: #667991;
  font-size: 23rpx;
  font-weight: 900;
  white-space: nowrap;
}

.radar-workbench-tab.active {
  background: #1677ff;
  color: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(22, 119, 255, 0.2);
}

.radar-workbench-tab-count {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 30rpx;
  height: 30rpx;
  margin-left: 7rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: #f4b46a;
  color: #ffffff;
  font-size: 17rpx;
  line-height: 1;
}

.radar-workbench-tab.active .radar-workbench-tab-count { background: rgba(255, 255, 255, 0.26); }

.radar-workbench-refresh {
  display: flex;
  align-items: center;
  margin: -4rpx 4rpx 14rpx;
  color: #6e8299;
  font-size: 20rpx;
}

.radar-workbench-refresh-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 7rpx;
}

.radar-workbench-state,
.radar-workbench-empty {
  margin-bottom: 20rpx;
  padding: 48rpx 28rpx;
  border: 1rpx solid #d6e4f4;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.92);
  text-align: center;
  box-sizing: border-box;
  box-shadow: 0 10rpx 26rpx rgba(43, 87, 133, 0.05);
}

.radar-workbench-state-icon,
.radar-workbench-empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  margin: 0 auto 16rpx;
  border-radius: 50%;
  background: #fff0dc;
  color: #d98220;
  font-size: 34rpx;
  font-weight: 900;
}

.radar-workbench-state-icon.neutral,
.radar-workbench-empty-icon {
  background: #eaf3ff;
  color: #1677ff;
}

.radar-workbench-empty-icon.abandoned { background: #fff0de; color: #d98220; }
.radar-workbench-state-title,
.radar-workbench-empty-title { color: #17243a; font-size: 28rpx; font-weight: 900; line-height: 1.35; }
.radar-workbench-state-desc,
.radar-workbench-empty-desc,
.radar-workbench-empty-hint { margin-top: 10rpx; color: #78889b; font-size: 22rpx; line-height: 1.55; }
.radar-workbench-empty-hint { margin-top: 14rpx; color: #9aa8b8; font-size: 20rpx; }

.radar-workbench-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 72rpx;
  margin: 0;
  padding: 0 14rpx;
  border: 0;
  border-radius: 17rpx;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1;
  white-space: nowrap;
  box-sizing: border-box;
}

.radar-workbench-button::after { border: 0; }
.radar-workbench-button.primary { background: #1677ff; box-shadow: 0 9rpx 18rpx rgba(22, 119, 255, 0.16); }
.radar-workbench-button.abandon { border: 1rpx solid #f1c58f; background: #fff8ed; color: #b96918; }
.radar-workbench-button.restore { border: 1rpx solid #b9e2cb; background: #effbf3; color: #23875d; }
.radar-workbench-button.delete { border: 1rpx solid #f1c7bd; background: #fff4f1; color: #c45d4d; }
.radar-workbench-button.full { width: 100%; margin-top: 24rpx; }
.radar-workbench-button:active { opacity: 0.78; }

.radar-workbench-filter {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid #cfe1fb;
  border-radius: 18rpx;
  background: #f5f9ff;
}

.radar-workbench-filter-copy { min-width: 0; }
.radar-workbench-filter-label { color: #7d8da1; font-size: 19rpx; }
.radar-workbench-filter-title { margin-top: 4rpx; overflow: hidden; color: #245b9b; font-size: 22rpx; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }
.radar-workbench-filter-clear { display: flex; align-items: center; justify-content: center; flex: 0 0 auto; height: 54rpx; margin: 0; padding: 0 16rpx; border: 1rpx solid #bfd6f6; border-radius: 13rpx; background: #ffffff; color: #1769e0; font-size: 20rpx; font-weight: 900; line-height: 1; }
.radar-workbench-filter-clear::after { border: 0; }

.radar-workbench-section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin: 12rpx 2rpx 16rpx;
}

.radar-workbench-section-title { color: #17243a; font-size: 30rpx; font-weight: 900; line-height: 1.3; }
.radar-workbench-section-desc { margin-top: 6rpx; color: #7b8b9f; font-size: 20rpx; line-height: 1.45; }
.radar-workbench-section-count { flex: 0 0 auto; padding-top: 4rpx; color: #1769e0; font-size: 22rpx; font-weight: 900; white-space: nowrap; }
.radar-workbench-section-count.abandoned-count { color: #c87925; }
.radar-workbench-section-count.following-count { color: #23875d; }

.radar-workbench-card {
  margin-bottom: 18rpx;
  padding: 22rpx;
  border: 2rpx solid #c2e7d1;
  border-radius: 24rpx;
  background: #f3fcf6;
  box-shadow: 0 10rpx 24rpx rgba(39, 124, 83, 0.07);
  box-sizing: border-box;
}

.radar-workbench-card.high-intent { border-color: #efc254; background: #fff9e9; box-shadow: 0 0 0 5rpx rgba(239, 194, 84, 0.12), 0 12rpx 28rpx rgba(184, 130, 24, 0.08); }
.radar-workbench-card.visitor-card { border-color: #c8dcf6; background: #f3f8ff; box-shadow: 0 10rpx 24rpx rgba(36, 102, 178, 0.07); }
.radar-workbench-card.abandoned-card { border-color: #f0c38e; background: #fff5e9; box-shadow: 0 10rpx 24rpx rgba(192, 119, 34, 0.07); }
.radar-workbench-card.following-card { border-color: #b8e2ca; background: #f0fbf4; box-shadow: 0 10rpx 24rpx rgba(35, 135, 93, 0.07); }

.radar-workbench-card-head { display: flex; align-items: center; gap: 14rpx; min-width: 0; }
.radar-workbench-avatar { display: flex; align-items: center; justify-content: center; flex: 0 0 auto; width: 72rpx; height: 72rpx; overflow: hidden; border-radius: 22rpx; background: #e3f2ff; color: #1677ff; font-size: 29rpx; font-weight: 900; }
.radar-workbench-avatar-image { width: 100%; height: 100%; }
.radar-workbench-avatar.abandoned-avatar { background: #ffe6c7; color: #c87925; }
.radar-workbench-avatar.following-avatar { background: #ddf5e6; color: #23875d; }
.radar-workbench-card-identity { flex: 1; min-width: 0; }
.radar-workbench-card-name { overflow: hidden; color: #17243a; font-size: 28rpx; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }
.radar-workbench-card-state { margin-top: 6rpx; color: #60809d; font-size: 20rpx; font-weight: 800; }
.radar-workbench-status { display: flex; align-items: center; justify-content: center; flex: 0 0 auto; min-height: 38rpx; padding: 0 12rpx; border-radius: 999rpx; font-size: 18rpx; font-weight: 900; white-space: nowrap; }
.radar-workbench-status.high { background: #fff0c6; color: #af6c00; }
.radar-workbench-status.normal { background: #dff4e7; color: #237c53; }
.radar-workbench-status.visitor { background: #e0edff; color: #2765a7; }
.radar-workbench-status.abandoned { background: #ffe7cc; color: #b96a1c; }
.radar-workbench-status.following { background: #dcf5e6; color: #23875d; }

.radar-workbench-evidence,
.radar-workbench-seen { margin-top: 18rpx; padding: 16rpx; border-radius: 16rpx; background: rgba(255, 255, 255, 0.58); }
.radar-workbench-evidence-label,
.radar-workbench-seen-label { color: #72859b; font-size: 19rpx; font-weight: 900; }
.radar-workbench-evidence-text { margin-top: 7rpx; color: #273b55; font-size: 22rpx; font-weight: 800; line-height: 1.45; }
.radar-workbench-seen { margin-top: 10rpx; background: rgba(247, 250, 255, 0.76); }
.radar-workbench-seen-row { display: flex; align-items: center; gap: 12rpx; margin-top: 7rpx; }
.radar-workbench-seen-text { flex: 1; min-width: 0; color: #354c67; font-size: 21rpx; line-height: 1.45; }
.radar-workbench-source-link { display: flex; align-items: center; justify-content: center; flex: 0 0 auto; color: #1769e0; font-size: 20rpx; font-weight: 900; white-space: nowrap; }
.radar-workbench-source-link text { margin-left: 3rpx; font-size: 29rpx; line-height: 1; }
.radar-workbench-tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 14rpx; }
.radar-workbench-tags text { display: flex; align-items: center; justify-content: center; min-height: 36rpx; padding: 0 11rpx; border-radius: 999rpx; background: rgba(226, 239, 255, 0.84); color: #2a66a4; font-size: 18rpx; white-space: nowrap; }
.radar-workbench-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; margin-top: 18rpx; }

@media screen and (max-width: 680rpx) {
  .radar-workbench-title { font-size: 38rpx; }
  .radar-workbench-metric { min-height: 124rpx; padding-left: 14rpx; padding-right: 12rpx; }
  .radar-workbench-metric-value { font-size: 36rpx; }
  .radar-workbench-metric-label { font-size: 19rpx; }
  .radar-workbench-card { padding: 18rpx; }
  .radar-workbench-card-name { font-size: 26rpx; }
  .radar-workbench-button { font-size: 21rpx; }
}

/* 2026-09 bottom-tab typography: prioritize signal, status and next action. */
.radar-workbench .radar-workbench-kicker { font-size: 24rpx; }
.radar-workbench .radar-workbench-title { font-size: 42rpx; }
.radar-workbench .radar-workbench-subtitle { font-size: 26rpx; }
.radar-workbench .radar-workbench-private { font-size: 22rpx; }
.radar-workbench .radar-workbench-metric { min-height: 136rpx; }
.radar-workbench .radar-workbench-metric-value { font-size: 42rpx; }
.radar-workbench .radar-workbench-metric-label { font-size: 24rpx; }
.radar-workbench .radar-workbench-metric-arrow { font-size: 32rpx; }
.radar-workbench .radar-workbench-tab { min-height: 76rpx; font-size: 25rpx; }
.radar-workbench .radar-workbench-tab-count { font-size: 19rpx; }
.radar-workbench .radar-workbench-refresh { font-size: 22rpx; }
.radar-workbench .radar-workbench-state-title,
.radar-workbench .radar-workbench-empty-title { font-size: 31rpx; }
.radar-workbench .radar-workbench-state-desc,
.radar-workbench .radar-workbench-empty-desc { font-size: 24rpx; }
.radar-workbench .radar-workbench-empty-hint { font-size: 22rpx; }
.radar-workbench .radar-workbench-button { font-size: 25rpx; }
.radar-workbench .radar-workbench-filter-label { font-size: 22rpx; }
.radar-workbench .radar-workbench-filter-title { font-size: 25rpx; }
.radar-workbench .radar-workbench-filter-clear { font-size: 22rpx; }
.radar-workbench .radar-workbench-section-title { font-size: 32rpx; }
.radar-workbench .radar-workbench-section-desc { font-size: 23rpx; }
.radar-workbench .radar-workbench-section-count { font-size: 24rpx; }
.radar-workbench .radar-workbench-card-name { font-size: 30rpx; }
.radar-workbench .radar-workbench-card-state { font-size: 22rpx; }
.radar-workbench .radar-workbench-status { font-size: 20rpx; }
.radar-workbench .radar-workbench-evidence-label,
.radar-workbench .radar-workbench-seen-label { font-size: 21rpx; }
.radar-workbench .radar-workbench-evidence-text { font-size: 24rpx; }
.radar-workbench .radar-workbench-seen-text { font-size: 23rpx; }
.radar-workbench .radar-workbench-source-link { font-size: 22rpx; }
.radar-workbench .radar-workbench-tags text { font-size: 20rpx; }
