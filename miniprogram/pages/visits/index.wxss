.visits-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0 24rpx;
}

.visits-visual {
  width: 176rpx;
  height: 176rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #dcebff, #ffffff);
  color: #1677ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 900;
  box-shadow: 0 18rpx 46rpx rgba(31, 88, 168, 0.12);
}

.range-tabs {
  display: flex;
  background: rgba(255, 255, 255, 0.74);
  border-radius: 24rpx;
  padding: 8rpx;
  margin-bottom: 22rpx;
}

.range-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  color: #5e6b7e;
  border-radius: 20rpx;
  font-size: 28rpx;
}

.range-tab.active {
  background: linear-gradient(135deg, #2d8cff, #0066ff);
  color: #fff;
  font-weight: 800;
}

.stat-icon.blue {
  background: linear-gradient(135deg, #368cff, #0066ff);
}

.stat-icon.green {
  background: linear-gradient(135deg, #44d58a, #12b76a);
}

.stat-icon.orange {
  background: linear-gradient(135deg, #ffb24a, #ff7a1a);
}

.stat-icon.purple {
  background: linear-gradient(135deg, #8b7cff, #6845f5);
}

.visits-filter {
  margin-bottom: 18rpx;
}

.visit-group {
  background: rgba(255, 255, 255, 0.94);
  border-radius: 32rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 18rpx 46rpx rgba(31, 88, 168, 0.09);
}

.visit-resource {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx;
  border-bottom: 1rpx solid #edf2f8;
}

.visit-cover {
  width: 146rpx;
  height: 96rpx;
  border-radius: 18rpx;
  background: #edf5ff;
}

.visit-cover.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1677ff;
  font-weight: 800;
}

.visit-info {
  flex: 1;
  min-width: 0;
}

.visit-title {
  font-size: 30rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mini-btn {
  min-width: 144rpx;
  padding: 0 18rpx;
  height: 62rpx;
  line-height: 62rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #4a5870;
  border: 1rpx solid #e5ebf3;
  font-size: 24rpx;
}

.visit-row {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #edf2f8;
}

.avatar.small {
  width: 64rpx;
  height: 64rpx;
}

.visit-row-main {
  flex: 1;
  margin-left: 18rpx;
}

.visit-name {
  font-size: 28rpx;
  font-weight: 800;
}

.visit-time {
  color: #8a96a8;
  font-size: 24rpx;
}

.empty-state.compact {
  padding: 24rpx;
}

.intent-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #fff1df, #fff7ed);
  margin: 8rpx 0 26rpx;
}

.intent-title {
  color: #8a3900;
  font-size: 30rpx;
  font-weight: 900;
}

.intent-desc {
  color: #9a5a21;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.intent-btn {
  color: #fff;
  background: linear-gradient(135deg, #ff9f2d, #ff6a00);
  border-radius: 999rpx;
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  font-weight: 800;
}
