<view class="account-page">
  <custom-nav title="我的账户" showBack="{{true}}" fallbackUrl="/subpackages/my-tools-mutual-help/mine/index" />

  <view class="account-content">
    <view class="account-hero">
      <view class="account-eyebrow">资料整理助手 · 互助积分账户</view>
      <view class="account-title">我的账户</view>
    </view>

    <view class="balance-card">
      <view class="balance-heading"><text wx:if="{{config.rechargeVisible}}">总积分</text><text wx:else>可用积分</text><text class="balance-caption">可用于三个工具</text></view>
      <view class="balance-total">{{balances.total}}<text>分</text></view>
      <view wx:if="{{config.rechargeVisible}}" class="balance-divider"></view>
      <view wx:if="{{config.rechargeVisible}}" class="balance-breakdown">
        <view class="balance-item base">
          <view class="balance-item-label"><text class="balance-dot"></text>基础积分</view>
          <view class="balance-item-value">{{balances.base}} 分</view>
          <view class="balance-item-tip">任务奖励 / 平台发放 · 不可提现</view>
        </view>
        <view class="balance-item reward">
          <view class="balance-item-label"><text class="balance-dot"></text>充值积分</view>
          <view class="balance-item-value">{{balances.reward}} 分</view>
          <view class="balance-item-tip">充值或任务奖励 · 可提现</view>
        </view>
      </view>
    </view>

    <view wx:if="{{config.rechargeVisible}}" class="account-actions">
      <button wx:if="{{config.rechargeVisible}}" class="account-action recharge" bindtap="handleRecharge" disabled="{{!config.rechargeEnabled}}">
        <text>{{config.rechargeEnabled ? '充值积分' : '充值暂未开放'}}</text><text class="action-sub">10 元 = 100 分</text>
      </button>
      <button wx:if="{{config.withdrawalVisible}}" class="account-action withdrawal" bindtap="handleWithdraw" disabled="{{!config.withdrawalEnabled}}">
        <text>{{config.withdrawalEnabled ? '提现积分' : '提现暂未开放'}}</text><text class="action-sub">审核后转账</text>
      </button>
    </view>

    <view wx:if="{{config.rechargeVisible && config.withdrawalVisible}}" class="rule-card">
      <view class="section-heading"><text>提现说明</text><text class="section-caption">服务端规则</text></view>
      <view class="rule-row"><text class="rule-mark">兑</text><view><view class="rule-title">提现范围</view><view class="rule-copy">{{rules.accountScopeText || '仅充值积分和充值积分任务奖励可提现；基础积分不可提现。'}}</view></view></view>
      <view class="rule-row"><text class="rule-mark">额</text><view><view class="rule-title">兑换与最低金额</view><view class="rule-copy">{{rules.conversionText || '10 充值积分 = 1 元。'}}{{rules.minimumText || '单笔最低提现 100 充值积分。'}}</view></view></view>
      <view class="rule-row"><text class="rule-mark">费</text><view><view class="rule-title">手续费</view><view class="rule-copy">{{rules.feeText || '提现手续费为提现金额的 20%。'}}</view></view></view>
      <view class="rule-row"><text class="rule-mark">次</text><view><view class="rule-title">申请次数与时间</view><view class="rule-copy">{{rules.withdrawalWindowText || '每日均可提交。'}}{{rules.dailyLimitText || '每日最多提交 1 笔。'}}</view></view></view>
      <view class="rule-row"><text class="rule-mark">审</text><view><view class="rule-title">审核与到账</view><view class="rule-copy">{{rules.reviewTimeText || '提交后进入 PC 管理员审核。'}}{{rules.arrivalTimeText || '到账时间以微信商户转账结果为准。'}}</view></view></view>
      <view class="rule-row last"><text class="rule-mark">退</text><view><view class="rule-title">失败与撤销</view><view class="rule-copy">{{rules.failureText || '审核拒绝、转账失败或撤销时，冻结积分退回。'}}</view></view></view>
    </view>

    <view wx:if="{{statusText}}" class="status-text">{{statusText}}</view>

    <view class="ledger-card">
      <view class="section-heading"><text>最近流水</text><text class="section-caption">实时同步</text></view>
      <view wx:for="{{ledgers}}" wx:key="id" class="ledger-row">
        <view class="ledger-main"><view class="ledger-reason">{{item.reason}}</view><view class="ledger-meta">{{item.pointTypeLabel}} · {{item.timeText}}</view></view>
        <view class="ledger-amount {{item.deltaClass}}">{{item.deltaText}} 分</view>
      </view>
      <view wx:if="{{!ledgers.length}}" class="ledger-empty">暂无积分流水</view>
    </view>
  </view>
</view>
