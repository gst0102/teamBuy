<view class="mutual-page theme-{{theme}}">
  <custom-nav title="" showBack="{{true}}" theme="{{theme}}" />

  <view class="mutual-content">
    <view class="theme-switch-row">
      <text class="theme-switch-label">主题</text>
      <view class="theme-switch">
        <view class="theme-option {{theme === 'light' ? 'active' : ''}}" data-theme="light" bindtap="handleThemeChange">浅色</view>
        <view class="theme-option {{theme === 'dark' ? 'active' : ''}}" data-theme="dark" bindtap="handleThemeChange">深色</view>
      </view>
    </view>

    <view class="mutual-heading">
      <view>
        <view class="mutual-title">互帮互助</view>
        <view class="mutual-subtitle">用互助积分交换真实的帮助，让每一次完成都有清楚的标准。</view>
      </view>
    </view>

    <view class="module-tabs">
      <view wx:for="{{tabs}}" wx:key="key" class="module-tab {{item.key === activeTab ? 'active' : ''}}" data-tab="{{item.key}}" bindtap="handleTabChange">{{item.label}}</view>
    </view>

    <view class="points-card">
      <view class="points-card-main">
        <view class="points-card-info">
          <view class="points-label">{{pointsLabel}}</view>
          <view class="points-line"><text class="points-value">{{points}}</text><text class="points-unit">分</text></view>
          <view class="points-tip">当前余额 · 可用于发布任务</view>
        </view>
        <view class="points-card-actions">
          <button class="rule-button" bindtap="handleOpenRules">规则</button>
        </view>
      </view>
    </view>

    <view class="mutual-growth-banner">
      <view class="growth-badge">互助</view>
      <view class="growth-copy">
        <view class="growth-title">互助赚积分，让别人帮你完成</view>
        <view class="growth-subtitle">完成别人的任务，赚取积分，发布自己的需求</view>
      </view>
      <view class="growth-arrow">›</view>
    </view>

    <view class="section-row">
      <view>
        <view class="section-heading">任务大厅</view>
      </view>
      <view class="section-controls">
        <view class="segmented-control">
          <view class="segment-item {{sortMode === 'publisher' ? 'active' : ''}}" data-sort="publisher" bindtap="handleSortChange">积分优先</view>
          <view class="segment-item {{sortMode === 'reward' ? 'active' : ''}}" data-sort="reward" bindtap="handleSortChange">赏金最高</view>
        </view>
        <view class="layout-switch" aria-label="任务卡片布局">
          <view class="layout-option {{listColumns === 1 ? 'active' : ''}}" data-columns="1" bindtap="handleColumnsChange">1x</view>
          <view class="layout-option {{listColumns === 2 ? 'active' : ''}}" data-columns="2" bindtap="handleColumnsChange">2x</view>
        </view>
      </view>
    </view>

    <scroll-view class="filter-row" scroll-x="true" show-scrollbar="false">
      <view class="filter-chip {{taskFilter === 'all' ? 'active' : ''}}" data-filter="all" bindtap="handleFilterChange">全部任务</view>
      <view class="filter-chip {{taskFilter === 'miniapp' ? 'active' : ''}}" data-filter="miniapp" bindtap="handleFilterChange">小程序任务</view>
      <view class="filter-chip {{taskFilter === 'wool' ? 'active' : ''}}" data-filter="wool" bindtap="handleFilterChange">羊毛</view>
      <view class="filter-chip {{taskFilter === 'ordinary' ? 'active' : ''}}" data-filter="ordinary" bindtap="handleFilterChange">普通任务</view>
    </scroll-view>

    <view class="task-list columns-{{listColumns}}" wx:if="{{tasks.length}}">
      <view wx:for="{{tasks}}" wx:key="id" class="task-card" data-id="{{item.id}}" bindtap="handleOpenTask">
        <view class="task-card-top">
          <view class="task-kind {{item.taskKind === 'ordinary' ? 'ordinary' : (item.taskKind === 'wool' ? 'wool' : '')}}">{{item.categoryLabel}}</view>
          <view class="task-reward">{{item.taskKind === 'wool' ? item.woolCardRewardText : item.rewardText}}</view>
        </view>
        <view class="task-title">{{item.title}}</view>
        <view class="task-description">{{item.description}}</view>
        <view class="task-entry-summary">{{item.taskLinkSummary}}</view>
        <view class="task-publisher">{{item.publisherPointsText}}</view>
        <view class="task-foot"><text>{{item.remainingText}} · {{item.deadlineText}}</text><text class="task-go">去完成 ›</text></view>
      </view>
    </view>

    <view class="empty-state" wx:else>
      <view class="empty-title">暂时没有匹配的任务</view>
      <view class="empty-copy">换个任务类型，或者稍后再来看看。</view>
    </view>
  </view>
</view>
