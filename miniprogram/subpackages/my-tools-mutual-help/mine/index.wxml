<view class="mutual-page theme-{{theme}}">
  <custom-nav title="我的工具" showBack="{{true}}" theme="{{theme}}" />

  <view class="mutual-content">
    <view class="theme-switch-row">
      <text class="theme-switch-label">主题</text>
      <view class="theme-switch">
        <view class="theme-option {{theme === 'light' ? 'active' : ''}}" data-theme="light" bindtap="handleThemeChange">浅色</view>
        <view class="theme-option {{theme === 'dark' ? 'active' : ''}}" data-theme="dark" bindtap="handleThemeChange">深色</view>
      </view>
    </view>

    <view class="module-tabs">
      <view wx:for="{{tabs}}" wx:key="key" class="module-tab {{item.key === activeTab ? 'active' : ''}}" data-tab="{{item.key}}" bindtap="handleTabChange">{{item.label}}</view>
    </view>

    <view class="mine-hero">
      <view class="mine-hero-label">当前互助积分</view>
      <view class="mine-hero-value">{{points}} <text class="points-unit">分</text></view>
      <view class="mine-hero-tip">{{pointsTip}}</view>
    </view>

    <view class="mine-stats">
      <view class="mine-stat"><view class="mine-stat-label">我发布的任务</view><view class="mine-stat-value">{{publishedCount}}</view></view>
      <view class="mine-stat"><view class="mine-stat-label">我领取的任务</view><view class="mine-stat-value">{{submittedCount}}</view></view>
    </view>

    <view class="mine-actions">
      <button wx:if="{{rechargeVisible}}" class="small-action" bindtap="handleRecharge">{{rechargeEnabled ? '充值积分' : '充值暂未开放'}}</button>
      <button wx:if="{{withdrawalVisible}}" class="small-action" bindtap="handleWithdraw">{{withdrawalEnabled ? '提现积分' : '提现暂未开放'}}</button>
    </view>

    <view class="mine-section">
      <view class="section-heading">发布管理</view>
      <view class="mine-list mine-link-list">
        <view class="mine-link-row" bindtap="handleGoTaskManage">
          <view class="mine-task-main"><view class="mine-task-title">我发布的任务</view><view class="mine-task-sub">{{publishedCount}} 条任务 · 查看待验收和发布状态</view></view>
          <view class="mine-task-status">去管理 ›</view>
        </view>
      </view>
    </view>

    <view class="mine-section">
      <view class="section-heading">我领取的</view>
      <view class="mine-list" wx:if="{{submittedTasks.length}}">
        <view wx:for="{{submittedTasks}}" wx:key="id" class="mine-task-row" data-id="{{item.id}}" bindtap="handleOpenTask">
          <view class="mine-task-main"><view class="mine-task-title">{{item.title}}</view><view class="mine-task-sub">{{item.kindLabel}} · {{item.rewardText}}</view></view>
          <view class="mine-task-status">{{item.submissionStatus}}</view>
        </view>
      </view>
      <view class="mine-list" wx:else><view class="mine-empty">完成任务后会显示在这里</view></view>
    </view>

    <button class="secondary-action" bindtap="handleGoPublish">去发布一个任务</button>
  </view>
</view>
