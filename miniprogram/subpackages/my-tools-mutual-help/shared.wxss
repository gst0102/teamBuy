.mutual-page {
  min-height: 100vh;
  overflow-x: hidden;
  padding: 0 28rpx calc(52rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 90% 3%, rgba(255, 157, 82, 0.2), transparent 260rpx),
    linear-gradient(180deg, #fff8ef 0%, #f7f4ef 42%, #f8fafb 100%);
  color: #20262e;
  box-sizing: border-box;
}

.mutual-page .custom-nav {
  margin-left: -28rpx;
  margin-right: -28rpx;
}

.mutual-content {
  width: 100%;
}

.mutual-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
  padding: 22rpx 4rpx 20rpx;
}

.mutual-eyebrow {
  color: #e7672e;
  font-size: 21rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.mutual-title {
  margin-top: 0;
  color: #20262e;
  font-size: 45rpx;
  font-weight: 900;
  line-height: 1.1;
  letter-spacing: -1rpx;
}

.mutual-subtitle {
  max-width: 360rpx;
  margin-top: 10rpx;
  color: #7c8188;
  font-size: 22rpx;
  line-height: 1.45;
}

.module-tabs {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 82rpx;
  padding: 0 8rpx;
  border: 2rpx solid #e4ddd4;
  border-radius: 25rpx;
  background: rgba(255, 255, 255, 0.75);
  box-sizing: border-box;
}

.module-tab {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 100%;
  color: #8a8e94;
  font-size: 24rpx;
  font-weight: 800;
  white-space: nowrap;
}

.module-tab.active {
  color: #e9672d;
}

.module-tab.active::after {
  content: "";
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  width: 32rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: #ef6d31;
  transform: translateX(-50%);
}

.points-card {
  display: block;
  margin-top: 22rpx;
  padding: 25rpx 28rpx;
  border: 2rpx solid #f6d2ae;
  border-radius: 27rpx;
  background: linear-gradient(135deg, #fff0dc, #ffe0b4);
  box-sizing: border-box;
}

.points-card-main {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  min-width: 0;
}

.points-card-info {
  flex: 1;
  min-width: 0;
}

.points-card-actions {
  display: flex;
  flex: 0 0 154rpx;
  width: 154rpx;
  min-width: 154rpx;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
  padding-top: 2rpx;
  box-sizing: border-box;
}

.points-label {
  color: #a36c47;
  font-size: 23rpx;
}

.points-line {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin-top: 6rpx;
}

.points-value {
  color: #20262e;
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1;
}

.points-unit {
  color: #a36c47;
  font-size: 22rpx;
}

.points-tip {
  margin-top: 8rpx;
  color: #a36c47;
  font-size: 20rpx;
}

.rule-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 96rpx;
  width: 96rpx;
  min-width: 96rpx;
  max-width: 96rpx;
  height: 56rpx;
  margin: 0;
  padding: 0 14rpx;
  border: 1rpx solid rgba(231, 103, 46, 0.25);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.5);
  color: #d76531;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
  box-sizing: border-box;
}

.rule-button::after,
.primary-action::after,
.secondary-action::after,
.submit-button::after,
.small-action::after,
.add-image-button::after,
.add-task-link-button::after,
.task-link-action::after {
  border: 0;
}

.mutual-growth-banner {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  border: 2rpx solid #f3d5b8;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #fff0dc 0%, #ffe4c6 100%);
  box-shadow: 0 10rpx 24rpx rgba(173, 100, 51, 0.08);
  box-sizing: border-box;
}

.growth-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 66rpx;
  width: 66rpx;
  height: 66rpx;
  border-radius: 22rpx;
  background: #e87536;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
  box-shadow: 0 8rpx 16rpx rgba(216, 93, 43, 0.2);
}

.growth-copy {
  flex: 1;
  min-width: 0;
}

.growth-title {
  color: #a94f2d;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.3;
}

.growth-subtitle {
  margin-top: 6rpx;
  color: #8d6b55;
  font-size: 20rpx;
  line-height: 1.4;
}

.growth-arrow {
  flex: 0 0 auto;
  color: #c26a3b;
  font-size: 38rpx;
  line-height: 1;
}

.section-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 30rpx;
}

.section-row > view:first-child {
  flex: 1;
  min-width: 0;
}

.section-controls {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  flex: 0 0 auto;
  min-width: 0;
}

.section-heading {
  color: #20262e;
  font-size: 31rpx;
  font-weight: 900;
}

.section-helper {
  margin-top: 6rpx;
  color: #a09a94;
  font-size: 18rpx;
  line-height: 1.4;
}

.segmented-control {
  display: flex;
  flex: 0 0 auto;
  padding: 5rpx;
  border-radius: 999rpx;
  background: #eeeae5;
}

.segment-item {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 105rpx;
  height: 47rpx;
  border-radius: 999rpx;
  color: #8a8e94;
  font-size: 20rpx;
  font-weight: 800;
  white-space: nowrap;
}

.segment-item.active {
  background: #ffffff;
  color: #e7672e;
  box-shadow: 0 4rpx 12rpx rgba(53, 47, 40, 0.08);
}

.layout-switch {
  display: flex;
  align-items: center;
  padding: 5rpx;
  border-radius: 999rpx;
  background: #eeeae5;
}

.layout-option {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 47rpx;
  border-radius: 999rpx;
  color: #8a8e94;
  font-size: 20rpx;
  font-weight: 800;
  white-space: nowrap;
}

.layout-option.active {
  background: #ffffff;
  color: #e7672e;
  box-shadow: 0 4rpx 12rpx rgba(53, 47, 40, 0.08);
}

.filter-row {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  min-height: 50rpx;
  padding: 0 18rpx;
  border: 1rpx solid #ebe7e2;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.8);
  color: #777d84;
  font-size: 21rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.filter-chip.active {
  border-color: #f2bd8a;
  background: #fff0e2;
  color: #e7672e;
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 18rpx;
}

.task-list.columns-2 {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.task-card {
  position: relative;
  padding: 24rpx 24rpx 18rpx;
  border: 2rpx solid #e4ded7;
  border-radius: 25rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 10rpx 26rpx rgba(50, 48, 44, 0.06);
  box-sizing: border-box;
}

.task-card:active,
.tools-entry:active,
.task-detail-card:active,
.mine-task-row:active {
  opacity: 0.78;
}

.task-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.task-kind {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 38rpx;
  padding: 0 12rpx;
  border-radius: 10rpx;
  background: #fff0e4;
  color: #e7672e;
  font-size: 19rpx;
  font-weight: 900;
  white-space: nowrap;
  box-sizing: border-box;
}

.task-kind.ordinary {
  background: #e8f6ef;
  color: #258153;
}

.task-kind.wool {
  background: #f2e8ff;
  color: #8a4bb1;
}

.task-reward {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 74rpx;
  height: 42rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: #fff4e9;
  color: #e7672e;
  font-size: 21rpx;
  font-weight: 900;
  white-space: nowrap;
  box-sizing: border-box;
}

.task-title {
  margin-top: 16rpx;
  color: #20262e;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.35;
}

.task-description {
  display: -webkit-box;
  margin-top: 8rpx;
  overflow: hidden;
  color: #7c8188;
  font-size: 22rpx;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.task-entry-summary {
  margin-top: 10rpx;
  overflow: hidden;
  color: #6c85a0;
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-publisher {
  margin-top: 14rpx;
  color: #e7672e;
  font-size: 22rpx;
  font-weight: 900;
}

.task-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 2rpx solid #e5dfd8;
  color: #8a8e94;
  font-size: 21rpx;
}

.task-go {
  color: #e7672e;
  font-size: 23rpx;
  font-weight: 900;
  white-space: nowrap;
}

.task-list.columns-2 .task-card {
  display: flex;
  flex-direction: column;
  min-width: 0;
  min-height: 356rpx;
  padding: 20rpx 16rpx 16rpx;
}

.task-list.columns-2 .task-card-top {
  gap: 6rpx;
}

.task-list.columns-2 .task-kind {
  padding: 0 9rpx;
  font-size: 18rpx;
}

.task-list.columns-2 .task-reward {
  min-width: 64rpx;
  padding: 0 8rpx;
  font-size: 19rpx;
}

.task-list.columns-2 .task-title {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.3;
}

.task-list.columns-2 .task-description {
  font-size: 20rpx;
  line-height: 1.45;
  -webkit-line-clamp: 3;
}

.task-list.columns-2 .task-publisher {
  margin-top: 12rpx;
  font-size: 20rpx;
}

.task-list.columns-2 .task-entry-summary {
  font-size: 18rpx;
}

.task-list.columns-2 .task-foot {
  align-items: flex-start;
  flex-direction: column;
  gap: 8rpx;
  margin-top: auto;
  font-size: 19rpx;
}

.task-list.columns-2 .task-go {
  align-self: flex-end;
  font-size: 21rpx;
}

.empty-state {
  display: flex;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  margin-top: 28rpx;
  padding: 66rpx 24rpx;
  border: 2rpx dashed #ddd5cc;
  border-radius: 25rpx;
  background: rgba(255, 255, 255, 0.5);
  text-align: center;
}

.empty-title {
  color: #555c64;
  font-size: 27rpx;
  font-weight: 900;
}

.empty-copy {
  margin-top: 10rpx;
  color: #92979c;
  font-size: 21rpx;
}

.primary-action,
.secondary-action,
.submit-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 82rpx;
  margin: 24rpx 0 0;
  padding: 0;
  border: 0;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #ff9149, #ed642c);
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1;
  box-shadow: 0 12rpx 25rpx rgba(237, 100, 44, 0.18);
  box-sizing: border-box;
}

.secondary-action {
  background: #ffffff;
  color: #e7672e;
  border: 1rpx solid #f1c49e;
  box-shadow: none;
}

.primary-action[disabled],
.submit-button[disabled] {
  background: #d8d3cd;
  color: #ffffff;
  box-shadow: none;
}

.task-detail-header {
  padding: 24rpx 4rpx 12rpx;
}

.back-line {
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: #e7672e;
  font-size: 22rpx;
  font-weight: 800;
}

.task-detail-title {
  margin-top: 16rpx;
  color: #20262e;
  font-size: 39rpx;
  font-weight: 900;
  line-height: 1.22;
}

.task-detail-meta {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 13rpx;
  color: #7c8188;
  font-size: 21rpx;
}

.task-detail-reward-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-top: 16rpx;
}

.task-detail-reward {
  color: #d85d2b;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1;
}

.task-detail-reward-copy {
  color: #a36c47;
  font-size: 21rpx;
}

.wool-detail-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
  color: #8a4bb1;
  font-size: 20rpx;
  font-weight: 800;
}

.wool-detail-meta text {
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  background: #f3eaff;
}

.task-detail-share-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
}

.task-detail-share-hint {
  flex: 1;
  min-width: 0;
  color: #8a8e94;
  font-size: 20rpx;
  line-height: 1.35;
}

.share-task-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 176rpx;
  width: 176rpx;
  height: 56rpx;
  min-height: 56rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid #f0c49e;
  border-radius: 999rpx;
  background: #fffaf5;
  color: #e7672e;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 1;
  white-space: nowrap;
  box-sizing: border-box;
}

.share-task-button::after {
  border: 0;
}

.share-task-button[disabled] {
  border-color: #e1ddd8;
  background: #f1efec;
  color: #aaa6a0;
  box-shadow: none;
}

.task-detail-card {
  margin-top: 18rpx;
  padding: 24rpx;
  border: 2rpx solid #e4ded7;
  border-radius: 25rpx;
  background: rgba(255, 255, 255, 0.95);
  box-sizing: border-box;
}

.detail-section + .detail-section {
  margin-top: 25rpx;
  padding-top: 22rpx;
  border-top: 2rpx solid #e5dfd8;
}

.detail-label {
  color: #20262e;
  font-size: 25rpx;
  font-weight: 900;
}

.detail-helper {
  margin-top: 7rpx;
  color: #91959a;
  font-size: 20rpx;
  line-height: 1.4;
}

.detail-helper-inline {
  color: #9a9ea3;
  font-size: 20rpx;
  font-weight: 500;
}

.content-blocks {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 14rpx;
}

.content-text {
  color: #525960;
  font-size: 24rpx;
  line-height: 1.6;
  white-space: pre-wrap;
}

.status-note-points {
  display: block;
  margin-top: 8rpx;
  color: #e7672e;
  font-size: 21rpx;
  font-weight: 900;
}

.content-image-wrap {
  width: 100%;
}

.content-image {
  display: block;
  width: 100%;
  border-radius: 16rpx;
  background: #f2f0ed;
}

.task-unlock-card {
  padding: 22rpx;
  border: 2rpx solid #d8c3ef;
  border-radius: 19rpx;
  background: linear-gradient(135deg, #f8f1ff, #f0e5ff);
}

.task-unlock-title {
  color: #673a8d;
  font-size: 27rpx;
  font-weight: 900;
}

.task-unlock-copy {
  margin-top: 9rpx;
  color: #816a93;
  font-size: 21rpx;
  line-height: 1.5;
}

.wool-unlock-button,
.wool-tip-button,
.wool-refund-button,
.comment-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 62rpx;
  margin: 16rpx 0 0;
  padding: 0 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 1;
  box-sizing: border-box;
}

.wool-unlock-button,
.wool-tip-button,
.comment-submit {
  border: 1rpx solid #b785d2;
  background: #8a4bb1;
  color: #ffffff;
}

.wool-refund-button {
  border: 1rpx solid #e0c7b2;
  background: #fffaf5;
  color: #b46843;
}

.task-comment-section {
  border-top: 2rpx solid #e5dfd8;
}

.task-comment-summary {
  margin-top: 10rpx;
  color: #8a4bb1;
  font-size: 20rpx;
  font-weight: 800;
}

.task-comment-list,
.manage-comment-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 14rpx;
}

.task-comment-item,
.manage-comment-item {
  padding: 16rpx;
  border: 2rpx solid #e5dfd8;
  border-radius: 16rpx;
  background: #fffaf6;
}

.task-comment-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  color: #9a9ea3;
  font-size: 17rpx;
}

.task-comment-author {
  color: #4b535b;
  font-size: 20rpx;
  font-weight: 900;
}

.task-comment-verified {
  margin-left: 8rpx;
  color: #258153;
  font-size: 17rpx;
}

.task-comment-date {
  flex: 0 0 auto;
}

.task-comment-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 38rpx;
  margin-top: 9rpx;
  padding: 0 11rpx;
  border-radius: 999rpx;
  background: #f2e8ff;
  color: #8a4bb1;
  font-size: 18rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.task-comment-badge.worth_it {
  background: #e8f6ef;
  color: #258153;
}

.task-comment-badge.not_worth_it {
  background: #fff0e4;
  color: #c35e32;
}

.task-comment-text {
  margin-top: 9rpx;
  color: #525960;
  font-size: 21rpx;
  line-height: 1.55;
  white-space: pre-wrap;
}

.task-comment-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 8rpx;
}

.task-comment-report {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 42rpx;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: #a47762;
  font-size: 17rpx;
  line-height: 1;
}

.task-comment-report::after {
  border: 0;
}

.task-comment-empty {
  margin-top: 13rpx;
  padding: 19rpx;
  border-radius: 15rpx;
  background: #f8f4f0;
  color: #92979c;
  font-size: 20rpx;
  line-height: 1.45;
  text-align: center;
}

.comment-editor {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #e5dfd8;
}

.comment-choice-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.comment-choice {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 50rpx;
  border: 1rpx solid #e4ddd4;
  border-radius: 999rpx;
  background: #ffffff;
  color: #777d84;
  font-size: 19rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.comment-choice.active {
  border-color: #b785d2;
  background: #f2e8ff;
  color: #8a4bb1;
}

.comment-input {
  width: 100%;
  min-height: 120rpx;
  margin-top: 12rpx;
