.manage-task-brand-row {
  margin-top: 13rpx;
  color: #7f8b95;
  font-size: 19rpx;
}

.manage-task-brand-row > text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.manage-task-brand-row .manage-task-status {
  flex: 0 0 auto;
}

.manage-task-status,
.manage-detail-status {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 82rpx;
  height: 38rpx;
  padding: 0 12rpx;
  border: 2rpx solid #b9e2c9;
  border-radius: 999rpx;
  background: #effaf3;
  color: #2d8a50;
  font-size: 19rpx;
  font-weight: 900;
  line-height: 1;
  white-space: nowrap;
  box-sizing: border-box;
}

.manage-task-status.closed,
.manage-detail-status.closed {
  border-color: #e5d1c8;
  background: #faf3ef;
  color: #9d6b57;
}

.manage-task-title {
  margin-top: 12rpx;
  color: #20262e;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.35;
}

.manage-task-cover {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 520rpx;
  margin-top: 16rpx;
  overflow: hidden;
  border: 2rpx solid #e0e6eb;
  border-radius: 18rpx;
  background: #ffffff;
}

.manage-task-cover image {
  display: block;
  width: 100%;
  height: 100%;
}

.manage-task-cover-hint {
  position: absolute;
  right: 14rpx;
  bottom: 12rpx;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(32, 38, 46, 0.7);
  color: #ffffff;
  font-size: 17rpx;
  line-height: 1.2;
}

.manage-task-icon-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 86rpx;
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  border: 2rpx solid #dfe8f0;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #f8fbfe, #edf5fb);
  color: #758696;
  font-size: 20rpx;
  line-height: 1.35;
  box-sizing: border-box;
}

.manage-task-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 64rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 17rpx;
  background: linear-gradient(135deg, #3bc45d, #1aa344);
  color: #ffffff;
  font-size: 17rpx;
  font-weight: 900;
}

.manage-task-description {
  display: -webkit-box;
  margin-top: 7rpx;
  overflow: hidden;
  color: #697580;
  font-size: 21rpx;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.manage-task-entry-summary {
  margin-top: 8rpx;
  overflow: hidden;
  color: #5f82a0;
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.manage-task-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 7rpx;
  color: #7c8188;
  font-size: 20rpx;
}

.manage-task-progress {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0;
  margin-top: 17rpx;
  padding: 14rpx 0 13rpx;
  border-top: 2rpx solid #e6edf3;
  border-bottom: 2rpx solid #e6edf3;
}

.manage-task-progress > view {
  min-width: 0;
  padding: 0 12rpx;
  border-left: 2rpx solid #e6edf3;
}

.manage-task-progress > view:first-child {
  padding-left: 0;
  border-left: 0;
}

.manage-task-progress text,
.manage-task-progress strong {
  display: block;
}

.manage-task-progress text {
  color: #929ba4;
  font-size: 19rpx;
}

.manage-task-progress strong {
  margin-top: 4rpx;
  color: #2d6f9d;
  font-size: 27rpx;
  font-weight: 900;
}

.manage-task-progress strong.pending {
  color: #e7672e;
}

.manage-task-foot {
  margin-top: 13rpx;
  color: #929ba4;
  font-size: 20rpx;
}

.manage-task-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 12rpx;
  margin: 10rpx 8rpx 0;
}

.manage-share-button,
.manage-delete-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 58rpx;
  margin: 0;
  padding: 0 10rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
  white-space: nowrap;
  box-sizing: border-box;
}

.manage-share-button {
  border: 1rpx solid #06ad56;
  background: #07c160;
  color: #ffffff;
}

.manage-share-button::after {
  border: 0;
}

.manage-delete-button {
  border: 1rpx solid #e2d4cb;
  background: #fffaf7;
  color: #a47762;
}

.manage-share-button[disabled] {
  border-color: #d9dee3;
  background: #edf0f2;
  color: #9ca5ad;
}

.manage-detail-share {
  margin-top: 20rpx;
}

.task-detail-share-button {
  margin: 18rpx 4rpx 0;
}

.task-detail-share-status {
  margin-left: 4rpx;
  margin-right: 4rpx;
}

.manage-share-status {
  margin-top: 20rpx;
  color: #8b98a3;
  font-size: 20rpx;
  text-align: center;
}

.manage-empty-action {
  width: 250rpx;
  height: 66rpx;
  margin-top: 22rpx;
  font-size: 23rpx;
}

.manage-detail-header {
  padding: 24rpx 4rpx 12rpx;
}

.manage-detail-status {
  align-self: flex-start;
  margin-top: 18rpx;
}

.manage-progress-card {
  margin-top: 18rpx;
  padding: 20rpx;
  border: 2rpx solid #d5e4ef;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #f4f9fd, #eaf3f9);
  box-sizing: border-box;
}

.manage-progress-heading > text {
  color: #6d8598;
  font-size: 20rpx;
  white-space: nowrap;
}

.manage-metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-top: 16rpx;
  padding-top: 15rpx;
  border-top: 2rpx solid #d6e4ef;
}

.manage-metric {
  min-width: 0;
  padding: 0 14rpx;
  border-left: 2rpx solid #d6e4ef;
}

.manage-metric:first-child {
  padding-left: 0;
  border-left: 0;
}

.manage-metric text,
.manage-metric strong,
.manage-metric small {
  display: block;
}

.manage-metric text {
  color: #748899;
  font-size: 19rpx;
}

.manage-metric strong {
  margin-top: 4rpx;
  color: #2c6f9d;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1;
}

.manage-metric.pending strong {
  color: #e7672e;
}

.manage-metric small {
  margin-top: 5rpx;
  overflow: hidden;
  color: #91a0ac;
  font-size: 17rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.manage-section {
  margin-top: 24rpx;
  padding-top: 21rpx;
  border-top: 2rpx solid #e2e9ef;
}

.manage-section-count {
  flex: 0 0 auto;
  color: #e7672e;
  font-size: 21rpx;
  font-weight: 900;
}

.manage-review-empty,
.manage-review-placeholder {
  margin-top: 14rpx;
  padding: 25rpx 20rpx;
  border: 2rpx dashed #d8e3ec;
  border-radius: 17rpx;
  background: rgba(247, 250, 252, 0.9);
  color: #8d99a3;
  font-size: 21rpx;
  text-align: center;
}

.manage-review-placeholder {
  color: #70899c;
  text-align: left;
}

.manage-review-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 14rpx;
}

.manage-review-item {
  padding: 18rpx;
  border: 2rpx solid #d8e3ec;
  border-radius: 18rpx;
  background: #f8fbfd;
}

.manage-review-item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  color: #657583;
  font-size: 19rpx;
}

.manage-review-item-head > text:first-child {
  color: #20262e;
  font-weight: 900;
}

.manage-review-text {
  margin-top: 14rpx;
  color: #525960;
  font-size: 22rpx;
  line-height: 1.55;
  white-space: pre-wrap;
}

.manage-review-images {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 14rpx;
}

.manage-review-image-wrap {
  width: 100%;
}

.manage-review-image {
  display: block;
  width: 100%;
  border-radius: 14rpx;
  background: #eef3f7;
}

.manage-review-deadline {
  margin-top: 14rpx;
  color: #8997a2;
  font-size: 18rpx;
}

.manage-approve-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 58rpx;
  margin: 14rpx 0 0;
  padding: 0 14rpx;
  border: 1rpx solid #aad7c0;
  border-radius: 999rpx;
  background: #ecfbf3;
  color: #167a55;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
  box-sizing: border-box;
}

.manage-rules-card {
  margin-top: 24rpx;
}

.manage-miniapp-card {
  margin-top: 12rpx;
}

.manage-action {
  margin-top: 20rpx;
}

.manage-pause-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 70rpx;
  margin: 12rpx 0 0;
  padding: 0;
  border: 2rpx solid #d9c2b6;
  border-radius: 17rpx;
  background: #fffaf7;
  color: #9b6a55;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
  box-sizing: border-box;
}

.manage-pause-button::after {
  border: 0;
}

.mine-task-row:last-child {
  border-bottom: 0;
}

.mine-task-main {
  flex: 1;
  min-width: 0;
}

.mine-task-title {
  overflow: hidden;
  color: #30363d;
  font-size: 23rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mine-task-sub {
  margin-top: 5rpx;
  color: #999da2;
  font-size: 19rpx;
}

.mine-task-status {
  flex: 0 0 auto;
  color: #e7672e;
  font-size: 20rpx;
  font-weight: 800;
  white-space: nowrap;
}

.mine-empty {
  padding: 34rpx 20rpx;
  color: #999da2;
  font-size: 21rpx;
  text-align: center;
}

.safe-note {
  margin-top: 22rpx;
  color: #999da2;
  font-size: 19rpx;
  line-height: 1.5;
  text-align: center;
}

/* A compact theme control stays above the module tabs on every mutual-help page. */
.theme-switch-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
  margin: 8rpx 4rpx 0;
}

.theme-switch-label {
  color: #7b8188;
  font-size: 19rpx;
  font-weight: 800;
}

.theme-switch {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx;
  border: 1rpx solid #e2e7ed;
  border-radius: 999rpx;
  background: #edf1f5;
}

.theme-option {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 64rpx;
  height: 42rpx;
  border-radius: 999rpx;
  color: #7d8792;
  font-size: 19rpx;
  font-weight: 800;
  white-space: nowrap;
}

.theme-option.active {
  background: #ffffff;
  color: #e7672e;
  box-shadow: 0 3rpx 9rpx rgba(49, 58, 68, 0.1);
}

@media screen and (max-width: 680rpx) {
  .section-row {
    align-items: flex-start;
  }

  .section-controls {
    flex-direction: column;
    align-items: flex-end;
  }
}

