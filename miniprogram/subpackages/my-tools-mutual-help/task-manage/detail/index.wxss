@import "../../shared.wxss";

.manage-chat-section { margin-top: 22rpx; padding: 22rpx; border: 2rpx solid #eee3d8; border-radius: 23rpx; background: rgba(255,255,255,.9); box-sizing: border-box; }
.manage-chat-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.manage-chat-heading > text { color: #d8753d; font-size: 22rpx; font-weight: 900; }
.manage-chat-helper { margin-top: 6rpx; color: #90959b; font-size: 19rpx; }
.manage-chat-empty { margin-top: 18rpx; padding: 18rpx 14rpx; border-radius: 15rpx; background: #faf8f5; color: #92979c; font-size: 21rpx; text-align: center; }
.manage-chat-list { margin-top: 8rpx; }
.manage-chat-row { display: flex; align-items: center; gap: 13rpx; padding: 15rpx 0; border-top: 1rpx solid #f0ece7; }
.manage-chat-avatar { flex: 0 0 62rpx; width: 62rpx; height: 62rpx; border-radius: 50%; background: #e8f0f5; }
.manage-chat-avatar-fallback { display: flex; align-items: center; justify-content: center; color: #507181; font-size: 22rpx; }
.manage-chat-person { flex: 1; min-width: 0; }
.manage-chat-name { overflow: hidden; color: #30363c; font-size: 24rpx; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }
.manage-chat-last { margin-top: 5rpx; overflow: hidden; color: #858c93; font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }
.manage-chat-unread { display: flex; min-width: 30rpx; height: 30rpx; align-items: center; justify-content: center; padding: 0 6rpx; border-radius: 999rpx; background: #e96736; color: #fff; font-size: 18rpx; }
.manage-chat-button { display: flex; align-items: center; justify-content: center; width: 92rpx; height: 54rpx; margin: 0; padding: 0; border: 1rpx solid #edc7a7; border-radius: 999rpx; background: #fff5e9; color: #c76d39; font-size: 20rpx; font-weight: 800; line-height: 1; }
.manage-chat-button::after { border: 0; }
.theme-dark .manage-chat-section { border-color: #484047; background: #28242a; }
.theme-dark .manage-chat-name { color: #f3ece4; }
