<view class="mutual-page theme-{{theme}} task-manage-page">
  <custom-nav title="任务管理" showBack="{{true}}" fallbackUrl="/subpackages/my-tools-mutual-help/mine/index" theme="{{theme}}" />

  <view class="mutual-content">
    <view class="theme-switch-row">
      <text class="theme-switch-label">主题</text>
      <view class="theme-switch">
        <view class="theme-option {{theme === 'light' ? 'active' : ''}}" data-theme="light" bindtap="handleThemeChange">浅色</view>
        <view class="theme-option {{theme === 'dark' ? 'active' : ''}}" data-theme="dark" bindtap="handleThemeChange">深色</view>
      </view>
    </view>

    <view class="module-tabs">
      <view wx:for="{{tabs}}" wx:key="key" class="module-tab {{item.key === activeTab ? 'active' : ''}}" data-tab="{{item.key}}" bindtap="handleTabChange">{{item.label}}</view>
    </view>

    <view class="manage-intro">
      <view>
        <view class="manage-eyebrow">发布者工作台</view>
        <view class="manage-title">我发布的任务</view>
      </view>
      <button class="manage-add-button" bindtap="handleGoPublish">发布任务</button>
    </view>

    <view class="manage-summary">
      <view><view class="manage-summary-label">当前可用积分</view><view class="manage-summary-value">{{points}} <text>分</text></view><view class="manage-summary-sub" wx:if="{{rewardPointsVisible}}">基础 {{basePoints}} · 充值 {{rewardPoints}}</view><view class="manage-summary-sub" wx:else>用于发布任务和处理验收</view></view>
      <view class="manage-summary-side"><view>已发布</view><strong>{{publishedCount}} 条</strong></view>
    </view>

    <view class="filter-row manage-filter-row">
      <view class="filter-chip {{taskStateFilter === 'all' ? 'active' : ''}}" data-filter="all" catchtap="handleStateFilterChange">全部</view>
      <view class="filter-chip {{taskStateFilter === 'active' ? 'active' : ''}}" data-filter="active" catchtap="handleStateFilterChange">进行中</view>
      <view class="filter-chip {{taskStateFilter === 'paused' ? 'active' : ''}}" data-filter="paused" catchtap="handleStateFilterChange">已暂停</view>
      <view class="filter-chip {{taskStateFilter === 'closed' ? 'active' : ''}}" data-filter="closed" catchtap="handleStateFilterChange">已结束</view>
    </view>

    <view wx:if="{{syncError}}" class="empty-state retry-state" bindtap="refresh">
      <view class="empty-title">我的发布暂时无法读取</view>
      <view class="empty-copy">当前不展示旧缓存，点击这里重试获取服务端最新数据。</view>
      <button class="secondary-action manage-empty-action">重新加载</button>
    </view>

    <view class="manage-task-list" wx:elif="{{tasks.length}}">
      <block wx:for="{{tasks}}" wx:key="id">
        <view class="manage-task-card" data-id="{{item.id}}" bindtap="handleOpenTask">
          <view class="manage-task-top">
            <view class="task-kind {{item.taskKind === 'ordinary' ? 'ordinary' : (item.taskKind === 'wool' ? 'wool' : '')}}">{{item.categoryLabel}}</view>
            <view class="manage-task-reward">{{item.taskKind === 'wool' ? item.woolCardRewardText : item.rewardText}}</view>
          </view>
          <view class="manage-task-brand-row">
            <view class="manage-task-status {{item.taskClosed ? 'closed' : ''}}">{{item.statusLabel}}</view>
          </view>
          <view class="manage-task-title">{{item.title}}</view>
          <view class="manage-task-description">{{item.description}}</view>
          <view class="manage-task-meta">
            <block wx:if="{{item.taskKind === 'wool'}}"><text>{{item.woolAccessLabel}}</text><text wx:if="{{item.woolAllowTip}}">可自愿打赏</text></block>
            <block wx:else><text>{{item.rewardPointTypeLabel}} · 发布者 -{{item.rewardPoints}} 分/次</text><text>执行者 +{{item.executorReward}} {{item.rewardPointTypeLabel}}</text></block>
          </view>
          <view class="manage-task-progress">
            <view><text>剩余</text><strong>{{item.remaining === null ? '不限' : item.remaining}}</strong></view>
            <view><text>{{item.taskKind === 'wool' ? '已解锁' : '已完成'}}</text><strong>{{item.taskKind === 'wool' ? item.woolUnlockCount : item.completedCount}}</strong></view>
            <view wx:if="{{item.taskKind !== 'wool'}}"><text>待验收</text><strong class="pending">{{item.pendingCount}}</strong></view>
            <view wx:else><text>评论</text><strong>{{item.commentSummary.count}}</strong></view>
          </view>
          <view class="manage-task-foot"><text>{{item.deadlineText}}</text><text>{{item.taskClosed ? '任务已关闭' : '持续接收提交'}}</text></view>
        </view>
        <view class="manage-task-actions">
          <button class="manage-primary-button" data-id="{{item.id}}" catchtap="handleOpenTask">{{item.pendingCount > 0 ? '去验收' : '查看管理'}}</button>
          <button class="manage-share-button" open-type="share" data-id="{{item.id}}" catchtap="handleSelectShareTask" disabled="{{!item.shareReady}}">{{item.shareReady ? '分享任务' : item.shareStatusText}}</button>
          <view class="manage-delete-link" data-id="{{item.id}}" catchtap="handleDeleteTask">删除任务</view>
        </view>
      </block>
    </view>

    <view class="empty-state" wx:else>
      <view class="empty-title">{{publishedCount ? '这个筛选下暂无任务' : '还没有发布任务'}}</view>
      <view class="empty-copy">发布一个任务后，可以在这里查看进度和验收状态。</view>
      <button class="secondary-action manage-empty-action" bindtap="handleGoPublish">去发布任务</button>
    </view>
  </view>
  <canvas canvas-id="shareCardCanvas" class="share-card-canvas"></canvas>
</view>
