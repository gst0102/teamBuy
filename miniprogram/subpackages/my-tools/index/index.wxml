<view class="tools-page">
  <custom-nav title="微信群工具" showBack="{{true}}" fallbackUrl="/pages/profile/index" />

  <view class="tools-content">
    <view class="tools-kicker">微信群工具</view>
    <view class="tools-title">群资源与活码</view>
    <view class="tools-subtitle">找群、发布群资源，也能免费管理自己的群二维码。</view>

    <view class="tools-list">
      <view wx:for="{{tools}}" wx:key="key" class="tool-card {{item.key}} {{item.available ? '' : 'disabled'}}" data-index="{{index}}" bindtap="handleOpenTool">
        <view class="tool-icon {{item.key}}">{{item.icon}}</view>
        <view class="tool-copy">
          <view class="tool-title">{{item.title}}</view>
          <view class="tool-description">{{item.description}}</view>
        </view>
        <view class="tool-side">
          <view wx:if="{{item.tag}}" class="tool-tag">{{item.tag}}</view>
          <view class="tool-arrow">›</view>
        </view>
      </view>
    </view>

  </view>
</view>
