.card-editor-page { min-height:100vh; padding:0 24rpx 150rpx; background:#f4f7fb; color:#172033; box-sizing:border-box; }
.editor-loading { padding:160rpx 0; color:#7d899b; font-size:25rpx; text-align:center; }
.preview-section,.editor-section { margin-top:22rpx; padding:26rpx; border:1rpx solid #e3e9f1; border-radius:24rpx; background:#fff; box-shadow:0 10rpx 30rpx rgba(30,64,110,.05); box-sizing:border-box; }
.section-heading { display:flex; align-items:flex-start; justify-content:space-between; gap:20rpx; margin-bottom:24rpx; }
.section-heading.compact { align-items:center; }
.section-title { color:#172033; font-size:29rpx; font-weight:900; line-height:1.3; }
.section-hint { margin-top:7rpx; color:#8b96a7; font-size:20rpx; line-height:1.45; }
.text-link,.count-label { flex:0 0 auto; color:#1677ff; font-size:22rpx; font-weight:800; white-space:nowrap; }
.live-card { display:flex; align-items:flex-start; gap:22rpx; min-height:248rpx; padding:28rpx 24rpx; border:2rpx solid #dfe7f2; border-radius:24rpx; background:linear-gradient(145deg,#f0f5fb,#fbfcfe); box-sizing:border-box; }
.live-avatar { flex:0 0 auto; width:112rpx; height:112rpx; margin-top:2rpx; border:5rpx solid rgba(255,255,255,.96); border-radius:999rpx; background:#dce8f8; box-shadow:0 8rpx 24rpx rgba(27,75,140,.12); }
.placeholder { display:flex; align-items:center; justify-content:center; color:#8190a5; font-weight:800; }
.live-copy { flex:1; min-width:0; padding-top:2rpx; }
.live-name { overflow:hidden; color:#101828; font-size:34rpx; font-weight:900; text-overflow:ellipsis; white-space:nowrap; }
.live-role { margin-top:7rpx; overflow:hidden; color:#667085; font-size:22rpx; text-overflow:ellipsis; white-space:nowrap; }
.live-divider { height:1rpx; margin:18rpx 0 14rpx; background:#e5eaf1; }
.live-detail { display:flex; align-items:center; min-width:0; gap:10rpx; margin-top:11rpx; color:#273349; font-size:21rpx; line-height:1.4; }
.live-detail text:last-child { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.live-detail-marker { flex:0 0 auto; width:10rpx; height:10rpx; border-radius:999rpx; background:#1677ff; }
.live-contact { color:#52657d; }
.live-keywords,.keyword-preview { display:flex; flex-wrap:wrap; gap:9rpx; margin-top:14rpx; }
.live-keywords text,.keyword-preview text { display:flex; align-items:center; justify-content:center; min-height:38rpx; padding:0 13rpx; border-radius:999rpx; background:rgba(22,119,255,.09); color:#166fe3; font-size:18rpx; box-sizing:border-box; }
.identity-avatar-row,.qr-row { display:grid; grid-template-columns:148rpx minmax(0,1fr) 64rpx; align-items:center; gap:12rpx; padding-bottom:24rpx; }
.identity-avatar { flex:0 0 auto; width:148rpx; height:148rpx; border-radius:999rpx; background:#edf2f7; }
.identity-avatar-copy,.qr-copy { flex:1; min-width:0; }
.identity-avatar-copy view,.qr-copy view { color:#273349; font-size:23rpx; font-weight:900; }
.identity-avatar-copy text,.qr-copy text { display:block; margin-top:6rpx; color:#8a96a7; font-size:19rpx; line-height:1.4; }
button { margin:0; padding:0; line-height:1; box-sizing:border-box; }
button::after { border:0; }
.small-outline { display:flex; flex:0 0 64rpx; align-items:center; justify-content:center; width:64rpx; max-width:64rpx; height:46rpx; margin:0; padding:0; border:1rpx solid #cdd9e9; border-radius:11rpx; background:#fff; color:#1677ff; font-size:18rpx; font-weight:800; }
.form-grid.two-col,.contact-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:20rpx 18rpx; }
.form-field { min-width:0; }
.form-field.full { margin-top:22rpx; }
.form-field.full:first-of-type { margin-top:0; }
.field-label { margin-bottom:10rpx; color:#344054; font-size:22rpx; font-weight:800; }
.field-label text { margin-left:8rpx; color:#98a2b3; font-size:18rpx; font-weight:500; }
.form-field input,.form-field textarea { width:100%; padding:0 18rpx; border:1rpx solid #dfe6ef; border-radius:14rpx; background:#f8faff; color:#172033; font-size:23rpx; box-sizing:border-box; }
.form-field input { height:70rpx; }
.form-field textarea { height:170rpx; padding-top:18rpx; line-height:1.55; }
.keyword-preview { margin-top:13rpx; }
.qr-row { grid-template-columns:184rpx minmax(0,1fr) 64rpx; margin-top:24rpx; padding:20rpx; border-radius:18rpx; background:#f8faff; }
.qr-image { flex:0 0 auto; width:184rpx; height:184rpx; border-radius:14rpx; background:#edf2f7; }
.qr-action { width:64rpx; max-width:64rpx; height:44rpx; font-size:17rpx; }
.more-toggle { display:flex; align-items:center; justify-content:space-between; margin-top:8rpx; padding:22rpx 0 0; border-top:1rpx solid #edf1f5; color:#1677ff; font-size:21rpx; font-weight:800; }
.more-toggle > view > view { color:#344054; font-size:23rpx; }
.more-toggle > view > text { display:block; margin-top:5rpx; color:#98a2b3; font-size:18rpx; font-weight:500; }
.more-contact { margin-top:20rpx; }
.featured-list { display:flex; flex-direction:column; gap:12rpx; }
.featured-item { display:grid; grid-template-columns:74rpx minmax(0,1fr) auto; align-items:center; gap:14rpx; min-height:88rpx; padding:12rpx; border:1rpx solid #e4eaf2; border-radius:16rpx; background:#fbfcfe; box-sizing:border-box; }
.featured-item image,.featured-icon { width:74rpx; height:64rpx; border-radius:11rpx; background:#eaf3ff; }
.featured-icon { display:flex; align-items:center; justify-content:center; color:#1677ff; font-size:24rpx; font-weight:900; }
.featured-copy { min-width:0; }
.featured-copy view { overflow:hidden; color:#273349; font-size:22rpx; font-weight:800; text-overflow:ellipsis; white-space:nowrap; }
.featured-copy text { display:block; margin-top:6rpx; overflow:hidden; color:#8a96a7; font-size:18rpx; text-overflow:ellipsis; white-space:nowrap; }
.featured-remove { padding:16rpx 4rpx; color:#e05252; font-size:19rpx; }
.add-resource { display:flex; align-items:center; justify-content:center; width:100%; height:68rpx; margin-top:16rpx; border:1rpx dashed #9fc1f2; border-radius:15rpx; background:#f7fbff; color:#1677ff; font-size:22rpx; font-weight:800; }
.style-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:14rpx; }
.style-option { position:relative; display:grid; grid-template-columns:76rpx minmax(0,1fr); align-items:center; gap:13rpx; min-height:92rpx; padding:12rpx; border:2rpx solid #e3e8ef; border-radius:17rpx; box-sizing:border-box; }
.style-standard { grid-template-columns:76rpx minmax(0,1fr) auto; width:100%; min-height:104rpx; border-color:#1677ff; background:#f5f9ff; }
.style-option.active { border-color:#1677ff; background:#f5f9ff; }
.style-option > view:nth-child(2) > view { color:#2f3b4f; font-size:21rpx; font-weight:900; }
.style-option > view:nth-child(2) > text { display:block; margin-top:5rpx; color:#929dac; font-size:17rpx; }
.style-mini { display:flex; flex-direction:column; justify-content:center; width:76rpx; height:66rpx; padding-left:28rpx; border-radius:10rpx; background:#dcebff; box-sizing:border-box; }
.style-mini view { position:absolute; width:22rpx; height:22rpx; margin-left:-24rpx; border-radius:999rpx; background:#fff; }
.style-mini text { width:38rpx; height:5rpx; margin:3rpx 0; border-radius:9rpx; background:rgba(32,74,130,.35); }
.tone-white .style-mini { border:1rpx solid #dfe5ec; background:#fff; }
.tone-gold .style-mini { background:#eee5d7; }
.tone-green .style-mini { background:#dff3e8; }
.style-check { position:absolute; top:8rpx; right:10rpx; color:#1677ff; font-size:20rpx; font-weight:900; }
.bottom-space { height:100rpx; }
.bottom-bar { position:fixed; z-index:30; left:0; right:0; bottom:0; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16rpx; padding:18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom)); border-top:1rpx solid #e4e9f0; background:rgba(255,255,255,.97); box-sizing:border-box; }
.preview-button,.save-button { display:flex; align-items:center; justify-content:center; width:100%; height:78rpx; border-radius:16rpx; font-size:25rpx; font-weight:900; }
.preview-button { background:#eef3f9; color:#334155; }
.save-button { background:#1677ff; color:#fff; }
.picker-mask { position:fixed; z-index:100; inset:0; display:flex; align-items:flex-end; background:rgba(15,23,42,.5); }
.picker-sheet { width:100%; max-height:78vh; padding:28rpx 24rpx calc(24rpx + env(safe-area-inset-bottom)); border-radius:28rpx 28rpx 0 0; background:#fff; box-sizing:border-box; }
.picker-head { display:flex; align-items:flex-start; justify-content:space-between; }
.picker-head > view > view { color:#172033; font-size:30rpx; font-weight:900; }
.picker-head > view > text { display:block; margin-top:7rpx; color:#8a96a7; font-size:20rpx; }
.picker-head > text { display:flex; align-items:center; justify-content:center; width:52rpx; height:52rpx; border-radius:999rpx; background:#f1f4f8; color:#667085; font-size:34rpx; }
.picker-list { max-height:54vh; margin-top:22rpx; }
.picker-item { display:grid; grid-template-columns:82rpx minmax(0,1fr) 42rpx; align-items:center; gap:15rpx; min-height:104rpx; padding:12rpx; border-bottom:1rpx solid #edf1f5; box-sizing:border-box; }
.picker-item.selected { background:#f5f9ff; }
.picker-item image,.picker-icon { width:82rpx; height:76rpx; border-radius:12rpx; background:#eaf3ff; }
.picker-icon { display:flex; align-items:center; justify-content:center; color:#1677ff; font-size:25rpx; font-weight:900; }
.picker-copy { min-width:0; }
.picker-copy view { overflow:hidden; color:#263247; font-size:23rpx; font-weight:800; text-overflow:ellipsis; white-space:nowrap; }
.picker-copy text { display:block; margin-top:7rpx; overflow:hidden; color:#8c97a8; font-size:19rpx; text-overflow:ellipsis; white-space:nowrap; }
.picker-check { display:flex; align-items:center; justify-content:center; width:38rpx; height:38rpx; border:2rpx solid #ccd6e3; border-radius:999rpx; color:#fff; font-size:21rpx; }
.picker-item.selected .picker-check { border-color:#1677ff; background:#1677ff; }
.picker-empty { padding:100rpx 0; color:#8a96a7; font-size:23rpx; text-align:center; }
.picker-done { display:flex; align-items:center; justify-content:center; width:100%; height:76rpx; margin-top:18rpx; border-radius:16rpx; background:#1677ff; color:#fff; font-size:25rpx; font-weight:900; }
