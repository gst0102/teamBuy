.page {
  min-height: 100vh;
  padding: 24rpx;
  background: #eef6ff;
  color: #172033;
  box-sizing: border-box;
}

.summary-band {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  padding: 20rpx;
  border-radius: 8rpx;
  background: #ffffff;
}

.summary-band view {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.summary-band text:first-child {
  color: #172033;
  font-size: 34rpx;
  font-weight: 900;
}

.summary-band text:last-child {
  color: #64748b;
  font-size: 22rpx;
}

.summary-band .warn text:first-child {
  color: #ef4444;
}

.section {
  margin-top: 24rpx;
}

.section-title {
  margin-bottom: 14rpx;
  color: #172033;
  font-size: 30rpx;
  font-weight: 900;
}

.action-item,
.lead-item {
  margin-bottom: 16rpx;
  padding: 22rpx;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.lead-item.hot {
  border-left: 8rpx solid #ef4444;
}

.item-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.relay-person {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.relay-main {
  flex: 1;
  min-width: 0;
}

.item-title {
  color: #172033;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.25;
  word-break: break-all;
}

.item-time {
  margin-top: 6rpx;
  color: #94a3b8;
  font-size: 22rpx;
}

.status-pill {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #fff1f2;
  color: #ef4444;
  font-size: 22rpx;
  font-weight: 800;
}

.detail-lines,
.lead-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 16rpx;
  color: #475569;
  font-size: 24rpx;
  line-height: 1.45;
}

.phone-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  padding: 12rpx 14rpx;
  border-radius: 18rpx;
  background: #f3fbf6;
  color: #172033;
  font-size: 25rpx;
  font-weight: 800;
}

.call-action {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 92rpx;
  min-height: 50rpx;
  border-radius: 999rpx;
  background: #11924d;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 900;
}

.plain-btn {
  margin: 18rpx 0 0;
  padding: 0;
  background: transparent;
  color: #11924d;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.4;
  text-align: left;
}

.plain-btn::after {
  border: 0;
}

.summary-copy-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-width: 188rpx;
  height: 58rpx;
  min-height: 58rpx;
  margin: 0 0 14rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #e8f7ef;
  line-height: 58rpx;
  box-sizing: border-box;
}

.sku-filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 0 0 16rpx;
}

.sku-filter {
  max-width: 100%;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #64748b;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.25;
  box-sizing: border-box;
  word-break: break-all;
}

.sku-filter.active {
  background: #e8f7ef;
  color: #11924d;
}

.relay-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.relay-avatar {
  flex: 0 0 auto;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #edf2f7;
}

.relay-avatar.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: linear-gradient(135deg, #1677ff, #20c997);
  font-size: 28rpx;
  font-weight: 900;
}

.relay-buttons .plain-btn {
  flex: 0 0 auto;
  width: auto;
  min-width: 128rpx;
  height: 56rpx;
  min-height: 56rpx;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #eef8f2;
  font-size: 23rpx;
  line-height: 56rpx;
  text-align: center;
  box-sizing: border-box;
}

.relay-buttons .plain-btn::after {
  border: 0;
}

.relay-status-actions {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 14rpx;
}

.relay-status-actions button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  line-height: 60rpx;
  margin: 0;
  border-radius: 8rpx;
  background: #f1f5f9;
  color: #475569;
  font-size: 23rpx;
  font-weight: 800;
}

.relay-status-actions button.active {
  background: #11924d;
  color: #ffffff;
}

.relay-status-actions button::after {
  border: 0;
}

.lead-quick-actions {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 16rpx;
}

.lead-quick-actions button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 58rpx;
  margin: 0;
  padding: 0 6rpx;
  border-radius: 8rpx;
  background: #f1f5f9;
  color: #475569;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.1;
  box-sizing: border-box;
}

.lead-quick-actions button:first-child {
  color: #11924d;
  background: #e8f7ef;
}

.lead-quick-actions button::after {
  border: 0;
}

.empty {
  padding: 44rpx 20rpx;
  border-radius: 8rpx;
  background: #ffffff;
  color: #94a3b8;
  font-size: 26rpx;
  text-align: center;
}
