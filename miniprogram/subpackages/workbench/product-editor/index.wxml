<view class="product-page">
  <custom-nav title="编辑商品" showBack="{{true}}" rightText="{{saveStatus}}" />
  <view wx:if="{{loading}}" class="product-loading">正在读取商品…</view>
  <block wx:else>
    <view class="product-content">
      <view class="product-card preview-card">
        <view class="section-heading-row"><view class="section-heading">客户看到的效果</view><view class="section-link" bindtap="handlePreview">完整预览 <text>›</text></view></view>
        <view class="customer-preview">
          <image wx:if="{{imageMedia.length}}" class="customer-cover" src="{{imageMedia[0].displayUrl || imageMedia[0].url}}" mode="aspectFill" data-index="0" bindtap="handlePreviewImage" />
          <view wx:else class="customer-cover customer-cover-empty" bindtap="chooseImages"><text>＋</text><view>添加主图</view></view>
          <view class="customer-copy">
            <view class="customer-title">{{previewTitle}}</view>
            <view class="customer-price">{{previewPrice}}</view>
            <view class="mode-badge">{{previewMode}}</view>
            <view class="customer-headline">{{previewHeadline}}</view>
          </view>
        </view>
      </view>

      <view class="product-card image-card">
        <view class="section-heading-row"><view class="section-heading">商品图片</view><view class="section-note">长按设为封面 · 第一张作为主图</view></view>
        <scroll-view class="image-strip" scroll-x enable-flex>
          <view class="image-thumb-wrap" wx:for="{{imageMedia}}" wx:key="id">
            <image class="image-thumb" src="{{item.displayUrl || item.url}}" mode="aspectFill" data-index="{{index}}" bindtap="handlePreviewImage" bindlongpress="handleSetCover" />
            <view class="image-order">{{index + 1}}</view><view class="image-remove" data-index="{{index}}" bindtap="handleRemoveImage">×</view>
          </view>
          <view class="image-add" bindtap="chooseImages"><text>＋</text><view>{{uploading ? '上传中' : '添加'}}</view></view>
        </scroll-view>
      </view>

      <view class="product-card core-card">
        <view class="section-heading">核心信息</view>
        <view class="mode-row" bindtap="handleModeChange"><view class="field-label">销售方式</view><view class="mode-value">{{previewMode}} <text>切换 ›</text></view></view>
        <view class="core-field"><view class="field-label">商品名称</view><input class="product-input" value="{{structuredData.productName}}" data-key="productName" bindinput="handleStructuredInput" placeholder="未命名商品" placeholder-class="product-placeholder" /></view>
        <view class="core-field"><view class="field-label">一句话卖点</view><input class="product-input" value="{{structuredData.headline}}" data-key="headline" bindinput="handleStructuredInput" placeholder="例如：当天采摘，坏果包赔" placeholder-class="product-placeholder" /></view>
      </view>

      <view class="product-card variants-card">
        <view class="section-heading">价格与规格</view>
        <view class="variant-head"><text>规格</text><text>售价</text><text>状态</text><text></text></view>
        <view class="variant-row" wx:for="{{variants}}" wx:key="id">
          <input class="product-input" value="{{item.name}}" data-index="{{index}}" data-key="name" bindinput="handleVariantInput" placeholder="默认规格" placeholder-class="product-placeholder" />
          <view class="price-input"><text>¥</text><input type="digit" value="{{item.priceInput}}" data-index="{{index}}" data-key="priceInput" bindinput="handleVariantInput" placeholder="0.00" placeholder-class="product-placeholder" /></view>
          <view class="stock-tag {{item.stockStatus}}" data-index="{{index}}" bindtap="handleVariantStock">{{item.stockStatus === 'sold_out' ? '售罄' : '有货'}}</view>
          <view class="variant-remove" data-index="{{index}}" bindtap="handleRemoveVariant">×</view>
        </view>
        <view class="add-variant" bindtap="handleAddVariant">⊕ 添加规格</view>
      </view>

      <view class="product-card highlights-card">
        <view class="section-heading">商品亮点</view>
        <view wx:if="{{highlights.length}}" class="highlight-preview"><text wx:for="{{highlights}}" wx:key="*this" class="highlight-chip">{{item}} ✓</text></view>
        <input class="product-input full-input" value="{{highlightsText}}" bindinput="handleHighlightsInput" placeholder="当天采摘、冷链配送、坏果包赔" placeholder-class="product-placeholder" />
        <view class="field-label standalone">商品说明</view>
        <textarea class="product-textarea" value="{{structuredData.remark}}" data-key="remark" bindinput="handleStructuredInput" maxlength="300" placeholder="补充口感、保存方式、售后说明等" placeholder-class="product-placeholder" />
        <view class="text-count">{{remarkCount}}/300</view>
      </view>

      <view class="product-card progressive-card">
        <view class="progressive-row" data-section="fulfillment" bindtap="handleToggleSection"><view class="row-icon blue">▣</view><view class="row-copy"><view class="row-title">配送与自提</view><view class="row-summary">{{fulfillment.methods.length ? '已选择 ' + fulfillment.methods.length + ' 种方式' : '按实际情况选择，未选内容不展示'}}</view></view><text class="row-arrow">{{openSection === 'fulfillment' ? '⌄' : '›'}}</text></view>
        <view wx:if="{{openSection === 'fulfillment'}}" class="expanded-fields">
          <view class="method-grid"><view wx:for="{{fulfillmentOptions}}" wx:key="key" class="method-chip {{item.active ? 'active' : ''}}" data-key="{{item.key}}" bindtap="handleToggleFulfillment">{{item.label}}</view></view>
          <view wx:if="{{showShipping}}" class="expanded-field"><view class="field-label">快递与运费说明</view><input class="product-input" value="{{fulfillment.shippingFeeNote}}" data-key="shippingFeeNote" bindinput="handleFulfillmentInput" placeholder="例如：冷链包邮，48小时内发出" placeholder-class="product-placeholder" /></view>
          <block wx:if="{{showDelivery}}"><view class="expanded-field"><view class="field-label">配送范围</view><input class="product-input" value="{{fulfillment.deliveryArea}}" data-key="deliveryArea" bindinput="handleFulfillmentInput" placeholder="例如：滨江区内" placeholder-class="product-placeholder" /></view><view class="expanded-field"><view class="field-label">配送费说明</view><input class="product-input" value="{{fulfillment.deliveryFeeNote}}" data-key="deliveryFeeNote" bindinput="handleFulfillmentInput" placeholder="例如：满99元免配送费" placeholder-class="product-placeholder" /></view></block>
          <view wx:if="{{showPickup}}" class="pickup-box"><view class="pickup-copy"><view class="field-label">自提位置</view><view>{{fulfillment.pickupLocation.name || '尚未选择自提点'}}</view><text>{{fulfillment.pickupLocation.address}}</text></view><button class="small-button" bindtap="choosePickupLocation">地图选点</button></view>
          <view class="expanded-field"><view class="field-label">可领取 / 配送时间</view><input class="product-input" value="{{fulfillment.availableTime}}" data-key="availableTime" bindinput="handleFulfillmentInput" placeholder="例如：每天18:00后" placeholder-class="product-placeholder" /></view>
          <view class="supplement-head"><view><view class="field-label">补充资料</view><view class="small-note">PDF 与链接折叠展示，不抢占商品主图</view></view><button class="small-button" bindtap="handleChooseSupplement">添加</button></view>
          <view wx:if="{{supplementalMedia.length}}" class="supplement-list"><view wx:for="{{supplementalMedia}}" wx:key="id" class="supplement-item"><text>{{item.type === 'pdf' ? 'PDF' : '链接'}} · {{item.title || item.name || '补充资料'}}</text><text data-index="{{index}}" bindtap="handleRemoveSupplement">删除</text></view></view>
          <view wx:if="{{showLinkForm}}" class="link-form"><input class="product-input" data-key="title" value="{{linkDraft.title}}" bindinput="handleLinkInput" placeholder="链接标题（可选）" placeholder-class="product-placeholder" /><input class="product-input" data-key="url" value="{{linkDraft.url}}" bindinput="handleLinkInput" placeholder="https://" placeholder-class="product-placeholder" /><button class="link-confirm" bindtap="addLink">确认添加</button></view>
        </view>

        <block wx:if="{{salesMode === 'relay'}}"><view class="progressive-row" data-section="relay" bindtap="handleToggleSection"><view class="row-icon orange">▦</view><view class="row-copy"><view class="row-title">接龙设置</view><view class="row-summary">截止时间、限购与履约说明</view></view><text class="row-arrow">{{openSection === 'relay' ? '⌄' : '›'}}</text></view>
        <view wx:if="{{openSection === 'relay'}}" class="expanded-fields two-columns"><view class="expanded-field"><view class="field-label">截止时间</view><input class="product-input" value="{{relayConfig.deadlineAt}}" data-key="deadlineAt" bindinput="handleRelayInput" placeholder="例如：周五 22:00" placeholder-class="product-placeholder" /></view><view class="expanded-field"><view class="field-label">每人限购</view><input class="product-input" type="number" value="{{relayConfig.limitPerPerson}}" data-key="limitPerPerson" bindinput="handleRelayInput" placeholder="不限" placeholder-class="product-placeholder" /></view><view class="expanded-field full"><view class="field-label">库存提示</view><input class="product-input" value="{{relayConfig.stockNote}}" data-key="stockNote" bindinput="handleRelayInput" placeholder="例如：限量100份，售完即止" placeholder-class="product-placeholder" /></view><view class="expanded-field full"><view class="field-label">履约说明</view><textarea class="product-textarea compact" value="{{relayConfig.fulfillmentNote}}" data-key="fulfillmentNote" bindinput="handleRelayInput" placeholder="接龙成功后的发货或自提说明" placeholder-class="product-placeholder" /></view></view></block>

        <view class="progressive-row private" data-section="private" bindtap="handleToggleSection"><view class="row-icon gold">▢</view><view class="row-copy"><view class="row-title">仅自己可见 · 进货与管理</view><view class="row-summary">供应商、进货成本、内部库存</view></view><text class="row-arrow">{{openSection === 'private' ? '⌄' : '›'}}</text></view>
        <view wx:if="{{openSection === 'private'}}" class="expanded-fields two-columns private-fields"><view wx:for="{{privateFields}}" wx:key="key" class="expanded-field {{item.multiline ? 'full' : ''}}"><view class="field-label">{{item.label}}</view><textarea wx:if="{{item.multiline}}" class="product-textarea compact" value="{{privateData[item.key]}}" data-key="{{item.key}}" bindinput="handlePrivateInput" placeholder="{{item.placeholder}}" placeholder-class="product-placeholder" /><input wx:else class="product-input" value="{{privateData[item.key]}}" data-key="{{item.key}}" bindinput="handlePrivateInput" placeholder="{{item.placeholder}}" placeholder-class="product-placeholder" /></view></view>
      </view>
    </view>
    <view class="product-bottom-bar"><button class="delete-button" bindtap="handleDelete">删除商品</button><button class="save-button" bindtap="handlePublish" loading="{{saving}}">发客户</button></view>
  </block>
</view>
