page { background: #f3f7fd; }
.product-page { min-height: 100vh; color: #111b2e; }
.product-loading { padding: 180rpx 32rpx; color: #8b97aa; font-size: 26rpx; text-align: center; }
.product-content { display: grid; gap: 18rpx; padding: 18rpx 20rpx calc(150rpx + env(safe-area-inset-bottom)); }
.product-card { padding: 22rpx 24rpx; border: 1rpx solid #e8edf5; border-radius: 22rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(38,69,111,.045); box-sizing: border-box; }
.section-heading-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 18rpx; }
.section-heading { color: #132039; font-size: 28rpx; font-weight: 900; line-height: 1.2; }
.section-link { display: flex; align-items: center; gap: 6rpx; color: #0e6ff4; font-size: 23rpx; font-weight: 700; }
.section-link text { font-size: 34rpx; font-weight: 400; line-height: 1; }
.section-note { color: #96a1b2; font-size: 20rpx; white-space: nowrap; }

.customer-preview { display: grid; grid-template-columns: 305rpx minmax(0,1fr); gap: 22rpx; align-items: stretch; }
.customer-cover { width: 305rpx; height: 202rpx; border-radius: 15rpx; background: #f5ede8; }
.customer-cover-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx; border: 2rpx dashed #d6c9c0; color: #9b7d6c; font-size: 20rpx; box-sizing: border-box; }
.customer-cover-empty text { color: #f05f2a; font-size: 46rpx; font-weight: 300; line-height: 1; }
.customer-copy { min-width: 0; padding-top: 3rpx; }
.customer-title { overflow: hidden; color: #15223b; font-size: 29rpx; font-weight: 900; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }
.customer-price { margin-top: 10rpx; color: #f1472d; font-size: 34rpx; font-weight: 900; }
.mode-badge { display: inline-flex; align-items: center; justify-content: center; min-height: 34rpx; margin-top: 10rpx; padding: 0 12rpx; border: 1rpx solid #f06a50; border-radius: 7rpx; color: #e64c35; font-size: 18rpx; white-space: nowrap; box-sizing: border-box; }
.customer-headline { margin-top: 10rpx; overflow: hidden; color: #5c687c; font-size: 21rpx; line-height: 1.45; text-overflow: ellipsis; white-space: nowrap; }

.image-strip { width: 100%; white-space: nowrap; }
.image-thumb-wrap, .image-add { position: relative; display: inline-flex; width: 154rpx; height: 132rpx; margin-right: 14rpx; overflow: hidden; vertical-align: top; border-radius: 14rpx; box-sizing: border-box; }
.image-thumb { width: 100%; height: 100%; }
.image-order { position: absolute; top: 7rpx; left: 7rpx; display: flex; align-items: center; justify-content: center; width: 28rpx; height: 28rpx; border: 2rpx solid #fff; border-radius: 50%; background: #1677ff; color: #fff; font-size: 17rpx; font-weight: 800; }
.image-remove { position: absolute; top: 6rpx; right: 6rpx; display: flex; align-items: center; justify-content: center; width: 30rpx; height: 30rpx; border-radius: 50%; background: rgba(17,27,46,.68); color: #fff; font-size: 24rpx; line-height: 1; }
.image-add { flex-direction: column; align-items: center; justify-content: center; gap: 3rpx; border: 2rpx dashed #c8d2e0; color: #8290a4; font-size: 20rpx; }
.image-add text { color: #1677ff; font-size: 46rpx; font-weight: 300; line-height: 1; }

.core-card > .section-heading, .variants-card > .section-heading, .highlights-card > .section-heading { margin-bottom: 20rpx; }
.mode-row { display: flex; align-items: center; justify-content: space-between; min-height: 66rpx; margin-bottom: 18rpx; padding: 0 15rpx; border-top: 1rpx solid #edf1f6; border-bottom: 1rpx solid #edf1f6; box-sizing: border-box; }
.mode-value { display: flex; align-items: center; gap: 12rpx; color: #1c2940; font-size: 22rpx; font-weight: 800; }
.mode-value text { color: #1677ff; font-size: 19rpx; }
.core-field { display: grid; grid-template-columns: 112rpx minmax(0,1fr); gap: 12rpx; align-items: center; min-width: 0; margin-top: 14rpx; }
.field-label { color: #3b485f; font-size: 21rpx; font-weight: 700; white-space: nowrap; }
.product-input { width: 100%; height: 58rpx; padding: 0 15rpx; border: 1rpx solid #d9e1ec; border-radius: 10rpx; background: #fff; color: #172238; font-size: 22rpx; box-sizing: border-box; }
.product-placeholder { color: #a0aaba; font-size: 20rpx; }

.variant-head, .variant-row { display: grid; grid-template-columns: minmax(0,1.25fr) minmax(0,1fr) 86rpx 32rpx; gap: 10rpx; align-items: center; }
.variant-head { padding: 0 4rpx 10rpx; color: #8d98aa; font-size: 18rpx; }
.variant-row { margin-bottom: 12rpx; }
.price-input { position: relative; }
.price-input text { position: absolute; z-index: 1; top: 0; left: 12rpx; display: flex; align-items: center; height: 58rpx; color: #8793a5; font-size: 20rpx; }
.price-input input { width: 100%; height: 58rpx; padding: 0 10rpx 0 34rpx; border: 1rpx solid #d9e1ec; border-radius: 10rpx; font-size: 22rpx; box-sizing: border-box; }
.stock-tag { display: flex; align-items: center; justify-content: center; height: 50rpx; border-radius: 9rpx; background: #eaf8ef; color: #1f9b56; font-size: 19rpx; font-weight: 800; white-space: nowrap; }
.stock-tag.sold_out { background: #f1f3f6; color: #727f91; }
.variant-remove { display: flex; align-items: center; justify-content: center; width: 32rpx; height: 50rpx; color: #9ca6b5; font-size: 27rpx; }
.add-variant { display: flex; align-items: center; justify-content: center; min-height: 58rpx; border: 2rpx dashed #c9d6e7; border-radius: 10rpx; color: #1677ff; font-size: 21rpx; font-weight: 700; }

.highlight-preview { display: flex; flex-wrap: wrap; gap: 8rpx; margin: -3rpx 0 16rpx; }
.highlight-chip { display: flex; align-items: center; justify-content: center; min-height: 40rpx; padding: 0 13rpx; border: 1rpx solid #2f83ef; border-radius: 8rpx; background: #f6fbff; color: #1469dc; font-size: 19rpx; white-space: nowrap; box-sizing: border-box; }
.full-input { height: 62rpx; }
.standalone { margin: 18rpx 0 10rpx; }
.product-textarea { width: 100%; min-height: 116rpx; padding: 16rpx; border: 1rpx solid #d9e1ec; border-radius: 11rpx; background: #fff; color: #172238; font-size: 22rpx; line-height: 1.55; box-sizing: border-box; }
.product-textarea.compact { min-height: 88rpx; }
.text-count { margin-top: -30rpx; padding-right: 13rpx; color: #9aa5b5; font-size: 18rpx; text-align: right; pointer-events: none; }

.progressive-card { padding: 0; overflow: hidden; }
.progressive-row { display: grid; grid-template-columns: 48rpx minmax(0,1fr) 32rpx; gap: 12rpx; align-items: center; min-height: 92rpx; padding: 15rpx 24rpx; border-bottom: 1rpx solid #edf1f6; box-sizing: border-box; }
.progressive-row.private { background: #fffaf3; }
.row-icon { display: flex; align-items: center; justify-content: center; width: 42rpx; height: 42rpx; font-size: 28rpx; }
.row-icon.blue { color: #1677ff; }.row-icon.orange { color: #ef6a2e; }.row-icon.gold { color: #d79a38; }
.row-copy { min-width: 0; }.row-title { color: #1c2940; font-size: 23rpx; font-weight: 800; }
.row-summary { margin-top: 6rpx; overflow: hidden; color: #8c98aa; font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }
.row-arrow { color: #7f8ca0; font-size: 32rpx; text-align: right; }
.expanded-fields { display: grid; gap: 16rpx; padding: 20rpx 24rpx 24rpx; border-bottom: 1rpx solid #edf1f6; background: #fbfcfe; }
.expanded-fields.two-columns { grid-template-columns: 1fr 1fr; }.expanded-field.full { grid-column: 1 / -1; }
.expanded-field .field-label { margin-bottom: 8rpx; }.private-fields { background: #fffcf8; }
.method-grid { display: flex; flex-wrap: wrap; gap: 10rpx; }
.method-chip { display: flex; align-items: center; justify-content: center; min-height: 48rpx; padding: 0 18rpx; border: 1rpx solid #dae2ee; border-radius: 9rpx; color: #637087; font-size: 20rpx; white-space: nowrap; box-sizing: border-box; }
.method-chip.active { border-color: #1677ff; background: #edf6ff; color: #116cde; font-weight: 800; }
.pickup-box, .supplement-head { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; padding: 14rpx; border-radius: 11rpx; background: #fff; }
.pickup-copy { min-width: 0; color: #3b485f; font-size: 21rpx; }.pickup-copy > view:nth-child(2) { margin-top: 7rpx; font-weight: 800; }.pickup-copy > text { display: block; margin-top: 5rpx; overflow: hidden; color: #929dad; font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }
.small-note { margin-top: 6rpx; color: #929dad; font-size: 18rpx; }
.small-button, .link-confirm { display: flex; align-items: center; justify-content: center; height: 52rpx; margin: 0; padding: 0 20rpx; border: 0; border-radius: 10rpx; background: #eaf4ff; color: #146bdc; font-size: 21rpx; font-weight: 800; line-height: 1; box-sizing: border-box; }
.small-button::after, .link-confirm::after { border: 0; }
.supplement-list, .link-form { display: grid; gap: 10rpx; }
.supplement-item { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 12rpx 15rpx; border-radius: 10rpx; background: #fff; color: #536075; font-size: 19rpx; }
.supplement-item text:first-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.supplement-item text:last-child { flex: none; color: #df5364; }
.link-confirm { width: 100%; background: #1677ff; color: #fff; }

.product-bottom-bar { position: fixed; z-index: 20; right: 0; bottom: 0; left: 0; display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 14rpx; padding: 14rpx 22rpx calc(14rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e5eaf1; background: rgba(255,255,255,.96); box-shadow: 0 -8rpx 24rpx rgba(32,55,90,.08); box-sizing: border-box; }
.delete-button, .save-button { display: flex; align-items: center; justify-content: center; height: 76rpx; margin: 0; padding: 0; border-radius: 13rpx; font-size: 25rpx; font-weight: 800; line-height: 1; box-sizing: border-box; }
.delete-button { background: #eef3f9; color: #334155; }.save-button { background: linear-gradient(135deg,#1284ff,#0864ea); color: #fff; }
.delete-button::after, .save-button::after { border: 0; }
