page {
  background: #f4f7f5;
}

.page-shell {
  min-height: 100vh;
  padding: 24rpx 24rpx 150rpx;
  box-sizing: border-box;
}

.hero-card,
.section-card,
.step-card {
  margin-bottom: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #e3ebe5;
  border-radius: 8rpx;
  background: #fff;
  box-sizing: border-box;
}

.hero-card {
  background: #0f5f3d;
  color: #fff;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 128rpx;
  height: 42rpx;
  padding: 0 16rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: 23rpx;
  font-weight: 800;
  white-space: nowrap;
}

.hero-title {
  margin-top: 18rpx;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.2;
}

.hero-desc {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 26rpx;
  line-height: 1.5;
}

.mode-switch { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; margin-bottom: 20rpx; }
.mode-option { padding: 22rpx; border: 2rpx solid #dfe7e2; border-radius: 18rpx; background: #fff; }
.mode-option.active { border-color: #0f7a4c; background: #edf8f2; }
.mode-title { color: #172033; font-size: 27rpx; font-weight: 900; }
.mode-desc { margin-top: 8rpx; color: #718078; font-size: 21rpx; line-height: 1.4; }
.own-note-list { display: flex; flex-direction: column; gap: 12rpx; }
.own-note-row { display: grid; grid-template-columns: 44rpx minmax(0, 1fr); align-items: center; gap: 14rpx; min-height: 72rpx; padding: 0 16rpx; border: 1rpx solid #dfe7e2; border-radius: 14rpx; }
.own-note-row.selected { border-color: #0f7a4c; background: #edf8f2; }
.own-note-check { display: flex; align-items: center; justify-content: center; width: 38rpx; height: 38rpx; border: 2rpx solid #b8c7bd; border-radius: 10rpx; color: #0f7a4c; font-size: 24rpx; font-weight: 900; }
.own-note-title { overflow: hidden; color: #243044; font-size: 24rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.own-note-empty { padding: 28rpx; color: #738078; font-size: 23rpx; text-align: center; }

.section-title {
  margin-bottom: 18rpx;
  color: #172033;
  font-size: 30rpx;
  font-weight: 900;
}

.source-row {
  display: grid;
  grid-template-columns: 92rpx minmax(0, 1fr);
  gap: 16rpx;
  align-items: start;
}

.source-label {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 44rpx;
  border-radius: 8rpx;
  background: #edf7f1;
  color: #0f7a4c;
  font-size: 23rpx;
  font-weight: 800;
  white-space: nowrap;
}

.source-main {
  min-width: 0;
}

.source-title {
  color: #172033;
  font-size: 29rpx;
  font-weight: 850;
  line-height: 1.4;
}

.source-sub {
  margin-top: 8rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.45;
}

.form-field {
  margin-top: 16rpx;
}

.field-label {
  margin-bottom: 10rpx;
  color: #475467;
  font-size: 24rpx;
  font-weight: 800;
}

.field-input {
  width: 100%;
  min-width: 0;
  height: 76rpx;
  padding: 0 20rpx;
  border: 1rpx solid #d7e1dc;
  border-radius: 8rpx;
  background: #f9fbfa;
  color: #172033;
  font-size: 27rpx;
  box-sizing: border-box;
}

.privacy-note {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 8rpx;
  background: #fff7e8;
  color: #7a4d00;
  font-size: 24rpx;
  line-height: 1.55;
}

.step-card {
  display: grid;
  gap: 14rpx;
}

.step-item {
  display: grid;
  grid-template-columns: 46rpx minmax(0, 1fr);
  gap: 14rpx;
  align-items: center;
  color: #344054;
  font-size: 25rpx;
  line-height: 1.45;
}

.step-num {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: #0f7a4c;
  color: #fff;
  font-size: 23rpx;
  font-weight: 900;
}

.fallback-note {
  padding: 16rpx 18rpx;
  border-radius: 8rpx;
  background: #fff7e8;
  color: #7a4d00;
  font-size: 24rpx;
  line-height: 1.5;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr);
  gap: 16rpx;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e5e7eb;
  background: rgba(255, 255, 255, 0.96);
  box-sizing: border-box;
}

.primary-btn,
.secondary-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 82rpx;
  margin: 0;
  padding: 0 16rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.2;
  white-space: nowrap;
  box-sizing: border-box;
}

.primary-btn::after,
.secondary-btn::after {
  border: 0;
}

.primary-btn {
  color: #fff;
  background: #0f7a4c;
}

.primary-btn[disabled] {
  color: rgba(255, 255, 255, 0.72);
  background: #6aa98a;
}

.secondary-btn {
  color: #0f7a4c;
  background: #edf7f1;
}
/* Typography scale v2: clarify the same-style flow and its privacy choices. */
.page-shell .hero-title { font-size: 38rpx; }
.page-shell .hero-desc { font-size: 26rpx; }
.page-shell .mode-title { font-size: 29rpx; }
.page-shell .mode-desc { font-size: 24rpx; }
.page-shell .section-title { font-size: 32rpx; }
.page-shell .source-label { font-size: 24rpx; }
.page-shell .source-title { font-size: 28rpx; }
.page-shell .source-sub { font-size: 23rpx; }
.page-shell .own-note-title { font-size: 26rpx; }
.page-shell .own-note-empty { font-size: 24rpx; }
.page-shell .field-label { font-size: 26rpx; }
.page-shell .field-input { font-size: 28rpx; }
.page-shell .privacy-note { font-size: 23rpx; }
.page-shell .step-item { font-size: 25rpx; }
.page-shell .action-bar button { display: flex; align-items: center; justify-content: center; min-height: 72rpx; font-size: 26rpx; }
