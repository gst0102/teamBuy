.editor-count { color: #1677ff; font-weight: 700; }
.editor-section { margin: 20rpx 24rpx 0; padding: 28rpx 24rpx; background: #fff; border-radius: 22rpx; box-sizing: border-box; box-shadow: 0 8rpx 24rpx rgba(42, 63, 92, .04); }
.hero-section { border-top: 6rpx solid #1677ff; }.section-kicker { color: #6b7280; font-size: 23rpx; font-weight: 700; letter-spacing: 1rpx; }.section-title { margin-top: 8rpx; color: #111827; font-size: 32rpx; font-weight: 800; }.section-head-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.editor-title-input { width: 100%; margin-top: 18rpx; color: #111827; font-size: 42rpx; font-weight: 800; box-sizing: border-box; }.editor-description-input { width: 100%; min-height: 100rpx; margin-top: 10rpx; color: #667085; font-size: 27rpx; box-sizing: border-box; }
.cover-row { display: flex; align-items: center; gap: 18rpx; margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid #edf0f5; }.cover-preview { flex: 0 0 180rpx; width: 180rpx; height: 120rpx; border-radius: 14rpx; background: #e9f1ff; }.cover-empty { display: flex; align-items: center; justify-content: center; color: #4a75ba; font-size: 25rpx; }.cover-copy { flex: 1; min-width: 0; }.cover-title { display: block; color: #111827; font-size: 27rpx; font-weight: 700; }.cover-desc { display: block; margin: 8rpx 0 14rpx; color: #98a2b3; font-size: 22rpx; line-height: 1.45; }
.small-outline-button { display: flex; align-items: center; justify-content: center; min-width: 126rpx; height: 54rpx; margin: 0; padding: 0 18rpx; border: 1rpx solid #cfe0f7; border-radius: 12rpx; color: #1677ff; background: #f7fbff; font-size: 23rpx; line-height: 1; box-sizing: border-box; white-space: nowrap; }.small-outline-button::after { border: 0; }
.selected-showcase-row { display: flex; align-items: center; gap: 14rpx; padding: 18rpx 0; border-bottom: 1rpx solid #edf0f5; }.selected-cover { flex: 0 0 92rpx; width: 92rpx; height: 72rpx; border-radius: 10rpx; background: #eff4fa; }.selected-fallback { display: flex; align-items: center; justify-content: center; color: #4b75b7; font-size: 22rpx; }.selected-copy { flex: 1; min-width: 0; }.selected-title { color: #111827; font-size: 27rpx; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.selected-meta { margin-top: 7rpx; color: #98a2b3; font-size: 21rpx; }.selected-actions { display: flex; align-items: center; gap: 8rpx; }.selected-actions button { display: flex; align-items: center; justify-content: center; width: 52rpx; height: 48rpx; margin: 0; padding: 0; border-radius: 10rpx; color: #55708f; background: #f3f6fa; font-size: 22rpx; line-height: 1; }.selected-actions button:last-child { width: 76rpx; color: #e5484d; }.selected-actions button::after { border: 0; }
.note-picker-box { margin-top: 18rpx; padding: 18rpx; border: 1rpx solid #e1eaf5; border-radius: 16rpx; background: #f8fbff; }.picker-head, .picker-footer { display: flex; align-items: center; justify-content: space-between; color: #344054; font-size: 24rpx; }.picker-hint, .picker-footer { color: #98a2b3; font-size: 21rpx; }.note-picker-list { margin-top: 12rpx; }.picker-footer { margin-top: 14rpx; }
.template-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; margin-top: 18rpx; }.template-choice { position: relative; min-width: 0; padding: 14rpx; border: 2rpx solid #e7ecf4; border-radius: 16rpx; background: #fff; box-sizing: border-box; overflow: hidden; }.template-choice.active { border-color: #1677ff; background: #f6faff; }.template-preview { position: relative; height: 144rpx; overflow: hidden; border-radius: 10rpx; background: #e8eef7; box-sizing: border-box; }.template-preview-image { display: block; width: 100%; height: 100%; }.template-preview::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 58rpx; background: linear-gradient(180deg, rgba(12, 24, 44, 0), rgba(12, 24, 44, .34)); pointer-events: none; }.template-preview-badge { position: absolute; left: 12rpx; top: 12rpx; z-index: 2; padding: 5rpx 10rpx; border-radius: 8rpx; background: rgba(255,255,255,.88); color: #1677ff; font-size: 21rpx; font-weight: 700; line-height: 1; }.template-preview-fallback { display: flex; align-items: center; justify-content: center; flex-direction: column; width: 100%; height: 100%; }.template-preview-fallback-badge { color: #1677ff; font-size: 32rpx; font-weight: 900; }.template-preview-fallback-copy { margin-top: 8rpx; color: rgba(22,119,255,.72); font-size: 20rpx; }.template-preview.tone-green, .template-preview-fallback.tone-green { background: linear-gradient(135deg, #dff4ea, #bfe8d4); }.template-preview.tone-warm, .template-preview-fallback.tone-warm { background: linear-gradient(135deg, #fff0dc, #ffdcb5); }.template-preview.tone-blue, .template-preview-fallback.tone-blue { background: linear-gradient(135deg, #e1efff, #c6ddff); }.template-preview.tone-teal, .template-preview-fallback.tone-teal { background: linear-gradient(135deg, #dff5f2, #bfe7df); }.template-choice-title { margin-top: 12rpx; color: #111827; font-size: 27rpx; font-weight: 800; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }.template-choice-desc { margin-top: 6rpx; min-height: 56rpx; color: #7a8698; font-size: 21rpx; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }.template-check { position: absolute; top: 12rpx; right: 14rpx; color: #1677ff; font-size: 26rpx; font-weight: 800; }
.section-hint { margin-top: 6rpx; color: #8a95a6; font-size: 21rpx; line-height: 1.4; }
.layout-row { display: grid; grid-template-columns: 128rpx minmax(0, 1fr); column-gap: 16rpx; align-items: center; margin-top: 22rpx; padding-top: 18rpx; border-top: 1rpx solid #edf0f5; color: #475467; font-size: 24rpx; }.layout-row > text { min-width: 128rpx; white-space: nowrap; }.layout-options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); min-width: 0; gap: 10rpx; }.layout-option { display: flex; align-items: center; justify-content: center; width: 100%; min-width: 0; height: 52rpx; margin: 0; padding: 0; border-radius: 10rpx; color: #667085; background: #f2f5f9; font-size: 22rpx; line-height: 1; white-space: nowrap; box-sizing: border-box; }.layout-option.active { color: #1677ff; background: #e8f2ff; }.layout-option::after { border: 0; }
.check-row { display: flex; align-items: flex-start; gap: 12rpx; padding: 14rpx 0; border-bottom: 1rpx solid #edf0f5; }.check-icon { display: flex; align-items: center; justify-content: center; flex: 0 0 34rpx; width: 34rpx; height: 34rpx; border-radius: 50%; color: #fff; background: #1aae72; font-size: 20rpx; }.check-icon.warn { background: #f0a52b; }.check-label { display: block; color: #344054; font-size: 24rpx; }.check-fix { display: block; margin-top: 4rpx; color: #98a2b3; font-size: 21rpx; }.editor-contact-input { width: 100%; height: 72rpx; margin-top: 14rpx; padding: 0 18rpx; border: 1rpx solid #e0e7ef; border-radius: 12rpx; background: #fafcff; color: #344054; font-size: 24rpx; box-sizing: border-box; }.editor-empty { padding: 28rpx 12rpx; color: #98a2b3; text-align: center; font-size: 23rpx; }
.editor-bottom-spacer { height: 40rpx; }.editor-bottom-actions { position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; display: flex; gap: 12rpx; padding: 14rpx 20rpx calc(14rpx + env(safe-area-inset-bottom)); background: rgba(255,255,255,.97); border-top: 1rpx solid #e4eaf2; box-shadow: 0 -8rpx 24rpx rgba(15,23,42,.08); box-sizing: border-box; }.editor-bottom-actions button { display: flex; align-items: center; justify-content: center; flex: 1; min-width: 0; height: 76rpx; margin: 0; padding: 0 8rpx; border-radius: 12rpx; font-size: 23rpx; font-weight: 800; line-height: 1; white-space: nowrap; }.editor-bottom-actions button::after { border: 0; }.bottom-secondary { color: #1677ff; background: #edf5ff; }.bottom-primary { color: #fff; background: #1677ff; }
.share-image-canvas { position: fixed; left: -9999rpx; top: -9999rpx; width: 750rpx; height: 1800rpx; pointer-events: none; }
