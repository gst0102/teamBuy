# The core service is the only process that receives these credentials.
WECOM_ARCHIVE_CORE_ENVIRONMENT=development
WECOM_ARCHIVE_CORE_DATABASE_URL=postgresql://archive_core:archive_core_password@postgres:5432/archive_core
WECOM_ARCHIVE_CORE_CORP_ID=
WECOM_ARCHIVE_CORE_SECRET=
WECOM_ARCHIVE_CORE_ADMIN_TOKEN=
WECOM_ARCHIVE_CORE_CALLBACK_TOKEN=
WECOM_ARCHIVE_CORE_ENCODING_AES_KEY=
WECOM_ARCHIVE_CORE_PRIVATE_KEY_PATH=/app/secrets/wecom_archive_private.pem
WECOM_ARCHIVE_CORE_SDK_LIB_PATH=/opt/wecom-sdk/libWeWorkFinanceSdk_C.so
WECOM_ARCHIVE_CORE_PROXY=
WECOM_ARCHIVE_CORE_PROXY_PASSWORD=
WECOM_ARCHIVE_CORE_SDK_TIMEOUT_SECONDS=30

# Production compose reads these names from the same mode-600 env file.
POSTGRES_DB=archive_core
POSTGRES_USER=archive_core
POSTGRES_PASSWORD=change_me
WECOM_ARCHIVE_CORE_DATABASE_URL=postgresql://archive_core:change_me@archive-core-postgres:5432/archive_core

# 32-byte base64 or 64-character hex key used to seal decrypted archive data.
# Do not use a development default in production.
WECOM_ARCHIVE_CORE_DATA_KEY=
WECOM_ARCHIVE_CORE_MEDIA_TOKEN_KEY=

WECOM_ARCHIVE_CORE_ENABLED=false
WECOM_ARCHIVE_CORE_WORKER_ENABLED=false
WECOM_ARCHIVE_CORE_POLL_INTERVAL_SECONDS=60
WECOM_ARCHIVE_CORE_BATCH_LIMIT=50
WECOM_ARCHIVE_CORE_DELIVERY_LIMIT=50
WECOM_ARCHIVE_CORE_DELIVERY_TIMEOUT_SECONDS=15
# The shared core is a short-lived relay. Project consumers must persist an
# event before acknowledging it; pending deliveries are never cleaned up.
WECOM_ARCHIVE_CORE_RAW_RETENTION_HOURS=24

# Empty chatIds do not match group messages unless allowAllChats is explicitly true.
# One-to-one messages have no roomId; they require includeDirectMessages=true,
# and can be narrowed with fromUserIds/toUserIds.
# Tokens are runtime secrets and must never be committed with real values.
WECOM_ARCHIVE_CORE_PROJECTS_JSON=[]
